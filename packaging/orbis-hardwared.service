# orbis-hardwared.service — standalone dev deployment unit.
#
# Устанавливается deploy-dev-hardwared.sh как regular file в
# /etc/systemd/system/. Full services.orbis-control также умеет создавать
# NixOS-managed hardwared unit, поэтому deploy script отказывается перезаписывать
# symlink и ожидает policy-only module для standalone lifecycle.
#
# X-StopOnRemoval=false: при удалении unit'а systemd НЕ останавливает service.
# X-RestartIfChanged=false: при обновлении unit'а systemd НЕ перезапускает
# service (deploy script делает explicit restart).
#
# Direct sysfs write scope intentionally matches the full NixOS module:
# Performance platform_profile + ASUS keyboard backlight brightness only.
# Other Hardware1 mutations use typed service backends and do not widen /sys.

[Unit]
Description=Orbis Control hardware helper (standalone dev deployment)
X-StopOnRemoval=false
After=dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=io.github.orbiscontrol.Hardware
ExecStart=/usr/local/bin/orbis-hardwared
Restart=on-failure
RestartSec=2s
X-RestartIfChanged=false

# Sandbox (threat-model §3.3)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=true
AmbientCapabilities=
CapabilityBoundingSet=

# /sys stays read-only except the same two exact optional attributes used by
# the full NixOS module. A missing path does not widen the sandbox.
ReadOnlyPaths=/sys
ReadWritePaths=-/sys/firmware/acpi/platform_profile
ReadWritePaths=-/sys/class/leds/asus::kbd_backlight/brightness
