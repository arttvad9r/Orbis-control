# orbis-hardwared.service — package-owned Arch/Linux system service.
#
# Local installers substitute their /usr/local prefix before installing this
# template. Privileged mutation stays behind the typed Hardware1 D-Bus API and
# per-capability polkit actions.

[Unit]
Description=Orbis Control hardware helper
After=dbus.service asusd.service
Requires=dbus.service
Wants=asusd.service

[Service]
Type=dbus
BusName=io.github.orbiscontrol.Hardware
ExecStart=/usr/bin/orbis-hardwared
Restart=on-failure
RestartSec=2s

# Sandbox (threat-model §3.3)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=true
AmbientCapabilities=
CapabilityBoundingSet=

# /sys stays read-only except the exact capability-owned write paths.
ReadOnlyPaths=/sys
ReadWritePaths=-/sys/firmware/acpi/platform_profile
ReadWritePaths=-/sys/class/firmware-attributes/asus-armoury/attributes/ppt_pl1_spl/current_value
ReadWritePaths=-/sys/class/firmware-attributes/asus-armoury/attributes/ppt_pl2_sppt/current_value
ReadWritePaths=-/sys/class/firmware-attributes/asus-armoury/attributes/ppt_pl3_fppt/current_value
ReadWritePaths=-/sys/class/firmware-attributes/asus-armoury/attributes/nv_dynamic_boost/current_value
ReadWritePaths=-/sys/class/firmware-attributes/asus-armoury/attributes/nv_temp_target/current_value
ReadWritePaths=-/sys/devices/platform/asus-nb-wmi/ppt_pl1_spl
ReadWritePaths=-/sys/devices/platform/asus-nb-wmi/ppt_pl2_sppt
ReadWritePaths=-/sys/devices/platform/asus-nb-wmi/ppt_fppt
ReadWritePaths=-/sys/devices/platform/asus-nb-wmi/nv_dynamic_boost
ReadWritePaths=-/sys/devices/platform/asus-nb-wmi/nv_temp_target
ReadWritePaths=-/sys/class/leds/asus::kbd_backlight/brightness
ReadWritePaths=-/sys/class/leds/asus::kbd_backlight/max_brightness
ReadWritePaths=-/sys/class/firmware-attributes/asus-armoury/attributes/boot_sound/current_value
ReadWritePaths=-/sys/class/firmware-attributes/asus-armoury/attributes/apu_mem/current_value

[Install]
WantedBy=multi-user.target
