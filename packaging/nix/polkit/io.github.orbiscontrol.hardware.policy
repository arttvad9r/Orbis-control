<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
 <!-- Mutation actions orbis-hardwared: только активный локальный пользователь. -->
<policyconfig>
  <action id="io.github.orbiscontrol.hardware.set-performance-profile">
    <description>Change the Orbis Control performance profile</description>
    <description xml:lang="ru">Изменить профиль производительности Orbis Control</description>
    <message>Authentication is required to change the performance profile</message>
    <message xml:lang="ru">Требуется аутентификация для изменения профиля производительности</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
  <action id="io.github.orbiscontrol.hardware.set-charge-limit">
    <description>Change the Orbis Control battery charge limit</description>
    <description xml:lang="ru">Изменить лимит заряда батареи Orbis Control</description>
    <message>Authentication is required to change the battery charge limit</message>
    <message xml:lang="ru">Требуется аутентификация для изменения лимита заряда батареи</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
  <action id="io.github.orbiscontrol.hardware.set-gpu-mode">
    <description>Change the Orbis Control GPU backend mode</description>
    <description xml:lang="ru">Изменить backend-режим GPU Orbis Control</description>
    <message>Authentication is required to change the GPU backend mode</message>
    <message xml:lang="ru">Требуется аутентификация для изменения backend-режима GPU</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
