// Sidebar navigation item. Selected state uses both a quiet surface and a slim
// accent rail so navigation remains obvious without turning the whole row blue.
import { Icon } from "icon.slint";
import { Palette } from "../themes/dark.slint";

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <int> icon-kind: 0;
    in property <bool> selected: false;
    callback clicked;

    height: 42px;
    border-radius: 10px;
    background: root.selected ? Palette.surface-selected
        : touch.has-hover ? Palette.surface-hover
        : transparent;

    if (root.selected) : Rectangle {
        x: 0px;
        y: 9px;
        width: 3px;
        height: parent.height - 18px;
        border-radius: 1.5px;
        background: Palette.accent-default;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 11px;
        alignment: center;

        Rectangle {
            width: 22px;
            background: transparent;
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                kind: root.icon-kind;
                tint: root.selected ? Palette.accent-default : Palette.text-secondary;
            }
        }
        Text {
            text: root.label;
            font-size: 13.5px;
            font-weight: root.selected ? 650 : 500;
            color: root.selected ? Palette.text-primary : Palette.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
    }

    touch := TouchArea { clicked => { root.clicked(); } }
}
