// Sidebar navigation item: two-line row, solid accent pill when active
// (docs/references/orbis-visual-2026-09-24/). Geometry is absolute so the icon
// column and label x are identical on every row.
import { Icon } from "icon.slint";
import { Palette } from "../themes/dark.slint";

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> sublabel: "";
    in property <int> icon-kind: 0;
    in property <bool> selected: false;
    callback clicked;

    out property <length> row-inset: 14px;
    out property <length> icon-size: 20px;
    out property <length> spacing-icon-label: 14px;

    height: root.sublabel == "" ? 42px : 54px;
    border-radius: 10px;
    background: root.selected ? Palette.accent-fill
        : touch.has-hover ? Palette.surface-hover
        : transparent;

    Icon {
        x: root.row-inset;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        kind: root.icon-kind;
        tint: root.selected ? Palette.text-on-accent : Palette.text-secondary;
    }

    VerticalLayout {
        x: root.row-inset + root.icon-size + root.spacing-icon-label;
        width: parent.width - self.x - 10px;
        spacing: 2px;
        alignment: center;

        Text {
            text: root.label;
            font-size: 13.5px;
            font-weight: root.selected ? 600 : 500;
            color: root.selected ? Palette.text-on-accent : Palette.text-primary;
            overflow: elide;
        }
        if (root.sublabel != "") : Text {
            text: root.sublabel;
            font-size: 11px;
            color: root.selected ? Palette.text-on-accent.transparentize(0.2) : Palette.text-disabled;
            overflow: elide;
        }
    }

    touch := TouchArea { clicked => { root.clicked(); } }
}
