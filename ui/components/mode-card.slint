// ModeCard — large segmented-card selector (reference design):
// icon left, title + short description right. Selected = accent border +
// soft accent tint + accent icon; no glow, no filled accent blocks.
import { Icon } from "icon.slint";
import { Palette } from "../themes/dark.slint";

export component ModeCard inherits Rectangle {
    in property <string> title;
    in property <string> description: "";
    in property <color> accent: Palette.accent-default;
    in property <bool> selected: false;
    in property <bool> disabled: false;
    in property <bool> pending: false;
    in property <string> pending-note: "Требуется перезагрузка";
    in property <int> icon-kind: 4;
    in property <bool> icon-visible: true;
    callback clicked;

    horizontal-stretch: 1;
    min-height: 64px;
    border-radius: 10px;
    border-width: root.selected || root.pending ? 1.5px : 1px;
    border-color: root.selected || root.pending ? root.accent
        : touch.has-hover && !root.disabled ? Palette.border-strong
        : Palette.border-default;

    property <bool> hover: touch.has-hover;
    property <bool> down: touch.pressed;
    // Shared with the icon as an arc mask (gauge glyph).
    property <color> card-bg: root.disabled ? Palette.surface-disabled
        : root.down ? Palette.surface-pressed
        : root.selected || root.pending ? Palette.accent-soft
        : root.hover ? Palette.surface-hover
        : Palette.surface-default;

    background: root.card-bg;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 11px;
        alignment: center;

        if (root.icon-visible) : Rectangle {
            width: 22px;
            background: transparent;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    property <color> tint: root.disabled ? Palette.text-disabled
                        : root.selected || root.pending ? root.accent
                        : Palette.text-secondary;
                    background: transparent;
                    // 22px glyph: the shared 18px icon scaled by a wrapper is
                    // not supported by the software renderer, so mode glyphs
                    // reuse the Icon at native size inside a centering box.
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        kind: root.icon-kind;
                        tint: parent.tint;
                        mask: root.card-bg;
                    }
                }
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 13.5px;
                font-weight: 600;
                color: root.disabled ? Palette.text-disabled : Palette.text-primary;
                overflow: elide;
            }
            if (root.description != "") : Text {
                text: root.description;
                font-size: 11.5px;
                color: root.disabled ? Palette.text-disabled : Palette.text-secondary;
                overflow: elide;
            }
            if (root.pending && !root.disabled) : Text {
                text: root.pending-note;
                font-size: 10px;
                color: root.accent;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}
