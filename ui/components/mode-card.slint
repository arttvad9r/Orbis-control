// Product mode selector. A selected mode is emphasized by hierarchy, not by a
// large saturated fill; pending remains visually distinct from selected.
import { Icon } from "icon.slint";
import { Palette } from "../themes/dark.slint";

export component ModeCard inherits Rectangle {
    in property <string> title;
    in property <string> description: "";
    in property <color> accent: Palette.accent-default;
    in property <bool> selected: false;
    in property <bool> disabled: false;
    in property <bool> pending: false;
    in property <string> pending-note: "Требуется перезагрузка";
    in property <int> icon-kind: 4;
    in property <bool> icon-visible: true;
    callback clicked;

    horizontal-stretch: 1;
    min-height: 82px;
    border-radius: 12px;
    border-width: root.selected || root.pending ? 1.5px : 1px;
    border-color: root.selected || root.pending ? root.accent
        : touch.has-hover && !root.disabled ? Palette.border-strong
        : Palette.border-default;

    property <color> card-bg: root.disabled ? Palette.surface-disabled
        : touch.pressed ? Palette.surface-pressed
        : root.selected || root.pending ? root.accent.transparentize(0.90)
        : touch.has-hover ? Palette.surface-hover
        : Palette.surface-raised;
    background: root.card-bg;

    if (root.selected || root.pending) : Rectangle {
        x: 0px;
        y: 12px;
        width: 3px;
        height: parent.height - 24px;
        border-radius: 1.5px;
        background: root.accent;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        spacing: 12px;
        alignment: center;

        if (root.icon-visible) : Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 9px;
            background: root.disabled ? Palette.surface-muted : root.accent.transparentize(0.88);
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                kind: root.icon-kind;
                tint: root.disabled ? Palette.text-disabled
                    : root.selected || root.pending ? root.accent
                    : Palette.text-secondary;
                mask: parent.background;
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.title;
                font-size: 14px;
                font-weight: 650;
                color: root.disabled ? Palette.text-disabled : Palette.text-primary;
                overflow: elide;
            }
            if (root.description != "") : Text {
                text: root.description;
                font-size: 11.5px;
                color: root.disabled ? Palette.text-disabled : Palette.text-secondary;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            if (root.pending && !root.disabled) : Text {
                text: root.pending-note;
                font-size: 10.5px;
                font-weight: 600;
                color: root.accent;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}
