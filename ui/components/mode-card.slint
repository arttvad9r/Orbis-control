// Compact mode selector used by Performance and GPU sections.
// Visual language follows the useful part of the G-Helper pattern: equal cards,
// quiet neutral surfaces and a colored selected outline. Orbis deliberately
// avoids placeholder pictograms until real icon assets exist.

import { Palette } from "../themes/dark.slint";

export component ModeCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <color> accent: Palette.accent-default;
    in property <bool> selected: false;
    in property <bool> disabled: false;
    in property <bool> pending: false;
    in property <bool> error-state: false;
    in property <string> pending-note: "Reboot required";
    // Retained for source compatibility with existing call sites. The old
    // geometric placeholder icons are intentionally no longer rendered.
    in property <int> icon-kind: 0;
    in property <bool> compact: false;

    callback clicked;

    height: 54px;
    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 0px;
    border-radius: 8px;
    border-width: root.selected || root.pending || root.error-state ? 1.5px : 1px;

    property <bool> hover: touch.has-hover;
    property <bool> down: touch.pressed;
    property <length> title-size: root.compact ? 10px : 12px;

    background: root.disabled ? Palette.surface-disabled
        : root.down ? Palette.surface-pressed
        : root.selected || root.pending ? Palette.surface-selected
        : root.hover ? Palette.surface-hover
        : Palette.surface-default;

    border-color: root.error-state ? Palette.error
        : root.selected || root.pending ? root.accent
        : root.hover && !root.disabled ? Palette.border-strong
        : Palette.border-default;

    VerticalLayout {
        padding-left: 7px;
        padding-right: 7px;
        padding-top: 6px;
        padding-bottom: 5px;
        spacing: 3px;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.disabled ? Palette.text-disabled
                    : root.selected || root.pending ? root.accent
                    : Palette.text-secondary;
                opacity: root.selected || root.pending ? 1 : 0.48;
            }
            Text {
                text: root.title;
                font-size: root.title-size;
                font-weight: root.selected ? 700 : 600;
                color: root.disabled ? Palette.text-disabled : Palette.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if (root.pending) : Text {
            text: root.pending-note;
            font-size: 8px;
            color: root.accent;
            horizontal-alignment: center;
            overflow: elide;
        }

        if (!root.pending && root.subtitle != "") : Text {
            text: root.subtitle;
            font-size: 8px;
            color: root.disabled ? Palette.text-disabled : Palette.text-secondary;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}
