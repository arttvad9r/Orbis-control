// Mode tile: icon above a short label, as in the reference profile row.
// Selection cross-fades into a lit accent tile with a halo ring; hover
// brightens the border and tints the icon; press ripples. A queued (pending)
// mode keeps a warning outline so it never reads as already applied.
import { Icon } from "icon.slint";
import { Ripple, FocusRing } from "interaction.slint";
import { Palette } from "../themes/dark.slint";
import { Motion, Shape } from "../themes/tokens.slint";

export component ModeCard inherits Rectangle {
    in property <string> title;
    in property <string> description: "";
    in property <bool> selected: false;
    in property <bool> disabled: false;
    in property <bool> pending: false;
    in property <string> pending-note: "После перезагрузки";
    in property <int> icon-kind: 4;
    callback clicked;

    property <bool> filled: root.selected && !root.pending;
    property <bool> hover: touch.has-hover && !root.disabled;

    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    min-height: 96px;
    border-radius: Shape.tile;
    background: transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-checked: root.selected;
    accessible-action-default => { if (!root.disabled) { root.clicked(); } }

    // Halo ring around the active tile.
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: Shape.tile + 3px;
        border-width: 3px;
        border-color: Palette.accent-default.transparentize(0.78);
        background: transparent;
        opacity: root.filled && !root.disabled ? 1 : 0;
        animate opacity { duration: Motion.normal; }
    }

    // Idle surface.
    Rectangle {
        border-radius: Shape.tile;
        border-width: root.pending ? 1.5px : 1px;
        border-color: root.pending ? Palette.warning
            : root.hover ? Palette.accent-border.transparentize(0.35)
            : Palette.border-default;
        background: root.disabled ? Palette.surface-disabled
            : root.hover ? Palette.surface-hover
            : Palette.surface-raised;
        animate background, border-color { duration: Motion.fast; easing: ease-out; }
    }
    // Active fill, cross-faded.
    Rectangle {
        border-radius: Shape.tile;
        border-width: 1.5px;
        border-color: Palette.accent-border;
        background: root.disabled ? Palette.accent-fill.transparentize(0.5)
            : root.hover ? Palette.accent-fill.brighter(0.12) : Palette.accent-fill;
        opacity: root.filled ? 1 : 0;
        animate opacity { duration: Motion.normal; easing: ease-out; }
    }
    ripple := Ripple { radius: Shape.tile; tint: root.filled ? #FFFFFF : Palette.accent-default; strength: 0.18; }

    // Active dot.
    Rectangle {
        x: parent.width - 16px - (self.width - 6px) / 2;
        y: 10px - (self.height - 6px) / 2;
        width: root.filled ? 6px : 0px;
        height: self.width;
        border-radius: self.width / 2;
        background: Palette.text-on-accent;
        animate width { duration: Motion.slow; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 10px;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            Icon {
                width: 30px;
                height: 30px;
                kind: root.icon-kind;
                tint: root.filled ? Palette.text-on-accent
                    : root.disabled ? Palette.text-disabled
                    : root.pending ? Palette.warning
                    : root.hover ? Palette.accent-default
                    : Palette.text-primary;
                animate tint { duration: Motion.fast; }
            }
        }
        Text {
            text: root.title;
            font-size: 15px;
            font-weight: root.filled ? 600 : 500;
            color: root.filled ? Palette.text-on-accent
                : root.disabled ? Palette.text-disabled
                : Palette.text-primary;
            horizontal-alignment: center;
            overflow: elide;
            animate color { duration: Motion.fast; }
        }
        if (root.description != "") : Text {
            text: root.description;
            font-size: 11px;
            color: root.filled ? Palette.text-on-accent.transparentize(0.25) : Palette.text-secondary;
            horizontal-alignment: center;
            overflow: elide;
        }
        if (root.pending && !root.disabled) : Text {
            text: root.pending-note;
            font-size: 11px;
            font-weight: 600;
            color: Palette.warning;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) { ripple.press(self.mouse-x, self.mouse-y); }
            else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) { ripple.release(); }
        }
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        enabled: !root.disabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) { root.clicked(); return accept; }
            return reject;
        }
    }
    FocusRing { shown: focus.has-focus; radius: Shape.tile; }
}
