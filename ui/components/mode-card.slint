// Mode tile: icon above a short label, as in the reference profile row. The
// active mode is a solid accent tile; a queued (pending) mode keeps a warning
// outline so it never reads as already applied.
import { Icon } from "icon.slint";
import { Palette } from "../themes/dark.slint";

export component ModeCard inherits Rectangle {
    in property <string> title;
    in property <string> description: "";
    in property <bool> selected: false;
    in property <bool> disabled: false;
    in property <bool> pending: false;
    in property <string> pending-note: "После перезагрузки";
    in property <int> icon-kind: 4;
    callback clicked;

    property <bool> filled: root.selected && !root.pending;

    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    min-height: 84px;
    border-radius: 12px;
    border-width: root.filled || root.pending ? 1.5px : 1px;
    border-color: root.pending ? Palette.warning
        : root.filled ? Palette.accent-border
        : touch.has-hover && !root.disabled ? Palette.border-strong
        : Palette.border-default;
    background: root.filled ? (root.disabled ? Palette.accent-fill.transparentize(0.5) : Palette.accent-fill)
        : root.disabled ? Palette.surface-disabled
        : touch.pressed ? Palette.surface-pressed
        : touch.has-hover ? Palette.surface-hover
        : Palette.surface-raised;

    if (root.filled) : Rectangle {
        x: parent.width - 16px;
        y: 10px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Palette.text-on-accent;
    }

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            Icon {
                width: 22px;
                height: 22px;
                kind: root.icon-kind;
                tint: root.filled ? Palette.text-on-accent
                    : root.disabled ? Palette.text-disabled
                    : root.pending ? Palette.warning
                    : Palette.text-primary;
            }
        }
        Text {
            text: root.title;
            font-size: 13.5px;
            font-weight: root.filled ? 600 : 500;
            color: root.filled ? Palette.text-on-accent
                : root.disabled ? Palette.text-disabled
                : Palette.text-primary;
            horizontal-alignment: center;
            overflow: elide;
        }
        if (root.description != "") : Text {
            text: root.description;
            font-size: 11px;
            color: root.filled ? Palette.text-on-accent.transparentize(0.25) : Palette.text-secondary;
            horizontal-alignment: center;
            overflow: elide;
        }
        if (root.pending && !root.disabled) : Text {
            text: root.pending-note;
            font-size: 11px;
            font-weight: 600;
            color: Palette.warning;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}
