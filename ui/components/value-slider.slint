// Compact value slider with an authoritative external value.
// Dragging is local preview only; changed() is emitted once on pointer release.

import { Palette } from "../themes/dark.slint";

export component ValueSlider inherits Rectangle {
    in property <int> min: 40;
    in property <int> max: 100;
    in property <int> step: 5;
    in property <int> value: 80;
    in property <bool> disabled: false;
    callback changed(float);

    height: 30px;
    background: transparent;

    property <bool> gesture-active: false;
    property <float> preview-value: root.value;
    property <float> internal-value: root.gesture-active ? root.preview-value : root.value;
    property <float> frac: (root.internal-value - root.min) / (root.max - root.min);

    function snap(v: float) -> float {
        let clamped = Math.min(Math.max(v, root.min), root.max);
        let steps = Math.round((clamped - root.min) / root.step);
        return root.min + steps * root.step;
    }

    HorizontalLayout {
        spacing: 7px;
        alignment: center;

        Text {
            text: root.min + "";
            font-size: 9px;
            color: Palette.text-disabled;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            min-width: 120px;
            height: 4px;
            border-radius: 2px;
            background: root.disabled ? Palette.surface-disabled : Palette.border-default;

            Rectangle {
                x: 0px;
                width: parent.width * root.frac;
                height: 100%;
                border-radius: 2px;
                background: root.disabled ? Palette.text-disabled : Palette.accent-default;
            }

            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: root.disabled ? Palette.text-disabled : Palette.text-primary;
                border-width: touch.has-hover && !root.disabled ? 1.5px : 1px;
                border-color: root.disabled ? Palette.text-disabled : Palette.accent-default;
                x: root.frac * (parent.width - 14px);
                y: (parent.height - 14px) / 2;
            }

            touch := TouchArea {
                width: parent.width;
                height: 24px;
                y: (parent.height - 24px) / 2;
                enabled: !root.disabled;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        root.gesture-active = true;
                        root.preview-value = root.snap(root.min
                            + (self.mouse-x / parent.width) * (root.max - root.min));
                    } else if (ev.kind == PointerEventKind.move && self.pressed) {
                        let raw = root.min + (self.mouse-x / parent.width) * (root.max - root.min);
                        root.preview-value = root.snap(raw);
                    } else if (ev.kind == PointerEventKind.up && root.gesture-active) {
                        let raw = root.min + (self.mouse-x / parent.width) * (root.max - root.min);
                        let final-value = root.snap(raw);
                        root.gesture-active = false;
                        root.preview-value = root.value;
                        if (final-value != root.value) {
                            root.changed(final-value);
                        }
                    } else if (ev.kind == PointerEventKind.cancel) {
                        root.gesture-active = false;
                        root.preview-value = root.value;
                    }
                }
            }
        }

        Text {
            text: root.max + "";
            font-size: 9px;
            color: Palette.text-disabled;
            vertical-alignment: center;
        }

        Text {
            text: round(root.internal-value) + "%";
            font-size: 11px;
            font-weight: 650;
            color: root.disabled ? Palette.text-disabled : Palette.text-primary;
            min-width: 38px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}
