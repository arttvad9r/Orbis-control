// Value slider with an authoritative external value. Dragging previews locally;
// changed() is emitted once on release.
import { Palette } from "../themes/dark.slint";
import { Motion } from "../themes/tokens.slint";

export component ValueSlider inherits Rectangle {
    in property <int> min: 40;
    in property <int> max: 100;
    in property <int> step: 1;
    in property <int> value: 80;
    in property <string> unit: "%";
    in property <bool> disabled: false;
    // The trailing live readout is redundant when the enclosing row already
    // shows the authoritative value+unit (LimitRow); it also makes the minimum
    // slider width exceed a 1/3 card column at the 980px window (audit
    // t_29073c31).
    in property <bool> show-percent: true;
    out property <bool> has-keyboard-focus: focus-scope.has-focus;
    callback changed(float);

    height: 40px;
    background: transparent;

    property <bool> gesture-active: false;
    property <bool> keyboard-active: false;
    property <float> preview-value: root.value;
    property <float> internal-value: root.gesture-active ? root.preview-value : root.value;
    property <float> frac: (root.internal-value - root.min) / (root.max - root.min);

    function edit-to(target: float) {
        if (root.disabled) { return; }
        root.gesture-active = true;
        root.keyboard-active = true;
        root.preview-value = root.snap(target);
        commit-timer.running = false;
        commit-timer.running = true;
    }

    function nudge(delta: float) {
        root.edit-to((root.keyboard-active ? root.preview-value : root.value) + delta);
    }

    function commit-keyboard() {
        commit-timer.running = false;
        if (!root.keyboard-active) { return; }
        let final-value = root.snap(root.preview-value);
        root.keyboard-active = false;
        root.gesture-active = false;
        root.preview-value = root.value;
        if (final-value != root.value) {
            root.changed(final-value);
        }
    }

    commit-timer := Timer {
        interval: 600ms;
        running: false;
        triggered => { root.commit-keyboard(); }
    }

    function snap(v: float) -> float {
        let clamped = Math.min(Math.max(v, root.min), root.max);
        let steps = Math.round((clamped - root.min) / root.step);
        return root.min + steps * root.step;
    }

    focus-scope := FocusScope {
        focus-on-tab-navigation: true;
        enabled: !root.disabled;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.nudge(-root.step);
                return accept;
            } else if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.nudge(root.step);
                return accept;
            } else if (event.text == Key.PageDown) {
                root.nudge(-10 * root.step);
                return accept;
            } else if (event.text == Key.PageUp) {
                root.nudge(10 * root.step);
                return accept;
            } else if (event.text == Key.Home) {
                root.edit-to(root.min);
                return accept;
            } else if (event.text == Key.End) {
                root.edit-to(root.max);
                return accept;
            } else if (event.text == Key.Return) {
                root.commit-keyboard();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        spacing: 14px;
        alignment: stretch;

        Rectangle {
            horizontal-stretch: 1;
            min-width: 64px;
            background: transparent;

            property <bool> hot: (touch.has-hover || root.gesture-active) && !root.disabled;

            track := Rectangle {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 6px;
                border-radius: 3px;
                background: root.disabled ? Palette.surface-disabled : Palette.border-default;

                Rectangle {
                    x: 0px;
                    width: root.frac * (track.width - 20px) + 10px;
                    height: 100%;
                    border-radius: 3px;
                    background: root.disabled ? Palette.text-disabled
                        : Palette.accent-fill;
                    animate width { duration: root.gesture-active ? 0ms : Motion.normal; easing: cubic-bezier(0.2, 0, 0, 1); }
                }
            }

            // Hover / drag halo.
            Rectangle {
                width: 38px;
                height: 38px;
                x: thumb.x + thumb.width / 2 - self.width / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 19px;
                background: Palette.accent-default.transparentize(parent.hot ? (root.gesture-active ? 0.72 : 0.84) : 1);
                animate background { duration: Motion.fast; }
            }

            thumb := Rectangle {
                width: root.gesture-active && !root.keyboard-active ? 24px : 20px;
                height: self.width;
                x: root.frac * (parent.width - 20px) + 10px - self.width / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: root.disabled ? Palette.text-disabled : #FFFFFF;
                border-width: 5px;
                border-color: root.disabled ? Palette.surface-disabled : Palette.accent-fill;
                animate width { duration: Motion.fast; easing: ease-out; }
                animate x { duration: root.gesture-active ? 0ms : Motion.normal; easing: cubic-bezier(0.2, 0, 0, 1); }
            }
            // Keyboard focus ring around the thumb.
            Rectangle {
                width: thumb.width + 8px;
                height: self.width;
                x: thumb.x - 4px;
                y: thumb.y - 4px;
                border-radius: self.width / 2;
                border-width: 2px;
                border-color: Palette.accent-default;
                background: transparent;
                opacity: focus-scope.has-focus && root.keyboard-active ? 1 : 0;
                animate opacity { duration: Motion.fast; }
            }

            // Value bubble while dragging (Material 3 value indicator).
            Rectangle {
                width: 48px;
                height: 26px;
                x: thumb.x + thumb.width / 2 - self.width / 2;
                y: thumb.y - self.height - 8px;
                border-radius: 8px;
                background: Palette.accent-fill;
                opacity: root.gesture-active ? 1 : 0;
                animate opacity { duration: Motion.fast; }
                Text {
                    text: round(root.internal-value) + (root.unit == "" ? "" : root.unit == "%" ? "%" : " " + root.unit);
                    font-size: 12px;
                    font-weight: 650;
                    color: Palette.text-on-accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                width: parent.width;
                height: 34px;
                y: (parent.height - 34px) / 2;
                enabled: !root.disabled;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        focus-scope.focus();
                        commit-timer.running = false;
                        root.keyboard-active = false;
                        root.gesture-active = true;
                        root.preview-value = root.snap(root.min
                            + (self.mouse-x / parent.width) * (root.max - root.min));
                    } else if (ev.kind == PointerEventKind.move && self.pressed) {
                        let raw = root.min + (self.mouse-x / parent.width) * (root.max - root.min);
                        root.preview-value = root.snap(raw);
                    } else if (ev.kind == PointerEventKind.up && root.gesture-active) {
                        let raw = root.min + (self.mouse-x / parent.width) * (root.max - root.min);
                        let final-value = root.snap(raw);
                        root.gesture-active = false;
                        root.preview-value = root.value;
                        if (final-value != root.value) {
                            root.changed(final-value);
                        }
                    } else if (ev.kind == PointerEventKind.cancel) {
                        root.gesture-active = false;
                        root.preview-value = root.value;
                    }
                }
            }
        }

        if (root.show-percent) : Rectangle {
            width: 72px;
            height: 36px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            border-width: 1px;
            border-color: root.gesture-active ? Palette.accent-border : Palette.border-default;
            background: Palette.surface-raised;
            animate border-color { duration: Motion.fast; }
            Text {
                text: round(root.internal-value) + (root.unit == "" ? "" : " " + root.unit);
                font-size: 13.5px;
                font-weight: 600;
                color: root.disabled ? Palette.text-disabled : Palette.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
