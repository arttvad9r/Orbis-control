// ValueSlider — компактный ползунок на примитивах Slint (без std-widgets).
// Горизонтальный трек: неактивная серая часть + активная синяя часть от
// начала диапазона до текущего значения. Круглый бегунок 15px.
// Состояния: normal, hover, pressed/dragging, disabled.
// Значение ограничено [min, max] и округляется к шагу (step) при перетаскивании
// и нажатии по треку.

import { Palette } from "../themes/dark.slint";

export component ValueSlider inherits Rectangle {
    in property <int> min: 40;
    in property <int> max: 100;
    in property <int> step: 5;
    in property <int> value: 80;
    in property <bool> disabled: false;
    callback changed(float);

    height: 30px;
    background: transparent;

    property <float> internal-value: root.value;
    // доля диапазона [min, max], 0..1
    property <float> frac: (root.internal-value - root.min) / (root.max - root.min);

    // округление к шагу с ограничением диапазона
    function snap(v: float) -> float {
        let clamped = Math.min(Math.max(v, root.min), root.max);
        let steps = Math.round((clamped - root.min) / root.step);
        return root.min + steps * root.step;
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: center;

        // подпись минимума
        Text {
            text: root.min + "";
            font-size: 10px;
            color: Palette.text-disabled;
            vertical-alignment: center;
        }

        // трек
        Rectangle {
            height: 5px;
            border-radius: 2.5px;
            background: root.disabled ? Palette.surface-disabled : Palette.border-default;
            width: 190px;

            // активная часть от начала до текущего значения (frac в [0,1])
            Rectangle {
                x: 0px;
                width: parent.width * root.frac;
                height: 100%;
                border-radius: 2.5px;
                background: root.disabled ? Palette.text-disabled : Palette.accent-default;
            }

            // бегунок
            Rectangle {
                width: 15px;
                height: 15px;
                border-radius: 7.5px;
                background: root.disabled ? Palette.text-disabled
                    : touch.pressed ? Palette.accent-default
                    : Palette.text-primary;
                border-width: touch.has-hover ? 1.5px : 1px;
                border-color: root.disabled ? Palette.text-disabled : Palette.accent-default;
                // travel = ширина трека - ширина бегунка: на 100% правый внешний
                // край бегунка совпадает с правой границей трека (рамка рисуется
                // внутри границ элемента и не выходит за контейнер)
                x: root.frac * (parent.width - 15px);
                y: (parent.height - 15px) / 2;
            }

            touch := TouchArea {
                width: parent.width;
                height: 22px;
                y: (parent.height - 22px) / 2;
                enabled: !root.disabled;
                pointer-event(ev) => {
                    // Только при нажатии или перетаскивании (не при hover-движении).
                    if (ev.kind == PointerEventKind.down
                        || (ev.kind == PointerEventKind.move && self.pressed)) {
                        let raw = root.min + (self.mouse-x / parent.width) * (root.max - root.min);
                        // Значение отправляется в controller; отображаемое значение
                        // возвращается из ui-state через root.value (единый источник).
                        root.changed(root.snap(raw));
                    }
                }
            }
        }

        // подпись максимума
        Text {
            text: root.max + "";
            font-size: 10px;
            color: Palette.text-disabled;
            vertical-alignment: center;
        }

        // значение справа от ползунка
        Text {
            text: round(root.internal-value) + "%";
            font-size: 13px;
            color: Palette.text-primary;
            min-width: 44px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}
