// ValueSlider — собственный ползунок на примитивах Slint
// (без std-widgets): трек, заполнение, thumb, TouchArea.

import { Palette } from "../themes/dark.slint";

export component ValueSlider inherits Rectangle {
    in property <int> min: 40;
    in property <int> max: 100;
    in property <int> step: 5;
    in property <int> value: 80;
    callback changed(float);

    height: 30px;
    background: transparent;

    property <float> internal-value: root.value;
    property <float> frac: (root.internal-value - root.min) / (root.max - root.min);

    HorizontalLayout {
        spacing: 10px;
        alignment: center;

        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Palette.border-default;
            horizontal-stretch: 1;

            // заполнение
            Rectangle {
                width: parent.width * root.frac;
                height: 100%;
                border-radius: 2px;
                background: Palette.accent-default;
            }

            // thumb
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: Palette.text-primary;
                x: parent.width * root.frac - 7px;
                y: (parent.height - 14px) / 2;
            }

            touch := TouchArea {
                width: parent.width;
                height: 20px;
                y: (parent.height - 20px) / 2;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down || ev.kind == PointerEventKind.move) {
                        root.internal-value =
                            root.min + (self.mouse-x / parent.width) * (root.max - root.min);
                        root.changed(root.internal-value);
                    }
                }
            }
        }

        Text {
            text: round(root.internal-value) + "%";
            font-size: 13px;
            color: Palette.text-primary;
            min-width: 44px;
            horizontal-alignment: right;
        }
    }
}
