// Frameless product chrome: compact app identity, generous drag surface and
// conventional window controls.
import { Palette } from "../themes/dark.slint";
import { LayoutMetrics } from "../audited/common.slint";
import { AppMark } from "app-mark.slint";
import { Icon, Icons } from "icon.slint";

component WindowButton inherits Rectangle {
    in property <int> icon-kind;
    in property <bool> danger: false;
    callback clicked;

    width: 50px;
    height: LayoutMetrics.titlebar-height;
    background: btn-touch.has-hover
        ? (root.danger ? Palette.error : Palette.surface-hover)
        : transparent;

    Icon {
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        kind: root.icon-kind;
        tint: btn-touch.has-hover && root.danger ? Palette.text-on-accent : Palette.text-primary;
    }
    btn-touch := TouchArea { clicked => { root.clicked(); } }
}

export component TitleBar inherits Rectangle {
    in property <string> app-title: "Orbis Control";
    in property <bool> maximized: false;
    callback minimize-requested;
    callback maximize-requested;
    callback close-requested;
    callback drag-started;

    height: LayoutMetrics.titlebar-height;
    background: Palette.titlebar-background;

    drag-touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.drag-started();
            }
        }
    }

    HorizontalLayout {
        Rectangle {
            width: LayoutMetrics.sidebar-width;
            background: transparent;
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 12px;
                spacing: 12px;
                alignment: center;
                Rectangle {
                    width: 30px;
                    vertical-stretch: 1;
                    background: transparent;
                    AppMark {
                        width: 30px;
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                    }
                }
                Text {
                    text: root.app-title;
                    font-size: 16px;
                    font-weight: 600;
                    color: Palette.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }

        Rectangle { horizontal-stretch: 1; background: transparent; }

        WindowButton { icon-kind: Icons.minus; clicked => { root.minimize-requested(); } }
        WindowButton { icon-kind: Icons.maximize; clicked => { root.maximize-requested(); } }
        WindowButton { icon-kind: Icons.close; danger: true; clicked => { root.close-requested(); } }
    }

}
