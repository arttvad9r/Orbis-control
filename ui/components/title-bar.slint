// Frameless title bar: app identity above the sidebar, drag surface,
// minimize/maximize/close on the right (reference design).
// Window glyphs are text primitives; drag goes through the winit accessor.
import { Palette } from "../themes/dark.slint";

component WindowButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> rect-glyph: false;
    in property <bool> danger: false;
    callback clicked;

    width: 44px;
    background: btn-touch.has-hover
        ? (root.danger ? Palette.error : Palette.surface-hover)
        : transparent;
    Text {
        text: root.glyph;
        font-size: 13px;
        color: btn-touch.has-hover && root.danger ? Palette.text-on-accent : Palette.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if (root.rect-glyph) : Rectangle {
        width: 9px;
        height: 9px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        border-width: 1.3px;
        border-color: btn-touch.has-hover && root.danger ? Palette.text-on-accent : Palette.text-secondary;
        background: transparent;
    }
    btn-touch := TouchArea { clicked => { root.clicked(); } }
}

export component TitleBar inherits Rectangle {
    in property <string> app-title: "Orbis Control";
    in property <bool> maximized: false;
    callback minimize-requested;
    callback maximize-requested;
    callback close-requested;
    callback drag-started;

    height: 44px;
    background: Palette.titlebar-background;

    // Declared first: buttons below sit on top of this surface, so presses on
    // them never reach the drag handler.
    drag-touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.drag-started();
            }
        }
    }

    HorizontalLayout {
        // App identity aligned with the sidebar column.
        Rectangle {
            width: 230px;
            background: transparent;
            HorizontalLayout {
                padding-left: 16px;
                spacing: 9px;
                alignment: center;
                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 5px;
                    background: Palette.accent-default;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 1.5px;
                        background: Palette.text-on-accent;
                    }
                }
                Text {
                    text: root.app-title;
                    font-size: 13px;
                    font-weight: 600;
                    color: Palette.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        Rectangle { horizontal-stretch: 1; background: transparent; }

        WindowButton { glyph: "–"; clicked => { root.minimize-requested(); } }
        WindowButton { rect-glyph: true; clicked => { root.maximize-requested(); } }
        WindowButton { glyph: "\u{00D7}"; danger: true; clicked => { root.close-requested(); } }
    }
}
