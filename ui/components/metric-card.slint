// Telemetry tile: tinted icon + label, large value, one detail line and an
// optional level bar (progress in 0..1, negative hides it).
import { Icon } from "icon.slint";
import { Palette } from "../themes/dark.slint";

export component MetricCard inherits Rectangle {
    in property <string> label;
    in property <string> value: "—";
    in property <string> detail: "";
    in property <int> icon-kind: 10;
    in property <color> accent: Palette.accent-default;
    in property <color> value-color: Palette.text-primary;
    in property <color> detail-color: Palette.text-secondary;
    in property <float> progress: -1;

    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    height: 132px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Palette.border-default;
    background: @linear-gradient(180deg, Palette.card-top 0%, Palette.surface-default 100%);

    VerticalLayout {
        padding: 18px;
        spacing: 6px;

        HorizontalLayout {
            height: 22px;
            spacing: 10px;
            Icon {
                width: 20px;
                height: 20px;
                y: 1px;
                kind: root.icon-kind;
                tint: root.accent;
            }
            Text {
                horizontal-stretch: 1;
                text: root.label;
                font-size: 13.5px;
                font-weight: 500;
                color: Palette.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Text {
            text: root.value;
            font-size: 26px;
            font-weight: 700;
            color: root.value-color;
            overflow: elide;
        }
        Text {
            text: root.detail;
            font-size: 12px;
            color: root.detail-color;
            overflow: elide;
        }

        Rectangle { vertical-stretch: 1; }

        Rectangle {
            height: 5px;
            border-radius: 2.5px;
            background: root.progress >= 0 ? Palette.border-default : transparent;
            Rectangle {
                x: 0px;
                width: parent.width * Math.min(Math.max(root.progress, 0), 1);
                height: parent.height;
                border-radius: 2.5px;
                background: root.progress >= 0 ? root.accent : transparent;
            }
        }
    }
}
