// Telemetry tile (reference dashboard row): tinted icon + label, large value,
// two detail lines beside a live sparkline and a level bar at the bottom
// (progress in 0..1, negative hides it).
import { Icon } from "icon.slint";
import { Palette } from "../themes/dark.slint";
import { Motion } from "../themes/tokens.slint";
import { Skeleton } from "skeleton.slint";

export component MetricCard inherits Rectangle {
    in property <string> label;
    in property <string> value: "—";
    in property <string> detail: "";
    in property <string> detail-2: "";
    in property <int> icon-kind: 10;
    in property <color> accent: Palette.accent-default;
    in property <color> value-color: Palette.text-primary;
    in property <color> detail-color: Palette.text-secondary;
    in property <float> progress: -1;
    // White-on-transparent sparkline rendered by the runtime; tinted here.
    in property <image> spark;
    // Narrow windows: the value drops its label-aligned indent.
    in property <bool> compact: false;

    property <bool> has-spark: root.spark.width > 0;

    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    height: 176px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Palette.border-default;
    background: Palette.card-top.mix(Palette.surface-default, 0.5);

    VerticalLayout {
        padding: 18px;
        padding-top: 16px;
        spacing: 4px;

        HorizontalLayout {
            height: 30px;
            spacing: 14px;
            Icon {
                width: 30px;
                height: 30px;
                kind: root.icon-kind;
                tint: root.accent;
            }
            Text {
                horizontal-stretch: 1;
                text: root.label;
                font-size: 15px;
                font-weight: 550;
                color: Palette.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        HorizontalLayout {
            // Value aligns with the label; narrow cards reclaim the indent.
            padding-left: root.compact ? 0px : 44px;
            if (root.value != "—") : Text {
                text: root.value;
                font-size: 30px;
                font-weight: 700;
                color: root.value-color;
                overflow: elide;
            }
            // Loading placeholder instead of a bare dash.
            if (root.value == "—") : Rectangle {
                height: 38px;
                Skeleton { width: 96px; height: 26px; y: 6px; }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                alignment: center;
                spacing: 4px;
                Text {
                    text: root.detail;
                    font-size: 13px;
                    color: root.detail-color;
                    overflow: elide;
                }
                if (root.detail-2 != "") : Text {
                    text: root.detail-2;
                    font-size: 13px;
                    color: Palette.text-secondary;
                    overflow: elide;
                }
            }
            if (root.has-spark) : Rectangle {
                width: 48%;
                // Keep the sparkline's 5:2 proportions (see sparkline.rs).
                Image {
                    width: parent.width;
                    height: self.width * 0.4;
                    y: (parent.height - self.height) / 2;
                    source: root.spark;
                    colorize: root.accent;
                    image-fit: fill;
                }
            }
        }

        Rectangle {
            height: 7px;
            border-radius: 3.5px;
            background: root.progress >= 0 ? Palette.border-default : transparent;
            Rectangle {
                x: 0px;
                width: parent.width * Math.min(Math.max(root.progress, 0), 1);
                height: parent.height;
                border-radius: 3.5px;
                animate width { duration: Motion.data; easing: cubic-bezier(0.2, 0, 0, 1); }
                background: root.progress >= 0 ? root.accent : transparent;
            }
        }
    }
}
