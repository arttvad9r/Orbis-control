// MetricCard — compact telemetry tile (reference design):
// small icon + label on top, large primary metric, short secondary line.
// Values arrive as display strings; "—" is the honest loading/absence form.
import { Icon } from "icon.slint";
import { Palette } from "../themes/dark.slint";

export component MetricCard inherits Rectangle {
    in property <string> label;
    in property <string> value: "—";
    in property <string> detail: "";
    in property <int> icon-kind: 10;
    in property <color> value-color: Palette.text-primary;

    horizontal-stretch: 1;
    min-height: 92px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border-default;
    background: Palette.surface-default;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 5px;

        HorizontalLayout {
            height: 18px;
            spacing: 8px;
            Icon {
                y: (parent.height - self.height) / 2;
                kind: root.icon-kind;
                tint: Palette.text-secondary;
            }
            Text {
                text: root.label;
                font-size: 12px;
                color: Palette.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }

        Text {
            text: root.value;
            font-size: 20px;
            font-weight: 650;
            color: root.value-color;
            overflow: elide;
        }
        if (root.detail != "") : Text {
            text: root.detail;
            font-size: 11.5px;
            color: Palette.text-secondary;
            overflow: elide;
        }
    }
}
