// Compact telemetry tile with a stable label/value/detail hierarchy.
import { Icon } from "icon.slint";
import { Palette } from "../themes/dark.slint";

export component MetricCard inherits Rectangle {
    in property <string> label;
    in property <string> value: "—";
    in property <string> detail: "";
    in property <int> icon-kind: 10;
    in property <color> value-color: Palette.text-primary;

    horizontal-stretch: 1;
    min-height: 104px;
    border-radius: 13px;
    border-width: 1px;
    border-color: Palette.border-default;
    background: Palette.surface-default;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 6px;

        HorizontalLayout {
            height: 24px;
            spacing: 8px;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 7px;
                background: Palette.surface-muted;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2 + 1px;
                    kind: root.icon-kind;
                    tint: Palette.text-secondary;
                }
            }
            Text {
                text: root.label;
                font-size: 12.5px;
                font-weight: 550;
                color: Palette.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }

        Text {
            text: root.value;
            font-size: 22px;
            font-weight: 700;
            color: root.value-color;
            overflow: elide;
        }
        if (root.detail != "") : Text {
            text: root.detail;
            font-size: 11.5px;
            color: Palette.text-disabled;
            overflow: elide;
        }
    }
}
