// SectionHeader — заголовок секции (20px, semibold).

import { Palette } from "../themes/dark.slint";

export component SectionHeader inherits Rectangle {
    in property <string> title;

    height: 20px;
    background: transparent;

    HorizontalLayout {
        padding-left: 2px;
        alignment: center;
        Text {
            text: root.title;
            font-size: 13px;
            font-weight: 600;
            color: Palette.text-primary;
        }
    }
}
