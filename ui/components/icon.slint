// Icon — SVG line icons (ui/assets/icons, 24×24, white stroke) tinted with
// `colorize`. Slint rasterizes SVG through resvg, so the glyphs stay crisp in
// the software renderer and at any size. Use the `Icons` constants for `kind`.

import { Palette } from "../themes/dark.slint";

export global Icons {
    out property <int> home: 0;
    out property <int> gauge: 1;
    out property <int> battery: 2;
    out property <int> fan: 3;
    out property <int> gpu: 4;
    out property <int> sun: 5;
    out property <int> monitor: 6;
    out property <int> system: 7;
    out property <int> sliders: 8;
    out property <int> info: 9;
    out property <int> cpu: 10;
    out property <int> ram: 11;
    out property <int> thermometer: 12;
    out property <int> plug: 13;
    out property <int> keyboard: 14;
    out property <int> laptop: 15;
    out property <int> leaf: 16;
    out property <int> target: 17;
    out property <int> flame: 18;
    out property <int> zap: 19;
    out property <int> chevron-right: 20;
    out property <int> chevron-down: 21;
    out property <int> heart: 22;
    out property <int> refresh: 23;
    out property <int> power: 24;
    out property <int> palette: 25;
    out property <int> moon: 26;
    out property <int> bulb: 27;
    out property <int> sparkles: 28;
    out property <int> speed: 29;
    out property <int> rocket: 30;
    out property <int> file: 31;
    out property <int> shield: 32;
    out property <int> bell: 33;
    out property <int> download: 34;
    out property <int> upload: 35;
    out property <int> cog: 36;
    out property <int> check-circle: 37;
    out property <int> close: 38;
    out property <int> minus: 39;
    out property <int> maximize: 40;
    out property <int> swap: 41;
    out property <int> activity: 42;
    out property <int> timer: 43;
    out property <int> drive: 44;
    out property <int> lock: 45;
    out property <int> external: 46;
    out property <int> plus: 47;
    out property <int> reset: 48;
    out property <int> trash: 49;
    out property <int> hdr: 50;
    out property <int> sync: 51;
    out property <int> window: 52;
    out property <int> cpu-chip: 53;
    out property <int> tray: 54;
    out property <int> exit: 55;
    out property <int> lid: 56;
    out property <int> volume: 57;
    out property <int> memory-chip: 58;
    out property <int> pci: 59;
    out property <int> heart-line: 60;
}

export component Icon inherits Rectangle {
    in property <int> kind: 0;
    in property <color> tint: Palette.text-secondary;

    width: 20px;
    height: 20px;
    background: transparent;

    Image {
        width: parent.width;
        height: parent.height;
        colorize: root.tint;
        image-fit: contain;
        source:
            root.kind == 0 ? @image-url("../assets/icons/home.svg") :
            root.kind == 1 ? @image-url("../assets/icons/gauge.svg") :
            root.kind == 2 ? @image-url("../assets/icons/battery.svg") :
            root.kind == 3 ? @image-url("../assets/icons/fan.svg") :
            root.kind == 4 ? @image-url("../assets/icons/gpu.svg") :
            root.kind == 5 ? @image-url("../assets/icons/sun.svg") :
            root.kind == 6 ? @image-url("../assets/icons/monitor.svg") :
            root.kind == 7 ? @image-url("../assets/icons/system.svg") :
            root.kind == 8 ? @image-url("../assets/icons/sliders.svg") :
            root.kind == 9 ? @image-url("../assets/icons/info.svg") :
            root.kind == 10 ? @image-url("../assets/icons/cpu.svg") :
            root.kind == 11 ? @image-url("../assets/icons/ram.svg") :
            root.kind == 12 ? @image-url("../assets/icons/thermometer.svg") :
            root.kind == 13 ? @image-url("../assets/icons/plug.svg") :
            root.kind == 14 ? @image-url("../assets/icons/keyboard.svg") :
            root.kind == 15 ? @image-url("../assets/icons/laptop.svg") :
            root.kind == 16 ? @image-url("../assets/icons/leaf.svg") :
            root.kind == 17 ? @image-url("../assets/icons/target.svg") :
            root.kind == 18 ? @image-url("../assets/icons/flame.svg") :
            root.kind == 19 ? @image-url("../assets/icons/zap.svg") :
            root.kind == 20 ? @image-url("../assets/icons/chevron-right.svg") :
            root.kind == 21 ? @image-url("../assets/icons/chevron-down.svg") :
            root.kind == 22 ? @image-url("../assets/icons/heart.svg") :
            root.kind == 23 ? @image-url("../assets/icons/refresh.svg") :
            root.kind == 24 ? @image-url("../assets/icons/power.svg") :
            root.kind == 25 ? @image-url("../assets/icons/palette.svg") :
            root.kind == 26 ? @image-url("../assets/icons/moon.svg") :
            root.kind == 27 ? @image-url("../assets/icons/bulb.svg") :
            root.kind == 28 ? @image-url("../assets/icons/sparkles.svg") :
            root.kind == 29 ? @image-url("../assets/icons/speed.svg") :
            root.kind == 30 ? @image-url("../assets/icons/rocket.svg") :
            root.kind == 31 ? @image-url("../assets/icons/file.svg") :
            root.kind == 32 ? @image-url("../assets/icons/shield.svg") :
            root.kind == 33 ? @image-url("../assets/icons/bell.svg") :
            root.kind == 34 ? @image-url("../assets/icons/download.svg") :
            root.kind == 35 ? @image-url("../assets/icons/upload.svg") :
            root.kind == 36 ? @image-url("../assets/icons/cog.svg") :
            root.kind == 37 ? @image-url("../assets/icons/check-circle.svg") :
            root.kind == 38 ? @image-url("../assets/icons/close.svg") :
            root.kind == 39 ? @image-url("../assets/icons/minus.svg") :
            root.kind == 40 ? @image-url("../assets/icons/maximize.svg") :
            root.kind == 41 ? @image-url("../assets/icons/swap.svg") :
            root.kind == 42 ? @image-url("../assets/icons/activity.svg") :
            root.kind == 43 ? @image-url("../assets/icons/timer.svg") :
            root.kind == 44 ? @image-url("../assets/icons/drive.svg") :
            root.kind == 45 ? @image-url("../assets/icons/lock.svg") :
            root.kind == 46 ? @image-url("../assets/icons/external.svg") :
            root.kind == 47 ? @image-url("../assets/icons/plus.svg") :
            root.kind == 48 ? @image-url("../assets/icons/reset.svg") :
            root.kind == 49 ? @image-url("../assets/icons/trash.svg") :
            root.kind == 50 ? @image-url("../assets/icons/hdr.svg") :
            root.kind == 51 ? @image-url("../assets/icons/sync.svg") :
            root.kind == 52 ? @image-url("../assets/icons/window.svg") :
            root.kind == 53 ? @image-url("../assets/icons/cpu-chip.svg") :
            root.kind == 54 ? @image-url("../assets/icons/tray.svg") :
            root.kind == 55 ? @image-url("../assets/icons/exit.svg") :
            root.kind == 56 ? @image-url("../assets/icons/lid.svg") :
            root.kind == 57 ? @image-url("../assets/icons/volume.svg") :
            root.kind == 58 ? @image-url("../assets/icons/memory-chip.svg") :
            root.kind == 59 ? @image-url("../assets/icons/pci.svg") :
            @image-url("../assets/icons/heart-line.svg");
    }
}
