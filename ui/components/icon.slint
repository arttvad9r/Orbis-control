// Icon — Rectangle-based line glyphs (18×18 logical box).
//
// The software renderer does not rasterize `Path` and does not rotate
// rectangles, so every glyph is built from axis-aligned Rectangle primitives
// with a shared `tint`. Kinds:
// 0 home, 1 performance bars, 2 battery, 3 fan, 4 gpu chip, 5 sun,
// 6 monitor, 7 system stack, 8 sliders, 9 info, 10 cpu, 11 ram, 12 thermometer,
// 13 power plug, 14 keyboard, 15 laptop, 16 leaf, 17 scales, 18 gauge.

import { Palette } from "../themes/dark.slint";

export component Icon inherits Rectangle {
    in property <int> kind: 0;
    in property <color> tint: Palette.text-secondary;
    // Background color used to mask ring halves (gauge arc). Transparent by
    // default; containers with a solid background pass it for clean arcs.
    in property <color> mask: transparent;

    width: 18px;
    height: 18px;
    background: transparent;
    clip: false;

    // ── 0 home: roof bar + body outline + door ──────────────────────────
    if (root.kind == 0): Rectangle {
        x: 2px; y: 4.6px; width: 14px; height: 1.8px;
        border-radius: 0.9px; background: parent.tint;
    }
    if (root.kind == 0): Rectangle {
        x: 3.6px; y: 6.4px; width: 10.8px; height: 8.6px;
        border-radius: 1.5px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 0): Rectangle {
        x: 7.6px; y: 10.4px; width: 2.8px; height: 4.6px;
        border-radius: 1px; background: parent.tint;
    }

    // ── 1 performance: ascending bars ───────────────────────────────────
    if (root.kind == 1): Rectangle { x: 3px; y: 11px; width: 2.6px; height: 4px; border-radius: 1px; background: parent.tint; }
    if (root.kind == 1): Rectangle { x: 7.7px; y: 7px; width: 2.6px; height: 8px; border-radius: 1px; background: parent.tint; }
    if (root.kind == 1): Rectangle { x: 12.4px; y: 3px; width: 2.6px; height: 12px; border-radius: 1px; background: parent.tint; }

    // ── 2 battery: outline + terminal + charge level ────────────────────
    if (root.kind == 2): Rectangle {
        x: 2px; y: 5.5px; width: 12.5px; height: 7.5px;
        border-radius: 2px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 2): Rectangle {
        x: 15.2px; y: 7.6px; width: 1.8px; height: 3.3px;
        border-radius: 0.9px; background: parent.tint;
    }
    if (root.kind == 2): Rectangle {
        x: 4px; y: 7.5px; width: 6px; height: 3.5px;
        border-radius: 1px; background: parent.tint;
    }

    // ── 3 fan / airflow: three wind lines ───────────────────────────────
    if (root.kind == 3): Rectangle { x: 2.5px; y: 4.2px; width: 10.5px; height: 1.8px; border-radius: 0.9px; background: parent.tint; }
    if (root.kind == 3): Rectangle { x: 11.2px; y: 2.4px; width: 1.8px; height: 3.6px; border-radius: 0.9px; background: parent.tint; }
    if (root.kind == 3): Rectangle { x: 4.5px; y: 8.1px; width: 11px; height: 1.8px; border-radius: 0.9px; background: parent.tint; }
    if (root.kind == 3): Rectangle { x: 2.5px; y: 12px; width: 9px; height: 1.8px; border-radius: 0.9px; background: parent.tint; }
    if (root.kind == 3): Rectangle { x: 9.7px; y: 11.2px; width: 1.8px; height: 3.6px; border-radius: 0.9px; background: parent.tint; }

    // ── 4 gpu chip: wide package + die + top/bottom pins ────────────────
    if (root.kind == 4): Rectangle {
        x: 2px; y: 4.5px; width: 14px; height: 9px;
        border-radius: 2px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 4): Rectangle { x: 4.2px; y: 7px; width: 5px; height: 4px; border-radius: 1px; background: parent.tint; }
    if (root.kind == 4): Rectangle { x: 5.4px; y: 2.2px; width: 1.4px; height: 2px; background: parent.tint; }
    if (root.kind == 4): Rectangle { x: 8.3px; y: 2.2px; width: 1.4px; height: 2px; background: parent.tint; }
    if (root.kind == 4): Rectangle { x: 11.2px; y: 2.2px; width: 1.4px; height: 2px; background: parent.tint; }
    if (root.kind == 4): Rectangle { x: 5.4px; y: 13.8px; width: 1.4px; height: 2px; background: parent.tint; }
    if (root.kind == 4): Rectangle { x: 8.3px; y: 13.8px; width: 1.4px; height: 2px; background: parent.tint; }
    if (root.kind == 4): Rectangle { x: 11.2px; y: 13.8px; width: 1.4px; height: 2px; background: parent.tint; }

    // ── 5 sun: core + four rays ─────────────────────────────────────────
    if (root.kind == 5): Rectangle {
        x: 5px; y: 5px; width: 8px; height: 8px;
        border-radius: 4px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 5): Rectangle { x: 8.1px; y: 1.4px; width: 1.8px; height: 2.6px; border-radius: 0.9px; background: parent.tint; }
    if (root.kind == 5): Rectangle { x: 8.1px; y: 14px; width: 1.8px; height: 2.6px; border-radius: 0.9px; background: parent.tint; }
    if (root.kind == 5): Rectangle { x: 1.4px; y: 8.1px; width: 2.6px; height: 1.8px; border-radius: 0.9px; background: parent.tint; }
    if (root.kind == 5): Rectangle { x: 14px; y: 8.1px; width: 2.6px; height: 1.8px; border-radius: 0.9px; background: parent.tint; }

    // ── 6 monitor: panel + stand ────────────────────────────────────────
    if (root.kind == 6): Rectangle {
        x: 2px; y: 3px; width: 14px; height: 9.5px;
        border-radius: 1.5px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 6): Rectangle { x: 8.2px; y: 12.5px; width: 1.6px; height: 2.5px; background: parent.tint; }
    if (root.kind == 6): Rectangle { x: 5.5px; y: 15px; width: 7px; height: 1.6px; border-radius: 0.8px; background: parent.tint; }

    // ── 7 system: service stack (three bars with status dots) ───────────
    if (root.kind == 7): Rectangle {
        x: 2px; y: 2.6px; width: 14px; height: 3.6px;
        border-radius: 1.8px; border-width: 1.3px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 7): Rectangle { x: 4.2px; y: 4.4px; width: 1.4px; height: 1.4px; border-radius: 0.7px; background: parent.tint; }
    if (root.kind == 7): Rectangle {
        x: 2px; y: 7.2px; width: 14px; height: 3.6px;
        border-radius: 1.8px; border-width: 1.3px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 7): Rectangle { x: 4.2px; y: 9px; width: 1.4px; height: 1.4px; border-radius: 0.7px; background: parent.tint; }
    if (root.kind == 7): Rectangle {
        x: 2px; y: 11.8px; width: 14px; height: 3.6px;
        border-radius: 1.8px; border-width: 1.3px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 7): Rectangle { x: 4.2px; y: 13.6px; width: 1.4px; height: 1.4px; border-radius: 0.7px; background: parent.tint; }

    // ── 8 sliders: two tracks with knobs ────────────────────────────────
    if (root.kind == 8): Rectangle { x: 2.5px; y: 5.6px; width: 13px; height: 1.6px; border-radius: 0.8px; background: parent.tint; }
    if (root.kind == 8): Rectangle { x: 2.5px; y: 10.8px; width: 13px; height: 1.6px; border-radius: 0.8px; background: parent.tint; }
    if (root.kind == 8): Rectangle { x: 4.5px; y: 3.6px; width: 4px; height: 5.6px; border-radius: 2px; border-width: 1.4px; border-color: parent.tint; background: Palette.surface-default; }
    if (root.kind == 8): Rectangle { x: 9.5px; y: 8.8px; width: 4px; height: 5.6px; border-radius: 2px; border-width: 1.4px; border-color: parent.tint; background: Palette.surface-default; }

    // ── 9 info: ring + dot + short stem ─────────────────────────────────
    if (root.kind == 9): Rectangle {
        x: 2.5px; y: 2.5px; width: 13px; height: 13px;
        border-radius: 6.5px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 9): Rectangle { x: 8px; y: 4.6px; width: 2px; height: 2px; border-radius: 1px; background: parent.tint; }
    if (root.kind == 9): Rectangle { x: 8.1px; y: 8px; width: 1.8px; height: 5.2px; border-radius: 0.9px; background: parent.tint; }

    // ── 10 cpu: square package + die + pins on all sides ────────────────
    if (root.kind == 10): Rectangle {
        x: 4px; y: 4px; width: 10px; height: 10px;
        border-radius: 1.5px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 10): Rectangle { x: 6.5px; y: 6.5px; width: 5px; height: 5px; border-radius: 1px; background: parent.tint; }
    if (root.kind == 10): Rectangle { x: 6.2px; y: 1.6px; width: 1.4px; height: 2px; background: parent.tint; }
    if (root.kind == 10): Rectangle { x: 10.4px; y: 1.6px; width: 1.4px; height: 2px; background: parent.tint; }
    if (root.kind == 10): Rectangle { x: 6.2px; y: 14.4px; width: 1.4px; height: 2px; background: parent.tint; }
    if (root.kind == 10): Rectangle { x: 10.4px; y: 14.4px; width: 1.4px; height: 2px; background: parent.tint; }
    if (root.kind == 10): Rectangle { x: 1.6px; y: 6.2px; width: 2px; height: 1.4px; background: parent.tint; }
    if (root.kind == 10): Rectangle { x: 1.6px; y: 10.4px; width: 2px; height: 1.4px; background: parent.tint; }
    if (root.kind == 10): Rectangle { x: 14.4px; y: 6.2px; width: 2px; height: 1.4px; background: parent.tint; }
    if (root.kind == 10): Rectangle { x: 14.4px; y: 10.4px; width: 2px; height: 1.4px; background: parent.tint; }

    // ── 11 ram: module + chips + edge pins ──────────────────────────────
    if (root.kind == 11): Rectangle {
        x: 2px; y: 4px; width: 14px; height: 8px;
        border-radius: 1px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 11): Rectangle { x: 4px; y: 6px; width: 3px; height: 4px; background: parent.tint; }
    if (root.kind == 11): Rectangle { x: 8px; y: 6px; width: 3px; height: 4px; background: parent.tint; }
    if (root.kind == 11): Rectangle { x: 2px; y: 13.6px; width: 14px; height: 1.6px; border-radius: 0.8px; background: parent.tint; }

    // ── 12 thermometer: stem + bulb ─────────────────────────────────────
    if (root.kind == 12): Rectangle {
        x: 7.4px; y: 2px; width: 3.2px; height: 9px;
        border-radius: 1.6px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 12): Rectangle {
        x: 5.5px; y: 9px; width: 7px; height: 7px;
        border-radius: 3.5px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 12): Rectangle { x: 8.2px; y: 11px; width: 1.6px; height: 3px; border-radius: 0.8px; background: parent.tint; }

    // ── 13 power plug: prongs + body + stem ─────────────────────────────
    if (root.kind == 13): Rectangle { x: 5.5px; y: 1.5px; width: 1.8px; height: 4px; border-radius: 0.9px; background: parent.tint; }
    if (root.kind == 13): Rectangle { x: 10.7px; y: 1.5px; width: 1.8px; height: 4px; border-radius: 0.9px; background: parent.tint; }
    if (root.kind == 13): Rectangle {
        x: 3.5px; y: 5px; width: 11px; height: 6.5px;
        border-radius: 2px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 13): Rectangle { x: 8.1px; y: 11.5px; width: 1.8px; height: 5px; border-radius: 0.9px; background: parent.tint; }

    // ── 14 keyboard: body + keys + space ────────────────────────────────
    if (root.kind == 14): Rectangle {
        x: 1.5px; y: 4.5px; width: 15px; height: 9px;
        border-radius: 1.5px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 14): Rectangle { x: 4px; y: 6.8px; width: 1.6px; height: 1.6px; border-radius: 0.5px; background: parent.tint; }
    if (root.kind == 14): Rectangle { x: 6.6px; y: 6.8px; width: 1.6px; height: 1.6px; border-radius: 0.5px; background: parent.tint; }
    if (root.kind == 14): Rectangle { x: 9.2px; y: 6.8px; width: 1.6px; height: 1.6px; border-radius: 0.5px; background: parent.tint; }
    if (root.kind == 14): Rectangle { x: 11.8px; y: 6.8px; width: 1.6px; height: 1.6px; border-radius: 0.5px; background: parent.tint; }
    if (root.kind == 14): Rectangle { x: 5px; y: 10px; width: 8px; height: 1.6px; border-radius: 0.8px; background: parent.tint; }

    // ── 15 laptop: screen + base ────────────────────────────────────────
    if (root.kind == 15): Rectangle {
        x: 3.5px; y: 2.5px; width: 11px; height: 8.5px;
        border-radius: 1.5px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 15): Rectangle {
        x: 1.5px; y: 12.5px; width: 15px; height: 3px;
        border-radius: 1.5px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }

    // ── 16 leaf: ellipse blade + stem ───────────────────────────────────
    if (root.kind == 16): Rectangle {
        x: 3px; y: 3.5px; width: 12px; height: 9.5px;
        border-radius: 5.5px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 16): Rectangle { x: 4px; y: 13.4px; width: 5px; height: 1.6px; border-radius: 0.8px; background: parent.tint; }
    if (root.kind == 16): Rectangle { x: 3.2px; y: 8px; width: 1.6px; height: 6px; border-radius: 0.8px; background: parent.tint; }
    if (root.kind == 16): Rectangle { x: 8.2px; y: 5.4px; width: 1.6px; height: 5.6px; border-radius: 0.8px; background: parent.tint; }

    // ── 17 scales: post + beam + two pans ───────────────────────────────
    if (root.kind == 17): Rectangle { x: 2px; y: 4px; width: 14px; height: 1.6px; border-radius: 0.8px; background: parent.tint; }
    if (root.kind == 17): Rectangle { x: 8.2px; y: 4px; width: 1.6px; height: 9px; border-radius: 0.8px; background: parent.tint; }
    if (root.kind == 17): Rectangle { x: 5px; y: 13px; width: 8px; height: 1.6px; border-radius: 0.8px; background: parent.tint; }
    if (root.kind == 17): Rectangle { x: 2.5px; y: 5.6px; width: 4.6px; height: 1.6px; border-radius: 0.8px; background: parent.tint; }
    if (root.kind == 17): Rectangle { x: 10.9px; y: 5.6px; width: 4.6px; height: 1.6px; border-radius: 0.8px; background: parent.tint; }

    // ── 18 gauge: ring + optional bottom mask (semicircle) + needle ─────
    if (root.kind == 18): Rectangle {
        x: 2px; y: 2px; width: 14px; height: 14px;
        border-radius: 7px; border-width: 1.4px; border-color: parent.tint; background: transparent;
    }
    if (root.kind == 18): Rectangle {
        x: 0.6px; y: 9.4px; width: 16.8px; height: 7px;
        background: parent.mask;
    }
    if (root.kind == 18): Rectangle { x: 8.2px; y: 4.4px; width: 1.6px; height: 5px; border-radius: 0.8px; background: parent.tint; }
    if (root.kind == 18): Rectangle { x: 7.4px; y: 8.6px; width: 3.2px; height: 3.2px; border-radius: 1.6px; background: parent.tint; }
}
