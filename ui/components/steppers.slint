// Renderer-independent numeric and option controls used across product pages.
import { Palette } from "../themes/dark.slint";

component StepGlyphButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> disabled: false;
    callback clicked;

    width: 30px;
    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border-default;
    background: root.disabled ? Palette.surface-disabled
        : touch.pressed ? Palette.surface-pressed
        : touch.has-hover ? Palette.surface-hover
        : Palette.surface-raised;
    Text {
        text: root.glyph;
        font-size: 13px;
        font-weight: 600;
        color: root.disabled ? Palette.text-disabled : Palette.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

export component NumberStepper inherits Rectangle {
    in-out property <int> value: 0;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <bool> disabled: false;

    width: 142px;
    height: 40px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Palette.border-default;
    background: root.disabled ? Palette.surface-disabled : Palette.surface-default;

    function clamp(v: int) -> int {
        return Math.min(Math.max(v, root.minimum), root.maximum);
    }

    StepGlyphButton {
        glyph: "−";
        x: 5px;
        y: (parent.height - self.height) / 2;
        disabled: root.disabled || root.value <= root.minimum;
        clicked => { root.value = root.clamp(root.value - root.step); }
    }
    Text {
        x: 38px;
        width: parent.width - 76px;
        height: parent.height;
        text: root.value + "";
        font-size: 13px;
        font-weight: 600;
        color: root.disabled ? Palette.text-disabled : Palette.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    StepGlyphButton {
        glyph: "+";
        x: parent.width - 35px;
        y: (parent.height - self.height) / 2;
        disabled: root.disabled || root.value >= root.maximum;
        clicked => { root.value = root.clamp(root.value + root.step); }
    }
}

export component OptionStepper inherits Rectangle {
    in property <string> label;
    in property <bool> disabled: false;
    in property <bool> can-previous: true;
    in property <bool> can-next: true;
    callback previous;
    callback next;

    width: 184px;
    height: 40px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Palette.border-default;
    background: root.disabled ? Palette.surface-disabled : Palette.surface-default;

    StepGlyphButton {
        glyph: "‹";
        x: 5px;
        y: (parent.height - self.height) / 2;
        disabled: root.disabled || !root.can-previous;
        clicked => { root.previous(); }
    }
    Text {
        x: 38px;
        width: parent.width - 76px;
        height: parent.height;
        text: root.label;
        font-size: 12.5px;
        font-weight: 600;
        color: root.disabled ? Palette.text-disabled : Palette.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    StepGlyphButton {
        glyph: "›";
        x: parent.width - 35px;
        y: (parent.height - self.height) / 2;
        disabled: root.disabled || !root.can-next;
        clicked => { root.next(); }
    }
}
