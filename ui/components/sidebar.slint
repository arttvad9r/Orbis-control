// Left navigation: four sections with glyph icons built from primitives.
// The Slint software renderer (production + screenshots) does not render
// `Path`, so icons are Rectangle compositions — guaranteed to draw.
import { Section } from "../audited/model.slint";
import { Palette } from "../themes/dark.slint";

component NavItem inherits Rectangle {
    in property <string> label;
    in property <int> icon; // 0 dashboard, 1 fans, 2 hardware, 3 settings
    in property <bool> is-active;
    callback selected;

    height: 34px;
    border-radius: 8px;
    background: root.is-active ? Palette.surface-selected
        : touch.has-hover ? Palette.surface-hover : transparent;
    HorizontalLayout {
        padding-left: 12px;
        spacing: 10px;

        // 16x16 icon area.
        icons := Rectangle {
            width: 16px;
            height: 16px;
            property <color> tint: root.is-active ? Palette.accent-default : Palette.text-secondary;
            background: transparent;

            if (root.icon == 0): HorizontalLayout {
                spacing: 2px;
                VerticalLayout {
                    spacing: 2px;
                    Rectangle { width: 7px; height: 7px; border-radius: 2px; border-width: 1.3px; border-color: icons.tint; }
                    Rectangle { width: 7px; height: 7px; border-radius: 2px; border-width: 1.3px; border-color: icons.tint; }
                }
                VerticalLayout {
                    spacing: 2px;
                    Rectangle { width: 7px; height: 7px; border-radius: 2px; border-width: 1.3px; border-color: icons.tint; }
                    Rectangle { width: 7px; height: 7px; border-radius: 2px; border-width: 1.3px; border-color: icons.tint; }
                }
            }

            if (root.icon == 1): Rectangle {
                width: 13px;
                height: 13px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                border-width: 1.3px;
                border-color: icons.tint;
            }
            if (root.icon == 1): Rectangle {
                width: 4px;
                height: 4px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                background: icons.tint;
            }

            if (root.icon == 2): Rectangle {
                width: 12px;
                height: 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 2px;
                border-width: 1.3px;
                border-color: icons.tint;
            }
            if (root.icon == 2): Rectangle {
                width: 5px;
                height: 5px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 1px;
                background: icons.tint;
            }

            if (root.icon == 3): Rectangle {
                width: 9px;
                height: 9px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                border-width: 1.3px;
                border-color: icons.tint;
            }
            if (root.icon == 3): Rectangle {
                x: (parent.width - 1.3px) / 2;
                y: 1px;
                width: 1.3px;
                height: 4px;
                background: icons.tint;
            }
            if (root.icon == 3): Rectangle {
                x: (parent.width - 1.3px) / 2;
                y: parent.height - 5px;
                width: 1.3px;
                height: 4px;
                background: icons.tint;
            }
            if (root.icon == 3): Rectangle {
                x: 1px;
                y: (parent.height - 1.3px) / 2;
                width: 4px;
                height: 1.3px;
                background: icons.tint;
            }
            if (root.icon == 3): Rectangle {
                x: parent.width - 5px;
                y: (parent.height - 1.3px) / 2;
                width: 4px;
                height: 1.3px;
                background: icons.tint;
            }
        }

        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: root.is-active ? Palette.text-primary : Palette.text-secondary;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.selected(); }
    }
}

export component Sidebar inherits Rectangle {
    in-out property <Section> active: Section.Dashboard;
    callback section-selected(Section);

    width: 168px;
    background: Palette.titlebar-background;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;

        NavItem {
            label: "Dashboard";
            icon: 0;
            is-active: root.active == Section.Dashboard;
            selected => { root.section-selected(Section.Dashboard); }
        }
        NavItem {
            label: "Fans";
            icon: 1;
            is-active: root.active == Section.Fans;
            selected => { root.section-selected(Section.Fans); }
        }
        NavItem {
            label: "Hardware";
            icon: 2;
            is-active: root.active == Section.Hardware;
            selected => { root.section-selected(Section.Hardware); }
        }
        NavItem {
            label: "Settings";
            icon: 3;
            is-active: root.active == Section.Settings;
            selected => { root.section-selected(Section.Settings); }
        }
        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}
