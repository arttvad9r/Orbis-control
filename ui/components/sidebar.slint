// Left navigation: four sections with line-icon glyphs (spec §2).
import { Section } from "../audited/model.slint";
import { Palette } from "../themes/dark.slint";

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon-commands;
    in property <bool> is-active;
    callback selected;

    height: 34px;
    border-radius: 8px;
    background: root.is-active ? Palette.surface-selected
        : touch.has-hover ? Palette.surface-hover : transparent;
    HorizontalLayout {
        padding-left: 10px;
        spacing: 10px;
        alignment: center;
        Path {
            width: 16px;
            height: 16px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: root.icon-commands;
            stroke: root.is-active ? Palette.accent-default : Palette.text-secondary;
            stroke-width: 1.5px;
            fill: transparent;
        }
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: root.is-active ? Palette.text-primary : Palette.text-secondary;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.selected(); }
    }
}

export component Sidebar inherits Rectangle {
    in-out property <Section> active: Section.Dashboard;
    callback section-selected(Section);

    width: 168px;
    background: Palette.titlebar-background;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;

        NavItem {
            label: "Dashboard";
            icon-commands: "M 1.5 1.5 H 7 V 7 H 1.5 Z M 9 1.5 H 14.5 V 7 H 9 Z M 1.5 9 H 7 V 14.5 H 1.5 Z M 9 9 H 14.5 V 14.5 H 9 Z";
            is-active: root.active == Section.Dashboard;
            selected => { root.section-selected(Section.Dashboard); }
        }
        NavItem {
            label: "Fans";
            icon-commands: "M 8 6.2 C 8 3.5 9.5 2 11.5 2 C 12.5 4 11 6 8 6.2 M 9.6 9 C 11.9 10.4 14 10 14.8 8.2 C 13.5 6.4 11 6.6 9.6 9 M 6.4 9 C 4.1 10.4 3.7 12.5 5 13.9 C 7.1 13.6 8 11.3 6.4 9";
            is-active: root.active == Section.Fans;
            selected => { root.section-selected(Section.Fans); }
        }
        NavItem {
            label: "Hardware";
            icon-commands: "M 3 3 H 13 V 13 H 3 Z M 6 6 H 10 V 10 H 6 Z M 8 1 V 3 M 8 13 V 15 M 1 8 H 3 M 13 8 H 15 M 5 1 V 3 M 11 1 V 3 M 5 13 V 15 M 11 13 V 15 M 1 5 H 3 M 1 11 H 3 M 13 5 H 15 M 13 11 H 15";
            is-active: root.active == Section.Hardware;
            selected => { root.section-selected(Section.Hardware); }
        }
        NavItem {
            label: "Settings";
            icon-commands: "M 8 5.8 A 2.2 2.2 0 1 0 8 10.2 A 2.2 2.2 0 1 0 8 5.8 M 8 1.5 V 3.5 M 8 12.5 V 14.5 M 1.5 8 H 3.5 M 12.5 8 H 14.5 M 3.4 3.4 L 4.8 4.8 M 11.2 11.2 L 12.6 12.6 M 12.6 3.4 L 11.2 4.8 M 4.8 11.2 L 3.4 12.6";
            is-active: root.active == Section.Settings;
            selected => { root.section-selected(Section.Settings); }
        }
        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}
