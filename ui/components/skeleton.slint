// Loading placeholder (skeleton) with a slow shimmer sweep, used instead of a
// bare "—" while the first reading is on its way. It only animates while it
// is on screen.
import { Palette } from "../themes/dark.slint";

export component Skeleton inherits Rectangle {
    property <float> phase: Math.mod(animation-tick() / 1ms, 1600) / 1600;
    border-radius: 8px;
    background: Palette.surface-hover.transparentize(0.2);

    // Shimmer band, kept inside the straight part of the pill (gradients
    // and clips ignore rounding in the software renderer).
    Rectangle {
        x: root.border-radius;
        width: parent.width - 2 * root.border-radius;
        clip: true;
        Rectangle {
            x: (root.phase * 2 - 0.5) * parent.width;
            width: parent.width * 0.5;
            background: @linear-gradient(90deg, #FFFFFF00 0%, Palette.edge-light 50%, #FFFFFF00 100%);
        }
    }
}
