// Product mark shared by window chrome and About: an orbit around a glowing
// core (ui/assets/orbis-mark.svg), rasterized through resvg in every renderer.
export component AppMark inherits Rectangle {
    width: 30px;
    height: 30px;
    background: transparent;

    Image {
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        source: @image-url("../assets/orbis-mark.svg");
    }
}
