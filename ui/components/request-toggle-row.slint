import { Palette } from "../themes/dark.slint";

// Settings row with a backend-owned switch. Disabled rows remain legible and
// preserve their observed checked state instead of looking falsely off.
export component RequestToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in property <bool> checked: false;
    in property <bool> disabled: false;
    callback toggled(bool);

    height: root.description == "" ? 48px : 62px;
    border-radius: 10px;
    border-width: root.disabled ? 1px : 0px;
    border-color: Palette.border-default;
    background: root.disabled ? Palette.surface-disabled
        : touch.has-hover ? Palette.surface-hover : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 14px;

        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.label;
                font-size: 13.5px;
                font-weight: 550;
                color: root.disabled ? Palette.text-secondary : Palette.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            if (root.description != "") : Text {
                text: root.description;
                font-size: 11.5px;
                color: root.disabled ? Palette.text-disabled : Palette.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle { horizontal-stretch: 1; background: transparent; }

        Rectangle {
            width: 44px;
            vertical-stretch: 1;
            background: transparent;
            Rectangle {
                width: 44px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.checked
                    ? (root.disabled ? Palette.accent-default.transparentize(0.45) : Palette.accent-default)
                    : Palette.border-strong;
                background: root.checked
                    ? (root.disabled ? Palette.accent-default.transparentize(0.68) : Palette.accent-default)
                    : root.disabled ? Palette.surface-muted
                    : Palette.surface-pressed;

                Rectangle {
                    width: 18px;
                    height: 18px;
                    x: root.checked ? 23px : 2px;
                    y: 2px;
                    border-radius: 9px;
                    background: root.checked ? Palette.text-on-accent
                        : root.disabled ? Palette.text-disabled
                        : Palette.text-on-accent;
                }
            }
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.toggled(!root.checked); }
    }
}
