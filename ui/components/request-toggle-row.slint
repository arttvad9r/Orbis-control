import { Palette } from "../themes/dark.slint";
import { Icon } from "icon.slint";
import { Switch } from "../audited/common.slint";

// Settings row with a backend-owned switch. Disabled rows remain legible and
// preserve their observed checked state instead of looking falsely off.
export component RequestToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in property <bool> checked: false;
    in property <bool> disabled: false;
    // Negative hides the leading icon.
    in property <int> icon-kind: -1;
    in property <bool> separator: false;
    callback toggled(bool);

    min-height: root.description == "" ? 50px : 62px;
    vertical-stretch: 0;
    background: transparent;

    if (root.separator) : Rectangle {
        y: 0px;
        height: 1px;
        background: Palette.border-default;
    }

    HorizontalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 16px;

        if (root.icon-kind >= 0) : Rectangle {
            width: 26px;
            Icon {
                width: 24px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                kind: root.icon-kind;
                tint: root.disabled ? Palette.text-secondary : Palette.text-primary;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.label;
                font-size: 14.5px;
                font-weight: 550;
                color: root.disabled ? Palette.text-secondary : Palette.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            if (root.description != "") : Text {
                text: root.description;
                font-size: 12.5px;
                color: Palette.text-secondary;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        Rectangle {
            width: 50px;
            Switch {
                y: (parent.height - self.height) / 2;
                checked: root.checked;
                disabled: root.disabled;
                toggled(value) => { root.toggled(value); }
            }
        }
    }
}
