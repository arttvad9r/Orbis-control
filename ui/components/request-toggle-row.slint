import { Palette } from "../themes/dark.slint";

// Settings row with a backend-owned switch. A click emits the requested value
// but never changes `checked` locally; the owner must publish the new
// authoritative value.
export component RequestToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in property <bool> checked: false;
    in property <bool> disabled: false;
    callback toggled(bool);

    height: root.description == "" ? 40px : 50px;
    border-radius: 8px;
    background: touch.has-hover && !root.disabled ? Palette.surface-hover : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;

        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                font-size: 13px;
                font-weight: 500;
                color: root.disabled ? Palette.text-disabled : Palette.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            if (root.description != "") : Text {
                text: root.description;
                font-size: 11.5px;
                color: root.disabled ? Palette.text-disabled : Palette.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle { horizontal-stretch: 1; background: transparent; }

        Rectangle {
            width: 40px;
            height: 22px;
            border-radius: 11px;
            border-width: 1px;
            border-color: root.checked && !root.disabled ? Palette.accent-default : Palette.border-default;
            background: root.checked && !root.disabled ? Palette.accent-default : Palette.surface-pressed;

            Rectangle {
                width: 16px;
                height: 16px;
                x: root.checked ? 22px : 2px;
                y: 2px;
                border-radius: 8px;
                background: root.disabled ? Palette.text-disabled : Palette.text-on-accent;
            }
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.toggled(!root.checked); }
    }
}
