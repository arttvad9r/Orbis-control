import { Palette } from "../themes/dark.slint";

// Settings row with a backend-owned switch. Disabled rows remain legible and
// preserve their observed checked state instead of looking falsely off.
export component RequestToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in property <bool> checked: false;
    in property <bool> disabled: false;
    callback toggled(bool);

    min-height: root.description == "" ? 44px : 58px;
    vertical-stretch: 0;
    border-radius: 10px;
    background: touch.has-hover && !root.disabled ? Palette.surface-hover.transparentize(0.4) : transparent;

    HorizontalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 16px;

        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.label;
                font-size: 13.5px;
                font-weight: 500;
                color: root.disabled ? Palette.text-secondary : Palette.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            if (root.description != "") : Text {
                text: root.description;
                font-size: 12px;
                color: Palette.text-secondary;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        Rectangle { horizontal-stretch: 1; background: transparent; }

        Rectangle {
            width: 44px;
            vertical-stretch: 1;
            background: transparent;
            Rectangle {
                width: 44px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                border-radius: 12px;
                border-width: root.checked ? 0px : 1px;
                border-color: Palette.border-strong;
                background: root.checked
                    ? (root.disabled ? Palette.accent-fill.transparentize(0.55) : Palette.accent-fill)
                    : root.disabled ? Palette.surface-muted
                    : Palette.surface-pressed;

                Rectangle {
                    width: 18px;
                    height: 18px;
                    x: root.checked ? 23px : 3px;
                    y: 3px;
                    border-radius: 9px;
                    background: root.checked ? Palette.text-on-accent
                        : root.disabled ? Palette.text-disabled
                        : Palette.text-secondary;
                }
            }
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.toggled(!root.checked); }
    }
}
