// FanCurveEditor — G-Helper-inspired fan curve surface.
//
// This remains a thin UI boundary over the existing fan API. The graph uses
// authoritative temperature points and raw PWM (0..255). No RPM conversion or
// hardware range is invented. Point drag edits PWM only; temperature stays a
// separate +/- edit so the UI does not guess device-specific temperature limits.

import { Palette } from "../themes/dark.slint";

component ToggleChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> disabled: false;
    callback clicked;

    height: 32px;
    min-width: 62px;
    horizontal-stretch: 1;
    border-radius: 3px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Palette.accent-default : Palette.border-default;
    background: root.disabled ? Palette.surface-disabled
        : touch.pressed ? Palette.surface-pressed
        : touch.has-hover ? Palette.surface-hover
        : Palette.surface-default;

    Text {
        text: root.label;
        font-size: 12px;
        font-weight: root.selected ? 600 : 500;
        color: root.disabled ? Palette.text-disabled : Palette.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

component SmallButton inherits Rectangle {
    in property <string> label;
    in property <bool> disabled: false;
    in property <bool> accent: false;
    callback clicked;

    height: 30px;
    min-width: 92px;
    border-radius: 3px;
    border-width: 1px;
    border-color: root.accent && !root.disabled ? Palette.accent-default : Palette.border-default;
    background: root.disabled ? Palette.surface-disabled
        : touch.pressed ? Palette.surface-pressed
        : touch.has-hover ? Palette.surface-hover
        : root.accent ? Palette.accent-default
        : Palette.surface-default;

    Text {
        text: root.label;
        font-size: 11px;
        font-weight: 600;
        color: root.disabled ? Palette.text-disabled : Palette.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

component DisabledField inherits Rectangle {
    in property <string> value: "Unavailable";

    height: 28px;
    border-radius: 3px;
    border-width: 1px;
    border-color: Palette.border-default;
    background: Palette.surface-disabled;

    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.value;
        font-size: 11px;
        color: Palette.text-disabled;
        vertical-alignment: center;
        overflow: elide;
    }
}

component DisabledPowerBar inherits Rectangle {
    in property <string> label;

    height: 45px;
    background: transparent;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 16px;
        text: root.label;
        font-size: 10px;
        color: Palette.text-secondary;
        vertical-alignment: center;
    }

    Rectangle {
        x: 2px;
        y: 27px;
        width: parent.width - 4px;
        height: 4px;
        border-radius: 2px;
        background: Palette.surface-disabled;
    }

    Rectangle {
        x: 25%;
        y: 22px;
        width: 7px;
        height: 14px;
        border-radius: 2px;
        background: Palette.text-disabled;
    }
}

component TemperatureControl inherits Rectangle {
    in property <int> index;
    in property <int> value;
    in property <bool> editable: false;
    callback changed(int, int);

    width: 42px;
    height: 34px;
    background: transparent;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 14px;
        text: root.value + "°";
        font-size: 9px;
        font-weight: 600;
        color: root.editable ? Palette.text-primary : Palette.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    minus := Rectangle {
        x: 3px;
        y: 16px;
        width: 16px;
        height: 16px;
        border-radius: 2px;
        border-width: 1px;
        border-color: Palette.border-default;
        background: !root.editable ? Palette.surface-disabled
            : minus-touch.pressed ? Palette.surface-pressed
            : minus-touch.has-hover ? Palette.surface-hover
            : Palette.surface-default;
        Text {
            text: "−";
            font-size: 10px;
            color: root.editable ? Palette.text-secondary : Palette.text-disabled;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        minus-touch := TouchArea {
            enabled: root.editable;
            clicked => { root.changed(root.index, root.value - 1); }
        }
    }

    plus := Rectangle {
        x: 23px;
        y: 16px;
        width: 16px;
        height: 16px;
        border-radius: 2px;
        border-width: 1px;
        border-color: Palette.border-default;
        background: !root.editable ? Palette.surface-disabled
            : plus-touch.pressed ? Palette.surface-pressed
            : plus-touch.has-hover ? Palette.surface-hover
            : Palette.surface-default;
        Text {
            text: "+";
            font-size: 10px;
            color: root.editable ? Palette.text-secondary : Palette.text-disabled;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        plus-touch := TouchArea {
            enabled: root.editable;
            clicked => { root.changed(root.index, root.value + 1); }
        }
    }
}

component GraphPointColumn inherits Rectangle {
    in property <int> index;
    in property <int> pwm;
    in property <bool> editable: false;
    in property <color> accent-color: Palette.accent-default;
    callback previewed(int, int);
    callback committed(int, int);
    callback cancelled;

    property <bool> gesture-active: false;
    property <int> preview-pwm: root.pwm;
    property <int> display-pwm: root.gesture-active ? root.preview-pwm : root.pwm;

    width: 24px;
    background: transparent;

    point := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (1 - Math.min(Math.max(root.display-pwm / 255, 0), 1)) * (parent.height - self.height);
        width: 12px;
        height: 12px;
        border-radius: 6px;
        border-width: 2px;
        border-color: Palette.text-primary;
        background: root.editable ? root.accent-color : Palette.text-disabled;
    }

    if (drag.has-hover || root.gesture-active) : Rectangle {
        x: (parent.width - 42px) / 2;
        y: Math.max(point.y - 22px, 0px);
        width: 42px;
        height: 18px;
        border-radius: 3px;
        background: Palette.surface-default;
        border-width: 1px;
        border-color: Palette.border-default;
        Text {
            text: root.display-pwm + "";
            font-size: 9px;
            font-weight: 600;
            color: Palette.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    drag := TouchArea {
        enabled: root.editable;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.gesture-active = true;
                root.preview-pwm = Math.min(Math.max(Math.round((1 - self.mouse-y / self.height) * 255), 0), 255);
                root.previewed(root.index, root.preview-pwm);
            } else if (ev.kind == PointerEventKind.move && self.pressed) {
                root.preview-pwm = Math.min(Math.max(Math.round((1 - self.mouse-y / self.height) * 255), 0), 255);
                root.previewed(root.index, root.preview-pwm);
            } else if (ev.kind == PointerEventKind.up && root.gesture-active) {
                let final-pwm = Math.min(Math.max(Math.round((1 - self.mouse-y / self.height) * 255), 0), 255);
                root.gesture-active = false;
                root.preview-pwm = root.pwm;
                root.committed(root.index, final-pwm);
            } else if (ev.kind == PointerEventKind.cancel) {
                root.gesture-active = false;
                root.preview-pwm = root.pwm;
                root.cancelled();
            }
        }
    }
}

component CurveGraph inherits Rectangle {
    in property <bool> editable: false;
    in property <int> fan-selected: 0;
    in property <int> temp-0;
    in property <int> temp-1;
    in property <int> temp-2;
    in property <int> temp-3;
    in property <int> temp-4;
    in property <int> temp-5;
    in property <int> temp-6;
    in property <int> temp-7;
    in property <int> pwm-0;
    in property <int> pwm-1;
    in property <int> pwm-2;
    in property <int> pwm-3;
    in property <int> pwm-4;
    in property <int> pwm-5;
    in property <int> pwm-6;
    in property <int> pwm-7;

    callback temp-changed(int, int);
    callback pwm-changed(int, int);

    property <int> drag-index: -1;
    property <int> drag-pwm: 0;
    property <color> curve-color: root.fan-selected == 0 ? Palette.accent-default : Palette.error;
    property <int> axis-min: root.min-temp() - 5;
    property <int> axis-max: Math.max(root.max-temp() + 5, root.axis-min + 10);

    pure function min-temp() -> int {
        return Math.min(root.temp-0,
            Math.min(root.temp-1,
            Math.min(root.temp-2,
            Math.min(root.temp-3,
            Math.min(root.temp-4,
            Math.min(root.temp-5,
            Math.min(root.temp-6, root.temp-7)))))));
    }

    pure function max-temp() -> int {
        return Math.max(root.temp-0,
            Math.max(root.temp-1,
            Math.max(root.temp-2,
            Math.max(root.temp-3,
            Math.max(root.temp-4,
            Math.max(root.temp-5,
            Math.max(root.temp-6, root.temp-7)))))));
    }

    pure function x-pos(temp: int) -> float {
        return Math.min(Math.max((temp - root.axis-min) / (root.axis-max - root.axis-min) * 100, 0), 100);
    }

    pure function pwm-at(index: int) -> int {
        if (root.drag-index == index) { return root.drag-pwm; }
        if (index == 0) { return root.pwm-0; }
        if (index == 1) { return root.pwm-1; }
        if (index == 2) { return root.pwm-2; }
        if (index == 3) { return root.pwm-3; }
        if (index == 4) { return root.pwm-4; }
        if (index == 5) { return root.pwm-5; }
        if (index == 6) { return root.pwm-6; }
        return root.pwm-7;
    }

    pure function y-pos(index: int) -> float {
        return 100 - Math.min(Math.max(root.pwm-at(index) / 255, 0), 1) * 100;
    }

    height: 430px;
    min-width: 360px;
    horizontal-stretch: 1;
    border-radius: 3px;
    border-width: 1px;
    border-color: Palette.border-default;
    background: Palette.surface-pressed;

    Text {
        x: 46px;
        y: 7px;
        width: parent.width - 58px;
        height: 18px;
        text: (root.fan-selected == 0 ? "CPU" : "GPU") + " Fan Profile, raw PWM / °C";
        font-size: 11px;
        font-weight: 600;
        color: Palette.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    plot := Rectangle {
        x: 46px;
        y: 30px;
        width: parent.width - 58px;
        height: 326px;
        background: #00000000;
        border-width: 1px;
        border-color: Palette.border-default;
        clip: true;

        Rectangle { x: 0px; y: 20%; width: parent.width; height: 1px; background: Palette.border-default; }
        Rectangle { x: 0px; y: 40%; width: parent.width; height: 1px; background: Palette.border-default; }
        Rectangle { x: 0px; y: 60%; width: parent.width; height: 1px; background: Palette.border-default; }
        Rectangle { x: 0px; y: 80%; width: parent.width; height: 1px; background: Palette.border-default; }
        Rectangle { x: 12.5%; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: 25%; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: 37.5%; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: 50%; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: 62.5%; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: 75%; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: 87.5%; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }

        curve := Path {
            width: parent.width;
            height: parent.height;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 100;
            viewbox-height: 100;
            fit: fill;
            stroke: root.curve-color;
            stroke-width: 2px;
            stroke-line-cap: round;
            stroke-line-join: round;
            MoveTo { x: root.x-pos(root.temp-0); y: root.y-pos(0); }
            LineTo { x: root.x-pos(root.temp-1); y: root.y-pos(1); }
            LineTo { x: root.x-pos(root.temp-2); y: root.y-pos(2); }
            LineTo { x: root.x-pos(root.temp-3); y: root.y-pos(3); }
            LineTo { x: root.x-pos(root.temp-4); y: root.y-pos(4); }
            LineTo { x: root.x-pos(root.temp-5); y: root.y-pos(5); }
            LineTo { x: root.x-pos(root.temp-6); y: root.y-pos(6); }
            LineTo { x: root.x-pos(root.temp-7); y: root.y-pos(7); }
        }

        p0 := GraphPointColumn { x: root.x-pos(root.temp-0) * (plot.width - self.width) / 100; height: plot.height; index: 0; pwm: root.pwm-0; editable: root.editable; accent-color: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-0) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
        p1 := GraphPointColumn { x: root.x-pos(root.temp-1) * (plot.width - self.width) / 100; height: plot.height; index: 1; pwm: root.pwm-1; editable: root.editable; accent-color: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-1) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
        p2 := GraphPointColumn { x: root.x-pos(root.temp-2) * (plot.width - self.width) / 100; height: plot.height; index: 2; pwm: root.pwm-2; editable: root.editable; accent-color: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-2) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
        p3 := GraphPointColumn { x: root.x-pos(root.temp-3) * (plot.width - self.width) / 100; height: plot.height; index: 3; pwm: root.pwm-3; editable: root.editable; accent-color: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-3) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
        p4 := GraphPointColumn { x: root.x-pos(root.temp-4) * (plot.width - self.width) / 100; height: plot.height; index: 4; pwm: root.pwm-4; editable: root.editable; accent-color: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-4) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
        p5 := GraphPointColumn { x: root.x-pos(root.temp-5) * (plot.width - self.width) / 100; height: plot.height; index: 5; pwm: root.pwm-5; editable: root.editable; accent-color: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-5) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
        p6 := GraphPointColumn { x: root.x-pos(root.temp-6) * (plot.width - self.width) / 100; height: plot.height; index: 6; pwm: root.pwm-6; editable: root.editable; accent-color: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-6) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
        p7 := GraphPointColumn { x: root.x-pos(root.temp-7) * (plot.width - self.width) / 100; height: plot.height; index: 7; pwm: root.pwm-7; editable: root.editable; accent-color: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-7) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
    }

    Text { x: 4px; y: 24px; width: 38px; height: 14px; text: "255"; font-size: 9px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 4px; y: 104px; width: 38px; height: 14px; text: "192"; font-size: 9px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 4px; y: 185px; width: 38px; height: 14px; text: "128"; font-size: 9px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 4px; y: 266px; width: 38px; height: 14px; text: "64"; font-size: 9px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 4px; y: 348px; width: 38px; height: 14px; text: "0"; font-size: 9px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 42px; y: 360px; width: 48px; height: 14px; text: root.axis-min + "°"; font-size: 9px; color: Palette.text-secondary; horizontal-alignment: center; }
    Text { x: parent.width / 2 - 24px; y: 360px; width: 48px; height: 14px; text: Math.round((root.axis-min + root.axis-max) / 2) + "°"; font-size: 9px; color: Palette.text-secondary; horizontal-alignment: center; }
    Text { x: parent.width - 64px; y: 360px; width: 48px; height: 14px; text: root.axis-max + "°"; font-size: 9px; color: Palette.text-secondary; horizontal-alignment: center; }

    HorizontalLayout {
        x: 46px;
        y: 382px;
        width: parent.width - 58px;
        height: 40px;
        spacing: 2px;
        alignment: center;
        TemperatureControl { index: 0; value: root.temp-0; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
        TemperatureControl { index: 1; value: root.temp-1; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
        TemperatureControl { index: 2; value: root.temp-2; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
        TemperatureControl { index: 3; value: root.temp-3; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
        TemperatureControl { index: 4; value: root.temp-4; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
        TemperatureControl { index: 5; value: root.temp-5; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
        TemperatureControl { index: 6; value: root.temp-6; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
        TemperatureControl { index: 7; value: root.temp-7; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
    }
}

export enum FanCurveHwState {
    Loading,
    Ready,
    Unavailable,
}

export component FanCurveEditor inherits Rectangle {
    in property <FanCurveHwState> state: FanCurveHwState.Loading;
    in property <bool> writable: false;
    in property <bool> error-state: false;
    in property <bool> dirty: false;
    in property <int> fan-selected: 0;
    in property <int> profile-selected: 0;
    in property <int> temp-0: 0;
    in property <int> temp-1: 0;
    in property <int> temp-2: 0;
    in property <int> temp-3: 0;
    in property <int> temp-4: 0;
    in property <int> temp-5: 0;
    in property <int> temp-6: 0;
    in property <int> temp-7: 0;
    in property <int> pwm-0: 0;
    in property <int> pwm-1: 0;
    in property <int> pwm-2: 0;
    in property <int> pwm-3: 0;
    in property <int> pwm-4: 0;
    in property <int> pwm-5: 0;
    in property <int> pwm-6: 0;
    in property <int> pwm-7: 0;

    callback fan-changed(int);
    callback profile-changed(int);
    callback temp-point-changed(int, int);
    callback pwm-point-changed(int, int);
    callback apply-clicked;

    height: 530px;
    min-height: 530px;
    background: Palette.window-background;

    if (root.state == FanCurveHwState.Loading) : Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 4px;
        border-width: 1px;
        border-color: Palette.border-default;
        background: Palette.surface-default;
        z: 100;
        Text { text: "Loading fan curves…"; font-size: 12px; color: Palette.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
    }

    if (root.state == FanCurveHwState.Unavailable) : Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 4px;
        border-width: 1px;
        border-color: Palette.error;
        background: Palette.surface-default;
        z: 100;
        Text { text: "Fan curve backend unavailable"; font-size: 12px; color: Palette.text-primary; horizontal-alignment: center; vertical-alignment: center; }
    }

    if (root.state == FanCurveHwState.Ready) : VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            height: 32px;
            spacing: 7px;
            ToggleChip { label: "CPU"; selected: root.fan-selected == 0; clicked => { root.fan-changed(0); } }
            ToggleChip { label: "GPU"; selected: root.fan-selected == 1; clicked => { root.fan-changed(1); } }
            ToggleChip { label: "Advanced"; disabled: true; }
            Rectangle { width: 6px; background: transparent; }
            Text { min-width: 104px; text: "BIOS Fan Curves"; font-size: 11px; font-weight: 600; color: Palette.text-primary; vertical-alignment: center; }
            ToggleChip { label: "Balanced"; selected: root.profile-selected == 0; clicked => { root.profile-changed(0); } }
            ToggleChip { label: "Perf"; selected: root.profile-selected == 1; clicked => { root.profile-changed(1); } }
            ToggleChip { label: "Quiet"; selected: root.profile-selected == 2; clicked => { root.profile-changed(2); } }
            ToggleChip { label: "Low"; selected: root.profile-selected == 3; clicked => { root.profile-changed(3); } }
        }

        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 190px;
                border-radius: 3px;
                border-width: 1px;
                border-color: Palette.border-default;
                background: Palette.surface-default;
                VerticalLayout {
                    padding: 10px;
                    spacing: 7px;
                    Text { text: "Power Controls"; height: 18px; font-size: 12px; font-weight: 600; color: Palette.text-primary; vertical-alignment: center; }
                    Text { text: "Not exposed by the current Orbis backend"; height: 28px; font-size: 9px; color: Palette.text-secondary; wrap: word-wrap; }
                    Text { text: "Power Mode"; height: 16px; font-size: 10px; font-weight: 600; color: Palette.text-primary; vertical-alignment: center; }
                    DisabledField { value: "Unavailable"; }
                    Text { text: "CPU Boost"; height: 16px; font-size: 10px; font-weight: 600; color: Palette.text-primary; vertical-alignment: center; }
                    DisabledField { value: "Unavailable"; }
                    Text { text: "Power Limits"; height: 16px; font-size: 10px; font-weight: 600; color: Palette.text-primary; vertical-alignment: center; }
                    DisabledPowerBar { label: "SPL (CPU sustained)"; }
                    DisabledPowerBar { label: "sPPT (CPU long boost)"; }
                    DisabledPowerBar { label: "fPPT (CPU short boost)"; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Text { text: "Unavailable controls are display-only; no hardware write is attempted."; height: 34px; font-size: 9px; color: Palette.text-disabled; wrap: word-wrap; }
                }
            }

            CurveGraph {
                editable: root.writable;
                fan-selected: root.fan-selected;
                temp-0: root.temp-0; temp-1: root.temp-1; temp-2: root.temp-2; temp-3: root.temp-3;
                temp-4: root.temp-4; temp-5: root.temp-5; temp-6: root.temp-6; temp-7: root.temp-7;
                pwm-0: root.pwm-0; pwm-1: root.pwm-1; pwm-2: root.pwm-2; pwm-3: root.pwm-3;
                pwm-4: root.pwm-4; pwm-5: root.pwm-5; pwm-6: root.pwm-6; pwm-7: root.pwm-7;
                temp-changed(i,v) => { root.temp-point-changed(i,v); }
                pwm-changed(i,v) => { root.pwm-point-changed(i,v); }
            }
        }

        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            alignment: center;
            Rectangle { width: 3px; height: 16px; border-radius: 1.5px; background: root.error-state ? Palette.error : root.dirty ? Palette.warning : Palette.success; }
            Text {
                text: root.error-state ? "Apply failed" : !root.writable ? "Read only" : root.dirty ? "Modified" : "Current";
                font-size: 10px;
                color: root.error-state ? Palette.error : root.dirty ? Palette.warning : Palette.text-secondary;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            SmallButton { label: "Factory Defaults"; disabled: true; }
            SmallButton { label: "Apply Custom Fan Curve"; accent: true; disabled: !root.writable || !root.dirty || root.error-state; clicked => { root.apply-clicked(); } }
        }
    }
}
