// Orbis Control — главное окно (минимальный визуальный прототип).
// Ширина 425 logical px, без боковой панели. Секции: Performance, GPU,
// Battery Charge Limit, Telemetry, нижний служебный блок.

import { ModeCard } from "components/mode-card.slint";
import { SectionHeader } from "components/section-header.slint";
import { ValueSlider } from "components/value-slider.slint";
import { FanCurveEditor, FanCurveHwState } from "components/fan-curve-editor.slint";
import { Palette } from "themes/dark.slint";

export enum ChargeLimitState {
    Loading,
    Ready,
    Unavailable,
}

export enum GpuHwState {
    Loading,
    Ready,
    Unavailable,
}

export enum PerformanceHwState {
    Loading,
    Ready,
    Unavailable,
}

export enum GpuModeHwState {
    Loading,
    Ready,
    Unavailable,
}

export struct UiState {
    perf-selected: int,             // 0=Silent, 1=Balanced, 2=Turbo
    available-perf-mask: int,       // bit0=Silent, bit1=Balanced, bit2=Turbo
    perf-state: PerformanceHwState,
    perf-writable: bool,
    perf-unavailable-reason: string,
    gpu-selected: int,              // 0=Eco, 1=Standard, 2=Ultimate, 3=Optimized
    available-gpu-mask: int,        // bit0=Eco, bit1=Standard, bit2=Ultimate, bit3=Optimized
    gpu-ultimate-pending: bool,
    gpu-ultimate-disabled: bool,
    gpu-section-error: bool,
    gpu-mode-state: GpuModeHwState,
    gpu-mode-writable: bool,
    charge-limit: int,
    charge-limit-enabled: bool,
    charge-limit-writable: bool,
    charge-limit-unavailable-reason: string,
    charge-limit-state: ChargeLimitState,
    gpu-power-state: GpuHwState,
    gpu-mux-state: GpuHwState,
    gpu-access-state: GpuHwState,
    gpu-power-value: int,
    gpu-mux-value: int,
    gpu-access-value: int,
    cpu-temp: string,
    gpu-temp: string,
    cpu-fan-rpm: string,
    gpu-fan-rpm: string,
    battery-percent: string,
    power-ac-mw: string,
    battery-health: string,
    battery-cycles: string,
    battery-status: string,
    ac-online: string,
    gpu-power: string,
    version: string,
    mock-profile: string,

    // ── Fan Curve Editor ──────────────────────────────────────────
    fan-curve-state: FanCurveHwState,
    fan-curve-writable: bool,
    fan-curve-unavailable-reason: string,
    fan-curve-error: bool,
    fan-curve-dirty: bool,
    fan-selected: int,         // 0=CPU, 1=GPU
    fan-profile-selected: int, // 0=Balanced, 1=Perf, 2=Quiet, 3=Low
    fan-temp-0: int,
    fan-temp-1: int,
    fan-temp-2: int,
    fan-temp-3: int,
    fan-temp-4: int,
    fan-temp-5: int,
    fan-temp-6: int,
    fan-temp-7: int,
    fan-pwm-0: int,
    fan-pwm-1: int,
    fan-pwm-2: int,
    fan-pwm-3: int,
    fan-pwm-4: int,
    fan-pwm-5: int,
    fan-pwm-6: int,
    fan-pwm-7: int,
}

component TelemetryCell {
    in property <string> value;
    in property <string> label;

    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        Text {
            text: root.value;
            font-size: 13px;
            font-weight: 600;
            color: Palette.text-primary;
        }
        Text {
            text: root.label;
            font-size: 12px;
            color: Palette.text-secondary;
        }
    }
}

component HwStatusCell {
    in property <string> label;
    in property <string> text;

    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        Text {
            text: root.label + ":";
            font-size: 12px;
            color: Palette.text-secondary;
        }
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 600;
            color: Palette.text-primary;
        }
    }
}

export component AppWindow inherits Window {
    width: 425px;
    height: 381px;
    title: "Orbis Control";
    background: Palette.window-background;

    in-out property <UiState> ui-state: {
        perf-selected: 1,
        available-perf-mask: 0,
        perf-state: PerformanceHwState.Loading,
        perf-writable: false,
        perf-unavailable-reason: "",
        gpu-selected: 1,
        available-gpu-mask: 0,
        gpu-ultimate-pending: false,
        gpu-ultimate-disabled: false,
        gpu-section-error: false,
        gpu-mode-state: GpuModeHwState.Loading,
        gpu-mode-writable: false,
        charge-limit: 80,
        charge-limit-enabled: false,
        charge-limit-writable: false,
        charge-limit-unavailable-reason: "",
        charge-limit-state: ChargeLimitState.Loading,
        gpu-power-state: GpuHwState.Loading,
        gpu-mux-state: GpuHwState.Loading,
        gpu-access-state: GpuHwState.Loading,
        gpu-power-value: 0,
        gpu-mux-value: 0,
        gpu-access-value: 0,
        cpu-temp: "—",
        gpu-temp: "—",
        cpu-fan-rpm: "—",
        gpu-fan-rpm: "—",
        battery-percent: "—",
        power-ac-mw: "—",
        battery-health: "—",
        battery-cycles: "—",
        battery-status: "",
        ac-online: "—",
        gpu-power: "—",
        version: "0.1.0",
        mock-profile: "zephyrus-full",
        fan-curve-state: FanCurveHwState.Loading,
        fan-curve-writable: false,
        fan-curve-unavailable-reason: "",
        fan-curve-error: false,
        fan-curve-dirty: false,
        fan-selected: 0,
        fan-profile-selected: 0,
        fan-temp-0: 0,
        fan-temp-1: 0,
        fan-temp-2: 0,
        fan-temp-3: 0,
        fan-temp-4: 0,
        fan-temp-5: 0,
        fan-temp-6: 0,
        fan-temp-7: 0,
        fan-pwm-0: 0,
        fan-pwm-1: 0,
        fan-pwm-2: 0,
        fan-pwm-3: 0,
        fan-pwm-4: 0,
        fan-pwm-5: 0,
        fan-pwm-6: 0,
        fan-pwm-7: 0,
    };

    callback perf-clicked(int);
    callback gpu-clicked(int);
    callback charge-changed(float);

    // Fan curve editor
    callback fan-changed(int);           // 0=CPU, 1=GPU
    callback fan-profile-changed(int);   // 0=Balanced, 1=Perf, 2=Quiet, 3=Low
    callback fan-temp-point-changed(int, int); // index, new-temp
    callback fan-pwm-point-changed(int, int);  // index, new-pwm
    callback fan-apply-clicked;

    // Проверка бита маски доступности арифметикой: в Slint 1.13 нет побитовых
    // операторов (&), поэтому бит извлекается делением и Math.floor.
    function bit-set(mask: int, bit: int) -> bool {
        let shifted = Math.floor(mask / bit);
        return shifted - 2 * Math.floor(shifted / 2) == 1;
    }

    // Текстовое представление read-only GPU hardware capability.
    // Unavailable → "Unavailable"; Loading → "…"; Ready → semantic value.

    function gpu-power-text(state: GpuHwState, value: int) -> string {
        if (state == GpuHwState.Unavailable) { return "Unavailable"; }
        if (state == GpuHwState.Loading) { return "…"; }
        if (value == 0) { return "Active"; }
        if (value == 1) { return "Suspended"; }
        if (value == 2) { return "Off"; }
        if (value == 3) { return "Stale"; }
        return "Unknown";
    }

    function gpu-mux-text(state: GpuHwState, value: int) -> string {
        if (state == GpuHwState.Unavailable) { return "Unavailable"; }
        if (state == GpuHwState.Loading) { return "…"; }
        if (value == 0) { return "Integrated"; }
        if (value == 1) { return "Discrete"; }
        return "Unknown";
    }

    function gpu-access-text(state: GpuHwState, value: int) -> string {
        if (state == GpuHwState.Unavailable) { return "Unavailable"; }
        if (state == GpuHwState.Loading) { return "…"; }
        if (value == 0) { return "Unblocked"; }
        if (value == 1) { return "Blocked"; }
        if (value == 2) { return "Pending"; }
        return "Unknown";
    }

    VerticalLayout {


        // ---- Контент ----
        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 8px;

            // Performance Mode
            VerticalLayout {
                spacing: 4px;
                SectionHeader { title: "Performance Mode"; }
                HorizontalLayout {
                    spacing: 4px;
                    ModeCard {
                        title: "Silent";
                        compact: false;
                        accent: Palette.silent;
                        icon-kind: 0;
                        // Текущий профиль выделен только при authoritative Ready;
                        // при Loading/Unavailable никакая карточка не выглядит active.
                        selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 0;
                        // Read-only в production (perf-writable=false); unavailable
                        // профили не выглядят доступными.
                        disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 1);
                        clicked => { root.perf-clicked(0); }
                    }
                    ModeCard {
                        title: "Balanced";
                        compact: false;
                        accent: Palette.balanced;
                        icon-kind: 1;
                        selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 1;
                        disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 2);
                        clicked => { root.perf-clicked(1); }
                    }
                    ModeCard {
                        title: "Turbo";
                        compact: false;
                        accent: Palette.turbo;
                        icon-kind: 2;
                        selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 2;
                        disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 4);
                        clicked => { root.perf-clicked(2); }
                    }
                }
                if (root.ui-state.perf-unavailable-reason != "" && root.ui-state.perf-state == PerformanceHwState.Ready) : Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: Palette.surface-pressed;
                    border-width: 1px;
                    border-color: Palette.border-default;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Text {
                            text: root.ui-state.perf-unavailable-reason;
                            font-size: 12px;
                            color: Palette.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
                if (root.ui-state.perf-state == PerformanceHwState.Loading) : Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: Palette.surface-pressed;
                    border-width: 1px;
                    border-color: Palette.border-default;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Text {
                            text: "Loading performance state…";
                            font-size: 12px;
                            color: Palette.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
                if (root.ui-state.perf-state == PerformanceHwState.Unavailable) : Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: Palette.surface-pressed;
                    border-width: 1px;
                    border-color: Palette.border-default;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Rectangle {
                            width: 3px;
                            height: 14px;
                            border-radius: 1.5px;
                            background: Palette.error;
                            y: (parent.height - 14px) / 2;
                        }
                        Text {
                            text: "Performance backend unavailable";
                            font-size: 12px;
                            color: Palette.text-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // GPU Mode
            VerticalLayout {
                spacing: 4px;
                SectionHeader { title: "GPU Mode"; }
                if (root.ui-state.gpu-section-error) : Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: Palette.surface-pressed;
                    border-width: 1px;
                    border-color: Palette.error;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        // вертикальный индикатор слева (не отдельная точка)
                        Rectangle {
                            width: 3px;
                            height: 14px;
                            border-radius: 1.5px;
                            background: Palette.error;
                            y: (parent.height - 14px) / 2;
                        }
                        Text {
                            text: "GPU backend error";
                            font-size: 12px;
                            color: Palette.text-primary;
                            vertical-alignment: center;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    ModeCard {
                        title: "Eco";
                        compact: true;
                        accent: Palette.eco;
                        icon-kind: 0;
                        // Authoritative selected показывается только при Ready
                        // (production: Unavailable -> никакой mode не выбран).
                        selected: root.ui-state.gpu-mode-state == GpuModeHwState.Ready && root.ui-state.gpu-selected == 0;
                        // Клик недоступен вне Ready; production writable=false
                        // блокирует mutation даже при mock legacy worker path.
                        disabled: root.ui-state.gpu-mode-state != GpuModeHwState.Ready || !root.ui-state.gpu-mode-writable || !root.bit-set(root.ui-state.available-gpu-mask, 1);
                        clicked => { root.gpu-clicked(0); }
                    }
                    ModeCard {
                        title: "Standard";
                        compact: true;
                        accent: Palette.standard;
                        icon-kind: 1;
                        selected: root.ui-state.gpu-mode-state == GpuModeHwState.Ready && root.ui-state.gpu-selected == 1;
                        disabled: root.ui-state.gpu-mode-state != GpuModeHwState.Ready || !root.ui-state.gpu-mode-writable || !root.bit-set(root.ui-state.available-gpu-mask, 2);
                        clicked => { root.gpu-clicked(1); }
                    }
                    ModeCard {
                        title: "Ultimate";
                        compact: true;
                        accent: Palette.ultimate;
                        icon-kind: 2;
                        selected: root.ui-state.gpu-mode-state == GpuModeHwState.Ready && root.ui-state.gpu-selected == 2;
                        pending: root.ui-state.gpu-ultimate-pending;
                        disabled: root.ui-state.gpu-mode-state != GpuModeHwState.Ready || !root.ui-state.gpu-mode-writable || root.ui-state.gpu-ultimate-disabled || !root.bit-set(root.ui-state.available-gpu-mask, 4);
                        subtitle: root.ui-state.gpu-ultimate-disabled ? "MUX unavailable" : "";
                        clicked => { root.gpu-clicked(2); }
                    }
                    ModeCard {
                        title: "Optimized";
                        compact: true;
                        accent: Palette.optimized;
                        icon-kind: 1;
                        selected: root.ui-state.gpu-mode-state == GpuModeHwState.Ready && root.ui-state.gpu-selected == 3;
                        disabled: root.ui-state.gpu-mode-state != GpuModeHwState.Ready || !root.ui-state.gpu-mode-writable || !root.bit-set(root.ui-state.available-gpu-mask, 8);
                        clicked => { root.gpu-clicked(3); }
                    }
                }
                if (root.ui-state.gpu-mode-state == GpuModeHwState.Loading) : Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: Palette.surface-pressed;
                    border-width: 1px;
                    border-color: Palette.border-default;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Text {
                            text: "Loading GPU mode…";
                            font-size: 12px;
                            color: Palette.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
                if (root.ui-state.gpu-mode-state == GpuModeHwState.Unavailable) : Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: Palette.surface-pressed;
                    border-width: 1px;
                    border-color: Palette.border-default;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Text {
                            text: "GPU mode control unavailable";
                            font-size: 12px;
                            color: Palette.text-primary;
                            vertical-alignment: center;
                        }
                    }
                }
                // Read-only GPU hardware status (не интерактивно; независимо от product buttons).
                HorizontalLayout {
                    spacing: 8px;
                    HwStatusCell {
                        label: "Power";
                        text: root.gpu-power-text(root.ui-state.gpu-power-state, root.ui-state.gpu-power-value);
                    }
                    HwStatusCell {
                        label: "MUX";
                        text: root.gpu-mux-text(root.ui-state.gpu-mux-state, root.ui-state.gpu-mux-value);
                    }
                    HwStatusCell {
                        label: "Access";
                        text: root.gpu-access-text(root.ui-state.gpu-access-state, root.ui-state.gpu-access-value);
                    }
                }
            }

            // Battery Charge Limit
            VerticalLayout {
                spacing: 4px;
                SectionHeader { title: "Battery Charge Limit"; }
                if (root.ui-state.charge-limit-state == ChargeLimitState.Ready) : ValueSlider {
                    min: 20;
                    max: 100;
                    step: 1;
                    value: root.ui-state.charge-limit;
                    disabled: !root.ui-state.charge-limit-writable;
                    changed(v) => {
                        root.charge-changed(v);
                    }
                }
                if (root.ui-state.charge-limit-state == ChargeLimitState.Ready && root.ui-state.charge-limit-unavailable-reason != "") : Text {
                    text: root.ui-state.charge-limit-unavailable-reason;
                    height: 18px;
                    font-size: 11px;
                    color: Palette.text-secondary;
                    vertical-alignment: center;
                }
                if (root.ui-state.charge-limit-state == ChargeLimitState.Ready) : Text {
                    text: root.ui-state.charge-limit-enabled
                        ? "UPower threshold policy: On"
                        : "UPower threshold policy: Off";
                    height: 18px;
                    font-size: 11px;
                    color: Palette.text-secondary;
                    vertical-alignment: center;
                }
                if (root.ui-state.charge-limit-state == ChargeLimitState.Loading) : Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: Palette.surface-pressed;
                    border-width: 1px;
                    border-color: Palette.border-default;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Text {
                            text: "Loading battery state…";
                            font-size: 12px;
                            color: Palette.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
                if (root.ui-state.charge-limit-state == ChargeLimitState.Unavailable) : Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: Palette.surface-pressed;
                    border-width: 1px;
                    border-color: Palette.border-default;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        // вертикальный индикатор слева (как GPU error banner)
                        Rectangle {
                            width: 3px;
                            height: 14px;
                            border-radius: 1.5px;
                            background: Palette.error;
                            y: (parent.height - 14px) / 2;
                        }
                        Text {
                            text: "Battery backend unavailable";
                            font-size: 12px;
                            color: Palette.text-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Fan Curve Editor
            VerticalLayout {
                spacing: 4px;
                SectionHeader { title: "Fan Curve"; }
                FanCurveEditor {
                    state: root.ui-state.fan-curve-state;
                    writable: root.ui-state.fan-curve-writable;
                    unavailable-reason: root.ui-state.fan-curve-unavailable-reason;
                    error-state: root.ui-state.fan-curve-error;
                    dirty: root.ui-state.fan-curve-dirty;
                    fan-selected: root.ui-state.fan-selected;
                    profile-selected: root.ui-state.fan-profile-selected;
                    temp-0: root.ui-state.fan-temp-0;
                    temp-1: root.ui-state.fan-temp-1;
                    temp-2: root.ui-state.fan-temp-2;
                    temp-3: root.ui-state.fan-temp-3;
                    temp-4: root.ui-state.fan-temp-4;
                    temp-5: root.ui-state.fan-temp-5;
                    temp-6: root.ui-state.fan-temp-6;
                    temp-7: root.ui-state.fan-temp-7;
                    pwm-0: root.ui-state.fan-pwm-0;
                    pwm-1: root.ui-state.fan-pwm-1;
                    pwm-2: root.ui-state.fan-pwm-2;
                    pwm-3: root.ui-state.fan-pwm-3;
                    pwm-4: root.ui-state.fan-pwm-4;
                    pwm-5: root.ui-state.fan-pwm-5;
                    pwm-6: root.ui-state.fan-pwm-6;
                    pwm-7: root.ui-state.fan-pwm-7;
                    fan-changed(i) => { root.fan-changed(i); }
                    profile-changed(i) => { root.fan-profile-changed(i); }
                    temp-point-changed(i, v) => { root.fan-temp-point-changed(i, v); }
                    pwm-point-changed(i, v) => { root.fan-pwm-point-changed(i, v); }
                    apply-clicked => { root.fan-apply-clicked(); }
                }
            }

            // Telemetry
            VerticalLayout {
                spacing: 4px;
                SectionHeader { title: "Telemetry"; }
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 14px;
                        TelemetryCell { value: root.ui-state.cpu-temp; label: "CPU"; }
                        TelemetryCell { value: root.ui-state.gpu-temp; label: "GPU"; }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        TelemetryCell { value: root.ui-state.cpu-fan-rpm; label: "CPU fan"; }
                        TelemetryCell { value: root.ui-state.gpu-fan-rpm; label: "GPU fan"; }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        TelemetryCell { value: root.ui-state.battery-percent; label: "Battery"; }
                        TelemetryCell { value: root.ui-state.power-ac-mw; label: "Power (AC)"; }
                    }
                }
            }

            // Нижний служебный блок: версия • mock-профиль (без повтора названия)
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: Palette.surface-pressed;
                border-width: 1px;
                border-color: Palette.border-default;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: "v" + root.ui-state.version;
                        font-size: 11px;
                        color: Palette.text-disabled;
                    }
                    Text {
                        text: "•";
                        font-size: 11px;
                        color: Palette.text-disabled;
                    }
                    Text {
                        text: "Mock: " + root.ui-state.mock-profile;
                        font-size: 11px;
                        color: Palette.text-disabled;
                    }
                }
            }
        }
    }
}
