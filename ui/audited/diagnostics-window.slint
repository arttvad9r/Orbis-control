import { MetricTile } from "../components/visual-controls.slint";
import { WindowHeader, SectionCard, SectionTitle, ActionButton, LocalStatus } from "common.slint";
import { Palette } from "../themes/dark.slint";

export component DiagnosticsWindow inherits Window {
    width: 700px;
    height: 610px;
    title: "Orbis Control — Diagnostics";
    background: Palette.window-background;

    // Compatibility alias retained while Rust lifecycle wiring is migrated.
    in property <string> version: "Unknown";
    in property <string> kernel-value: "Unknown";
    in property <string> platform-value: "Unknown";
    in property <string> version-value: root.version;
    in property <string> build-detail: "Build metadata not embedded";
    in property <string> system-detail: "";
    in property <string> capabilities-text: "No capability entries";
    in property <string> services-text: "No service observations";
    in property <string> gpu-text: "Unknown";
    in property <string> telemetry-text: "Unknown";
    in property <string> display-text: "Unknown";
    in property <string> snapshot-meta: "";
    in-out property <string> local-status: "Diagnostics not loaded";
    callback refresh-requested;

    VerticalLayout {
        padding: 10px; spacing: 7px;
        WindowHeader { title: "Diagnostics"; subtitle: "Read-only production snapshot"; }
        LocalStatus { text: root.local-status; accent: Palette.text-secondary; }
        HorizontalLayout { height: 52px; spacing: 6px;
            MetricTile { label: "Kernel"; value: root.kernel-value; detail: root.system-detail; }
            MetricTile { label: "Platform"; value: root.platform-value; detail: "privacy-safe DMI"; }
            MetricTile { label: "Orbis"; value: "v" + root.version-value; detail: root.build-detail; }
        }
        HorizontalLayout { spacing: 10px; height: 260px;
            SectionCard {
                horizontal-stretch: 1;
                VerticalLayout { padding: 10px; spacing: 6px;
                    SectionTitle { title: "Capability Registry"; detail: root.snapshot-meta; }
                    Text {
                        text: root.capabilities-text;
                        font-size: 9px;
                        color: Palette.text-primary;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
            }
            SectionCard {
                width: 245px;
                VerticalLayout { padding: 10px; spacing: 6px;
                    SectionTitle { title: "Services"; detail: "presence only"; }
                    Text {
                        text: root.services-text;
                        font-size: 9px;
                        color: Palette.text-primary;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
            }
        }
        HorizontalLayout { spacing: 8px; height: 145px;
            SectionCard {
                horizontal-stretch: 1;
                VerticalLayout { padding: 9px; spacing: 5px;
                    SectionTitle { title: "GPU primitives"; }
                    Text { text: root.gpu-text; font-size: 9px; color: Palette.text-primary; wrap: word-wrap; }
                }
            }
            SectionCard {
                horizontal-stretch: 1;
                VerticalLayout { padding: 9px; spacing: 5px;
                    SectionTitle { title: "Telemetry"; }
                    Text { text: root.telemetry-text; font-size: 9px; color: Palette.text-primary; wrap: word-wrap; }
                }
            }
            SectionCard {
                horizontal-stretch: 1;
                VerticalLayout { padding: 9px; spacing: 5px;
                    SectionTitle { title: "Display"; detail: "read-only"; }
                    Text { text: root.display-text; font-size: 9px; color: Palette.text-primary; wrap: word-wrap; }
                }
            }
        }
        HorizontalLayout { height: 28px; spacing: 6px;
            ActionButton { label: "Refresh"; accent: true; clicked => { root.refresh-requested(); } }
            ActionButton { label: "Copy Summary"; disabled: true; }
            ActionButton { label: "Open Logs"; disabled: true; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            ActionButton { label: "Export Report"; disabled: true; }
        }
    }
}
