import { TextEdit } from "std-widgets.slint";
import { MetricTile } from "../components/visual-controls.slint";
import { WindowHeader, SectionCard, SectionTitle, ActionButton, LocalStatus } from "common.slint";
import { Palette } from "../themes/dark.slint";

export component DiagnosticsWindow inherits Window {
    width: 660px;
    height: 574px;
    title: "Orbis Control — Diagnostics";
    background: Palette.window-background;

    // Compatibility alias retained for current Rust glue.
    in property <string> version: "Unknown";
    in property <string> kernel-value: "Unknown";
    in property <string> platform-value: "Unknown";
    in property <string> version-value: root.version;
    in property <string> build-detail: "Build metadata unavailable";
    in property <string> system-detail: "";
    in property <string> capabilities-text: "No capability entries";
    in property <string> services-text: "No service observations";
    in property <string> gpu-text: "Unknown";
    in property <string> telemetry-text: "Unknown";
    in property <string> display-text: "Unknown";
    in property <string> snapshot-meta: "";

    in-out property <bool> refresh-enabled: false;
    in property <bool> refresh-pending: false;
    in property <bool> copy-enabled: false;
    in property <bool> logs-enabled: false;
    in property <bool> export-enabled: false;
    in-out property <string> local-status: "Diagnostics unavailable · lifecycle wiring pending";

    callback refresh-requested;
    // Compatibility callback retained for existing Rust glue. Clipboard copy is
    // now handled by Slint's own platform backend and does not require a shell
    // helper or a second host integration.
    callback copy-summary-requested;
    callback open-logs-requested;
    callback export-report-requested;

    function summary-text() -> string {
        return "Orbis Control diagnostics\n"
            + "Version: " + root.version-value + "\n"
            + "Kernel: " + root.kernel-value + "\n"
            + "Platform: " + root.platform-value + "\n"
            + "Build: " + root.build-detail + "\n"
            + "System: " + root.system-detail + "\n"
            + "Snapshot: " + root.snapshot-meta + "\n\n"
            + "Capabilities\n" + root.capabilities-text + "\n\n"
            + "Services\n" + root.services-text + "\n\n"
            + "GPU\n" + root.gpu-text + "\n\n"
            + "Telemetry\n" + root.telemetry-text + "\n\n"
            + "Display\n" + root.display-text;
    }

    // The standard TextEdit owns the actual platform clipboard integration.
    // It is kept off-canvas and read-only; the user-visible button selects its
    // complete privacy-safe text and invokes the built-in copy operation.
    clipboard-source := TextEdit {
        x: -10000px;
        y: -10000px;
        width: 1px;
        height: 1px;
        read-only: true;
        text: root.summary-text();
    }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        WindowHeader { title: "Diagnostics"; subtitle: "Read-only production snapshot"; }
        LocalStatus { text: root.local-status; accent: root.refresh-enabled ? Palette.text-secondary : Palette.warning; }

        HorizontalLayout {
            height: 54px;
            spacing: 8px;
            MetricTile { label: "Kernel"; value: root.kernel-value; detail: root.system-detail; }
            MetricTile { label: "Platform"; value: root.platform-value; detail: "privacy-safe DMI"; }
            MetricTile { label: "Orbis"; value: "v" + root.version-value; detail: root.build-detail; }
        }

        HorizontalLayout {
            spacing: 10px;
            height: 214px;
            SectionCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    SectionTitle { title: "Capabilities"; detail: root.snapshot-meta; }
                    Text {
                        vertical-stretch: 1;
                        text: root.capabilities-text;
                        font-size: 9px;
                        color: Palette.text-primary;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
            }
            SectionCard {
                width: 224px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    SectionTitle { title: "Services"; detail: "Presence only"; }
                    Text {
                        vertical-stretch: 1;
                        text: root.services-text;
                        font-size: 9px;
                        color: Palette.text-primary;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            height: 116px;
            SectionCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 9px;
                    spacing: 5px;
                    SectionTitle { title: "GPU"; }
                    Text { vertical-stretch: 1; text: root.gpu-text; font-size: 9px; color: Palette.text-primary; wrap: word-wrap; vertical-alignment: top; }
                }
            }
            SectionCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 9px;
                    spacing: 5px;
                    SectionTitle { title: "Telemetry"; }
                    Text { vertical-stretch: 1; text: root.telemetry-text; font-size: 9px; color: Palette.text-primary; wrap: word-wrap; vertical-alignment: top; }
                }
            }
            SectionCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 9px;
                    spacing: 5px;
                    SectionTitle { title: "Display"; detail: "Read-only"; }
                    Text { vertical-stretch: 1; text: root.display-text; font-size: 9px; color: Palette.text-primary; wrap: word-wrap; vertical-alignment: top; }
                }
            }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }

        HorizontalLayout {
            height: 30px;
            spacing: 6px;
            ActionButton { width: 88px; label: root.refresh-pending ? "Refreshing…" : "Refresh"; accent: true; disabled: !root.refresh-enabled || root.refresh-pending; clicked => { root.refresh-requested(); } }
            ActionButton {
                width: 104px;
                label: "Copy Summary";
                disabled: !root.copy-enabled;
                clicked => {
                    clipboard-source.select-all();
                    clipboard-source.copy();
                    root.local-status = "Summary copied to clipboard";
                }
            }
            ActionButton { width: 86px; label: "Open Logs"; disabled: !root.logs-enabled; clicked => { root.open-logs-requested(); } }
            Text {
                horizontal-stretch: 1;
                text: "Snapshot actions never mutate hardware";
                font-size: 9px;
                color: Palette.text-disabled;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
            ActionButton { width: 104px; label: "Export Report"; disabled: !root.export-enabled; clicked => { root.export-report-requested(); } }
        }
    }
}
