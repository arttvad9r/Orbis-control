import { ComboBox } from "std-widgets.slint";
import { FanCurveHwState } from "../components/fan-curve-editor.slint";
import { PreviewButton, PreviewSliderRow, ToggleRow, PreviewNotice, StatusBadge } from "../components/visual-controls.slint";
import { ActionButton, LocalStatus } from "common.slint";
import { Palette } from "../themes/dark.slint";

component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> disabled: false;
    callback clicked;
    height: 28px;
    min-width: 62px;
    horizontal-stretch: 1;
    border-radius: 3px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Palette.accent-default : Palette.border-default;
    background: root.disabled ? Palette.surface-disabled : touch.pressed ? Palette.surface-pressed : touch.has-hover ? Palette.surface-hover : Palette.surface-default;
    Text { text: root.label; font-size: 9px; font-weight: root.selected ? 600 : 500; color: root.disabled ? Palette.text-disabled : Palette.text-primary; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { enabled: !root.disabled; clicked => { root.clicked(); } }
}

component TemperatureControl inherits Rectangle {
    in property <int> index;
    in property <int> value;
    in property <bool> editable: false;
    callback changed(int, int);
    width: 38px;
    height: 32px;
    background: transparent;
    Text { x: 0px; y: 0px; width: parent.width; height: 13px; text: root.value + "°"; font-size: 8px; font-weight: 600; color: root.editable ? Palette.text-primary : Palette.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
    Rectangle {
        x: 1px; y: 15px; width: 16px; height: 15px; border-radius: 2px; border-width: 1px; border-color: Palette.border-default;
        background: !root.editable ? Palette.surface-disabled : minus.pressed ? Palette.surface-pressed : minus.has-hover ? Palette.surface-hover : Palette.surface-default;
        Text { text: "−"; font-size: 9px; color: root.editable ? Palette.text-secondary : Palette.text-disabled; horizontal-alignment: center; vertical-alignment: center; }
        minus := TouchArea { enabled: root.editable; clicked => { root.changed(root.index, root.value - 1); } }
    }
    Rectangle {
        x: 21px; y: 15px; width: 16px; height: 15px; border-radius: 2px; border-width: 1px; border-color: Palette.border-default;
        background: !root.editable ? Palette.surface-disabled : plus.pressed ? Palette.surface-pressed : plus.has-hover ? Palette.surface-hover : Palette.surface-default;
        Text { text: "+"; font-size: 9px; color: root.editable ? Palette.text-secondary : Palette.text-disabled; horizontal-alignment: center; vertical-alignment: center; }
        plus := TouchArea { enabled: root.editable; clicked => { root.changed(root.index, root.value + 1); } }
    }
}

component GraphPoint inherits Rectangle {
    in property <int> index;
    in property <int> pwm;
    in property <bool> editable: false;
    in property <color> accent: Palette.accent-default;
    callback previewed(int, int);
    callback committed(int, int);
    callback cancelled;
    property <bool> active: false;
    property <int> preview: root.pwm;
    property <int> shown: root.active ? root.preview : root.pwm;
    width: 20px;
    background: transparent;
    Rectangle {
        x: 4px;
        y: (1 - Math.min(Math.max(root.shown / 255, 0), 1)) * (parent.height - 12px);
        width: 12px; height: 12px; border-radius: 6px; border-width: 2px; border-color: Palette.text-primary;
        background: root.editable ? root.accent : Palette.text-disabled;
    }
    if (drag.has-hover || root.active) : Rectangle {
        x: -11px; y: Math.max((1 - Math.min(Math.max(root.shown / 255, 0), 1)) * (parent.height - 12px) - 18px, 0px);
        width: 42px; height: 16px; border-radius: 3px; border-width: 1px; border-color: Palette.border-default; background: Palette.surface-default;
        Text { text: root.shown + ""; font-size: 8px; color: Palette.text-primary; horizontal-alignment: center; vertical-alignment: center; }
    }
    drag := TouchArea {
        enabled: root.editable;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.active = true;
                root.preview = Math.min(Math.max(Math.round((1 - self.mouse-y / self.height) * 255), 0), 255);
                root.previewed(root.index, root.preview);
            } else if (ev.kind == PointerEventKind.move && self.pressed) {
                root.preview = Math.min(Math.max(Math.round((1 - self.mouse-y / self.height) * 255), 0), 255);
                root.previewed(root.index, root.preview);
            } else if (ev.kind == PointerEventKind.up && root.active) {
                let final-value = Math.min(Math.max(Math.round((1 - self.mouse-y / self.height) * 255), 0), 255);
                root.active = false;
                root.preview = root.pwm;
                root.committed(root.index, final-value);
            } else if (ev.kind == PointerEventKind.cancel) {
                root.active = false;
                root.preview = root.pwm;
                root.cancelled();
            }
        }
    }
}

component CurveGraph inherits Rectangle {
    in property <bool> editable: false;
    in property <int> fan-selected: 0;
    in property <int> temp-0; in property <int> temp-1; in property <int> temp-2; in property <int> temp-3;
    in property <int> temp-4; in property <int> temp-5; in property <int> temp-6; in property <int> temp-7;
    in property <int> pwm-0; in property <int> pwm-1; in property <int> pwm-2; in property <int> pwm-3;
    in property <int> pwm-4; in property <int> pwm-5; in property <int> pwm-6; in property <int> pwm-7;
    callback temp-changed(int, int);
    callback pwm-changed(int, int);

    property <int> drag-index: -1;
    property <int> drag-pwm: 0;
    property <color> curve-color: root.fan-selected == 0 ? Palette.accent-default : Palette.error;
    property <int> axis-min: root.min-temp() - 5;
    property <int> axis-max: Math.max(root.max-temp() + 5, root.axis-min + 10);

    pure function min-temp() -> int { return Math.min(root.temp-0, Math.min(root.temp-1, Math.min(root.temp-2, Math.min(root.temp-3, Math.min(root.temp-4, Math.min(root.temp-5, Math.min(root.temp-6, root.temp-7))))))); }
    pure function max-temp() -> int { return Math.max(root.temp-0, Math.max(root.temp-1, Math.max(root.temp-2, Math.max(root.temp-3, Math.max(root.temp-4, Math.max(root.temp-5, Math.max(root.temp-6, root.temp-7))))))); }
    pure function x-pos(temp: int) -> float { return Math.min(Math.max((temp - root.axis-min) / (root.axis-max - root.axis-min) * 100, 0), 100); }
    pure function pwm-at(index: int) -> int {
        if (root.drag-index == index) { return root.drag-pwm; }
        if (index == 0) { return root.pwm-0; } if (index == 1) { return root.pwm-1; } if (index == 2) { return root.pwm-2; } if (index == 3) { return root.pwm-3; }
        if (index == 4) { return root.pwm-4; } if (index == 5) { return root.pwm-5; } if (index == 6) { return root.pwm-6; } return root.pwm-7;
    }
    pure function y-pos(index: int) -> float { return 100 - Math.min(Math.max(root.pwm-at(index) / 255, 0), 1) * 100; }

    height: 310px;
    min-width: 340px;
    horizontal-stretch: 1;
    border-radius: 3px;
    border-width: 1px;
    border-color: Palette.border-default;
    background: Palette.surface-pressed;

    Text { x: 40px; y: 4px; width: parent.width - 48px; height: 17px; text: (root.fan-selected == 0 ? "CPU" : "GPU") + " Fan Profile · raw PWM / °C"; font-size: 10px; font-weight: 600; color: Palette.text-primary; horizontal-alignment: center; vertical-alignment: center; }
    plot := Rectangle {
        x: 40px; y: 23px; width: parent.width - 48px; height: 205px; background: transparent; border-width: 1px; border-color: Palette.border-default; clip: true;
        Rectangle { x: 0px; y: 20%; width: parent.width; height: 1px; background: Palette.border-default; }
        Rectangle { x: 0px; y: 40%; width: parent.width; height: 1px; background: Palette.border-default; }
        Rectangle { x: 0px; y: 60%; width: parent.width; height: 1px; background: Palette.border-default; }
        Rectangle { x: 0px; y: 80%; width: parent.width; height: 1px; background: Palette.border-default; }
        Rectangle { x: 12.5%; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: 25%; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: 37.5%; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: 50%; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: 62.5%; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: 75%; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: 87.5%; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Path {
            width: parent.width; height: parent.height; viewbox-x: 0; viewbox-y: 0; viewbox-width: 100; viewbox-height: 100; fit: fill;
            stroke: root.curve-color; stroke-width: 2px; stroke-line-cap: round; stroke-line-join: round;
            MoveTo { x: root.x-pos(root.temp-0); y: root.y-pos(0); }
            LineTo { x: root.x-pos(root.temp-1); y: root.y-pos(1); }
            LineTo { x: root.x-pos(root.temp-2); y: root.y-pos(2); }
            LineTo { x: root.x-pos(root.temp-3); y: root.y-pos(3); }
            LineTo { x: root.x-pos(root.temp-4); y: root.y-pos(4); }
            LineTo { x: root.x-pos(root.temp-5); y: root.y-pos(5); }
            LineTo { x: root.x-pos(root.temp-6); y: root.y-pos(6); }
            LineTo { x: root.x-pos(root.temp-7); y: root.y-pos(7); }
        }
        p0 := GraphPoint { x: root.x-pos(root.temp-0) * (plot.width - self.width) / 100; height: plot.height; index: 0; pwm: root.pwm-0; editable: root.editable; accent: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-0) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
        p1 := GraphPoint { x: root.x-pos(root.temp-1) * (plot.width - self.width) / 100; height: plot.height; index: 1; pwm: root.pwm-1; editable: root.editable; accent: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-1) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
        p2 := GraphPoint { x: root.x-pos(root.temp-2) * (plot.width - self.width) / 100; height: plot.height; index: 2; pwm: root.pwm-2; editable: root.editable; accent: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-2) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
        p3 := GraphPoint { x: root.x-pos(root.temp-3) * (plot.width - self.width) / 100; height: plot.height; index: 3; pwm: root.pwm-3; editable: root.editable; accent: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-3) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
        p4 := GraphPoint { x: root.x-pos(root.temp-4) * (plot.width - self.width) / 100; height: plot.height; index: 4; pwm: root.pwm-4; editable: root.editable; accent: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-4) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
        p5 := GraphPoint { x: root.x-pos(root.temp-5) * (plot.width - self.width) / 100; height: plot.height; index: 5; pwm: root.pwm-5; editable: root.editable; accent: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-5) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
        p6 := GraphPoint { x: root.x-pos(root.temp-6) * (plot.width - self.width) / 100; height: plot.height; index: 6; pwm: root.pwm-6; editable: root.editable; accent: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-6) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
        p7 := GraphPoint { x: root.x-pos(root.temp-7) * (plot.width - self.width) / 100; height: plot.height; index: 7; pwm: root.pwm-7; editable: root.editable; accent: root.curve-color; previewed(i,v) => { root.drag-index=i; root.drag-pwm=v; } committed(i,v) => { root.drag-index=-1; if (v != root.pwm-7) { root.pwm-changed(i,v); } } cancelled => { root.drag-index=-1; } }
    }
    Text { x: 2px; y: 20px; width: 34px; height: 12px; text: "255"; font-size: 8px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 2px; y: 70px; width: 34px; height: 12px; text: "192"; font-size: 8px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 2px; y: 122px; width: 34px; height: 12px; text: "128"; font-size: 8px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 2px; y: 173px; width: 34px; height: 12px; text: "64"; font-size: 8px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 2px; y: 221px; width: 34px; height: 12px; text: "0"; font-size: 8px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 36px; y: 230px; width: 48px; height: 12px; text: root.axis-min + "°"; font-size: 8px; color: Palette.text-secondary; horizontal-alignment: center; }
    Text { x: parent.width / 2 - 24px; y: 230px; width: 48px; height: 12px; text: Math.round((root.axis-min + root.axis-max) / 2) + "°"; font-size: 8px; color: Palette.text-secondary; horizontal-alignment: center; }
    Text { x: parent.width - 60px; y: 230px; width: 48px; height: 12px; text: root.axis-max + "°"; font-size: 8px; color: Palette.text-secondary; horizontal-alignment: center; }
    HorizontalLayout {
        x: 40px; y: 252px; width: parent.width - 48px; height: 34px; spacing: 1px; alignment: center;
        TemperatureControl { index: 0; value: root.temp-0; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
        TemperatureControl { index: 1; value: root.temp-1; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
        TemperatureControl { index: 2; value: root.temp-2; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
        TemperatureControl { index: 3; value: root.temp-3; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
        TemperatureControl { index: 4; value: root.temp-4; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
        TemperatureControl { index: 5; value: root.temp-5; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
        TemperatureControl { index: 6; value: root.temp-6; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
        TemperatureControl { index: 7; value: root.temp-7; editable: root.editable; changed(i,v) => { root.temp-changed(i,v); } }
    }
}

component CurveStateCard inherits Rectangle {
    in property <FanCurveHwState> state: FanCurveHwState.Loading;
    height: 310px;
    min-width: 340px;
    horizontal-stretch: 1;
    border-radius: 3px;
    border-width: 1px;
    border-color: root.state == FanCurveHwState.Unavailable ? Palette.error : Palette.border-default;
    background: Palette.surface-pressed;
    VerticalLayout { padding: 24px; alignment: center;
        Rectangle { vertical-stretch: 1; background: transparent; }
        Text { text: root.state == FanCurveHwState.Loading ? "Loading fan curves…" : "Fan curve backend unavailable"; font-size: 12px; font-weight: 600; color: root.state == FanCurveHwState.Unavailable ? Palette.error : Palette.text-primary; horizontal-alignment: center; }
        Text { text: "Power controls remain available as local preview controls."; font-size: 9px; color: Palette.text-secondary; horizontal-alignment: center; }
        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}

component PowerPreviewPanel inherits Rectangle {
    in property <int> page: 0;
    property <int> power-mode: 1;
    property <int> cpu-boost: 1;
    property <bool> apply-limits: false;
    property <float> spl: 48; property <float> sppt: 62; property <float> fppt: 78;
    property <float> gpu-power: 72; property <float> gpu-boost: 55; property <float> gpu-temp: 76;
    property <float> gpu-memory: 50; property <float> gpu-core: 50; property <float> gpu-clock: 65;
    property <string> status: "Preview only";

    width: 215px;
    height: 310px;
    border-radius: 3px;
    border-width: 1px;
    border-color: Palette.border-default;
    background: Palette.surface-default;
    VerticalLayout { padding: 8px; spacing: 2px;
        Text { text: root.page == 0 ? "CPU Power Controls" : "GPU Power Controls"; height: 16px; font-size: 10px; font-weight: 600; color: Palette.text-primary; }
        if (root.page == 0) : ComboBox { model: ["Best Efficiency", "Balanced", "Best Performance"]; current-index <=> root.power-mode; }
        if (root.page == 0) : ComboBox { model: ["CPU Boost: Disabled", "CPU Boost: Enabled", "CPU Boost: Aggressive", "CPU Boost: Efficient"]; current-index <=> root.cpu-boost; }
        if (root.page == 0) : PreviewSliderRow { label: "SPL / CPU sustained"; unit: "% preview"; value <=> root.spl; }
        if (root.page == 0) : PreviewSliderRow { label: "sPPT / long boost"; unit: "% preview"; value <=> root.sppt; }
        if (root.page == 0) : PreviewSliderRow { label: "fPPT / short boost"; unit: "% preview"; value <=> root.fppt; }
        if (root.page == 1) : PreviewSliderRow { label: "GPU Power"; unit: "% preview"; value <=> root.gpu-power; }
        if (root.page == 1) : PreviewSliderRow { label: "Dynamic Boost"; unit: "% preview"; value <=> root.gpu-boost; }
        if (root.page == 1) : PreviewSliderRow { label: "GPU Temperature"; unit: "% preview"; value <=> root.gpu-temp; }
        if (root.page == 1) : PreviewSliderRow { label: "Memory Offset"; unit: "% preview"; value <=> root.gpu-memory; }
        if (root.page == 1) : PreviewSliderRow { label: "Core Offset"; unit: "% preview"; value <=> root.gpu-core; }
        if (root.page == 1) : PreviewSliderRow { label: "Clock Limit"; unit: "% preview"; value <=> root.gpu-clock; }
        ToggleRow { label: "Apply Power Limits"; checked <=> root.apply-limits; }
        ActionButton { label: root.status; accent: root.apply-limits; clicked => { root.status = root.apply-limits ? "Applied locally" : "Enable limits first"; } }
    }
}

component AdvancedPreviewPanel inherits Rectangle {
    property <float> cpu-uv: 42;
    property <float> igpu-uv: 48;
    property <float> temp-limit: 75;
    property <bool> apply-uv: false;
    property <string> status: "Experimental preview";
    height: 310px;
    border-radius: 3px;
    border-width: 1px;
    border-color: Palette.border-default;
    background: Palette.surface-default;
    HorizontalLayout { padding: 10px; spacing: 12px;
        VerticalLayout { horizontal-stretch: 1; spacing: 3px;
            Text { text: "Advanced / Experimental"; height: 18px; font-size: 11px; font-weight: 600; color: Palette.text-primary; }
            PreviewNotice { text: "Visual only · backend semantics not claimed"; }
            PreviewSliderRow { label: "CPU Voltage Offset"; unit: "% preview"; value <=> root.cpu-uv; }
            PreviewSliderRow { label: "iGPU Voltage Offset"; unit: "% preview"; value <=> root.igpu-uv; }
            PreviewSliderRow { label: "CPU Temperature Limit"; unit: "% preview"; value <=> root.temp-limit; }
            ToggleRow { label: "Apply voltage offsets"; checked <=> root.apply-uv; }
            HorizontalLayout { spacing: 6px;
                ActionButton { label: "Read Limits"; clicked => { root.status = "Limits preview refreshed"; } }
                ActionButton { label: "Apply Advanced"; accent: root.apply-uv; clicked => { root.status = root.apply-uv ? "Applied locally" : "Enable offsets first"; } }
            }
        }
        Rectangle { width: 220px; border-radius: 4px; border-width: 1px; border-color: Palette.warning; background: Palette.surface-pressed;
            VerticalLayout { padding: 10px; spacing: 8px;
                StatusBadge { text: "Experimental"; accent: Palette.warning; }
                Text { text: "Production controls remain gated until units, safe ranges, ownership and authoritative read-back are proven."; font-size: 9px; color: Palette.text-secondary; wrap: word-wrap; }
                LocalStatus { text: root.status; accent: Palette.warning; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                ActionButton { label: "Restore Preview Defaults"; clicked => { root.cpu-uv = 42; root.igpu-uv = 48; root.temp-limit = 75; root.apply-uv = false; root.status = "Preview defaults restored"; } }
            }
        }
    }
}

export component FanCurveEditor inherits Rectangle {
    in property <FanCurveHwState> state: FanCurveHwState.Loading;
    in property <bool> writable: false;
    in property <bool> error-state: false;
    in property <bool> dirty: false;
    in property <int> fan-selected: 0;
    in property <int> profile-selected: 0;
    in property <int> temp-0: 0; in property <int> temp-1: 0; in property <int> temp-2: 0; in property <int> temp-3: 0;
    in property <int> temp-4: 0; in property <int> temp-5: 0; in property <int> temp-6: 0; in property <int> temp-7: 0;
    in property <int> pwm-0: 0; in property <int> pwm-1: 0; in property <int> pwm-2: 0; in property <int> pwm-3: 0;
    in property <int> pwm-4: 0; in property <int> pwm-5: 0; in property <int> pwm-6: 0; in property <int> pwm-7: 0;
    callback fan-changed(int);
    callback profile-changed(int);
    callback temp-point-changed(int, int);
    callback pwm-point-changed(int, int);
    callback apply-clicked;

    property <int> page: root.fan-selected;
    property <string> profile-status: "";
    height: 382px;
    min-height: 382px;
    background: Palette.window-background;

    VerticalLayout { spacing: 6px;
        HorizontalLayout { height: 28px; spacing: 5px;
            TabButton { label: "CPU"; selected: root.page == 0; clicked => { root.page = 0; root.fan-changed(0); } }
            TabButton { label: "GPU"; selected: root.page == 1; clicked => { root.page = 1; root.fan-changed(1); } }
            TabButton { label: "Advanced"; selected: root.page == 2; clicked => { root.page = 2; } }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            StatusBadge { text: root.page == 2 ? "Visual only" : root.state == FanCurveHwState.Loading ? "Loading" : root.state == FanCurveHwState.Unavailable ? "Unavailable" : root.writable ? "Editable" : "Read only"; accent: root.page == 2 ? Palette.warning : root.state == FanCurveHwState.Unavailable ? Palette.error : root.state == FanCurveHwState.Loading ? Palette.text-disabled : root.writable ? Palette.success : Palette.text-disabled; }
        }
        HorizontalLayout { height: 30px; spacing: 5px; alignment: center;
            Text { width: 90px; text: "BIOS Fan Curves"; font-size: 9px; font-weight: 600; color: Palette.text-primary; vertical-alignment: center; }
            profile-box := ComboBox { width: 190px; enabled: root.state == FanCurveHwState.Ready; model: ["Balanced", "Performance", "Quiet", "Low Power"]; current-index: root.profile-selected; selected(_) => { root.profile-changed(self.current-index); root.profile-status = "Profile selected"; } }
            ActionButton { width: 34px; label: "+"; clicked => { root.profile-status = "Custom profile slot preview"; } }
            if (root.profile-status != "") : Text { horizontal-stretch: 1; text: root.profile-status; font-size: 8px; color: Palette.text-secondary; vertical-alignment: center; overflow: elide; }
            if (root.profile-status == "") : Rectangle { horizontal-stretch: 1; background: transparent; }
        }
        if (root.page != 2) : HorizontalLayout { height: 310px; spacing: 8px;
            PowerPreviewPanel { page: root.page; }
            if (root.state == FanCurveHwState.Ready) : CurveGraph {
                editable: root.writable; fan-selected: root.fan-selected;
                temp-0: root.temp-0; temp-1: root.temp-1; temp-2: root.temp-2; temp-3: root.temp-3; temp-4: root.temp-4; temp-5: root.temp-5; temp-6: root.temp-6; temp-7: root.temp-7;
                pwm-0: root.pwm-0; pwm-1: root.pwm-1; pwm-2: root.pwm-2; pwm-3: root.pwm-3; pwm-4: root.pwm-4; pwm-5: root.pwm-5; pwm-6: root.pwm-6; pwm-7: root.pwm-7;
                temp-changed(i,v) => { root.temp-point-changed(i,v); }
                pwm-changed(i,v) => { root.pwm-point-changed(i,v); }
            }
            if (root.state != FanCurveHwState.Ready) : CurveStateCard { state: root.state; }
        }
        if (root.page == 2) : AdvancedPreviewPanel { height: 310px; }
    }
}
