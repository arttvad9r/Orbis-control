import { RequestToggleRow } from "../components/request-toggle-row.slint";
import { ChoiceChip } from "../components/visual-controls.slint";
import { ThemeBridge, WindowHeader, SectionCard, SectionTitle, LocalStatus } from "common.slint";
import { Palette, ThemeState, ThemeMode } from "../themes/dark.slint";

export component PreferencesWindow inherits Window {
    width: 452px;
    height: 466px;
    title: "Orbis Control — Preferences";
    background: Palette.window-background;

    callback theme-changed(bool);
    callback startup-changed(bool);
    callback start-minimized-changed(bool);
    callback remember-position-changed(bool);
    callback close-action-changed(int);

    // Backend-owned state. Disabled means the corresponding lifecycle backend
    // has not supplied authoritative state yet.
    in-out property <bool> startup: false;
    in-out property <bool> startup-enabled: false;
    in property <string> startup-status: "Unavailable";

    in property <bool> start-minimized: false;
    in property <bool> start-minimized-enabled: false;
    in property <bool> remember-position: false;
    in property <bool> remember-position-enabled: false;
    in property <int> close-action: 0; // 0 Quit, 1 Hide to tray
    in property <bool> close-action-enabled: false;

    in-out property <string> local-status: "Theme changes are saved immediately";

    function set-theme(light: bool) {
        ThemeState.mode = light ? ThemeMode.Light : ThemeMode.Dark;
        root.local-status = light ? "Light theme active" : "Dark theme active";
        root.theme-changed(light);
    }

    ThemeBridge { }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        WindowHeader {
            title: "Preferences";
            subtitle: "Appearance, startup and window behavior";
        }

        SectionCard {
            height: 84px;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                SectionTitle { title: "Appearance"; detail: "Saved immediately"; }
                HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    Text { width: 116px; text: "Theme"; font-size: 10px; font-weight: 550; color: Palette.text-primary; vertical-alignment: center; }
                    ChoiceChip { horizontal-stretch: 1; label: "Dark"; selected: ThemeState.mode == ThemeMode.Dark; clicked => { root.set-theme(false); } }
                    ChoiceChip { horizontal-stretch: 1; label: "Light"; selected: ThemeState.mode == ThemeMode.Light; clicked => { root.set-theme(true); } }
                }
            }
        }

        SectionCard {
            height: 126px;
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                SectionTitle { title: "Startup"; detail: root.startup-status; }
                RequestToggleRow {
                    label: "Run on startup";
                    description: root.startup-enabled ? "Start Orbis with the user session" : "Waiting for autostart backend";
                    checked: root.startup;
                    disabled: !root.startup-enabled;
                    toggled(value) => { root.startup-changed(value); }
                }
                RequestToggleRow {
                    label: "Start minimized";
                    description: root.start-minimized-enabled ? "Open without focusing the main window" : "Waiting for preferences lifecycle";
                    checked: root.start-minimized;
                    disabled: !root.start-minimized-enabled;
                    toggled(value) => { root.start-minimized-changed(value); }
                }
            }
        }

        SectionCard {
            height: 116px;
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                SectionTitle { title: "Window behavior"; }
                RequestToggleRow {
                    label: "Remember window position";
                    description: root.remember-position-enabled ? "Restore only when the active window system supports it" : "Unavailable on current lifecycle/backend";
                    checked: root.remember-position;
                    disabled: !root.remember-position-enabled;
                    toggled(value) => { root.remember-position-changed(value); }
                }
                HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    alignment: center;
                    Text { width: 148px; text: "Close button"; font-size: 10px; color: root.close-action-enabled ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; }
                    ChoiceChip {
                        horizontal-stretch: 1;
                        label: "Quit";
                        selected: root.close-action-enabled && root.close-action == 0;
                        disabled: !root.close-action-enabled;
                        clicked => { root.close-action-changed(0); }
                    }
                    ChoiceChip {
                        horizontal-stretch: 1;
                        label: "Hide to tray";
                        selected: root.close-action-enabled && root.close-action == 1;
                        disabled: !root.close-action-enabled;
                        clicked => { root.close-action-changed(1); }
                    }
                }
            }
        }

        LocalStatus {
            text: root.local-status;
            accent: Palette.text-secondary;
        }

        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}
