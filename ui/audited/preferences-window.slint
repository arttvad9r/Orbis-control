import { SelectRow, ToggleRow, PreviewSliderRow, ChoiceChip } from "../components/visual-controls.slint";
import { WindowHeader, SectionCard, SectionTitle, ActionButton, LocalStatus } from "common.slint";
import { Palette, ThemeState, ThemeMode } from "../themes/dark.slint";

export component PreferencesWindow inherits Window {
    width: 580px;
    height: 550px;
    title: "Orbis Control — Preferences";
    background: Palette.window-background;

    callback theme-changed(bool);
    callback startup-changed(bool);

    property <int> language: 0; property <int> update-channel: 0; property <int> close-action: 0;
    in-out property <bool> startup: false; in-out property <bool> startup-enabled: false; property <bool> notifications: true; property <bool> update-check: true; property <bool> tray: true; property <bool> restore-window: true;
    property <float> telemetry-rate: 1; property <float> ui-scale: 100;
    in-out property <string> local-status: "Theme saves immediately · Run on startup wiring pending · other controls preview-only";

    function set-theme(light: bool) {
        ThemeState.mode = light ? ThemeMode.Light : ThemeMode.Dark;
        root.local-status = light ? "Light theme active · save requested" : "Dark theme active · save requested";
        root.theme-changed(light);
    }

    function reset-values() {
        root.language = 0; root.update-channel = 0; root.close-action = 0;
        root.notifications = true; root.update-check = true; root.tray = true; root.restore-window = true;
        root.telemetry-rate = 1; root.ui-scale = 100;
        root.set-theme(false);
        root.local-status = "Preferences reset locally · dark theme restored";
    }

    VerticalLayout {
        padding: 10px; spacing: 7px;
        WindowHeader { title: "Preferences"; subtitle: "Application behavior and presentation"; }
        LocalStatus { text: root.local-status; accent: Palette.warning; }
        HorizontalLayout { height: 190px; spacing: 10px;
            SectionCard {
                horizontal-stretch: 1;
                VerticalLayout { padding: 9px; spacing: 2px;
                    SectionTitle { title: "General"; }
                    SelectRow { label: "Language"; model: ["System", "English", "Русский", "Deutsch", "Français"]; current-index <=> root.language; }
                    Rectangle {
                        height: 36px; background: transparent;
                        HorizontalLayout { spacing: 8px; alignment: center;
                            Text { width: 138px; text: "Appearance"; font-size: 10px; font-weight: 500; color: Palette.text-primary; vertical-alignment: center; }
                            ChoiceChip { horizontal-stretch: 1; label: "Dark"; selected: ThemeState.mode == ThemeMode.Dark; clicked => { root.set-theme(false); } }
                            ChoiceChip { horizontal-stretch: 1; label: "Light"; selected: ThemeState.mode == ThemeMode.Light; clicked => { root.set-theme(true); } }
                        }
                    }
                    SelectRow { label: "Close button"; model: ["Hide to tray", "Quit", "Ask every time"]; current-index <=> root.close-action; }
                    ToggleRow { label: "Restore window position"; checked <=> root.restore-window; }
                }
            }
            SectionCard {
                horizontal-stretch: 1;
                VerticalLayout { padding: 9px; spacing: 1px;
                    SectionTitle { title: "Startup / notifications"; }
                    ToggleRow {
                        label: "Run on startup";
                        checked <=> root.startup;
                        disabled: !root.startup-enabled;
                        toggled(value) => { root.startup-changed(value); }
                    }
                    ToggleRow { label: "Desktop notifications"; checked <=> root.notifications; }
                    ToggleRow { label: "Tray indicator"; checked <=> root.tray; }
                    ToggleRow { label: "Automatic update checks"; checked <=> root.update-check; }
                }
            }
        }
        SectionCard {
            height: 168px;
            VerticalLayout { padding: 9px; spacing: 2px;
                SectionTitle { title: "Updates / sampling"; }
                SelectRow { label: "Update channel"; model: ["Stable", "Preview", "Development"]; current-index <=> root.update-channel; }
                PreviewSliderRow { label: "Telemetry refresh"; unit: " Hz"; minimum: 0.5; maximum: 5; step: 0.5; value <=> root.telemetry-rate; }
                PreviewSliderRow { label: "UI scale preview"; unit: "%"; minimum: 80; maximum: 160; step: 5; value <=> root.ui-scale; }
            }
        }
        Rectangle { vertical-stretch: 1; background: transparent; }
        HorizontalLayout { height: 28px; spacing: 6px;
            Rectangle { horizontal-stretch: 1; background: transparent; }
            ActionButton { width: 92px; label: "Reset"; clicked => { root.reset-values(); } }
            ActionButton { width: 92px; label: "Save"; accent: true; clicked => { root.local-status = "Other preferences remain preview-only · theme saves immediately"; } }
        }
    }
}