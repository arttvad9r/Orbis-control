import { ToggleRow, ChoiceChip } from "../components/visual-controls.slint";
import { WindowHeader, SectionCard, SectionTitle, LocalStatus } from "common.slint";
import { Palette, ThemeState, ThemeMode } from "../themes/dark.slint";

export component PreferencesWindow inherits Window {
    width: 452px;
    height: 286px;
    title: "Orbis Control — Preferences";
    background: Palette.window-background;

    callback theme-changed(bool);
    callback startup-changed(bool);

    in-out property <bool> startup: false;
    in-out property <bool> startup-enabled: false;
    in-out property <string> local-status: "Theme changes are saved immediately";

    function set-theme(light: bool) {
        ThemeState.mode = light ? ThemeMode.Light : ThemeMode.Dark;
        root.local-status = light ? "Light theme active" : "Dark theme active";
        root.theme-changed(light);
    }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        WindowHeader {
            title: "Preferences";
            subtitle: "Only settings backed by current runtime behavior are shown";
        }

        SectionCard {
            height: 88px;
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                SectionTitle { title: "Appearance"; detail: "Saved immediately"; }
                HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    Text {
                        width: 116px;
                        text: "Theme";
                        font-size: 10px;
                        font-weight: 550;
                        color: Palette.text-primary;
                        vertical-alignment: center;
                    }
                    ChoiceChip {
                        horizontal-stretch: 1;
                        label: "Dark";
                        selected: ThemeState.mode == ThemeMode.Dark;
                        clicked => { root.set-theme(false); }
                    }
                    ChoiceChip {
                        horizontal-stretch: 1;
                        label: "Light";
                        selected: ThemeState.mode == ThemeMode.Light;
                        clicked => { root.set-theme(true); }
                    }
                }
            }
        }

        SectionCard {
            height: 78px;
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                SectionTitle { title: "Startup"; }
                ToggleRow {
                    label: "Run on startup";
                    description: root.startup-enabled ? "Start Orbis with the user session" : "Not connected to runtime lifecycle yet";
                    checked <=> root.startup;
                    disabled: !root.startup-enabled;
                    toggled(value) => { root.startup-changed(value); }
                }
            }
        }

        LocalStatus {
            text: root.startup-enabled ? root.local-status : root.local-status + " · Startup remains unavailable";
            accent: root.startup-enabled ? Palette.success : Palette.text-secondary;
        }

        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}
