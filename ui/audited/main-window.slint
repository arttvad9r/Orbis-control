// AppWindow — G-Helper-style single window (spec docs/ui-reference.md):
// 425 logical wide, custom 34px title bar, top tab strip
// [Performance | Fans | Extra], flat panels on formBack. No sidebar.
import { UiState, Section, ChargeLimitState, GpuHwState, PerformanceHwState, GpuModeHwState, FanCurveHwState } from "model.slint";
import { TitleBar } from "../components/title-bar.slint";
import { PerformanceSection } from "sections/performance.slint";
import { FansSection } from "sections/fans.slint";
import { ExtraSection } from "sections/extra.slint";
import { Palette } from "../themes/dark.slint";

export component AppWindow inherits Window {
    width: 425px;
    height: 620px;
    no-frame: true;
    background: transparent;
    title: "Orbis Control";

    in-out property <UiState> ui-state: {
        perf-selected: 1, available-perf-mask: 0, perf-state: PerformanceHwState.Loading, perf-writable: false, perf-unavailable-reason: "",
        gpu-selected: 1, available-gpu-mask: 0, gpu-ultimate-pending: false, gpu-ultimate-disabled: false,
        gpu-section-error: false, gpu-mode-state: GpuModeHwState.Loading, gpu-mode-writable: false,
        gpu-queued: -1, gpu-reboot-required: false,
        charge-limit: 80, charge-limit-enabled: false, charge-limit-writable: false, charge-limit-unavailable-reason: "", charge-limit-state: ChargeLimitState.Loading,
        gpu-power-state: GpuHwState.Loading, gpu-mux-state: GpuHwState.Loading, gpu-access-state: GpuHwState.Loading,
        gpu-power-value: 0, gpu-mux-value: 0, gpu-access-value: 0,
        cpu-temp: "—", gpu-temp: "—", cpu-fan-rpm: "—", gpu-fan-rpm: "—",
        battery-percent: "—", power-ac-mw: "—", battery-health: "—", battery-cycles: "—",
        battery-status: "", ac-online: "—", gpu-power: "—", telemetry-fresh: false, version: "0.1.0", mock-profile: "zephyrus-full",
        fan-curve-state: FanCurveHwState.Loading, fan-curve-writable: false, fan-curve-unavailable-reason: "", fan-curve-error: false, fan-curve-dirty: false,
        fan-curve-enabled-known: false, fan-curve-enabled: false,
        fan-selected: 0, fan-profile-selected: 0,
        fan-temp-0: 0, fan-temp-1: 0, fan-temp-2: 0, fan-temp-3: 0, fan-temp-4: 0, fan-temp-5: 0, fan-temp-6: 0, fan-temp-7: 0,
        fan-pwm-0: 0, fan-pwm-1: 0, fan-pwm-2: 0, fan-pwm-3: 0, fan-pwm-4: 0, fan-pwm-5: 0, fan-pwm-6: 0, fan-pwm-7: 0,
    };

    in-out property <Section> active-section: Section.Performance;
    callback section-selected(Section);
    callback titlebar-minimize-requested;
    callback titlebar-close-requested;
    callback titlebar-drag-started;

    // Performance page surface.
    callback perf-clicked(int);
    callback gpu-clicked(int);
    callback charge-changed(float);
    in property <bool> display-state-ready: false;
    in property <bool> display-control-ready: false;
    in property <int> display-mode: -1;
    in property <string> display-status: "Unavailable";
    callback display-mode-requested(int);
    in property <bool> keyboard-state-ready: false;
    in property <bool> keyboard-control-ready: false;
    in property <int> keyboard-brightness: -1;
    callback keyboard-brightness-requested(int);
    callback startup-changed(bool);
    in-out property <bool> startup: false;
    in-out property <bool> startup-enabled: false;
    in property <string> startup-status: "Unavailable";
    callback quit-requested;

    // Fans page surface.
    in property <bool> mutation-safety-blocked: true;
    in property <bool> factory-reset-available: false;
    in property <string> policy-status: "Fan writes are safety-blocked";
    callback fan-changed(int);
    callback fan-profile-changed(int);
    callback fan-temp-point-changed(int, int);
    callback fan-pwm-point-changed(int, int);
    callback fan-apply-clicked(bool);

    // Extra page surface (hardware + app settings).
    in property <bool> backend-ready: false;
    in property <bool> applying: false;
    in property <string> status: "Advanced controls backend unavailable";
    in property <bool> aura-state-ready: false;
    in property <bool> panel-overdrive-state-ready: false;
    in property <bool> panel-overdrive-control-ready: false;
    in property <bool> boot-sound-state-ready: false;
    in-out property <int> m1-action: 0;
    in-out property <int> m2-action: 0;
    in-out property <int> m3-action: 0;
    in-out property <int> m4-action: 0;
    in-out property <int> m5-action: 0;
    in-out property <int> keyboard-effect: -1;
    in-out property <int> keyboard-speed: -1;
    in-out property <bool> boot-sound: false;
    in-out property <bool> status-led: false;
    in-out property <bool> panel-overdrive: false;
    in-out property <bool> auto-clamshell: false;
    in-out property <bool> disable-aspm: false;
    in-out property <bool> disable-standby-networking: false;
    in-out property <int> igpu-memory: 0;
    in-out property <int> hibernate-after: 0;
    in-out property <int> p-cores: 1;
    in-out property <int> e-cores: 0;
    callback reload-requested;
    callback apply-requested;
    callback panel-overdrive-requested(bool);
    callback theme-changed(bool);
    callback start-minimized-changed(bool);
    callback remember-position-changed(bool);
    callback close-action-changed(int);
    in property <bool> start-minimized: false;
    in property <bool> start-minimized-enabled: false;
    in property <bool> remember-position: false;
    in property <bool> remember-position-enabled: false;
    in property <int> close-action: 0;
    in property <bool> close-action-enabled: false;
    in property <bool> hide-to-tray-enabled: false;
    in-out property <bool> refresh-enabled: false;
    in property <bool> refresh-pending: false;
    in property <string> diagnostics-summary: "";
    in property <bool> export-enabled: false;
    in property <string> diagnostics-status: "Diagnostics unavailable · lifecycle wiring pending";
    callback diagnostics-refresh-requested;
    callback diagnostics-export-requested;
    in-out property <string> settings-local-status: "Theme changes are saved immediately";

    callback preview-dialog-clicked(int);

    root-rect := Rectangle {
        border-radius: 8px;
        clip: true;
        background: Palette.window-background;

        VerticalLayout {
            TitleBar {
                height: 34px;
                section-title: "Orbis Control";
                minimize-requested => { root.titlebar-minimize-requested(); }
                close-requested => { root.titlebar-close-requested(); }
                drag-started => { root.titlebar-drag-started(); }
            }

            // Tab strip (G-Helper: flat equal tabs, selected = buttonMain).
            HorizontalLayout {
                height: 36px;
                spacing: 2px;

                perf-tab := Rectangle {
                    horizontal-stretch: 1;
                    property <bool> is-active: root.active-section == Section.Performance;
                    property <bool> hover: perf-touch.has-hover;
                    background: perf-tab.is-active ? Palette.surface-default
                        : perf-tab.hover ? Palette.surface-hover : transparent;
                    border-radius: 5.5px;
                    Text {
                        text: "Performance";
                        font-size: 13px;
                        font-weight: perf-tab.is-active ? 650 : 500;
                        color: perf-tab.is-active ? Palette.text-primary : Palette.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    perf-touch := TouchArea {
                        clicked => {
                            root.active-section = Section.Performance;
                            root.section-selected(Section.Performance);
                        }
                    }
                }
                fans-tab := Rectangle {
                    horizontal-stretch: 1;
                    property <bool> is-active: root.active-section == Section.Fans;
                    property <bool> hover: fans-touch.has-hover;
                    background: perf-tab.is-active ? Palette.surface-default
                        : perf-tab.hover ? Palette.surface-hover : transparent;
                    border-radius: 5.5px;
                    Text {
                        text: "Fans";
                        font-size: 13px;
                        font-weight: fans-tab.is-active ? 650 : 500;
                        color: fans-tab.is-active ? Palette.text-primary : Palette.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    fans-touch := TouchArea {
                        clicked => {
                            root.active-section = Section.Fans;
                            root.section-selected(Section.Fans);
                        }
                    }
                }
                extra-tab := Rectangle {
                    horizontal-stretch: 1;
                    property <bool> is-active: root.active-section == Section.Extra;
                    property <bool> hover: extra-touch.has-hover;
                    background: perf-tab.is-active ? Palette.surface-default
                        : perf-tab.hover ? Palette.surface-hover : transparent;
                    border-radius: 5.5px;
                    Text {
                        text: "Extra";
                        font-size: 13px;
                        font-weight: extra-tab.is-active ? 650 : 500;
                        color: extra-tab.is-active ? Palette.text-primary : Palette.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    extra-touch := TouchArea {
                        clicked => {
                            root.active-section = Section.Extra;
                            root.section-selected(Section.Extra);
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                background: Palette.window-background;

                if (root.active-section == Section.Performance) : PerformanceSection {
                    ui-state <=> root.ui-state;
                    display-state-ready <=> root.display-state-ready;
                    display-control-ready <=> root.display-control-ready;
                    display-mode <=> root.display-mode;
                    display-status <=> root.display-status;
                    display-mode-requested(i) => { root.display-mode-requested(i); }
                    perf-clicked(i) => { root.perf-clicked(i); }
                    gpu-clicked(i) => { root.gpu-clicked(i); }
                    charge-changed(v) => { root.charge-changed(v); }
                    fans-open-requested => { root.active-section = Section.Fans; root.section-selected(Section.Fans); }
                    startup <=> root.startup;
                    startup-enabled <=> root.startup-enabled;
                    startup-status <=> root.startup-status;
                    startup-changed(v) => { root.startup-changed(v); }
                    version: root.ui-state.version;
                    quit-requested => { root.titlebar-close-requested(); }
                }
                if (root.active-section == Section.Fans) : FansSection {
                    ui-state <=> root.ui-state;
                    mutation-safety-blocked <=> root.mutation-safety-blocked;
                    factory-reset-available <=> root.factory-reset-available;
                    policy-status <=> root.policy-status;
                    fan-changed(i) => { root.fan-changed(i); }
                    fan-profile-changed(i) => { root.fan-profile-changed(i); }
                    fan-temp-point-changed(i, v) => { root.fan-temp-point-changed(i, v); }
                    fan-pwm-point-changed(i, v) => { root.fan-pwm-point-changed(i, v); }
                    fan-apply-clicked(reset) => { root.fan-apply-clicked(reset); }
                }
                if (root.active-section == Section.Extra) : ExtraSection {
                    backend-ready <=> root.backend-ready;
                    applying <=> root.applying;
                    status <=> root.status;
                    keyboard-state-ready <=> root.keyboard-state-ready;
                    keyboard-control-ready <=> root.keyboard-control-ready;
                    keyboard-brightness <=> root.keyboard-brightness;
                    keyboard-brightness-requested(i) => { root.keyboard-brightness-requested(i); }
                    aura-state-ready <=> root.aura-state-ready;
                    panel-overdrive-state-ready <=> root.panel-overdrive-state-ready;
                    panel-overdrive-control-ready <=> root.panel-overdrive-control-ready;
                    boot-sound-state-ready <=> root.boot-sound-state-ready;
                    m1-action <=> root.m1-action;
                    m2-action <=> root.m2-action;
                    m3-action <=> root.m3-action;
                    m4-action <=> root.m4-action;
                    m5-action <=> root.m5-action;
                    keyboard-effect <=> root.keyboard-effect;
                    keyboard-speed <=> root.keyboard-speed;
                    boot-sound <=> root.boot-sound;
                    status-led <=> root.status-led;
                    panel-overdrive <=> root.panel-overdrive;
                    auto-clamshell <=> root.auto-clamshell;
                    disable-aspm <=> root.disable-aspm;
                    disable-standby-networking <=> root.disable-standby-networking;
                    igpu-memory <=> root.igpu-memory;
                    hibernate-after <=> root.hibernate-after;
                    p-cores <=> root.p-cores;
                    e-cores <=> root.e-cores;
                    reload-requested => { root.reload-requested(); }
                    apply-requested => { root.apply-requested(); }
                    panel-overdrive-requested(v) => { root.panel-overdrive-requested(v); }
                    theme-changed(light) => { root.theme-changed(light); }
                    start-minimized <=> root.start-minimized;
                    start-minimized-enabled <=> root.start-minimized-enabled;
                    start-minimized-changed(v) => { root.start-minimized-changed(v); }
                    remember-position <=> root.remember-position;
                    remember-position-enabled <=> root.remember-position-enabled;
                    remember-position-changed(v) => { root.remember-position-changed(v); }
                    close-action <=> root.close-action;
                    close-action-enabled <=> root.close-action-enabled;
                    hide-to-tray-enabled <=> root.hide-to-tray-enabled;
                    close-action-changed(v) => { root.close-action-changed(v); }
                    refresh-enabled <=> root.refresh-enabled;
                    refresh-pending <=> root.refresh-pending;
                    diagnostics-summary <=> root.diagnostics-summary;
                    export-enabled <=> root.export-enabled;
                    diagnostics-status <=> root.diagnostics-status;
                    diagnostics-refresh-requested => { root.diagnostics-refresh-requested(); }
                    diagnostics-export-requested => { root.diagnostics-export-requested(); }
                    settings-local-status <=> root.settings-local-status;
                }
            }
        }
    }
}
