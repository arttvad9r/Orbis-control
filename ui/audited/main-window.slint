// Orbis Control single-window shell. The shell owns product navigation and
// stable window geometry; hardware state remains in UiState and backend-owned
// callbacks keep their existing semantics.
import { UiState, NvidiaRow, Section, ChargeLimitState, GpuHwState, PerformanceHwState, GpuModeHwState, FanCurveHwState, ClamshellState } from "model.slint";
import { TitleBar } from "../components/title-bar.slint";
import { NavItem } from "../components/nav-item.slint";
import { Icons } from "../components/icon.slint";
import { ThemeBridge, LayoutMetrics } from "common.slint";
import { Palette } from "../themes/dark.slint";
import { DashboardSection } from "sections/dashboard.slint";
import { PerformanceSection } from "sections/performance.slint";
import { PowerSection } from "sections/power.slint";
import { CoolingSection } from "sections/cooling.slint";
import { GraphicsSection } from "sections/graphics.slint";
import { BacklightSection } from "sections/backlight.slint";
import { DisplaySection } from "sections/display.slint";
import { SystemSection } from "sections/system.slint";
import { SettingsSection } from "sections/settings.slint";
import { AboutSection } from "sections/about.slint";

export component AppWindow inherits Window {
    // Window size contract (user decision): 980x680 minimum, 1200x800 comfort.
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 980px;
    min-height: 680px;
    no-frame: true;
    background: transparent;
    title: "Orbis Control";

    in-out property <UiState> ui-state: {
        perf-selected: 1, available-perf-mask: 0, perf-state: PerformanceHwState.Loading, perf-writable: false, perf-unavailable-reason: "",
        gpu-selected: 1, available-gpu-mask: 0, gpu-ultimate-pending: false, gpu-ultimate-disabled: false,
        gpu-section-error: false, gpu-mode-state: GpuModeHwState.Loading, gpu-mode-writable: false, gpu-mode-pending: false, gpu-mode-unconfirmed: false,
        gpu-queued: -1, gpu-reboot-required: false,
        charge-limit: 80, charge-limit-enabled: false, charge-limit-writable: false, charge-limit-unavailable-reason: "", charge-limit-state: ChargeLimitState.Loading, charge-limit-pending: false, charge-limit-unconfirmed: false, charge-limit-error: "",
        gpu-power-state: GpuHwState.Loading, gpu-mux-state: GpuHwState.Loading, gpu-access-state: GpuHwState.Loading,
        gpu-power-value: 0, gpu-mux-value: 0, gpu-access-value: 0,
        cpu-temp: "—", gpu-temp: "—", cpu-fan-rpm: "—", gpu-fan-rpm: "—",
        battery-percent: "—", power-ac-mw: "—", battery-health: "—", battery-cycles: "—",
        battery-status: "", ac-online: "—", gpu-power: "—", telemetry-fresh: false, version: "0.1.0", mock-profile: "zephyrus-full",
        fan-curve-state: FanCurveHwState.Loading, fan-curve-writable: false, fan-curve-unavailable-reason: "", fan-curve-error: false, fan-curve-pending: false, fan-curve-unconfirmed: false, fan-curve-dirty: false,
        fan-curve-enabled-known: false, fan-curve-enabled: false,
        fan-selected: 0, fan-profile-selected: 0,
        fan-temp-0: 0, fan-temp-1: 0, fan-temp-2: 0, fan-temp-3: 0, fan-temp-4: 0, fan-temp-5: 0, fan-temp-6: 0, fan-temp-7: 0,
        fan-pwm-0: 0, fan-pwm-1: 0, fan-pwm-2: 0, fan-pwm-3: 0, fan-pwm-4: 0, fan-pwm-5: 0, fan-pwm-6: 0, fan-pwm-7: 0,
    };

    in property <string> device-name: "";
    in property <bool> fan-eco-profile-available: false;
    in property <string> device-board: "";
    in property <string> bios-version: "";
    in property <string> bios-date: "";
    in property <string> cpu-model: "";
    in property <string> cpu-detail: "";
    in property <string> memory-total: "";
    in property <string> kernel-release: "";
    in property <string> gpu-model: "";
    // Telemetry history rendered by the runtime (white SVG, tinted in UI).
    in property <image> cpu-temp-spark;
    in property <image> gpu-temp-spark;
    in property <image> battery-spark;
    in property <image> power-spark;
    in property <image> cpu-fan-spark;
    in property <image> gpu-fan-spark;
    in property <float> cpu-fan-level: -1;
    in property <int> battery-health-value: -1;
    in property <float> gpu-fan-level: -1;
    in property <image> cpu-temp-chart;
    in property <image> gpu-temp-chart;
    in property <string> history-span: "";

    in-out property <Section> active-section: Section.Dashboard;
    callback section-selected(Section);
    callback titlebar-minimize-requested;
    callback titlebar-maximize-requested;
    callback titlebar-close-requested;
    callback titlebar-drag-started;
    in property <bool> maximized: false;

    callback perf-clicked(int);
    callback gpu-clicked(int);
    in property <bool> gpu-optimized: false;
    callback gpu-optimized-requested(bool);
    in property <bool> nvidia-visible: false;
    in property <bool> nvidia-writable: false;
    in property <string> nvidia-status: "";
    in property <string> nvidia-error: "";
    in property <[NvidiaRow]> nvidia-rows: [];
    callback nvidia-tuning-requested(int, int);
    callback charge-changed(float);
    in property <bool> display-state-ready: false;
    in property <string> display-status: "Недоступно";
    in property <string> display-resolution: "";
    in property <bool> keyboard-state-ready: false;
    in property <bool> keyboard-control-ready: false;
    in property <int> keyboard-brightness: -1;
    in property <string> keyboard-mutation-error: "";
    callback keyboard-brightness-requested(int);
    callback startup-changed(bool);
    in-out property <bool> startup: false;
    in-out property <bool> startup-enabled: false;
    in property <string> startup-status: "Недоступно";
    callback quit-requested;

    in property <bool> mutation-safety-blocked: false;
    in property <bool> factory-reset-available: true;
    in property <string> policy-status: "Кривая применяется через Hardware1 с read-back";
    callback fan-changed(int);
    callback fan-profile-changed(int);
    callback fan-selection-discarded(int, int);
    callback fan-temp-point-changed(int, int);
    callback fan-pwm-point-changed(int, int);
    callback fan-apply-clicked(bool);
    callback power-limit-changed(int, int);
    callback power-limit-apply-clicked;
    in property <bool> profile-limits-known: false;
    in property <bool> profile-limits-auto-apply: false;
    in property <string> profile-limits-summary: "";
    callback profile-limits-auto-apply-toggled(bool);
    in property <bool> cpu-tuning-ready: false;
    in property <int> cpu-epp: 0;
    in property <bool> cpu-epp-supported: false;
    in property <bool> cpu-epp-writable: false;
    in property <bool> cpu-boost-known: false;
    in property <bool> cpu-boost: false;
    in property <bool> cpu-boost-writable: false;
    in property <string> cpu-tuning-error: "";
    callback cpu-epp-requested(int);
    callback cpu-boost-requested(bool);
    in property <bool> cpu-co-supported: false;
    in property <bool> cpu-co-writable: false;
    in property <bool> cpu-co-applied-known: false;
    in property <int> cpu-co-applied: 0;
    callback cpu-co-requested(int);
    in property <bool> power-rules-known: false;
    in property <bool> power-rules-enabled: false;
    in property <int> power-rules-ac: 0;
    in property <int> power-rules-battery: 0;
    in property <string> power-rules-error: "";
    callback power-rules-enabled-toggled(bool);
    callback power-rules-profile-requested(bool, int);
    in property <bool> panel-refresh-known: false;
    in property <[int]> panel-refresh-rates: [];
    in property <int> panel-refresh-current: 0;
    in property <string> panel-refresh-error: "";
    in property <int> power-rules-ac-hz: 0;
    in property <int> power-rules-battery-hz: 0;
    callback panel-refresh-requested(int);
    callback power-rules-refresh-requested(bool, int);
    in property <int> keyboard-timeout-ac: 0;
    in property <int> keyboard-timeout-battery: 0;
    in property <string> keyboard-timeout-status: "";
    in property <bool> keyboard-timeout-problem: false;
    callback keyboard-timeout-requested(bool, int);
    in property <bool> panel-brightness-known: false;
    in property <int> panel-brightness: 0;
    in property <string> panel-brightness-error: "";
    callback panel-brightness-requested(int);
    in property <string> update-status: "";
    in property <bool> update-problem: false;
    in property <bool> update-busy: false;
    callback update-check-requested();
    callback aura-static-rgb-requested(int, int, int);

    in property <bool> backend-ready: false;
    in property <bool> applying: false;
    in property <string> status: "Расширенные функции недоступны";
    in property <bool> aura-state-ready: false;
    in property <bool> aura-control-ready: false;
    in property <bool> panel-overdrive-state-ready: false;
    in property <bool> panel-overdrive-control-ready: false;
    in property <bool> boot-sound-state-ready: false;
    in property <bool> boot-sound-control-ready: false;
    in property <bool> igpu-memory-state-ready: false;
    in property <bool> igpu-memory-control-ready: false;
    in property <bool> igpu-memory-pending: false;
    in property <bool> status-led-state-ready: false;
    in property <bool> status-led-control-ready: false;
    in property <ClamshellState> auto-clamshell-state: ClamshellState.Loading;
    in property <string> lid-other-handler: "";
    in property <bool> standby-networking-control-ready: false;
    in property <bool> hibernate-control-ready: false;
    in property <bool> core-count-control-ready: false;
    in property <bool> binding-control-ready: false;
    in property <bool> advanced-apply-ready: false;
    in property <bool> aspm-state-ready: false;
    in property <bool> aspm-control-ready: false;
    in-out property <int> m1-action: 0;
    in-out property <int> m2-action: 0;
    in-out property <int> m3-action: 0;
    in-out property <int> m4-action: 0;
    in-out property <int> m5-action: 0;
    in-out property <int> keyboard-effect: -1;
    in-out property <int> keyboard-speed: -1;
    in-out property <int> rgb-red: 255;
    in-out property <int> rgb-green: 65;
    in-out property <int> rgb-blue: 77;
    in property <bool> aura-static-supported: false;
    in property <bool> aura-breathe-supported: false;
    in property <bool> aura-rainbow-supported: false;
    in property <bool> aura-rainbow-wave-supported: false;
    in property <bool> aura-star-supported: false;
    in property <bool> aura-rain-supported: false;
    in property <bool> aura-highlight-supported: false;
    in property <bool> aura-laser-supported: false;
    in property <bool> aura-ripple-supported: false;
    in property <bool> aura-pulse-supported: false;
    in property <bool> aura-comet-supported: false;
    in property <bool> aura-flash-supported: false;
    in-out property <int> aura-secondary-red: 0;
    in-out property <int> aura-secondary-green: 0;
    in-out property <int> aura-secondary-blue: 0;
    in-out property <bool> boot-sound: false;
    in-out property <bool> status-led: false;
    in-out property <bool> panel-overdrive: false;
    in-out property <bool> disable-aspm: false;
    in-out property <bool> disable-standby-networking: false;
    in-out property <int> igpu-memory: 0;
    in-out property <int> hibernate-after: 0;
    in-out property <int> p-cores: 1;
    in-out property <int> e-cores: 0;
    callback reload-requested;
    callback boot-sound-requested(bool);
    callback igpu-memory-requested(int);
    callback apply-requested;
    callback panel-overdrive-requested(bool);
    callback aspm-requested(bool);
    callback auto-clamshell-requested(bool);
    callback theme-changed(bool);
    callback aura-effect-requested(int, int, int, int, int, int, int, int);
    callback start-minimized-changed(bool);
    callback remember-position-changed(bool);
    callback close-action-changed(int);
    in property <bool> start-minimized: false;
    in property <bool> start-minimized-enabled: false;
    in property <bool> remember-position: false;
    in property <bool> remember-position-enabled: false;
    in property <int> close-action: 0;
    in property <bool> close-action-enabled: false;
    in property <bool> hide-to-tray-enabled: false;
    in-out property <bool> refresh-enabled: false;
    in property <bool> refresh-pending: false;
    in property <string> diagnostics-summary: "";
    in property <bool> export-enabled: false;
    in property <string> diagnostics-status: "Диагностика недоступна · подключение ещё не готово";
    callback diagnostics-refresh-requested;
    callback diagnostics-export-requested;
    in-out property <string> settings-local-status: "Изменения темы сохраняются сразу";

    callback preview-dialog-clicked(int);

    ThemeBridge { }

    function open-section(section: Section) {
        root.active-section = section;
        root.section-selected(section);
    }

    root-rect := Rectangle {
        border-radius: 14px;
        border-width: 1px;
        border-color: Palette.border-default;
        clip: true;
        background: Palette.titlebar-background;

        VerticalLayout {
            TitleBar {
                maximized: root.maximized;
                minimize-requested => { root.titlebar-minimize-requested(); }
                maximize-requested => { root.titlebar-maximize-requested(); }
                close-requested => { root.titlebar-close-requested(); }
                drag-started => { root.titlebar-drag-started(); }
            }

            HorizontalLayout {
                vertical-stretch: 1;

                Rectangle {
                    width: LayoutMetrics.sidebar-width;
                    background: transparent;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 4px;
                        padding-bottom: 14px;
                        spacing: 3px;

                        NavItem {
                            label: "Главная";
                            sublabel: "Обзор и быстрые действия";
                            icon-kind: Icons.home;
                            selected: root.active-section == Section.Dashboard;
                            clicked => { root.open-section(Section.Dashboard); }
                        }


                        NavItem {
                            label: "Производительность";
                            sublabel: "Профили и лимиты мощности";
                            icon-kind: Icons.gauge;
                            selected: root.active-section == Section.Performance;
                            clicked => { root.open-section(Section.Performance); }
                        }
                        NavItem {
                            label: "Питание";
                            sublabel: "Заряд и здоровье батареи";
                            icon-kind: Icons.battery;
                            selected: root.active-section == Section.Power;
                            clicked => { root.open-section(Section.Power); }
                        }
                        NavItem {
                            label: "Охлаждение";
                            sublabel: "Кривые вентиляторов";
                            icon-kind: Icons.fan;
                            selected: root.active-section == Section.Cooling;
                            clicked => { root.open-section(Section.Cooling); }
                        }
                        NavItem {
                            label: "Графика";
                            sublabel: "Режим GPU, MUX и NVIDIA";
                            icon-kind: Icons.gpu;
                            selected: root.active-section == Section.Graphics;
                            clicked => { root.open-section(Section.Graphics); }
                        }
                        NavItem {
                            label: "Подсветка";
                            sublabel: "Клавиатура, эффекты Aura";
                            icon-kind: Icons.keyboard;
                            selected: root.active-section == Section.Backlight;
                            clicked => { root.open-section(Section.Backlight); }
                        }
                        NavItem {
                            label: "Экран";
                            sublabel: "Яркость, частота, Overdrive";
                            icon-kind: Icons.monitor;
                            selected: root.active-section == Section.Display;
                            clicked => { root.open-section(Section.Display); }
                        }
                        NavItem {
                            label: "Система";
                            sublabel: "Устройство, BIOS, диагностика";
                            icon-kind: Icons.cog;
                            selected: root.active-section == Section.System;
                            clicked => { root.open-section(Section.System); }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }
                        NavItem {
                            label: "Настройки";
                            sublabel: "Внешний вид и автозапуск";
                            icon-kind: Icons.sliders;
                            selected: root.active-section == Section.Settings;
                            clicked => { root.open-section(Section.Settings); }
                        }
                        NavItem {
                            label: "О программе";
                            sublabel: "Версия и обновления";
                            icon-kind: Icons.info;
                            selected: root.active-section == Section.About;
                            clicked => { root.open-section(Section.About); }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    border-top-left-radius: 18px;
                    border-width: 1px;
                    border-color: Palette.border-default;
                    background: @linear-gradient(170deg, Palette.window-background.brighter(0.08) 0%, Palette.window-background 45%, Palette.window-background.darker(0.1) 100%);

                    if (root.active-section == Section.Dashboard) : DashboardSection {
                        ui-state <=> root.ui-state;
                        device-name: root.device-name;
                        device-board: root.device-board;
                        keyboard-state-ready <=> root.keyboard-state-ready;
                        keyboard-control-ready <=> root.keyboard-control-ready;
                        keyboard-brightness <=> root.keyboard-brightness;
                        keyboard-mutation-error <=> root.keyboard-mutation-error;
                        keyboard-brightness-requested(i) => { root.keyboard-brightness-requested(i); }
                        perf-clicked(i) => { root.perf-clicked(i); }
                        charge-changed(v) => { root.charge-changed(v); }
                        cooling-open-requested => { root.open-section(Section.Cooling); }
                        display-open-requested => { root.open-section(Section.Display); }
                        cpu-model: root.cpu-model;
                        cpu-detail: root.cpu-detail;
                        memory-total: root.memory-total;
                        kernel-release: root.kernel-release;
                        gpu-model: root.gpu-model;
                        cpu-temp-spark: root.cpu-temp-spark;
                        gpu-temp-spark: root.gpu-temp-spark;
                        battery-spark: root.battery-spark;
                        power-spark: root.power-spark;
                        cpu-fan-spark: root.cpu-fan-spark;
                        gpu-fan-spark: root.gpu-fan-spark;
                        cpu-fan-level: root.cpu-fan-level;
                        gpu-fan-level: root.gpu-fan-level;
                        display-status: root.display-status;
                        display-resolution: root.display-resolution;
                        display-state-ready: root.display-state-ready;
                        panel-refresh-known: root.panel-refresh-known;
                        panel-refresh-current: root.panel-refresh-current;
                        panel-overdrive-state-ready: root.panel-overdrive-state-ready;
                        panel-overdrive: root.panel-overdrive;
                    }
                    if (root.active-section == Section.Performance) : PerformanceSection {
                        ui-state <=> root.ui-state;
                        perf-clicked(i) => { root.perf-clicked(i); }
                        power-limit-changed(f, v) => { root.power-limit-changed(f, v); }
                        power-limit-apply-clicked => { root.power-limit-apply-clicked(); }
                        profile-limits-known: root.profile-limits-known;
                        profile-limits-auto-apply: root.profile-limits-auto-apply;
                        profile-limits-summary: root.profile-limits-summary;
                        profile-limits-auto-apply-toggled(v) => { root.profile-limits-auto-apply-toggled(v); }
                        cpu-tuning-ready: root.cpu-tuning-ready;
                        cpu-epp: root.cpu-epp;
                        cpu-epp-supported: root.cpu-epp-supported;
                        cpu-epp-writable: root.cpu-epp-writable;
                        cpu-boost-known: root.cpu-boost-known;
                        cpu-boost: root.cpu-boost;
                        cpu-boost-writable: root.cpu-boost-writable;
                        cpu-tuning-error: root.cpu-tuning-error;
                        cpu-epp-requested(v) => { root.cpu-epp-requested(v); }
                        cpu-boost-requested(v) => { root.cpu-boost-requested(v); }
                        cpu-co-supported: root.cpu-co-supported;
                        cpu-co-writable: root.cpu-co-writable;
                        cpu-co-applied-known: root.cpu-co-applied-known;
                        cpu-co-applied: root.cpu-co-applied;
                        cpu-co-requested(v) => { root.cpu-co-requested(v); }
                        power-rules-known: root.power-rules-known;
                        power-rules-enabled: root.power-rules-enabled;
                        power-rules-ac: root.power-rules-ac;
                        power-rules-battery: root.power-rules-battery;
                        power-rules-error: root.power-rules-error;
                        power-rules-enabled-toggled(v) => { root.power-rules-enabled-toggled(v); }
                        power-rules-profile-requested(ac, p) => { root.power-rules-profile-requested(ac, p); }
                        graphics-open-requested => { root.open-section(Section.Graphics); }
                        cpu-temp-chart: root.cpu-temp-chart;
                        gpu-temp-chart: root.gpu-temp-chart;
                        history-span: root.history-span;
                    }
                    if (root.active-section == Section.Power) : PowerSection {
                        ui-state <=> root.ui-state;
                        battery-spark: root.battery-spark;
                        battery-health-value: root.battery-health-value;
                        charge-changed(v) => { root.charge-changed(v); }
                    }
                    if (root.active-section == Section.Cooling) : CoolingSection {
                        ui-state <=> root.ui-state;
                        mutation-safety-blocked <=> root.mutation-safety-blocked;
                        factory-reset-available <=> root.factory-reset-available;
                        fan-eco-profile-available: root.fan-eco-profile-available;
                        policy-status <=> root.policy-status;
                        fan-changed(i) => { root.fan-changed(i); }
                        fan-profile-changed(i) => { root.fan-profile-changed(i); }
                        fan-temp-point-changed(i, v) => { root.fan-temp-point-changed(i, v); }
                        fan-pwm-point-changed(i, v) => { root.fan-pwm-point-changed(i, v); }
                        fan-apply-clicked(reset) => { root.fan-apply-clicked(reset); }
                    }
                    if (root.active-section == Section.Graphics) : GraphicsSection {
                        ui-state <=> root.ui-state;
                        gpu-optimized: root.gpu-optimized;
                        gpu-clicked(i) => { root.gpu-clicked(i); }
                        gpu-optimized-requested(on) => { root.gpu-optimized-requested(on); }
                        nvidia-visible: root.nvidia-visible;
                        nvidia-writable: root.nvidia-writable;
                        nvidia-status: root.nvidia-status;
                        nvidia-error: root.nvidia-error;
                        nvidia-rows: root.nvidia-rows;
                        nvidia-tuning-requested(f, v) => { root.nvidia-tuning-requested(f, v); }
                    }
                    if (root.active-section == Section.Backlight) : BacklightSection {
                        keyboard-state-ready <=> root.keyboard-state-ready;
                        keyboard-control-ready <=> root.keyboard-control-ready;
                        keyboard-brightness <=> root.keyboard-brightness;
                        keyboard-mutation-error <=> root.keyboard-mutation-error;
                        keyboard-brightness-requested(i) => { root.keyboard-brightness-requested(i); }
                        keyboard-timeout-ac: root.keyboard-timeout-ac;
                        keyboard-timeout-battery: root.keyboard-timeout-battery;
                        keyboard-timeout-status: root.keyboard-timeout-status;
                        keyboard-timeout-problem: root.keyboard-timeout-problem;
                        keyboard-timeout-requested(ac, secs) => { root.keyboard-timeout-requested(ac, secs); }
                        aura-state-ready <=> root.aura-state-ready;
                        aura-control-ready <=> root.aura-control-ready;
                        keyboard-effect <=> root.keyboard-effect;
                        keyboard-speed <=> root.keyboard-speed;
                        rgb-red <=> root.rgb-red;
                        rgb-green <=> root.rgb-green;
                        rgb-blue <=> root.rgb-blue;
                        aura-static-supported <=> root.aura-static-supported;
                        aura-breathe-supported <=> root.aura-breathe-supported;
                        aura-rainbow-supported <=> root.aura-rainbow-supported;
                        aura-rainbow-wave-supported <=> root.aura-rainbow-wave-supported;
                        aura-star-supported <=> root.aura-star-supported;
                        aura-rain-supported <=> root.aura-rain-supported;
                        aura-highlight-supported <=> root.aura-highlight-supported;
                        aura-laser-supported <=> root.aura-laser-supported;
                        aura-ripple-supported <=> root.aura-ripple-supported;
                        aura-pulse-supported <=> root.aura-pulse-supported;
                        aura-comet-supported <=> root.aura-comet-supported;
                        aura-flash-supported <=> root.aura-flash-supported;
                        aura-secondary-red <=> root.aura-secondary-red;
                        aura-secondary-green <=> root.aura-secondary-green;
                        aura-secondary-blue <=> root.aura-secondary-blue;
                        aura-effect-requested(a, b, c, d, e, f, g, h) => { root.aura-effect-requested(a, b, c, d, e, f, g, h); }
                        aura-static-rgb-requested(a, b, c) => { root.aura-static-rgb-requested(a, b, c); }
                    }
                    if (root.active-section == Section.Display) : DisplaySection {
                        display-state-ready <=> root.display-state-ready;
                        display-status <=> root.display-status;
                        device-name: root.device-name;
                        display-resolution: root.display-resolution;
                        panel-overdrive-state-ready <=> root.panel-overdrive-state-ready;
                        panel-overdrive-control-ready <=> root.panel-overdrive-control-ready;
                        panel-overdrive <=> root.panel-overdrive;
                        applying <=> root.applying;
                        panel-overdrive-requested(v) => { root.panel-overdrive-requested(v); }
                        panel-refresh-known: root.panel-refresh-known;
                        panel-refresh-rates: root.panel-refresh-rates;
                        panel-refresh-current: root.panel-refresh-current;
                        panel-refresh-error: root.panel-refresh-error;
                        power-rules-enabled: root.power-rules-known && root.power-rules-enabled;
                        power-rules-ac-hz: root.power-rules-ac-hz;
                        power-rules-battery-hz: root.power-rules-battery-hz;
                        panel-brightness-known: root.panel-brightness-known;
                        panel-brightness: root.panel-brightness;
                        panel-brightness-error: root.panel-brightness-error;
                        panel-brightness-requested(v) => { root.panel-brightness-requested(v); }
                        panel-refresh-requested(hz) => { root.panel-refresh-requested(hz); }
                        power-rules-refresh-requested(ac, hz) => { root.power-rules-refresh-requested(ac, hz); }
                    }
                    if (root.active-section == Section.System) : SystemSection {
                        ui-state <=> root.ui-state;
                        device-name: root.device-name;
                        device-board: root.device-board;
                        bios-version: root.bios-version;
                        bios-date: root.bios-date;
                        cpu-model: root.cpu-model;
                        cpu-detail: root.cpu-detail;
                        memory-total: root.memory-total;
                        kernel-release: root.kernel-release;
                        gpu-model: root.gpu-model;
                        backend-ready <=> root.backend-ready;
                        applying <=> root.applying;
                        status <=> root.status;
                        boot-sound-state-ready <=> root.boot-sound-state-ready;
                        boot-sound-control-ready <=> root.boot-sound-control-ready;
                        boot-sound <=> root.boot-sound;
                        igpu-memory-state-ready <=> root.igpu-memory-state-ready;
                        igpu-memory-control-ready <=> root.igpu-memory-control-ready;
                        igpu-memory-pending <=> root.igpu-memory-pending;
                        status-led-state-ready <=> root.status-led-state-ready;
                        status-led-control-ready <=> root.status-led-control-ready;
                        auto-clamshell-state <=> root.auto-clamshell-state;
                        lid-other-handler <=> root.lid-other-handler;
                        standby-networking-control-ready <=> root.standby-networking-control-ready;
                        hibernate-control-ready <=> root.hibernate-control-ready;
                        core-count-control-ready <=> root.core-count-control-ready;
                        binding-control-ready <=> root.binding-control-ready;
                        advanced-apply-ready <=> root.advanced-apply-ready;
                        aspm-state-ready <=> root.aspm-state-ready;
                        aspm-control-ready <=> root.aspm-control-ready;
                        m1-action <=> root.m1-action;
                        m2-action <=> root.m2-action;
                        m3-action <=> root.m3-action;
                        m4-action <=> root.m4-action;
                        m5-action <=> root.m5-action;
                        status-led <=> root.status-led;
                        disable-aspm <=> root.disable-aspm;
                        disable-standby-networking <=> root.disable-standby-networking;
                        igpu-memory <=> root.igpu-memory;
                        hibernate-after <=> root.hibernate-after;
                        p-cores <=> root.p-cores;
                        e-cores <=> root.e-cores;
                        reload-requested => { root.reload-requested(); }
                        boot-sound-requested(v) => { root.boot-sound-requested(v); }
                        igpu-memory-requested(v) => { root.igpu-memory-requested(v); }
                        apply-requested => { root.apply-requested(); }
                        aspm-requested(v) => { root.aspm-requested(v); }
                        auto-clamshell-requested(v) => { root.auto-clamshell-requested(v); }
                        diagnostics-summary <=> root.diagnostics-summary;
                        refresh-enabled <=> root.refresh-enabled;
                        refresh-pending <=> root.refresh-pending;
                        export-enabled <=> root.export-enabled;
                        diagnostics-status <=> root.diagnostics-status;
                        diagnostics-refresh-requested => { root.diagnostics-refresh-requested(); }
                        diagnostics-export-requested => { root.diagnostics-export-requested(); }
                    }
                    if (root.active-section == Section.Settings) : SettingsSection {
                        theme-changed(light) => { root.theme-changed(light); }
                        startup <=> root.startup;
                        startup-enabled <=> root.startup-enabled;
                        startup-status <=> root.startup-status;
                        startup-changed(v) => { root.startup-changed(v); }
                        start-minimized <=> root.start-minimized;
                        start-minimized-enabled <=> root.start-minimized-enabled;
                        start-minimized-changed(v) => { root.start-minimized-changed(v); }
                        remember-position <=> root.remember-position;
                        remember-position-enabled <=> root.remember-position-enabled;
                        remember-position-changed(v) => { root.remember-position-changed(v); }
                        close-action <=> root.close-action;
                        close-action-enabled <=> root.close-action-enabled;
                        hide-to-tray-enabled <=> root.hide-to-tray-enabled;
                        close-action-changed(v) => { root.close-action-changed(v); }
                        settings-local-status <=> root.settings-local-status;
                        quit-requested => { root.titlebar-close-requested(); }
                    }
                    if (root.active-section == Section.About) : AboutSection {
                        version: root.ui-state.version;
                        update-status: root.update-status;
                        update-problem: root.update-problem;
                        update-busy: root.update-busy;
                        update-check-requested => { root.update-check-requested(); }
                    }
                }
            }
        }
    }
}
