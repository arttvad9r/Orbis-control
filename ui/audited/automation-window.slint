import { ComboBox } from "std-widgets.slint";
import { ToggleRow } from "../components/visual-controls.slint";
import { ThemeBridge, WindowHeader, SectionCard, SectionTitle, ActionButton, LocalStatus } from "common.slint";
import { Palette } from "../themes/dark.slint";

component PolicyRow inherits Rectangle {
    in property <string> label;
    in property <[string]> model;
    in property <int> current-index: 0;
    in property <bool> disabled: false;
    callback changed(int);

    height: 34px;
    background: transparent;

    HorizontalLayout {
        spacing: 8px;
        alignment: center;
        Text {
            width: 84px;
            text: root.label;
            font-size: 10px;
            font-weight: 550;
            color: root.disabled ? Palette.text-disabled : Palette.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
        ComboBox {
            horizontal-stretch: 1;
            enabled: !root.disabled;
            model: root.model;
            current-index: root.current-index;
            selected(_) => { root.changed(self.current-index); }
        }
    }
}

export component AutomationWindow inherits Window {
    width: 620px;
    height: 548px;
    title: "Orbis Control — Automation";
    background: Palette.window-background;

    // All values are backend-owned. Selection callbacks update the backend-side
    // draft only; Save is the explicit persistence boundary.
    in property <bool> backend-ready: false;
    in property <bool> saving: false;
    in property <bool> enabled: false;
    in property <int> ac-profile: 3;
    in property <int> battery-profile: 3;
    in property <int> ac-gpu: 3;
    in property <int> battery-gpu: 3;
    in property <int> ac-display: 3;
    in property <int> battery-display: 3;
    in property <int> ac-lighting: 3;
    in property <int> battery-lighting: 3;
    in property <bool> on-resume: false;
    in property <bool> on-ac-change: false;
    in property <bool> reconcile-only: true;
    in property <bool> notify-transitions: false;
    in property <string> status: "Automation backend unavailable";

    callback enabled-requested(bool);
    callback ac-profile-requested(int);
    callback battery-profile-requested(int);
    callback ac-gpu-requested(int);
    callback battery-gpu-requested(int);
    callback ac-display-requested(int);
    callback battery-display-requested(int);
    callback ac-lighting-requested(int);
    callback battery-lighting-requested(int);
    callback on-resume-requested(bool);
    callback on-ac-change-requested(bool);
    callback reconcile-only-requested(bool);
    callback notify-transitions-requested(bool);
    callback reset-requested;
    callback save-requested;

    ThemeBridge { }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        WindowHeader { title: "Automation"; subtitle: "Desired state for AC and battery sessions"; }
        LocalStatus { text: root.status; accent: root.backend-ready ? Palette.text-secondary : Palette.warning; }

        ToggleRow {
            label: "Enable automation";
            description: root.backend-ready ? "Reconcile configured policy on lifecycle events" : "Waiting for automation backend";
            checked: root.enabled;
            disabled: !root.backend-ready || root.saving;
            toggled(value) => { root.enabled-requested(value); }
        }

        HorizontalLayout {
            height: 198px;
            spacing: 10px;

            SectionCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;
                    SectionTitle { title: "AC Power"; detail: root.enabled ? "Policy" : "Paused"; }
                    PolicyRow { label: "Performance"; disabled: !root.backend-ready || !root.enabled || root.saving; model: ["Silent", "Balanced", "Turbo", "Keep current"]; current-index: root.ac-profile; changed(i) => { root.ac-profile-requested(i); } }
                    PolicyRow { label: "GPU"; disabled: !root.backend-ready || !root.enabled || root.saving; model: ["Eco", "Standard", "Optimized", "Keep current"]; current-index: root.ac-gpu; changed(i) => { root.ac-gpu-requested(i); } }
                    PolicyRow { label: "Display"; disabled: !root.backend-ready || !root.enabled || root.saving; model: ["60 Hz", "120 Hz", "Auto", "Keep current"]; current-index: root.ac-display; changed(i) => { root.ac-display-requested(i); } }
                    PolicyRow { label: "Lighting"; disabled: !root.backend-ready || !root.enabled || root.saving; model: ["Off", "Dim", "Normal", "Keep current"]; current-index: root.ac-lighting; changed(i) => { root.ac-lighting-requested(i); } }
                }
            }

            SectionCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;
                    SectionTitle { title: "Battery"; detail: root.enabled ? "Policy" : "Paused"; }
                    PolicyRow { label: "Performance"; disabled: !root.backend-ready || !root.enabled || root.saving; model: ["Silent", "Balanced", "Turbo", "Keep current"]; current-index: root.battery-profile; changed(i) => { root.battery-profile-requested(i); } }
                    PolicyRow { label: "GPU"; disabled: !root.backend-ready || !root.enabled || root.saving; model: ["Eco", "Standard", "Optimized", "Keep current"]; current-index: root.battery-gpu; changed(i) => { root.battery-gpu-requested(i); } }
                    PolicyRow { label: "Display"; disabled: !root.backend-ready || !root.enabled || root.saving; model: ["60 Hz", "120 Hz", "Auto", "Keep current"]; current-index: root.battery-display; changed(i) => { root.battery-display-requested(i); } }
                    PolicyRow { label: "Lighting"; disabled: !root.backend-ready || !root.enabled || root.saving; model: ["Off", "Dim", "Normal", "Keep current"]; current-index: root.battery-lighting; changed(i) => { root.battery-lighting-requested(i); } }
                }
            }
        }

        SectionCard {
            height: 110px;
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                SectionTitle { title: "Triggers / Reconciliation"; }
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 0px;
                        ToggleRow { label: "Apply on AC / battery change"; checked: root.on-ac-change; disabled: !root.backend-ready || !root.enabled || root.saving; toggled(value) => { root.on-ac-change-requested(value); } }
                        ToggleRow { label: "Reconcile after resume"; checked: root.on-resume; disabled: !root.backend-ready || !root.enabled || root.saving; toggled(value) => { root.on-resume-requested(value); } }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 0px;
                        ToggleRow { label: "Write only when state differs"; checked: root.reconcile-only; disabled: !root.backend-ready || !root.enabled || root.saving; toggled(value) => { root.reconcile-only-requested(value); } }
                        ToggleRow { label: "Notify about transitions"; checked: root.notify-transitions; disabled: !root.backend-ready || !root.enabled || root.saving; toggled(value) => { root.notify-transitions-requested(value); } }
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }

        HorizontalLayout {
            height: 30px;
            spacing: 6px;
            Text {
                horizontal-stretch: 1;
                text: root.backend-ready ? "Changes remain a draft until Save" : "No automation state loaded";
                font-size: 9px;
                color: Palette.text-disabled;
                vertical-alignment: center;
            }
            ActionButton { width: 84px; label: "Reset"; disabled: !root.backend-ready || root.saving; clicked => { root.reset-requested(); } }
            ActionButton { width: 96px; label: root.saving ? "Saving…" : "Save"; accent: true; disabled: !root.backend-ready || root.saving; clicked => { root.save-requested(); } }
        }
    }
}
