// System page — device identity and diagnostics.
import { ScrollView, TextEdit } from "std-widgets.slint";
import { UiState, ClamshellState } from "../model.slint";
import { PageHeader, SectionCard, SectionTitle, InfoRow, LocalStatus, ActionButton, StatusPill, LayoutMetrics } from "../common.slint";
import { Palette } from "../../themes/dark.slint";

export component SystemSection inherits Rectangle {
    in property <UiState> ui-state;
    in property <string> device-name: "";
    in property <string> device-board: "";
    in property <string> bios-version: "";
    in property <string> bios-date: "";

    in property <bool> backend-ready: false;
    in property <bool> applying: false;
    in property <string> status: "Расширенные функции недоступны";
    in property <bool> boot-sound-state-ready: false;
    in property <bool> boot-sound-control-ready: false;
    in-out property <bool> boot-sound: false;
    in property <bool> igpu-memory-state-ready: false;
    in property <bool> igpu-memory-control-ready: false;
    in property <bool> igpu-memory-pending: false;
    in property <bool> status-led-state-ready: false;
    in property <bool> status-led-control-ready: false;
    in property <ClamshellState> auto-clamshell-state: ClamshellState.Loading;
    in property <bool> standby-networking-control-ready: false;
    in property <bool> hibernate-control-ready: false;
    in property <bool> core-count-control-ready: false;
    in property <bool> binding-control-ready: false;
    in property <bool> advanced-apply-ready: false;
    in property <bool> aspm-state-ready: false;
    in property <bool> aspm-control-ready: false;
    in-out property <int> m1-action: 0;
    in-out property <int> m2-action: 0;
    in-out property <int> m3-action: 0;
    in-out property <int> m4-action: 0;
    in-out property <int> m5-action: 0;
    in-out property <bool> status-led: false;
    in-out property <bool> disable-aspm: false;
    in-out property <bool> disable-standby-networking: false;
    in-out property <int> igpu-memory: 0;
    in-out property <int> hibernate-after: 0;
    in-out property <int> p-cores: 1;
    in-out property <int> e-cores: 0;
    callback reload-requested;
    callback boot-sound-requested(bool);
    callback igpu-memory-requested(int);
    callback apply-requested;
    callback aspm-requested(bool);
    callback auto-clamshell-requested(bool);

    in property <string> diagnostics-summary: "";
    in property <bool> refresh-enabled: false;
    in property <bool> refresh-pending: false;
    in property <bool> export-enabled: false;
    in property <string> diagnostics-status: "Диагностика недоступна · подключение ещё не готово";
    callback diagnostics-refresh-requested;
    callback diagnostics-export-requested;

    property <int> binding-action-count: 10;

    function binding-label(index: int) -> string {
        if (index == 0) { return "По умолчанию"; }
        if (index == 1) { return "Нет действия"; }
        if (index == 2) { return "Mute"; }
        if (index == 3) { return "Громкость +"; }
        if (index == 4) { return "Громкость −"; }
        if (index == 5) { return "Микрофон"; }
        if (index == 6) { return "Экран"; }
        if (index == 7) { return "Aura"; }
        if (index == 8) { return "Производительность"; }
        if (index == 9) { return "GPU Mode"; }
        return "По умолчанию";
    }

    function igpu-label(index: int) -> string {
        if (index == 0) { return "Авто"; }
        if (index == 1) { return "512 МБ"; }
        if (index == 2) { return "1 ГБ"; }
        if (index == 3) { return "2 ГБ"; }
        if (index == 4) { return "4 ГБ"; }
        if (index == 5) { return "8 ГБ"; }
        if (index == 6) { return "16 ГБ"; }
        if (index == 7) { return "32 ГБ"; }
        if (index == 8) { return "64 ГБ"; }
        return "Авто";
    }

    function clamp-index(index: int, delta: int) -> int {
        let next = index + delta;
        if (next < 0) { return 0; }
        if (next > root.binding-action-count - 1) { return root.binding-action-count - 1; }
        return next;
    }

    function device-label() -> string { return root.device-name != "" ? root.device-name : "—"; }
    function board-label() -> string { return root.device-board != "" ? root.device-board : "—"; }
    function bios-label() -> string {
        if (root.bios-version == "" && root.bios-date == "") { return "—"; }
        if (root.bios-date == "") { return root.bios-version; }
        return root.bios-version + " · " + root.bios-date;
    }

    function clamshell-state-label() -> string {
        if (root.auto-clamshell-state == ClamshellState.Loading) { return "Определяется"; }
        if (root.auto-clamshell-state == ClamshellState.Inactive) { return "Выключено"; }
        if (root.auto-clamshell-state == ClamshellState.Active) { return "Включено"; }
        if (root.auto-clamshell-state == ClamshellState.Unavailable) { return "Недоступно"; }
        if (root.auto-clamshell-state == ClamshellState.PermissionDenied) { return "Нет разрешения"; }
        if (root.auto-clamshell-state == ClamshellState.StartFailed) { return "Не включилось"; }
        if (root.auto-clamshell-state == ClamshellState.ExitFailed) { return "Не выключилось"; }
        return "Неизвестно";
    }

    function clamshell-state-accent() -> color {
        if (root.auto-clamshell-state == ClamshellState.Active) { return Palette.success; }
        if (root.auto-clamshell-state == ClamshellState.PermissionDenied
            || root.auto-clamshell-state == ClamshellState.StartFailed
            || root.auto-clamshell-state == ClamshellState.ExitFailed) { return Palette.error; }
        if (root.auto-clamshell-state == ClamshellState.Inactive) { return Palette.text-secondary; }
        return Palette.warning;
    }

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: 14px;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            PageHeader {
                title: "Система";
                description: "Сведения об устройстве и диагностика.";
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 4px;
                    SectionTitle { title: "Устройство"; }
                    InfoRow { label: "Модель"; value: root.device-label(); }
                    InfoRow { label: "Плата"; value: root.board-label(); }
                    InfoRow { label: "BIOS"; value: root.bios-label(); }
                    InfoRow { label: "Orbis Control"; value: root.ui-state.version; }
                }
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 30px;
                        SectionTitle { horizontal-stretch: 1; title: "Диагностика"; detail: root.refresh-enabled ? "Сводка системы" : "Недоступно"; }
                        StatusPill {
                            text: root.refresh-enabled ? "Готово" : "Недоступно";
                            accent: root.refresh-enabled ? Palette.success : Palette.text-secondary;
                        }
                    }
                    HorizontalLayout {
                        height: 38px;
                        spacing: 8px;
                        ActionButton { label: root.refresh-pending ? "Обновление…" : "Обновить"; disabled: !root.refresh-enabled || root.refresh-pending; clicked => { root.diagnostics-refresh-requested(); } }
                        ActionButton {
                            label: "Копировать";
                            disabled: root.diagnostics-summary == "";
                            clicked => { copy-ti.select-all(); copy-ti.copy(); }
                        }
                        ActionButton { label: "Экспорт"; disabled: !root.export-enabled; clicked => { root.diagnostics-export-requested(); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    LocalStatus { text: root.diagnostics-status; accent: Palette.text-secondary; }
                    Text {
                        text: root.diagnostics-summary == "" ? "Нажми «Обновить», чтобы получить снимок состояния." : root.diagnostics-summary;
                        color: Palette.text-secondary;
                        font-size: 11.5px;
                        horizontal-stretch: 1;
                        height: 170px;
                        vertical-alignment: top;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    copy-ti := TextEdit {
        y: -1000px;
        width: 300px;
        height: 100px;
        wrap: word-wrap;
        text: root.diagnostics-summary;
        read-only: true;
    }
}
