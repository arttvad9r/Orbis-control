// System page — device identity, capability-gated ASUS advanced parameters and
// diagnostics. An advanced row is rendered only when its capability is observed
// on this machine; there are no inert placeholder controls.
import { ScrollView, TextEdit } from "std-widgets.slint";
import { OptionStepper } from "../../components/steppers.slint";
import { RequestToggleRow } from "../../components/request-toggle-row.slint";
import { UiState, ClamshellState } from "../model.slint";
import { PageHeader, SectionCard, SectionTitle, CardHeader, IconBadge, InfoRow, LocalStatus, ActionButton, LayoutMetrics, PageSurface } from "../common.slint";
import { Icon, Icons } from "../../components/icon.slint";
import { Palette } from "../../themes/dark.slint";

component SpecCell inherits HorizontalLayout {
    in property <int> icon-kind;
    in property <string> value;
    in property <string> caption;
    spacing: 14px;
    Rectangle {
        width: 30px;
        Icon { width: 30px; height: 30px; y: (parent.height - self.height) / 2; kind: root.icon-kind; tint: Palette.text-primary; }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text { text: root.value; font-size: 14px; font-weight: 550; color: Palette.text-primary; overflow: elide; }
        if (root.caption != "") : Text { text: root.caption; font-size: 12px; color: Palette.text-secondary; overflow: elide; }
    }
}

export component SystemSection inherits PageSurface {
    in property <UiState> ui-state;
    in property <string> device-name: "";
    in property <string> device-board: "";
    in property <string> bios-version: "";
    in property <string> bios-date: "";
    in property <string> cpu-model: "";
    in property <string> cpu-detail: "";
    in property <string> memory-total: "";
    in property <string> kernel-release: "";
    in property <string> gpu-model: "";

    in property <bool> backend-ready: false;
    in property <bool> applying: false;
    in property <string> status: "Расширенные функции недоступны";
    in property <bool> boot-sound-state-ready: false;
    in property <bool> boot-sound-control-ready: false;
    in-out property <bool> boot-sound: false;
    in property <bool> igpu-memory-state-ready: false;
    in property <bool> igpu-memory-control-ready: false;
    in property <bool> igpu-memory-pending: false;
    in property <ClamshellState> auto-clamshell-state: ClamshellState.Loading;
    in property <string> lid-other-handler: "";
    in property <bool> advanced-apply-ready: false;
    in property <bool> aspm-state-ready: false;
    in property <bool> aspm-control-ready: false;
    in-out property <bool> disable-aspm: false;
    in-out property <int> igpu-memory: 0;
    callback reload-requested;
    callback boot-sound-requested(bool);
    callback igpu-memory-requested(int);
    callback apply-requested;
    callback aspm-requested(bool);
    callback auto-clamshell-requested(bool);

    in property <string> diagnostics-summary: "";
    in property <bool> refresh-enabled: false;
    in property <bool> refresh-pending: false;
    in property <bool> export-enabled: false;
    in property <string> diagnostics-status: "Диагностика недоступна · подключение ещё не готово";
    callback diagnostics-refresh-requested;
    callback diagnostics-export-requested;

    function igpu-label(index: int) -> string {
        if (index == 0) { return "Авто"; }
        if (index == 1) { return "512 МБ"; }
        if (index == 2) { return "1 ГБ"; }
        if (index == 3) { return "2 ГБ"; }
        if (index == 4) { return "4 ГБ"; }
        if (index == 5) { return "8 ГБ"; }
        if (index == 6) { return "16 ГБ"; }
        if (index == 7) { return "32 ГБ"; }
        if (index == 8) { return "64 ГБ"; }
        return "Авто";
    }


    function device-label() -> string { return root.device-name != "" ? root.device-name : "—"; }
    function board-label() -> string { return root.device-board != "" ? root.device-board : "—"; }
    function bios-label() -> string {
        if (root.bios-version == "" && root.bios-date == "") { return "—"; }
        if (root.bios-date == "") { return root.bios-version; }
        return root.bios-version + " · " + root.bios-date;
    }

    function clamshell-state-label() -> string {
        if (root.auto-clamshell-state == ClamshellState.Loading) { return "Проверяем состояние компонента сессии"; }
        if (root.auto-clamshell-state == ClamshellState.Inactive) { return "Выключено"; }
        if (root.auto-clamshell-state == ClamshellState.Active) { return "Включено"; }
        if (root.auto-clamshell-state == ClamshellState.Unavailable) { return "Недоступно"; }
        if (root.auto-clamshell-state == ClamshellState.PermissionDenied) { return "Компонент сессии отклонил доступ"; }
        if (root.auto-clamshell-state == ClamshellState.StartFailed) { return "Не удалось включить режим"; }
        if (root.auto-clamshell-state == ClamshellState.ExitFailed) { return "Не удалось выключить режим"; }
        return "Состояние компонента сессии не определено";
    }

    // Closed-lid mode is owned by sessiond; it is hidden only when the session
    // component reports the capability as unavailable.
    function clamshell-visible() -> bool {
        return root.auto-clamshell-state != ClamshellState.Unavailable;
    }

    function advanced-visible() -> bool {
        return root.boot-sound-state-ready || root.igpu-memory-state-ready
            || root.aspm-state-ready || root.clamshell-visible();
    }

    function staged-visible() -> bool {
        return root.boot-sound-state-ready || root.igpu-memory-state-ready || root.aspm-state-ready;
    }


    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: LayoutMetrics.page-margin;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            HorizontalLayout {
                spacing: 16px;
                PageHeader {
                    horizontal-stretch: 1;
                    title: "Система";
                    subtitle: "Устройство, параметры ASUS и диагностика";
                }
                Rectangle {
                    width: 300px;
                    height: 66px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.border-default;
                    background: Palette.surface-default;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 14px;
                        Rectangle {
                            width: 18px;
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 18px;
                                height: 18px;
                                border-radius: 9px;
                                background: root.backend-ready ? Palette.success : Palette.warning;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            Text {
                                text: root.backend-ready ? "Службы подключены" : "Ожидание службы";
                                font-size: 15px;
                                font-weight: 600;
                                color: Palette.text-primary;
                            }
                            Text {
                                text: root.backend-ready ? "Hardware1 и сессия отвечают" : "Функции управления пока недоступны";
                                font-size: 12px;
                                color: Palette.text-secondary;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            // Device hero: illustration, identity and spec grid.
            SectionCard {
                height: 216px;
                HorizontalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 26px;
                    Rectangle {
                        width: 290px;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: @image-url("../../assets/laptop.svg");
                            image-fit: contain;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 6px;
                        Text { text: root.device-label(); font-size: 22px; font-weight: 700; color: Palette.text-primary; overflow: elide; }
                        Text {
                            text: root.board-label() + (root.kernel-release != "" ? "   ·   Linux " + root.kernel-release : "") + "   ·   Orbis Control " + root.ui-state.version;
                            font-size: 14px;
                            color: Palette.text-secondary;
                            overflow: elide;
                        }
                        Rectangle { height: 8px; }
                        Rectangle { height: 1px; background: Palette.border-default; }
                        Rectangle { height: 6px; }
                        GridLayout {
                            spacing-horizontal: 24px;
                            spacing-vertical: 12px;
                            Row {
                                SpecCell { icon-kind: Icons.cpu; value: root.cpu-model != "" ? root.cpu-model : "Процессор"; caption: root.cpu-detail; }
                                SpecCell { icon-kind: Icons.gpu; value: root.gpu-model != "" ? root.gpu-model : "Графика"; caption: root.gpu-model != "" ? "Дискретная графика" : "Модель не определена"; }
                            }
                            Row {
                                SpecCell { icon-kind: Icons.ram; value: root.memory-total != "" ? root.memory-total : "—"; caption: "Оперативная память"; }
                                SpecCell { icon-kind: Icons.memory-chip; value: root.bios-label(); caption: "Версия BIOS"; }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: LayoutMetrics.page-gap;

                if (root.advanced-visible()) : SectionCard {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 4px;

                        CardHeader {
                            title: "Параметры ASUS";
                            icon-kind: Icons.sliders;
                            detail: root.applying ? "Применение…" : root.backend-ready ? "" : "Чтение…";
                        }

                        if (root.status != "") : LocalStatus { text: root.status; accent: Palette.text-secondary; }

                        if (root.boot-sound-state-ready) : RequestToggleRow {
                            icon-kind: Icons.volume;
                            label: "Звук при включении";
                            checked: root.boot-sound;
                            disabled: !root.boot-sound-control-ready || root.applying;
                            toggled(value) => { root.boot-sound-requested(value); }
                        }

                        if (root.aspm-state-ready) : RequestToggleRow {
                            icon-kind: Icons.pci;
                            label: "Без энергосбережения PCIe";
                            description: "До перезагрузки";
                            checked: root.disable-aspm;
                            disabled: !root.aspm-control-ready || root.applying;
                            toggled(value) => { root.aspm-requested(value); }
                        }

                        if (root.igpu-memory-state-ready) : HorizontalLayout {
                            height: 50px;
                            spacing: 16px;
                            Rectangle { width: 26px; Icon { width: 24px; height: 24px; y: 12px; kind: Icons.memory-chip; tint: Palette.text-primary; } }
                            Text { horizontal-stretch: 1; text: "Память iGPU"; font-size: 14.5px; font-weight: 550; color: Palette.text-primary; vertical-alignment: center; }
                            OptionStepper {
                                y: 4px;
                                label: root.igpu-memory-pending ? root.igpu-label(root.igpu-memory) + " · после перезагрузки" : root.igpu-label(root.igpu-memory);
                                disabled: !root.igpu-memory-control-ready || root.applying;
                                can-previous: root.igpu-memory > 0;
                                can-next: root.igpu-memory < 8;
                                previous => { root.igpu-memory-requested(Math.max(0, root.igpu-memory - 1)); }
                                next => { root.igpu-memory-requested(Math.min(8, root.igpu-memory + 1)); }
                            }
                        }

                        if (root.clamshell-visible()) : RequestToggleRow {
                            icon-kind: Icons.lid;
                            label: "Не засыпать при закрытой крышке";
                            description: root.auto-clamshell-state == ClamshellState.Active && root.lid-other-handler != ""
                                ? root.lid-other-handler + " тоже обрабатывает крышку: задайте ему «Ничего не делать»"
                                : root.auto-clamshell-state == ClamshellState.Inactive || root.auto-clamshell-state == ClamshellState.Active
                                ? ""
                                : root.clamshell-state-label();
                            checked: root.auto-clamshell-state == ClamshellState.Active;
                            disabled: (root.auto-clamshell-state != ClamshellState.Inactive && root.auto-clamshell-state != ClamshellState.Active) || root.applying;
                            toggled(value) => { root.auto-clamshell-requested(value); }
                        }

                        Rectangle { vertical-stretch: 1; }

                        if (root.staged-visible()) : HorizontalLayout {
                            height: 40px;
                            spacing: 8px;
                            alignment: end;
                            ActionButton { width: 120px; label: "Обновить"; disabled: root.applying; clicked => { root.reload-requested(); } }
                            ActionButton {
                                width: 140px;
                                label: root.applying ? "Применение…" : "Применить";
                                accent: root.advanced-apply-ready;
                                disabled: !root.advanced-apply-ready || root.applying;
                                clicked => { root.apply-requested(); }
                            }
                        }
                    }
                }
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 46px;
                        spacing: 8px;
                        CardHeader { horizontal-stretch: 1; title: "Диагностика"; subtitle: root.diagnostics-status; icon-kind: Icons.file; divider: false; }
                        ActionButton { width: 120px; label: root.refresh-pending ? "Обновление…" : "Обновить"; disabled: !root.refresh-enabled || root.refresh-pending; clicked => { root.diagnostics-refresh-requested(); } }
                        ActionButton {
                            width: 120px;
                            label: "Копировать";
                            disabled: root.diagnostics-summary == "";
                            clicked => { copy-ti.select-all(); copy-ti.copy(); }
                        }
                        ActionButton { width: 120px; label: "Экспорт"; disabled: !root.export-enabled; clicked => { root.diagnostics-export-requested(); } }
                    }
                    Rectangle {
                        height: 170px;
                        border-radius: 10px;
                        background: Palette.surface-muted;
                        clip: true;
                        Text {
                            x: 14px;
                            y: 12px;
                            width: parent.width - 28px;
                            height: parent.height - 24px;
                            text: root.diagnostics-summary == "" ? "Нажмите «Обновить», чтобы получить снимок состояния" : root.diagnostics-summary;
                            color: Palette.text-secondary;
                            font-size: 12px;
                            vertical-alignment: top;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            Rectangle { vertical-stretch: 100; }
        }
    }

    copy-ti := TextEdit {
        y: -1000px;
        width: 300px;
        height: 100px;
        wrap: word-wrap;
        text: root.diagnostics-summary;
        read-only: true;
    }
}
