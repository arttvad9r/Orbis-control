// Performance page — platform profiles with explicit current/availability state,
// plus the backend-metadata power/thermal limits card (REQ-POWER/REQ-BOOST,
// AC-040/AC-041): rows render only fields the backend actually reports, with
// the backend's real unit; no invented CPU-boost entry exists.
import { ScrollView } from "std-widgets.slint";
import { UiState, PerformanceHwState } from "../model.slint";
import { PageHeader, SectionCard, SectionTitle, ActionButton, StatusPill, LocalStatus, LayoutMetrics } from "../common.slint";
import { ModeCard } from "../../components/mode-card.slint";
import { MetricCard } from "../../components/metric-card.slint";
import { ValueSlider } from "../../components/value-slider.slint";
import { Palette } from "../../themes/dark.slint";

// One backend-reported limit field: authoritative value+unit headline, a local
// preview slider bound to the backend range and the draft when one is dirty.
export component LimitRow inherits Rectangle {
    in property <int> field-index;
    in property <string> label;
    in property <int> value;
    in property <int> min;
    in property <int> max;
    in property <int> step;
    in property <string> unit;
    in property <string> range;
    in property <bool> disabled: false;
    callback changed(int, float);

    height: 96px;
    background: transparent;
    VerticalLayout {
        spacing: 2px;
        Text { text: root.label; font-size: 12px; color: Palette.text-secondary; overflow: elide; }
        Text { text: root.value + " " + root.unit; font-size: 18px; font-weight: 600; color: Palette.text-primary; }
        ValueSlider {
            min: root.min;
            max: root.max;
            step: root.step;
            value: root.value;
            disabled: root.disabled;
            // The row headline already carries the authoritative value+unit;
            // hiding the slider's own readout keeps three limit rows inside
            // the card at the 980px minimum window (audit t_29073c31).
            show-percent: false;
            changed(v) => { root.changed(root.field-index, v); }
        }
        Text { text: root.range; font-size: 10.5px; color: Palette.text-secondary; overflow: elide; }
    }
}

export component PerformanceSection inherits Rectangle {
    in property <UiState> ui-state;
    callback perf-clicked(int);
    callback power-limit-changed(int, int);
    callback power-limit-apply-clicked;
    callback graphics-open-requested;

    function bit-set(mask: int, bit: int) -> bool {
        let shifted = Math.floor(mask / bit);
        return shifted - 2 * Math.floor(shifted / 2) == 1;
    }

    function perf-reason() -> string {
        if (root.ui-state.performance-delegated-pending) { return "Ожидание подтверждения"; }
        if (root.ui-state.performance-delegated-error != "") { return root.ui-state.performance-delegated-error; }
        if (root.ui-state.perf-state == PerformanceHwState.Ready) {
            return root.ui-state.perf-writable ? (root.ui-state.performance-delegated-ready ? "Доступно через power-profiles-daemon" : "Доступно") : "Только чтение";
        }
        if (root.ui-state.perf-state == PerformanceHwState.Loading) { return "Получение профиля"; }
        return root.ui-state.perf-unavailable-reason;
    }

    function current-profile() -> string {
        if (root.ui-state.perf-state != PerformanceHwState.Ready) { return "—"; }
        if (root.ui-state.perf-selected == 0) { return "Тихий"; }
        if (root.ui-state.perf-selected == 1) { return "Сбалансированный"; }
        if (root.ui-state.perf-selected == 2) { return "Турбо"; }
        return "—";
    }

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: 14px;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            PageHeader {
                title: "Производительность";
                description: "Профиль платформы управляет балансом производительности, температуры и шума.";
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 14px;

                    HorizontalLayout {
                        height: 30px;
                        SectionTitle {
                            horizontal-stretch: 1;
                            title: "Режим производительности";
                            detail: root.perf-reason();
                        }
                        StatusPill {
                            width: 156px;
                            text: root.current-profile();
                            accent: root.ui-state.perf-state == PerformanceHwState.Ready ? Palette.balanced : Palette.text-secondary;
                        }
                    }

                    HorizontalLayout {
                        height: 94px;
                        spacing: 12px;
                        ModeCard {
                            title: "Тихий";
                            description: "Минимум шума и нагрева";
                            icon-kind: 16;
                            accent: Palette.silent;
                            selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 0;
                            disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 1);
                            clicked => { root.perf-clicked(0); }
                        }
                        ModeCard {
                            title: "Сбалансированный";
                            description: "Оптимален для повседневной работы";
                            icon-kind: 17;
                            accent: Palette.balanced;
                            selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 1;
                            disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 2);
                            clicked => { root.perf-clicked(1); }
                        }
                        ModeCard {
                            title: "Турбо";
                            description: "Максимальная производительность";
                            icon-kind: 18;
                            accent: Palette.turbo;
                            selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 2;
                            disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 4);
                            clicked => { root.perf-clicked(2); }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: 108px;
                spacing: 14px;
                MetricCard { label: "CPU"; value: root.ui-state.cpu-temp; detail: "температура процессора"; icon-kind: 10; }
                MetricCard {
                    label: "GPU";
                    // A suspended dGPU reports no temperature; show the iGPU then.
                    value: root.ui-state.gpu-temp != "—" || root.ui-state.igpu-temp == "—" ? root.ui-state.gpu-temp : root.ui-state.igpu-temp;
                    detail: root.ui-state.gpu-temp != "—" ? "температура dGPU" : root.ui-state.igpu-temp != "—" ? "температура iGPU · dGPU спит" : "температура графики";
                    icon-kind: 4;
                }
                MetricCard { label: "Вентилятор CPU"; value: root.ui-state.cpu-fan-rpm; detail: "скорость вентилятора"; icon-kind: 3; }
                MetricCard { label: "ПИТАНИЕ"; value: root.ui-state.power-ac-mw; detail: "потребление от адаптера"; icon-kind: 13; }
            }

            SectionCard {
                min-height: 108px;
                HorizontalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 18px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;
                        Text { text: "Графический режим"; font-size: 15px; font-weight: 650; color: Palette.text-primary; }
                        Text {
                            text: "Режим GPU настраивается отдельно и может требовать перезагрузку.";
                            font-size: 12.5px;
                            color: Palette.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                    Rectangle {
              width: 126px;
              vertical-stretch: 1;
              background: transparent;
              ActionButton {
                  width: parent.width;
                  y: (parent.height - self.height) / 2;
                  label: "Открыть графику";
                  clicked => { root.graphics-open-requested(); }
              }
          }
                }
            }

            // Power/thermal limits: values, ranges and units come from the
            // backend snapshot (REQ-POWER/REQ-BOOST); a field row exists only
            // when the backend reports that field with metadata.
            SectionCard {
                visible: root.ui-state.power-limits-ready;
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 10px;

                    SectionTitle { title: "Лимиты мощности и температуры"; detail: root.ui-state.power-limits-reason; }
                    Text {
                        text: "Значения и диапазоны получены от backend. Изменение проходит авторизацию, запись и authoritative read-back.";
                        font-size: 11.5px;
                        color: Palette.text-secondary;
                        overflow: elide;
                    }

                    if (root.ui-state.power-limit-error) : LocalStatus {
                        text: "Не удалось применить лимиты мощности: доступ запрещён или backend отклонил запись. Измените черновик и повторите.";
                        accent: Palette.error;
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        if (root.ui-state.spl-unit != "") : LimitRow {
                            horizontal-stretch: 1;
                            field-index: 0;
                            label: "SPL / PL1";
                            value: root.bit-set(root.ui-state.power-limit-dirty-mask, 1) ? root.ui-state.spl-draft : root.ui-state.spl-value;
                            min: root.ui-state.spl-min;
                            max: root.ui-state.spl-max;
                            step: root.ui-state.spl-step;
                            unit: root.ui-state.spl-unit;
                            disabled: !root.ui-state.power-limits-writable || root.bit-set(root.ui-state.power-limit-pending-mask, 1);
                            range: root.ui-state.spl-min + "–" + root.ui-state.spl-max + " · шаг " + root.ui-state.spl-step;
                            changed(f, v) => { root.power-limit-changed(f, Math.round(v)); }
                        }
                        if (root.ui-state.sppt-unit != "") : LimitRow {
                            horizontal-stretch: 1;
                            field-index: 1;
                            label: "SPPT / PL2";
                            value: root.bit-set(root.ui-state.power-limit-dirty-mask, 2) ? root.ui-state.sppt-draft : root.ui-state.sppt-value;
                            min: root.ui-state.sppt-min;
                            max: root.ui-state.sppt-max;
                            step: root.ui-state.sppt-step;
                            unit: root.ui-state.sppt-unit;
                            disabled: !root.ui-state.power-limits-writable || root.bit-set(root.ui-state.power-limit-pending-mask, 2);
                            range: root.ui-state.sppt-min + "–" + root.ui-state.sppt-max + " · шаг " + root.ui-state.sppt-step;
                            changed(f, v) => { root.power-limit-changed(f, Math.round(v)); }
                        }
                        if (root.ui-state.fppt-unit != "") : LimitRow {
                            horizontal-stretch: 1;
                            field-index: 2;
                            label: "FPPT / PL3";
                            value: root.bit-set(root.ui-state.power-limit-dirty-mask, 4) ? root.ui-state.fppt-draft : root.ui-state.fppt-value;
                            min: root.ui-state.fppt-min;
                            max: root.ui-state.fppt-max;
                            step: root.ui-state.fppt-step;
                            unit: root.ui-state.fppt-unit;
                            disabled: !root.ui-state.power-limits-writable || root.bit-set(root.ui-state.power-limit-pending-mask, 4);
                            range: root.ui-state.fppt-min + "–" + root.ui-state.fppt-max + " · шаг " + root.ui-state.fppt-step;
                            changed(f, v) => { root.power-limit-changed(f, Math.round(v)); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        if (root.ui-state.cpu-temp-limit-unit != "") : LimitRow {
                            horizontal-stretch: 1;
                            field-index: 3;
                            label: "Лимит температуры CPU";
                            value: root.bit-set(root.ui-state.power-limit-dirty-mask, 8) ? root.ui-state.cpu-temp-limit-draft : root.ui-state.cpu-temp-limit-value;
                            min: root.ui-state.cpu-temp-limit-min;
                            max: root.ui-state.cpu-temp-limit-max;
                            step: root.ui-state.cpu-temp-limit-step;
                            unit: root.ui-state.cpu-temp-limit-unit;
                            disabled: !root.ui-state.power-limits-writable || root.bit-set(root.ui-state.power-limit-pending-mask, 8);
                            range: root.ui-state.cpu-temp-limit-min + "–" + root.ui-state.cpu-temp-limit-max + " · шаг " + root.ui-state.cpu-temp-limit-step;
                            changed(f, v) => { root.power-limit-changed(f, Math.round(v)); }
                        }
                        if (root.ui-state.gpu-dynamic-boost-unit != "") : LimitRow {
                            horizontal-stretch: 1;
                            field-index: 4;
                            label: "NVIDIA Dynamic Boost";
                            value: root.bit-set(root.ui-state.power-limit-dirty-mask, 16) ? root.ui-state.gpu-dynamic-boost-draft : root.ui-state.gpu-dynamic-boost-value;
                            min: root.ui-state.gpu-dynamic-boost-min;
                            max: root.ui-state.gpu-dynamic-boost-max;
                            step: root.ui-state.gpu-dynamic-boost-step;
                            unit: root.ui-state.gpu-dynamic-boost-unit;
                            disabled: !root.ui-state.power-limits-writable || root.bit-set(root.ui-state.power-limit-pending-mask, 16);
                            range: root.ui-state.gpu-dynamic-boost-min + "–" + root.ui-state.gpu-dynamic-boost-max + " · шаг " + root.ui-state.gpu-dynamic-boost-step;
                            changed(f, v) => { root.power-limit-changed(f, Math.round(v)); }
                        }
                        if (root.ui-state.gpu-temp-target-unit != "") : LimitRow {
                            horizontal-stretch: 1;
                            field-index: 5;
                            label: "Целевая температура GPU";
                            value: root.bit-set(root.ui-state.power-limit-dirty-mask, 32) ? root.ui-state.gpu-temp-target-draft : root.ui-state.gpu-temp-target-value;
                            min: root.ui-state.gpu-temp-target-min;
                            max: root.ui-state.gpu-temp-target-max;
                            step: root.ui-state.gpu-temp-target-step;
                            unit: root.ui-state.gpu-temp-target-unit;
                            disabled: !root.ui-state.power-limits-writable || root.bit-set(root.ui-state.power-limit-pending-mask, 32);
                            range: root.ui-state.gpu-temp-target-min + "–" + root.ui-state.gpu-temp-target-max + " · шаг " + root.ui-state.gpu-temp-target-step;
                            changed(f, v) => { root.power-limit-changed(f, Math.round(v)); }
                        }
                    }

                    HorizontalLayout {
                        height: LayoutMetrics.compact-control-height;
                        spacing: 12px;
                        ActionButton {
                            width: 168px;
                            label: root.ui-state.power-limit-dirty-mask != 0 ? "Применить лимиты" : "Лимиты применены";
                            disabled: !root.ui-state.power-limits-writable || root.ui-state.power-limit-dirty-mask == 0 || root.ui-state.power-limit-pending-mask != 0;
                            clicked => { root.power-limit-apply-clicked(); }
                        }
                        if (root.ui-state.power-limit-verification-mask != 0) : LocalStatus {
                            horizontal-stretch: 1;
                            text: "Подтверждение записи чтением фактического состояния…";
                            accent: Palette.warning;
                        }
                    }
                }
            }

            if (!root.ui-state.power-limits-ready) : SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    SectionTitle { title: "Лимиты мощности и температуры"; detail: root.ui-state.power-limits-reason; }
                }
            }

            Rectangle { vertical-stretch: 100; background: transparent; }
        }
    }
}
