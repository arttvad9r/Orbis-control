// Performance page — platform profiles with explicit current/availability state,
// plus the backend-metadata power/thermal limits card (REQ-POWER/REQ-BOOST,
// AC-040/AC-041): rows render only fields the backend actually reports, with
// the backend's real unit; no invented CPU-boost entry exists.
import { ScrollView } from "std-widgets.slint";
import { UiState, PerformanceHwState } from "../model.slint";
import { PageHeader, SectionCard, SectionTitle, CardHeader, ActionButton, ChoiceButton, FieldRow, Divider, LocalStatus, LayoutMetrics } from "../common.slint";
import { Icon, Icons } from "../../components/icon.slint";
import { TempChart } from "../../components/temp-chart.slint";
import { ModeCard } from "../../components/mode-card.slint";
import { ValueSlider } from "../../components/value-slider.slint";
import { RequestToggleRow } from "../../components/request-toggle-row.slint";
import { Palette } from "../../themes/dark.slint";

// One backend-reported limit field: label, slider bound to the backend range
// and the authoritative value (or the dirty draft) with the backend's unit.
export component LimitRow inherits Rectangle {
    in property <int> field-index;
    in property <string> label;
    in property <int> value;
    in property <int> min;
    in property <int> max;
    in property <int> step;
    in property <string> unit;
    in property <bool> disabled: false;
    callback changed(int, float);

    height: 44px;
    background: transparent;
    HorizontalLayout {
        spacing: 16px;
        Text {
            width: 158px;
            text: root.label;
            font-size: 14px;
            color: Palette.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
        ValueSlider {
            horizontal-stretch: 1;
            min: root.min;
            max: root.max;
            step: root.step;
            value: root.value;
            unit: root.unit;
            disabled: root.disabled;
            changed(v) => { root.changed(root.field-index, v); }
        }
    }
}

export component PerformanceSection inherits Rectangle {
    in property <UiState> ui-state;
    callback perf-clicked(int);
    callback power-limit-changed(int, int);
    callback power-limit-apply-clicked;
    in property <bool> profile-limits-known: false;
    in property <bool> profile-limits-auto-apply: false;
    in property <string> profile-limits-summary: "";
    callback profile-limits-auto-apply-toggled(bool);
    in property <bool> cpu-tuning-ready: false;
    in property <int> cpu-epp: 0;
    in property <bool> cpu-epp-supported: false;
    in property <bool> cpu-epp-writable: false;
    in property <bool> cpu-boost-known: false;
    in property <bool> cpu-boost: false;
    in property <bool> cpu-boost-writable: false;
    in property <string> cpu-tuning-error: "";
    callback cpu-epp-requested(int);
    callback cpu-boost-requested(bool);
    in property <bool> cpu-co-supported: false;
    in property <bool> cpu-co-writable: false;
    in property <bool> cpu-co-applied-known: false;
    in property <int> cpu-co-applied: 0;
    callback cpu-co-requested(int);
    property <int> co-draft: 0;
    property <bool> co-confirming: false;
    in property <bool> power-rules-known: false;
    in property <bool> power-rules-enabled: false;
    in property <int> power-rules-ac: 0;
    in property <int> power-rules-battery: 0;
    in property <string> power-rules-error: "";
    callback power-rules-enabled-toggled(bool);
    callback power-rules-profile-requested(bool, int);
    callback graphics-open-requested;
    in property <image> cpu-temp-chart;
    in property <image> gpu-temp-chart;
    in property <string> history-span: "";

    function bit-set(mask: int, bit: int) -> bool {
        let shifted = Math.floor(mask / bit);
        return shifted - 2 * Math.floor(shifted / 2) == 1;
    }

    // Only non-normal states get a line under the tiles.
    function perf-note() -> string {
        if (root.ui-state.performance-delegated-pending) { return "Ожидание подтверждения"; }
        if (root.ui-state.performance-delegated-error != "") { return root.ui-state.performance-delegated-error; }
        if (root.ui-state.perf-state == PerformanceHwState.Ready) {
            return root.ui-state.perf-writable ? "" : "Профиль доступен только для чтения";
        }
        if (root.ui-state.perf-state == PerformanceHwState.Loading) { return ""; }
        return root.ui-state.perf-unavailable-reason;
    }

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: LayoutMetrics.page-margin;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            PageHeader { title: "Производительность"; subtitle: "Профили, лимиты мощности CPU и GPU, история температур"; }

            HorizontalLayout {
                height: 96px;
                spacing: 14px;
                ModeCard {
                    title: "Тихий";
                    icon-kind: Icons.leaf;
                    selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 0;
                    disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 1);
                    clicked => { root.perf-clicked(0); }
                }
                ModeCard {
                    title: "Баланс";
                    icon-kind: Icons.target;
                    selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 1;
                    disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 2);
                    clicked => { root.perf-clicked(1); }
                }
                ModeCard {
                    title: "Турбо";
                    icon-kind: Icons.flame;
                    selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 2;
                    disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 4);
                    clicked => { root.perf-clicked(2); }
                }
            }
            if (root.perf-note() != "") : LocalStatus {
                text: root.perf-note();
                accent: root.ui-state.performance-delegated-error != "" ? Palette.error : Palette.warning;
            }

            HorizontalLayout {
                spacing: LayoutMetrics.page-gap;
                alignment: stretch;

                // Power/thermal limits: values, ranges and units come from the
                // backend snapshot (REQ-POWER/REQ-BOOST); a field row exists
                // only when the backend reports that field with metadata.
                if (root.ui-state.power-limits-ready) : SectionCard {
                    width: (parent.width - LayoutMetrics.page-gap) * 0.55;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 8px;
                        CardHeader { title: "Лимиты мощности и температуры"; detail: root.ui-state.power-limits-reason; }
                        VerticalLayout {
                            spacing: 4px;
                            if (root.ui-state.spl-unit != "") : LimitRow {
                                field-index: 0;
                                label: "SPL / PL1";
                                value: root.bit-set(root.ui-state.power-limit-dirty-mask, 1) ? root.ui-state.spl-draft : root.ui-state.spl-value;
                                min: root.ui-state.spl-min;
                                max: root.ui-state.spl-max;
                                step: root.ui-state.spl-step;
                                unit: root.ui-state.spl-unit;
                                disabled: !root.ui-state.power-limits-writable || root.bit-set(root.ui-state.power-limit-pending-mask, 1);
                                changed(f, v) => { root.power-limit-changed(f, Math.round(v)); }
                            }
                            if (root.ui-state.sppt-unit != "") : LimitRow {
                                field-index: 1;
                                label: "SPPT / PL2";
                                value: root.bit-set(root.ui-state.power-limit-dirty-mask, 2) ? root.ui-state.sppt-draft : root.ui-state.sppt-value;
                                min: root.ui-state.sppt-min;
                                max: root.ui-state.sppt-max;
                                step: root.ui-state.sppt-step;
                                unit: root.ui-state.sppt-unit;
                                disabled: !root.ui-state.power-limits-writable || root.bit-set(root.ui-state.power-limit-pending-mask, 2);
                                changed(f, v) => { root.power-limit-changed(f, Math.round(v)); }
                            }
                            if (root.ui-state.fppt-unit != "") : LimitRow {
                                field-index: 2;
                                label: "FPPT / PL3";
                                value: root.bit-set(root.ui-state.power-limit-dirty-mask, 4) ? root.ui-state.fppt-draft : root.ui-state.fppt-value;
                                min: root.ui-state.fppt-min;
                                max: root.ui-state.fppt-max;
                                step: root.ui-state.fppt-step;
                                unit: root.ui-state.fppt-unit;
                                disabled: !root.ui-state.power-limits-writable || root.bit-set(root.ui-state.power-limit-pending-mask, 4);
                                changed(f, v) => { root.power-limit-changed(f, Math.round(v)); }
                            }
                            if (root.ui-state.cpu-temp-limit-unit != "") : LimitRow {
                                field-index: 3;
                                label: "Темп. CPU";
                                value: root.bit-set(root.ui-state.power-limit-dirty-mask, 8) ? root.ui-state.cpu-temp-limit-draft : root.ui-state.cpu-temp-limit-value;
                                min: root.ui-state.cpu-temp-limit-min;
                                max: root.ui-state.cpu-temp-limit-max;
                                step: root.ui-state.cpu-temp-limit-step;
                                unit: root.ui-state.cpu-temp-limit-unit;
                                disabled: !root.ui-state.power-limits-writable || root.bit-set(root.ui-state.power-limit-pending-mask, 8);
                                changed(f, v) => { root.power-limit-changed(f, Math.round(v)); }
                            }
                            if (root.ui-state.gpu-dynamic-boost-unit != "") : LimitRow {
                                field-index: 4;
                                label: "NVIDIA Dynamic Boost";
                                value: root.bit-set(root.ui-state.power-limit-dirty-mask, 16) ? root.ui-state.gpu-dynamic-boost-draft : root.ui-state.gpu-dynamic-boost-value;
                                min: root.ui-state.gpu-dynamic-boost-min;
                                max: root.ui-state.gpu-dynamic-boost-max;
                                step: root.ui-state.gpu-dynamic-boost-step;
                                unit: root.ui-state.gpu-dynamic-boost-unit;
                                disabled: !root.ui-state.power-limits-writable || root.bit-set(root.ui-state.power-limit-pending-mask, 16);
                                changed(f, v) => { root.power-limit-changed(f, Math.round(v)); }
                            }
                            if (root.ui-state.gpu-temp-target-unit != "") : LimitRow {
                                field-index: 5;
                                label: "Темп. GPU";
                                value: root.bit-set(root.ui-state.power-limit-dirty-mask, 32) ? root.ui-state.gpu-temp-target-draft : root.ui-state.gpu-temp-target-value;
                                min: root.ui-state.gpu-temp-target-min;
                                max: root.ui-state.gpu-temp-target-max;
                                step: root.ui-state.gpu-temp-target-step;
                                unit: root.ui-state.gpu-temp-target-unit;
                                disabled: !root.ui-state.power-limits-writable || root.bit-set(root.ui-state.power-limit-pending-mask, 32);
                                changed(f, v) => { root.power-limit-changed(f, Math.round(v)); }
                            }
                        }
                        if (root.ui-state.power-limit-error) : LocalStatus {
                            text: "Лимиты не применены: доступ запрещён или запись отклонена";
                            accent: Palette.error;
                        }
                        if (root.ui-state.power-limit-verification-mask != 0) : LocalStatus {
                            text: "Проверка записанных значений…";
                            accent: Palette.warning;
                        }
                        Rectangle { vertical-stretch: 1; }
                        HorizontalLayout {
                            alignment: end;
                            ActionButton {
                                width: 160px;
                                label: "Применить";
                                accent: root.ui-state.power-limit-dirty-mask != 0;
                                disabled: !root.ui-state.power-limits-writable || root.ui-state.power-limit-dirty-mask == 0 || root.ui-state.power-limit-pending-mask != 0;
                                clicked => { root.power-limit-apply-clicked(); }
                            }
                        }
                    }
                }
                if (!root.ui-state.power-limits-ready) : SectionCard {
                    width: (parent.width - LayoutMetrics.page-gap) * 0.55;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 10px;
                        CardHeader { title: "Лимиты мощности и температуры"; }
                        LocalStatus {
                            text: root.ui-state.power-limits-reason != "" ? root.ui-state.power-limits-reason : "Недоступно";
                            accent: Palette.text-secondary;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                SectionCard {
                    horizontal-stretch: 1;
                    min-height: 330px;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 10px;
                        CardHeader { title: "История температур"; }
                        TempChart {
                            vertical-stretch: 1;
                            cpu-chart: root.cpu-temp-chart;
                            gpu-chart: root.gpu-temp-chart;
                            cpu-value: root.ui-state.cpu-temp;
                            gpu-value: root.ui-state.gpu-temp != "—" || root.ui-state.igpu-temp == "—" ? root.ui-state.gpu-temp : root.ui-state.igpu-temp;
                            span: root.history-span;
                        }
                    }
                }
            }

            if (root.cpu-tuning-ready) : HorizontalLayout {
                spacing: LayoutMetrics.page-gap;

                if (root.cpu-tuning-ready) : SectionCard {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 10px;

                        CardHeader {
                            title: "Процессор";
                            icon-kind: Icons.cpu;
                            detail: root.cpu-epp-writable || root.cpu-boost-writable || root.cpu-co-writable ? "" : "Только чтение";
                        }
                        if (root.cpu-epp-supported) : VerticalLayout {
                            spacing: 8px;
                            Text { text: "Энергорежим (EPP)"; font-size: 13.5px; color: Palette.text-secondary; }
                            HorizontalLayout {
                                spacing: 6px;
                                ChoiceButton { min-width: 0px; label: "Скорость"; selected: root.cpu-epp == 1; disabled: !root.cpu-epp-writable; clicked => { root.cpu-epp-requested(1); } }
                                ChoiceButton { min-width: 0px; label: "Баланс+"; selected: root.cpu-epp == 2; disabled: !root.cpu-epp-writable; clicked => { root.cpu-epp-requested(2); } }
                                ChoiceButton { min-width: 0px; label: "Баланс−"; selected: root.cpu-epp == 3; disabled: !root.cpu-epp-writable; clicked => { root.cpu-epp-requested(3); } }
                                ChoiceButton { min-width: 0px; label: "Экономия"; selected: root.cpu-epp == 4; disabled: !root.cpu-epp-writable; clicked => { root.cpu-epp-requested(4); } }
                            }
                        }
                        if (root.cpu-boost-known) : RequestToggleRow {
                            icon-kind: Icons.rocket;
                            label: "Турбо-буст";
                            checked: root.cpu-boost;
                            disabled: !root.cpu-boost-writable;
                            toggled(value) => { root.cpu-boost-requested(value); }
                        }
                        if (root.cpu-co-supported) : VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Curve Optimizer";
                                    font-size: 13.5px;
                                    color: Palette.text-secondary;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.cpu-co-applied-known ? "применено " + root.cpu-co-applied : "не применялось";
                                    font-size: 12px;
                                    color: Palette.text-disabled;
                                    vertical-alignment: center;
                                }
                            }
                            ValueSlider {
                                min: -30;
                                max: 0;
                                step: 1;
                                value: root.co-draft;
                                unit: "";
                                disabled: !root.cpu-co-writable;
                                changed(v) => { root.co-draft = Math.round(v); root.co-confirming = false; }
                            }
                            if (root.co-confirming) : LocalStatus {
                                text: "Ниже −15 часто нестабильно: при сбое система перезагрузится";
                                accent: Palette.warning;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                ActionButton {
                                    width: 120px;
                                    label: "Сбросить";
                                    disabled: !root.cpu-co-writable || !root.cpu-co-applied-known || root.cpu-co-applied == 0;
                                    clicked => {
                                        root.co-confirming = false;
                                        root.co-draft = 0;
                                        root.cpu-co-requested(0);
                                    }
                                }
                                ActionButton {
                                    width: 160px;
                                    label: root.co-confirming ? "Подтвердить" : "Применить";
                                    accent: true;
                                    disabled: !root.cpu-co-writable || (root.cpu-co-applied-known && root.cpu-co-applied == root.co-draft) || (!root.cpu-co-applied-known && root.co-draft == 0);
                                    clicked => {
                                        if (root.co-draft < -15 && !root.co-confirming) {
                                            root.co-confirming = true;
                                        } else {
                                            root.co-confirming = false;
                                            root.cpu-co-requested(root.co-draft);
                                        }
                                    }
                                }
                            }
                        }
                        if (root.cpu-tuning-error != "") : LocalStatus {
                            text: root.cpu-tuning-error;
                            accent: Palette.error;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            if ((root.profile-limits-known && (root.ui-state.power-limits-writable || root.cpu-epp-writable || root.cpu-boost-writable || root.cpu-co-writable))
                || (root.power-rules-known && root.ui-state.perf-writable)) : SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 8px;
                    CardHeader { title: "Автоматизация"; icon-kind: Icons.refresh; }
                    if (root.profile-limits-known && (root.ui-state.power-limits-writable || root.cpu-epp-writable || root.cpu-boost-writable || root.cpu-co-writable)) : RequestToggleRow {
                        icon-kind: Icons.sliders;
                        label: "Запоминать настройки для каждого профиля";
                        description: root.profile-limits-summary;
                        checked: root.profile-limits-auto-apply;
                        toggled(value) => { root.profile-limits-auto-apply-toggled(value); }
                    }
                    if (root.power-rules-known && root.ui-state.perf-writable) : RequestToggleRow {
                        icon-kind: Icons.plug;
                        label: "Правила по источнику питания";
                        description: "Профиль и частота экрана при подключении и отключении зарядки";
                        checked: root.power-rules-enabled;
                        toggled(value) => { root.power-rules-enabled-toggled(value); }
                    }
                    if (root.power-rules-known && root.ui-state.perf-writable && root.power-rules-enabled) : VerticalLayout {
                        spacing: 8px;
                            FieldRow {
                                label: "От сети";
                                ChoiceButton { label: "Не менять"; selected: root.power-rules-ac == 0; clicked => { root.power-rules-profile-requested(true, 0); } }
                                ChoiceButton { label: "Тихий"; selected: root.power-rules-ac == 1; clicked => { root.power-rules-profile-requested(true, 1); } }
                                ChoiceButton { label: "Баланс"; selected: root.power-rules-ac == 2; clicked => { root.power-rules-profile-requested(true, 2); } }
                                ChoiceButton { label: "Турбо"; selected: root.power-rules-ac == 3; clicked => { root.power-rules-profile-requested(true, 3); } }
                            }
                            FieldRow {
                                label: "От батареи";
                                ChoiceButton { label: "Не менять"; selected: root.power-rules-battery == 0; clicked => { root.power-rules-profile-requested(false, 0); } }
                                ChoiceButton { label: "Тихий"; selected: root.power-rules-battery == 1; clicked => { root.power-rules-profile-requested(false, 1); } }
                                ChoiceButton { label: "Баланс"; selected: root.power-rules-battery == 2; clicked => { root.power-rules-profile-requested(false, 2); } }
                                ChoiceButton { label: "Турбо"; selected: root.power-rules-battery == 3; clicked => { root.power-rules-profile-requested(false, 3); } }
                            }
                    }
                    if (root.power-rules-error != "") : LocalStatus {
                        text: root.power-rules-error;
                        accent: Palette.error;
                    }
                }
            }

            Rectangle { vertical-stretch: 100; }
        }
    }
}
