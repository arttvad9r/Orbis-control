// Main product dashboard: device identity, daily modes, telemetry and the
// three most-used quick controls on one symmetric grid.
import { ScrollView } from "std-widgets.slint";
import { UiState, ChargeLimitState, PerformanceHwState } from "../model.slint";
import { SectionCard, SectionTitle, ActionButton, ChoiceButton, Divider, StatusPill, LocalStatus, LayoutMetrics } from "../common.slint";
import { ModeCard } from "../../components/mode-card.slint";
import { MetricCard } from "../../components/metric-card.slint";
import { ValueSlider } from "../../components/value-slider.slint";
import { Icon } from "../../components/icon.slint";
import { AppMark } from "../../components/app-mark.slint";
import { Palette } from "../../themes/dark.slint";

export component DashboardSection inherits Rectangle {
    in property <UiState> ui-state;
    in property <string> device-name: "";
    in property <string> device-board: "";
    in property <bool> keyboard-state-ready: false;
    in property <bool> keyboard-control-ready: false;
    in property <int> keyboard-brightness: -1;
    in property <string> keyboard-mutation-error: "";
    callback keyboard-brightness-requested(int);
    callback perf-clicked(int);
    callback charge-changed(float);
    callback cooling-open-requested;

    function bit-set(mask: int, bit: int) -> bool {
        let shifted = Math.floor(mask / bit);
        return shifted - 2 * Math.floor(shifted / 2) == 1;
    }

    // Only non-normal states get a line; a writable, ready profile needs none.
    function perf-note() -> string {
        if (root.ui-state.perf-state == PerformanceHwState.Ready) {
            return root.ui-state.perf-writable ? "" : "Профиль доступен только для чтения";
        }
        if (root.ui-state.perf-state == PerformanceHwState.Loading) { return ""; }
        return root.ui-state.perf-unavailable-reason;
    }

    function gpu-temp-value() -> int {
        return root.ui-state.gpu-temp != "—" || root.ui-state.igpu-temp == "—" ? root.ui-state.gpu-temp-value : root.ui-state.igpu-temp-value;
    }

    function device-title() -> string {
        if (root.device-name != "") { return root.device-name; }
        return "Ноутбук ASUS";
    }

    function device-subtitle() -> string {
        if (root.device-board != "") { return root.device-board; }
        return "—";
    }

    function battery-status-label() -> string {
        if (root.ui-state.battery-status == "") { return "—"; }
        if (root.ui-state.battery-status == "Charging" || root.ui-state.battery-status == "charging") { return "Зарядка"; }
        if (root.ui-state.battery-status == "Discharging" || root.ui-state.battery-status == "discharging") { return "От батареи"; }
        if (root.ui-state.battery-status == "Full" || root.ui-state.battery-status == "full") { return "Заряжен"; }
        if (root.ui-state.battery-status == "Not charging" || root.ui-state.battery-status == "Not Charging") { return "Не заряжается"; }
        return root.ui-state.battery-status;
    }

    function battery-status-color() -> color {
        if (root.ui-state.battery-status == "Charging" || root.ui-state.battery-status == "charging"
            || root.ui-state.battery-status == "Full" || root.ui-state.battery-status == "full") {
            return Palette.success;
        }
        return Palette.text-secondary;
    }

    function ac-status-label() -> string {
        if (root.ui-state.ac-online == "On AC") { return "От сети"; }
        if (root.ui-state.ac-online == "On battery") { return "От батареи"; }
        if (root.ui-state.ac-online == "—") { return "—"; }
        return root.ui-state.ac-online;
    }

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: LayoutMetrics.page-margin;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            // Device identity + battery at a glance.
            SectionCard {
                height: 128px;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 20px;

                    Rectangle {
                        width: 64px;
                        AppMark {
                            width: 64px;
                            height: 64px;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: root.device-title();
                            font-size: 22px;
                            font-weight: 700;
                            color: Palette.text-primary;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: root.device-subtitle();
                                font-size: 13.5px;
                                color: Palette.text-secondary;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if (!root.ui-state.telemetry-fresh) : StatusPill {
                                width: 150px;
                                text: "Данные обновляются";
                                accent: Palette.warning;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }

                    for stat[i] in [
                        { label: "Источник", value: root.ac-status-label(), detail: root.battery-status-label() },
                        { label: "Здоровье", value: root.ui-state.battery-health, detail: root.ui-state.battery-cycles + " циклов" },
                    ] : HorizontalLayout {
                        spacing: 20px;
                        Divider { width: 1px; }
                        VerticalLayout {
                            width: 108px;
                            alignment: center;
                            spacing: 4px;
                            Text { text: stat.label; font-size: 12.5px; color: Palette.text-secondary; }
                            Text { text: stat.value; font-size: 20px; font-weight: 700; color: Palette.text-primary; overflow: elide; }
                            Text {
                                text: stat.detail;
                                font-size: 12px;
                                color: i == 0 ? root.battery-status-color() : Palette.text-secondary;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            // Performance profile tiles.
            HorizontalLayout {
                height: 92px;
                spacing: 12px;
                ModeCard {
                    title: "Тихий";
                    icon-kind: 16;
                    selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 0;
                    disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 1);
                    clicked => { root.perf-clicked(0); }
                }
                ModeCard {
                    title: "Баланс";
                    icon-kind: 17;
                    selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 1;
                    disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 2);
                    clicked => { root.perf-clicked(1); }
                }
                ModeCard {
                    title: "Турбо";
                    icon-kind: 18;
                    selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 2;
                    disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 4);
                    clicked => { root.perf-clicked(2); }
                }
            }
            if (root.perf-note() != "") : LocalStatus {
                text: root.perf-note();
                accent: Palette.warning;
            }

            // Live telemetry.
            HorizontalLayout {
                spacing: LayoutMetrics.page-gap;
                MetricCard {
                    label: "Процессор";
                    value: root.ui-state.cpu-temp;
                    detail: "Вентилятор " + root.ui-state.cpu-fan-rpm;
                    icon-kind: 10;
                    accent: Palette.accent-default;
                    progress: root.ui-state.cpu-temp-value >= 0 ? root.ui-state.cpu-temp-value / 100 : -1;
                }
                MetricCard {
                    label: "Графика";
                    // A suspended dGPU reports no temperature; show the iGPU then.
                    value: root.ui-state.gpu-temp != "—" || root.ui-state.igpu-temp == "—" ? root.ui-state.gpu-temp : root.ui-state.igpu-temp;
                    detail: root.ui-state.gpu-temp == "—" && root.ui-state.igpu-temp != "—" ? "iGPU · dGPU спит" : "Вентилятор " + root.ui-state.gpu-fan-rpm;
                    icon-kind: 4;
                    accent: Palette.success;
                    progress: root.gpu-temp-value() >= 0 ? root.gpu-temp-value() / 100 : -1;
                }
                MetricCard {
                    label: "Батарея";
                    value: root.ui-state.battery-percent;
                    detail: root.ui-state.charge-limit-state == ChargeLimitState.Ready ? "Лимит " + root.ui-state.charge-limit + "%" : root.battery-status-label();
                    icon-kind: 2;
                    accent: Palette.success;
                    progress: root.ui-state.battery-percent-value >= 0 ? root.ui-state.battery-percent-value / 100 : -1;
                }
                MetricCard {
                    label: "Потребление";
                    // Not every laptop reports adapter power; fall back to the
                    // GPU that is actually awake.
                    value: root.ui-state.power-ac-mw != "—" ? root.ui-state.power-ac-mw
                        : root.ui-state.gpu-power != "—" ? root.ui-state.gpu-power
                        : root.ui-state.igpu-power;
                    detail: root.ui-state.power-ac-mw != "—" ? "dGPU " + root.ui-state.gpu-power
                        : root.ui-state.gpu-power != "—" ? "Дискретная графика"
                        : root.ui-state.igpu-power != "—" ? "Встроенная графика" : "Нет датчика";
                    icon-kind: 13;
                    accent: Palette.violet;
                }
            }

            // Quick controls: three equal cards.
            HorizontalLayout {
                spacing: LayoutMetrics.page-gap;
                height: 152px;

                SectionCard {
                    width: (parent.width - 2 * LayoutMetrics.page-gap) / 3;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 12px;
                        HorizontalLayout {
                            height: 30px;
                            SectionTitle { horizontal-stretch: 1; title: "Вентиляторы"; }
                            ActionButton {
                                width: 36px;
                                height: 30px;
                                label: "›";
                                clicked => { root.cooling-open-requested(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            for fan[i] in [
                                { label: "CPU", rpm: root.ui-state.cpu-fan-rpm },
                                { label: "GPU", rpm: root.ui-state.gpu-fan-rpm },
                            ] : VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Icon { kind: 3; tint: Palette.accent-default; }
                                    Text { text: fan.label; font-size: 12.5px; color: Palette.text-secondary; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Text { text: fan.rpm; font-size: 18px; font-weight: 650; color: Palette.text-primary; overflow: elide; }
                            }
                        }
                    }
                }

                SectionCard {
                    width: (parent.width - 2 * LayoutMetrics.page-gap) / 3;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 12px;
                        SectionTitle {
                            title: "Лимит заряда";
                            detail: root.ui-state.charge-limit-state == ChargeLimitState.Ready && !root.ui-state.charge-limit-writable ? "Только чтение" : "";
                        }
                        if (root.ui-state.charge-limit-state == ChargeLimitState.Ready) : ValueSlider {
                            min: 20; max: 100; step: 1; value: root.ui-state.charge-limit;
                            disabled: !root.ui-state.charge-limit-writable;
                            changed(v) => { root.charge-changed(v); }
                        }
                        if (root.ui-state.charge-limit-state != ChargeLimitState.Ready) : LocalStatus {
                            text: root.ui-state.charge-limit-state == ChargeLimitState.Loading ? "Чтение…" : "Недоступно";
                            accent: root.ui-state.charge-limit-state == ChargeLimitState.Loading ? Palette.text-secondary : Palette.warning;
                        }
                    }
                }

                SectionCard {
                    width: (parent.width - 2 * LayoutMetrics.page-gap) / 3;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 12px;
                        SectionTitle {
                            title: "Подсветка";
                            detail: root.keyboard-mutation-error != "" ? root.keyboard-mutation-error
                                : root.keyboard-state-ready && !root.keyboard-control-ready ? "Только чтение" : "";
                            detail-color: root.keyboard-mutation-error != "" ? Palette.warning : Palette.text-secondary;
                        }
                        if (root.keyboard-state-ready) : HorizontalLayout {
                            spacing: 6px;
                            for level in 4: ChoiceButton {
                                min-width: 0px;
                                label: level == 0 ? "Выкл" : level + "";
                                selected: root.keyboard-brightness == level;
                                disabled: !root.keyboard-control-ready;
                                clicked => { root.keyboard-brightness-requested(level); }
                            }
                        }
                        if (!root.keyboard-state-ready) : LocalStatus {
                            text: "Чтение…";
                            accent: Palette.text-secondary;
                        }
                    }
                }
            }

            Rectangle { vertical-stretch: 100; }
        }
    }
}
