// Dashboard (Главная) — reference design home page:
// device header → performance mode → telemetry row → fans → charge limit +
// keyboard lighting. Only frequently used controls live here; everything else
// stays in the themed sidebar sections. All values come from UiState; "—" is
// the honest loading/absence form.
import { ScrollView } from "std-widgets.slint";
import { UiState, ChargeLimitState, PerformanceHwState, FanCurveHwState } from "../model.slint";
import { SectionCard, SectionTitle, ActionButton, Divider } from "../common.slint";
import { ModeCard } from "../../components/mode-card.slint";
import { MetricCard } from "../../components/metric-card.slint";
import { ValueSlider } from "../../components/value-slider.slint";
import { FanCurveChart } from "../../components/fan-curve-chart.slint";
import { Icon } from "../../components/icon.slint";
import { Palette } from "../../themes/dark.slint";

export component DashboardSection inherits Rectangle {
    in property <UiState> ui-state;
    in property <string> device-name: "";
    in property <string> device-board: "";
    in property <bool> keyboard-state-ready: false;
    in property <bool> keyboard-control-ready: false;
    in property <int> keyboard-brightness: -1;
    callback keyboard-brightness-requested(int);
    callback perf-clicked(int);
    callback charge-changed(float);
    callback cooling-open-requested;

    function bit-set(mask: int, bit: int) -> bool {
        let shifted = Math.floor(mask / bit);
        return shifted - 2 * Math.floor(shifted / 2) == 1;
    }

    function perf-reason() -> string {
        if (root.ui-state.perf-state == PerformanceHwState.Ready) {
            return root.ui-state.perf-writable ? "" : "Только чтение";
        }
        return root.ui-state.perf-unavailable-reason;
    }

    function device-title() -> string {
        if (root.device-name != "") { return root.device-name; }
        return "Ноутбук ASUS";
    }

    function device-subtitle() -> string {
        if (root.device-board != "") { return root.device-board; }
        return "Модель устройства не определена";
    }

    function battery-status-label() -> string {
        if (root.ui-state.battery-status == "") { return "—"; }
        if (root.ui-state.battery-status == "Charging" || root.ui-state.battery-status == "charging") { return "Зарядка"; }
        if (root.ui-state.battery-status == "Discharging" || root.ui-state.battery-status == "discharging") { return "От батареи"; }
        if (root.ui-state.battery-status == "Full" || root.ui-state.battery-status == "full") { return "Полностью заряжен"; }
        if (root.ui-state.battery-status == "Not charging" || root.ui-state.battery-status == "Not Charging") { return "Не заряжается"; }
        return root.ui-state.battery-status;
    }

    function battery-status-color() -> color {
        if (root.ui-state.battery-status == "Charging" || root.ui-state.battery-status == "charging"
            || root.ui-state.battery-status == "Full" || root.ui-state.battery-status == "full") {
            return Palette.success;
        }
        return Palette.text-primary;
    }

    function ac-status-label() -> string {
        if (root.ui-state.ac-online == "On AC") { return "От сети"; }
        if (root.ui-state.ac-online == "On battery") { return "От батареи"; }
        if (root.ui-state.ac-online == "—") { return "Источник питания неизвестен"; }
        return root.ui-state.ac-online;
    }

    function battery-frac() -> float {
        if (root.ui-state.battery-percent-value < 0) { return 0; }
        return Math.min(Math.max(root.ui-state.battery-percent-value / 100, 0), 1);
    }

    ScrollView {
        VerticalLayout {
            width: root.width - 28px;
            x: 14px;
            spacing: 16px;
            padding-top: 4px;
            padding-bottom: 20px;

            // ── Device header ───────────────────────────────────────────
            SectionCard {
                min-height: 150px;
                HorizontalLayout {
                    padding: 20px;
                    spacing: 20px;

                    // Neutral device glyph (no model-specific assets).
                    Rectangle {
                        width: 128px;
                        background: transparent;

                        Rectangle {
                            width: 118px;
                            height: 74px;
                            x: (parent.width - self.width) / 2;
                            y: 0px;
                            border-radius: 6px;
                            border-width: 2px;
                            border-color: Palette.text-secondary;
                            background: Palette.accent-soft;
                            Rectangle {
                                width: 14px;
                                height: 14px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: Palette.accent-default;
                            }
                        }
                        Rectangle {
                            width: 128px;
                            height: 7px;
                            x: (parent.width - self.width) / 2;
                            y: 76px;
                            border-radius: 3px;
                            background: Palette.border-strong;
                        }
                    }

                    VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: root.device-title();
                            font-size: 21px;
                            font-weight: 650;
                            color: Palette.text-primary;
                            overflow: elide;
                        }
                        Text {
                            text: root.device-subtitle();
                            font-size: 13px;
                            color: Palette.text-secondary;
                            overflow: elide;
                        }
                    }

                    Divider { width: 1px; }

                    // Battery block.
                    VerticalLayout {
                        width: 132px;
                        alignment: center;
                        spacing: 3px;
                        Text { text: "Батарея"; font-size: 12px; color: Palette.text-secondary; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            Text {
                                text: root.ui-state.battery-percent;
                                font-size: 22px;
                                font-weight: 650;
                                color: Palette.text-primary;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 26px;
                                height: 13px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 3px;
                                border-width: 1.4px;
                                border-color: Palette.text-secondary;
                                Rectangle {
                                    x: 1.5px; y: 1.5px;
                                    height: parent.height - 3px;
                                    width: root.battery-frac() * (parent.width - 3px);
                                    border-radius: 1.5px;
                                    background: root.battery-status-color();
                                }
                                // Hide the pill entirely while the percent is unknown.
                                if (root.ui-state.battery-percent-value < 0) : Rectangle {
                                    x: -1.4px; y: -1.4px;
                                    width: parent.width + 2.8px;
                                    height: parent.height + 2.8px;
                                    background: Palette.surface-default;
                                }
                            }
                        }
                        Text {
                            text: root.battery-status-label();
                            font-size: 12px;
                            color: root.battery-status-color();
                            overflow: elide;
                        }
                        Text {
                            text: root.ac-status-label();
                            font-size: 11px;
                            color: Palette.text-secondary;
                            overflow: elide;
                        }
                    }

                    Divider { width: 1px; }

                    // Battery health (real evidence only; "—" while unknown).
                    VerticalLayout {
                        width: 118px;
                        alignment: center;
                        spacing: 3px;
                        Text { text: "Состояние батареи"; font-size: 12px; color: Palette.text-secondary; }
                        Text {
                            text: root.ui-state.battery-health == "—" ? "—" : root.ui-state.battery-health;
                            font-size: 22px;
                            font-weight: 650;
                            color: Palette.text-primary;
                        }
                        Text { text: "от ёмкости"; font-size: 12px; color: Palette.text-secondary; }
                    }
                }
            }

            // ── Performance mode ────────────────────────────────────────
            SectionCard {
                HorizontalLayout {
                    padding: 16px;
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 12px;
                        SectionTitle {
                            title: "Режим производительности";
                            detail: root.perf-reason();
                        }
                        HorizontalLayout {
                            height: 76px;
                            spacing: 12px;
                            ModeCard {
                                title: "Тихий";
                                description: "Минимум шума";
                                icon-kind: 16;
                                accent: Palette.silent;
                                selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 0;
                                disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 1);
                                clicked => { root.perf-clicked(0); }
                            }
                            ModeCard {
                                title: "Сбалансированный";
                                description: "Повседневные задачи";
                                icon-kind: 17;
                                accent: Palette.balanced;
                                selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 1;
                                disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 2);
                                clicked => { root.perf-clicked(1); }
                            }
                            ModeCard {
                                title: "Турбо";
                                description: "Максимальная производительность";
                                icon-kind: 18;
                                accent: Palette.turbo;
                                selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 2;
                                disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 4);
                                clicked => { root.perf-clicked(2); }
                            }
                        }
                    }
                }
            }

            // ── Telemetry ───────────────────────────────────────────────
            HorizontalLayout {
                height: 96px;
                spacing: 16px;
                MetricCard { label: "CPU"; value: root.ui-state.cpu-temp; detail: "процессор · температура"; icon-kind: 10; }
                MetricCard { label: "GPU"; value: root.ui-state.gpu-temp; detail: "дискретная графика"; icon-kind: 4; }
                MetricCard { label: "Потребление"; value: root.ui-state.power-ac-mw; detail: "от адаптера питания"; icon-kind: 13; }
                MetricCard { label: "dGPU"; value: root.ui-state.gpu-power; detail: "потребление графики"; icon-kind: 4; }
            }
            if (!root.ui-state.telemetry-fresh) : Text {
                text: "Телеметрия не подтверждена свежим чтением; показанные значения могут быть устаревшими.";
                font-size: 12px;
                color: Palette.warning;
                horizontal-alignment: center;
                overflow: elide;
            }

            // ── Fans ────────────────────────────────────────────────────
            SectionCard {
                HorizontalLayout {
                    padding: 16px;
                    spacing: 16px;

                    VerticalLayout {
                        width: 190px;
                        spacing: 12px;
                        SectionTitle { title: "Вентиляторы"; }
                        HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                width: 18px;
                                Icon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    kind: 3;
                                    tint: Palette.text-secondary;
                                }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    Text { text: "CPU"; font-size: 13px; color: Palette.text-secondary; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text { text: root.ui-state.cpu-fan-rpm; font-size: 14px; font-weight: 600; color: Palette.text-primary; vertical-alignment: center; }
                                }
                                HorizontalLayout {
                                    Text { text: "GPU"; font-size: 13px; color: Palette.text-secondary; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text { text: root.ui-state.gpu-fan-rpm; font-size: 14px; font-weight: 600; color: Palette.text-primary; vertical-alignment: center; }
                                }
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        ActionButton {
                            label: "Настроить";
                            clicked => { root.cooling-open-requested(); }
                        }
                    }

                    Divider { width: 1px; }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 12px;
                        SectionTitle {
                            title: "Кривая вентиляторов";
                            detail: root.ui-state.fan-curve-state == FanCurveHwState.Ready ? (root.ui-state.fan-curve-writable ? "" : "только чтение") : "";
                        }
                        FanCurveChart {
                            vertical-stretch: 1;
                            state: root.ui-state.fan-curve-state;
                            editable: false;
                            percent-labels: true;
                            temp-0: root.ui-state.fan-temp-0; temp-1: root.ui-state.fan-temp-1; temp-2: root.ui-state.fan-temp-2; temp-3: root.ui-state.fan-temp-3;
                            temp-4: root.ui-state.fan-temp-4; temp-5: root.ui-state.fan-temp-5; temp-6: root.ui-state.fan-temp-6; temp-7: root.ui-state.fan-temp-7;
                            pwm-0: root.ui-state.fan-pwm-0; pwm-1: root.ui-state.fan-pwm-1; pwm-2: root.ui-state.fan-pwm-2; pwm-3: root.ui-state.fan-pwm-3;
                            pwm-4: root.ui-state.fan-pwm-4; pwm-5: root.ui-state.fan-pwm-5; pwm-6: root.ui-state.fan-pwm-6; pwm-7: root.ui-state.fan-pwm-7;
                        }
                    }
                }
            }

            // ── Charge limit + keyboard lighting ────────────────────────
            HorizontalLayout {
                spacing: 16px;

                SectionCard {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        SectionTitle {
                            title: "Ограничение заряда батареи";
                            detail: root.ui-state.charge-limit-state == ChargeLimitState.Ready ? (root.ui-state.charge-limit-writable ? "" : "только чтение") : "";
                        }
                        if (root.ui-state.charge-limit-state == ChargeLimitState.Ready) : ValueSlider {
                            min: 20;
                            max: 100;
                            step: 1;
                            value: root.ui-state.charge-limit;
                            disabled: !root.ui-state.charge-limit-writable;
                            changed(v) => { root.charge-changed(v); }
                        }
                        if (root.ui-state.charge-limit-state != ChargeLimitState.Ready) : Text {
                            text: root.ui-state.charge-limit-state == ChargeLimitState.Loading
                                ? "Чтение порога заряда…"
                                : "Порог заряда недоступен";
                            font-size: 12.5px;
                            color: Palette.text-secondary;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Ограничение максимального заряда уменьшает износ аккумулятора.";
                            font-size: 11.5px;
                            color: Palette.text-secondary;
                            overflow: elide;
                        }
                    }
                }

                if (root.keyboard-state-ready) : SectionCard {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        SectionTitle {
                            title: "Подсветка клавиатуры";
                            detail: root.keyboard-control-ready ? "" : "только чтение";
                        }
                        HorizontalLayout {
                            height: 34px;
                            spacing: 8px;
                            for level in 4: Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 8px;
                                border-width: root.keyboard-brightness == level && root.keyboard-control-ready ? 1.5px : 1px;
                                border-color: root.keyboard-brightness == level && root.keyboard-control-ready ? Palette.accent-default
                                    : kb-touch.has-hover && root.keyboard-control-ready ? Palette.border-strong
                                    : Palette.border-default;
                                background: root.keyboard-brightness == level && root.keyboard-control-ready ? Palette.accent-soft
                                    : kb-touch.pressed && root.keyboard-control-ready ? Palette.surface-pressed
                                    : kb-touch.has-hover && root.keyboard-control-ready ? Palette.surface-hover
                                    : Palette.surface-default;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Icon {
                                        kind: 5;
                                        tint: root.keyboard-brightness == level && root.keyboard-control-ready ? Palette.accent-default : Palette.text-disabled;
                                    }
                                    Text {
                                        text: level == 0 ? "Выкл" : level + "";
                                        font-size: 12.5px;
                                        font-weight: 500;
                                        color: root.keyboard-control-ready ? Palette.text-primary : Palette.text-disabled;
                                        vertical-alignment: center;
                                    }
                                }
                                kb-touch := TouchArea {
                                    enabled: root.keyboard-control-ready;
                                    clicked => { root.keyboard-brightness-requested(level); }
                                }
                            }
                        }
                        Text {
                            text: "Расширенные эффекты — в разделе «Подсветка».";
                            font-size: 11.5px;
                            color: Palette.text-secondary;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
