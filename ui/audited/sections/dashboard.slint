// Main product dashboard: device identity, daily modes, telemetry and quick
// controls. It intentionally stays information-rich while using one page grid.
import { ScrollView } from "std-widgets.slint";
import { UiState, ChargeLimitState, PerformanceHwState, FanCurveHwState } from "../model.slint";
import { PageHeader, SectionCard, SectionTitle, ActionButton, Divider, StatusPill, LocalStatus, LayoutMetrics } from "../common.slint";
import { ModeCard } from "../../components/mode-card.slint";
import { MetricCard } from "../../components/metric-card.slint";
import { ValueSlider } from "../../components/value-slider.slint";
import { FanCurveChart } from "../../components/fan-curve-chart.slint";
import { Icon } from "../../components/icon.slint";
import { AppMark } from "../../components/app-mark.slint";
import { Palette } from "../../themes/dark.slint";

export component DashboardSection inherits Rectangle {
    in property <UiState> ui-state;
    in property <string> device-name: "";
    in property <string> device-board: "";
    in property <bool> keyboard-state-ready: false;
    in property <bool> keyboard-control-ready: false;
    in property <int> keyboard-brightness: -1;
    callback keyboard-brightness-requested(int);
    callback perf-clicked(int);
    callback charge-changed(float);
    callback cooling-open-requested;

    function bit-set(mask: int, bit: int) -> bool {
        let shifted = Math.floor(mask / bit);
        return shifted - 2 * Math.floor(shifted / 2) == 1;
    }

    function perf-reason() -> string {
        if (root.ui-state.perf-state == PerformanceHwState.Ready) {
            return root.ui-state.perf-writable ? "Доступно" : "Только чтение";
        }
        return root.ui-state.perf-unavailable-reason;
    }

    function device-title() -> string {
        if (root.device-name != "") { return root.device-name; }
        return "Ноутбук ASUS";
    }

    function device-subtitle() -> string {
        if (root.device-board != "") { return root.device-board; }
        return "Модель устройства определяется";
    }

    function battery-status-label() -> string {
        if (root.ui-state.battery-status == "") { return "—"; }
        if (root.ui-state.battery-status == "Charging" || root.ui-state.battery-status == "charging") { return "Зарядка"; }
        if (root.ui-state.battery-status == "Discharging" || root.ui-state.battery-status == "discharging") { return "От батареи"; }
        if (root.ui-state.battery-status == "Full" || root.ui-state.battery-status == "full") { return "Полностью заряжен"; }
        if (root.ui-state.battery-status == "Not charging" || root.ui-state.battery-status == "Not Charging") { return "Не заряжается"; }
        return root.ui-state.battery-status;
    }

    function battery-status-color() -> color {
        if (root.ui-state.battery-status == "Charging" || root.ui-state.battery-status == "charging"
            || root.ui-state.battery-status == "Full" || root.ui-state.battery-status == "full") {
            return Palette.success;
        }
        return Palette.text-secondary;
    }

    function ac-status-label() -> string {
        if (root.ui-state.ac-online == "On AC") { return "От сети"; }
        if (root.ui-state.ac-online == "On battery") { return "От батареи"; }
        if (root.ui-state.ac-online == "—") { return "Источник неизвестен"; }
        return root.ui-state.ac-online;
    }

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: 14px;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            PageHeader {
                title: "Главная";
                description: "Состояние ноутбука и часто используемые параметры.";
            }

            SectionCard {
                min-height: 118px;
                background: Palette.surface-raised;
                HorizontalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 18px;

                    Rectangle {
                        width: 54px;
                        vertical-stretch: 1;
                        background: transparent;
                        AppMark {
                            width: 54px;
                            height: 54px;
                            y: (parent.height - self.height) / 2 + 1px;
                        }
                    }

                    VerticalLayout {
                        width: 380px;
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: root.device-title();
                            font-size: 20px;
                            font-weight: 700;
                            color: Palette.text-primary;
                            overflow: elide;
                        }
                        Text {
                            text: root.device-subtitle();
                            font-size: 12.5px;
                            color: Palette.text-secondary;
                            overflow: elide;
                        }
                        Rectangle { height: 4px; background: transparent; }
                        StatusPill {
                            width: 168px;
                            text: root.ui-state.telemetry-fresh ? "Телеметрия актуальна" : "Обновление телеметрии";
                            accent: root.ui-state.telemetry-fresh ? Palette.success : Palette.warning;
                        }
                    }

                    Divider { width: 1px; }

                    VerticalLayout {
                        width: 110px;
                        alignment: center;
                        spacing: 3px;
                        Text { text: "БАТАРЕЯ"; font-size: 10.5px; font-weight: 650; color: Palette.text-disabled; }
                        Text {
                            text: root.ui-state.battery-percent;
                            font-size: 25px;
                            font-weight: 700;
                            color: Palette.text-primary;
                        }
                        Text {
                            text: root.battery-status-label();
                            font-size: 12px;
                            font-weight: 550;
                            color: root.battery-status-color();
                        }
                        Text { text: root.ac-status-label(); font-size: 11px; color: Palette.text-secondary; }
                    }

                    Divider { width: 1px; }

                    VerticalLayout {
                        width: 110px;
                        alignment: center;
                        spacing: 3px;
                        Text { text: "ЗДОРОВЬЕ"; font-size: 10.5px; font-weight: 650; color: Palette.text-disabled; }
                        Text {
                            text: root.ui-state.battery-health;
                            font-size: 25px;
                            font-weight: 700;
                            color: Palette.text-primary;
                        }
                        Text { text: "от ёмкости"; font-size: 11.5px; color: Palette.text-secondary; }
                    }
                }
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 13px;
                    SectionTitle {
                        title: "Режим производительности";
                        detail: root.perf-reason();
                        detail-color: root.ui-state.perf-writable ? Palette.success : Palette.text-secondary;
                    }
                    HorizontalLayout {
                        height: 86px;
                        spacing: 12px;
                        ModeCard {
                            title: "Тихий";
                            description: "Минимум шума";
                            icon-kind: 16;
                            accent: Palette.silent;
                            selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 0;
                            disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 1);
                            clicked => { root.perf-clicked(0); }
                        }
                        ModeCard {
                            title: "Сбалансированный";
                            description: "Повседневные задачи";
                            icon-kind: 17;
                            accent: Palette.balanced;
                            selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 1;
                            disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 2);
                            clicked => { root.perf-clicked(1); }
                        }
                        ModeCard {
                            title: "Турбо";
                            description: "Максимальная производительность";
                            icon-kind: 18;
                            accent: Palette.turbo;
                            selected: root.ui-state.perf-state == PerformanceHwState.Ready && root.ui-state.perf-selected == 2;
                            disabled: root.ui-state.perf-state != PerformanceHwState.Ready || !root.ui-state.perf-writable || !root.bit-set(root.ui-state.available-perf-mask, 4);
                            clicked => { root.perf-clicked(2); }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: 108px;
                spacing: 14px;
                MetricCard { label: "CPU"; value: root.ui-state.cpu-temp; detail: "температура процессора"; icon-kind: 10; }
                MetricCard { label: "GPU"; value: root.ui-state.gpu-temp; detail: "температура графики"; icon-kind: 4; }
                MetricCard { label: "Система"; value: root.ui-state.power-ac-mw; detail: "потребление от адаптера"; icon-kind: 13; }
                MetricCard { label: "dGPU"; value: root.ui-state.gpu-power; detail: "потребление графики"; icon-kind: 4; }
            }

            SectionCard {
                min-height: 224px;
                HorizontalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 18px;

                    VerticalLayout {
                        width: 214px;
                        spacing: 12px;
                        SectionTitle { title: "Вентиляторы"; }

                        Rectangle {
                            height: 54px;
                            border-radius: 10px;
                            background: Palette.surface-muted;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: 10px; alignment: center;
                                Rectangle {
                                    width: 18px;
                                    vertical-stretch: 1;
                                    background: transparent;
                                    Icon {
                                        kind: 3;
                                        tint: Palette.text-secondary;
                                        y: (parent.height - self.height) / 2 + 1px;
                                    }
                                }
                                Text { vertical-stretch: 1; text: "CPU"; font-size: 12.5px; color: Palette.text-secondary; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Text { vertical-stretch: 1; text: root.ui-state.cpu-fan-rpm; font-size: 14px; font-weight: 650; color: Palette.text-primary; vertical-alignment: center; }
                            }
                        }
                        Rectangle {
                            height: 54px;
                            border-radius: 10px;
                            background: Palette.surface-muted;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: 10px; alignment: center;
                                Rectangle {
                                    width: 18px;
                                    vertical-stretch: 1;
                                    background: transparent;
                                    Icon {
                                        kind: 3;
                                        tint: Palette.text-secondary;
                                        y: (parent.height - self.height) / 2 + 1px;
                                    }
                                }
                                Text { vertical-stretch: 1; text: "GPU"; font-size: 12.5px; color: Palette.text-secondary; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Text { vertical-stretch: 1; text: root.ui-state.gpu-fan-rpm; font-size: 14px; font-weight: 650; color: Palette.text-primary; vertical-alignment: center; }
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        ActionButton { label: "Настроить кривые"; clicked => { root.cooling-open-requested(); } }
                    }

                    Divider { width: 1px; }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 10px;
                        SectionTitle {
                            title: "Кривая вентилятора";
                            detail: root.ui-state.fan-curve-state == FanCurveHwState.Ready
                                ? (root.ui-state.fan-curve-writable ? "Профиль доступен" : "Только чтение")
                                : "Получение данных";
                        }
                        FanCurveChart {
                            vertical-stretch: 1;
                            state: root.ui-state.fan-curve-state;
                            editable: false;
                            percent-labels: true;
                            temp-0: root.ui-state.fan-temp-0; temp-1: root.ui-state.fan-temp-1; temp-2: root.ui-state.fan-temp-2; temp-3: root.ui-state.fan-temp-3;
                            temp-4: root.ui-state.fan-temp-4; temp-5: root.ui-state.fan-temp-5; temp-6: root.ui-state.fan-temp-6; temp-7: root.ui-state.fan-temp-7;
                            pwm-0: root.ui-state.fan-pwm-0; pwm-1: root.ui-state.fan-pwm-1; pwm-2: root.ui-state.fan-pwm-2; pwm-3: root.ui-state.fan-pwm-3;
                            pwm-4: root.ui-state.fan-pwm-4; pwm-5: root.ui-state.fan-pwm-5; pwm-6: root.ui-state.fan-pwm-6; pwm-7: root.ui-state.fan-pwm-7;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 14px;

                SectionCard {
                    horizontal-stretch: 1;
                    min-height: 136px;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 9px;
                        SectionTitle {
                            title: "Ограничение заряда";
                            detail: root.ui-state.charge-limit-state == ChargeLimitState.Ready
                                ? (root.ui-state.charge-limit-writable ? "Доступно" : "Только чтение")
                                : "Получение данных";
                        }
                        if (root.ui-state.charge-limit-state == ChargeLimitState.Ready) : ValueSlider {
                            min: 20; max: 100; step: 1; value: root.ui-state.charge-limit;
                            disabled: !root.ui-state.charge-limit-writable;
                            changed(v) => { root.charge-changed(v); }
                        }
                        if (root.ui-state.charge-limit-state != ChargeLimitState.Ready) : LocalStatus {
                            text: root.ui-state.charge-limit-state == ChargeLimitState.Loading ? "Чтение порога заряда" : "Порог заряда недоступен";
                            accent: root.ui-state.charge-limit-state == ChargeLimitState.Loading ? Palette.text-secondary : Palette.warning;
                        }
                    }
                }

                SectionCard {
                    horizontal-stretch: 1;
                    min-height: 136px;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 9px;
                        SectionTitle {
                            title: "Подсветка клавиатуры";
                            detail: root.keyboard-state-ready ? (root.keyboard-control-ready ? "Доступно" : "Только чтение") : "Определяется";
                        }
                        if (root.keyboard-state-ready) : HorizontalLayout {
                            height: 40px;
                            spacing: 8px;
                            for level in 4: Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 10px;
                                border-width: root.keyboard-brightness == level && root.keyboard-control-ready ? 1.5px : 1px;
                                border-color: root.keyboard-brightness == level && root.keyboard-control-ready ? Palette.accent-default : Palette.border-default;
                                background: root.keyboard-brightness == level && root.keyboard-control-ready ? Palette.accent-soft : Palette.surface-raised;
                                Text {
                                    text: level == 0 ? "Выкл" : level + "";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: root.keyboard-control-ready ? Palette.text-primary : Palette.text-disabled;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                kb-touch := TouchArea {
                                    enabled: root.keyboard-control-ready;
                                    clicked => { root.keyboard-brightness-requested(level); }
                                }
                            }
                        }
                        if (!root.keyboard-state-ready) : LocalStatus {
                            text: "Получение состояния подсветки";
                            accent: Palette.text-secondary;
                        }
                    }
                }
            }
        }
    }
}
