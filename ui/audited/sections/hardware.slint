// Hardware section: remaining hardware surfaces in compact grouped rows
// (spec §2.3). Carried over from the former extra-window; the keyboard
// brightness quick control lives on the Dashboard now, so this section keeps
// only the Aura effect/speed observation rows.
import { ScrollView, ComboBox, SpinBox } from "std-widgets.slint";
import { RequestToggleRow } from "../../components/request-toggle-row.slint";
import { ThemeBridge, SectionCard, SectionTitle, ActionButton, LocalStatus } from "../common.slint";
import { Palette } from "../../themes/dark.slint";

export component HardwareSection inherits Rectangle {
    // backend-ready means the remaining multi-field editable draft/apply
    // backend exists. Proven independent hardware controls below may be writable
    // without enabling that unrelated draft surface.
    in property <bool> backend-ready: false;
    in property <bool> applying: false;
    in property <string> status: "Advanced controls backend unavailable";

    in property <bool> keyboard-state-ready: false;
    in property <bool> aura-state-ready: false;
    in property <bool> panel-overdrive-state-ready: false;
    in property <bool> panel-overdrive-control-ready: false;
    in property <bool> boot-sound-state-ready: false;

    in-out property <int> m1-action: 0;
    in-out property <int> m2-action: 0;
    in-out property <int> m3-action: 0;
    in-out property <int> m4-action: 0;
    in-out property <int> m5-action: 0;

    // These values are authoritative observations when their state-ready flag
    // is set. Known direct controls emit a request and are replaced only by
    // backend read-back; they are not optimistic drafts.
    in-out property <int> keyboard-effect: -1;
    in-out property <int> keyboard-speed: -1;
    in-out property <bool> boot-sound: false;
    in-out property <bool> status-led: false;
    in-out property <bool> panel-overdrive: false;
    in-out property <bool> auto-clamshell: false;
    in-out property <bool> disable-aspm: false;
    in-out property <bool> disable-standby-networking: false;
    in-out property <int> igpu-memory: 0;
    in-out property <int> hibernate-after: 0;
    in-out property <int> p-cores: 1;
    in-out property <int> e-cores: 0;

    callback reload-requested;
    callback apply-requested;
    callback panel-overdrive-requested(bool);

    property <bool> any-observed-state: root.keyboard-state-ready || root.aura-state-ready || root.panel-overdrive-state-ready || root.boot-sound-state-ready;
    property <bool> any-direct-write: root.panel-overdrive-control-ready;
    property <[string]> binding-actions: ["Default", "None", "Mute", "Volume Up", "Volume Down", "Mic", "Screen", "Aura", "Performance", "GPU Mode"];

    ThemeBridge { }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        LocalStatus { text: root.status; accent: root.backend-ready || root.any-observed-state ? Palette.text-secondary : Palette.warning; }

        scroll := ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 10px;

                SectionCard {
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        SectionTitle { title: "Hotkeys"; detail: root.backend-ready ? "Draft" : "Unavailable"; }

                        HorizontalLayout {
                            height: 30px; spacing: 10px;
                            HorizontalLayout { horizontal-stretch: 1; spacing: 6px; Text { width: 26px; text: "M1"; font-size: 10px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } ComboBox { horizontal-stretch: 1; enabled: root.backend-ready && !root.applying; model: root.binding-actions; current-index <=> root.m1-action; } }
                            HorizontalLayout { horizontal-stretch: 1; spacing: 6px; Text { width: 26px; text: "M2"; font-size: 10px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } ComboBox { horizontal-stretch: 1; enabled: root.backend-ready && !root.applying; model: root.binding-actions; current-index <=> root.m2-action; } }
                        }
                        HorizontalLayout {
                            height: 30px; spacing: 10px;
                            HorizontalLayout { horizontal-stretch: 1; spacing: 6px; Text { width: 26px; text: "M3"; font-size: 10px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } ComboBox { horizontal-stretch: 1; enabled: root.backend-ready && !root.applying; model: root.binding-actions; current-index <=> root.m3-action; } }
                            HorizontalLayout { horizontal-stretch: 1; spacing: 6px; Text { width: 26px; text: "M4"; font-size: 10px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } ComboBox { horizontal-stretch: 1; enabled: root.backend-ready && !root.applying; model: root.binding-actions; current-index <=> root.m4-action; } }
                        }
                        HorizontalLayout {
                            height: 30px; spacing: 10px;
                            HorizontalLayout { horizontal-stretch: 1; spacing: 6px; Text { width: 26px; text: "M5"; font-size: 10px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } ComboBox { horizontal-stretch: 1; enabled: root.backend-ready && !root.applying; model: root.binding-actions; current-index <=> root.m5-action; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                    }
                }

                SectionCard {
                    VerticalLayout {
                        padding: 10px; spacing: 7px;
                        SectionTitle {
                            title: "Keyboard / Aura";
                            detail: root.aura-state-ready ? (root.panel-overdrive-control-ready ? "Hardware1 write ready" : "Observed · read only") : "Unavailable";
                        }
                        HorizontalLayout {
                            height: 30px; spacing: 8px; alignment: center;
                            Text { width: 92px; text: "Effect"; font-size: 10px; color: root.aura-state-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; }
                            // The existing privileged Aura writer is Static RGB,
                            // not mode/speed. Keep these fields read-only until a
                            // typed effect mutation contract exists.
                            ComboBox { horizontal-stretch: 1; enabled: false; model: ["Static", "Breathing", "Color Cycle", "Strobing"]; current-index <=> root.keyboard-effect; }
                            ComboBox { width: 122px; enabled: false; model: ["Slow", "Normal", "Fast"]; current-index <=> root.keyboard-speed; }
                        }
                        RequestToggleRow {
                            label: "Boot sound";
                            description: root.boot-sound-state-ready ? "Firmware attribute · read only" : "State unavailable";
                            checked: root.boot-sound-state-ready && root.boot-sound;
                            disabled: true;
                        }
                        RequestToggleRow {
                            label: "Status LEDs";
                            description: root.backend-ready ? "Draft surface · Apply persists the draft" : "Waiting for advanced backend";
                            checked: root.status-led;
                            disabled: !root.backend-ready || root.applying;
                            toggled(value) => { root.status-led = value; }
                        }
                    }
                }

                SectionCard {
                    VerticalLayout {
                        padding: 10px; spacing: 3px;
                        SectionTitle { title: "Platform"; detail: root.panel-overdrive-state-ready ? (root.panel-overdrive-control-ready ? "Hardware1 write ready" : "Partial observation") : (root.backend-ready ? "Hardware draft" : "Unavailable"); }
                        RequestToggleRow {
                            label: "Panel overdrive";
                            description: root.panel-overdrive-state-ready ? (root.panel-overdrive-control-ready ? "Request is committed only after authoritative read-back" : "Observed from asus-armoury · read only") : "State unavailable";
                            checked: root.panel-overdrive;
                            disabled: !root.panel-overdrive-control-ready || root.applying;
                            toggled(value) => { root.panel-overdrive-requested(value); }
                        }
                        RequestToggleRow {
                            label: "Auto clamshell mode";
                            description: root.backend-ready ? "Draft surface · Apply persists the draft" : "Waiting for advanced backend";
                            checked: root.auto-clamshell;
                            disabled: !root.backend-ready || root.applying;
                            toggled(value) => { root.auto-clamshell = value; }
                        }
                        RequestToggleRow {
                            label: "Disable PCIe ASPM when plugged in";
                            description: root.backend-ready ? "Draft surface · Apply persists the draft" : "Waiting for advanced backend";
                            checked: root.disable-aspm;
                            disabled: !root.backend-ready || root.applying;
                            toggled(value) => { root.disable-aspm = value; }
                        }
                        RequestToggleRow {
                            label: "Disable networking in Modern Standby";
                            description: root.backend-ready ? "Draft surface · Apply persists the draft" : "Waiting for advanced backend";
                            checked: root.disable-standby-networking;
                            disabled: !root.backend-ready || root.applying;
                            toggled(value) => { root.disable-standby-networking = value; }
                        }
                    }
                }

                SectionCard {
                    VerticalLayout {
                        padding: 10px; spacing: 7px;
                        SectionTitle { title: "Power / CPU"; detail: root.backend-ready ? "Draft" : "Unavailable"; }
                        HorizontalLayout { height: 30px; spacing: 8px; alignment: center; Text { width: 142px; text: "iGPU memory"; font-size: 10px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } ComboBox { horizontal-stretch: 1; enabled: root.backend-ready && !root.applying; model: ["Auto", "512 MB", "1 GB", "2 GB", "4 GB", "8 GB"]; current-index <=> root.igpu-memory; } }
                        HorizontalLayout { height: 30px; spacing: 8px; alignment: center; Text { width: 142px; text: "Hibernate after"; font-size: 10px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } SpinBox { width: 120px; enabled: root.backend-ready && !root.applying; minimum: 0; maximum: 1440; step-size: 5; value <=> root.hibernate-after; } Text { text: "min"; font-size: 9px; color: Palette.text-secondary; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } }
                        HorizontalLayout { height: 30px; spacing: 8px; alignment: center; Text { width: 142px; text: "Performance cores"; font-size: 10px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } SpinBox { width: 120px; enabled: root.backend-ready && !root.applying; minimum: 1; maximum: 32; value <=> root.p-cores; } Rectangle { horizontal-stretch: 1; background: transparent; } }
                        HorizontalLayout { height: 30px; spacing: 8px; alignment: center; Text { width: 142px; text: "Efficiency cores"; font-size: 10px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } SpinBox { width: 120px; enabled: root.backend-ready && !root.applying; minimum: 0; maximum: 32; value <=> root.e-cores; } Rectangle { horizontal-stretch: 1; background: transparent; } }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 30px;
            spacing: 6px;
            Text {
                horizontal-stretch: 1;
                text: root.backend-ready ? "Edit the remaining draft, then Apply" : (root.any-direct-write ? "Proven hardware controls apply individually after read-back" : (root.any-observed-state ? "Observed values are read only; unsupported controls stay disabled" : "No advanced-control state loaded"));
                font-size: 9px;
                color: Palette.text-disabled;
                vertical-alignment: center;
            }
            ActionButton { width: 88px; label: "Reload"; disabled: (!root.backend-ready && !root.any-observed-state) || root.applying; clicked => { root.reload-requested(); } }
            ActionButton { width: 96px; label: root.applying ? "Applying…" : "Apply"; accent: true; disabled: !root.backend-ready || root.applying; clicked => { root.apply-requested(); } }
        }
    }
}
