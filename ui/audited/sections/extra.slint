// Extra page — G-Helper Extra-tab layout: Bindings, Backlight, Other,
// Power/CPU and the app settings group (spec §2.3/§2.4 merged).
import { ScrollView, ComboBox, SpinBox } from "std-widgets.slint";
import { RequestToggleRow } from "../../components/request-toggle-row.slint";
import { ChoiceChip } from "../../components/visual-controls.slint";
import { ModeCard } from "../../components/mode-card.slint";
import { ThemeBridge, SectionTitle, ActionButton, LocalStatus } from "../common.slint";
import { Palette, ThemeState, ThemeMode } from "../../themes/dark.slint";

export component ExtraSection inherits Rectangle {
    // Hardware draft/observation surface (former extra-window contract).
    in property <bool> backend-ready: false;
    in property <bool> applying: false;
    in property <string> status: "Advanced controls backend unavailable";
    in property <bool> keyboard-state-ready: false;
    in property <bool> keyboard-control-ready: false;
    in property <int> keyboard-brightness: -1;
    in property <bool> aura-state-ready: false;
    in property <bool> panel-overdrive-state-ready: false;
    in property <bool> panel-overdrive-control-ready: false;
    in property <bool> boot-sound-state-ready: false;
    in-out property <int> m1-action: 0;
    in-out property <int> m2-action: 0;
    in-out property <int> m3-action: 0;
    in-out property <int> m4-action: 0;
    in-out property <int> m5-action: 0;
    in-out property <int> keyboard-effect: -1;
    in-out property <int> keyboard-speed: -1;
    in-out property <bool> boot-sound: false;
    in-out property <bool> status-led: false;
    in-out property <bool> panel-overdrive: false;
    in-out property <bool> auto-clamshell: false;
    in-out property <bool> disable-aspm: false;
    in-out property <bool> disable-standby-networking: false;
    in-out property <int> igpu-memory: 0;
    in-out property <int> hibernate-after: 0;
    in-out property <int> p-cores: 1;
    in-out property <int> e-cores: 0;
    callback reload-requested;
    callback apply-requested;
    callback panel-overdrive-requested(bool);
    callback keyboard-brightness-requested(int);

    // App settings (former preferences + diagnostics surfaces).
    callback theme-changed(bool);
    callback start-minimized-changed(bool);
    callback remember-position-changed(bool);
    callback close-action-changed(int);
    in property <bool> start-minimized: false;
    in property <bool> start-minimized-enabled: false;
    in property <bool> remember-position: false;
    in property <bool> remember-position-enabled: false;
    in property <int> close-action: 0;
    in property <bool> close-action-enabled: false;
    in property <bool> hide-to-tray-enabled: false;
    in-out property <bool> refresh-enabled: false;
    in property <bool> refresh-pending: false;
    in property <string> diagnostics-summary: "";
    in property <bool> export-enabled: false;
    in property <string> diagnostics-status: "Diagnostics unavailable · lifecycle wiring pending";
    callback diagnostics-refresh-requested;
    callback diagnostics-export-requested;
    in-out property <string> settings-local-status: "Theme changes are saved immediately";

    property <[string]> binding-actions: ["Default", "None", "Mute", "Volume Up", "Volume Down", "Mic", "Screen", "Aura", "Performance", "GPU Mode"];

    ThemeBridge { }

    ScrollView {
        viewport-width: self.width - 14px;
        viewport-height: 980px;

        VerticalLayout {
            width: root.width - 28px;
            height: 980px;
            spacing: 10px;

            LocalStatus { text: root.status; accent: root.backend-ready || root.keyboard-state-ready || root.aura-state-ready || root.panel-overdrive-state-ready || root.boot-sound-state-ready ? Palette.text-secondary : Palette.warning; }

            VerticalLayout {
                spacing: 4px;
                SectionTitle { title: "Bindings"; detail: root.backend-ready ? "Draft" : "Unavailable"; }
                HorizontalLayout { height: 30px; spacing: 10px; HorizontalLayout { horizontal-stretch: 1; spacing: 6px; Text { width: 26px; text: "M1"; font-size: 12px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } ComboBox { horizontal-stretch: 1; enabled: root.backend-ready && !root.applying; model: root.binding-actions; current-index <=> root.m1-action; } } HorizontalLayout { horizontal-stretch: 1; spacing: 6px; Text { width: 26px; text: "M2"; font-size: 12px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } ComboBox { horizontal-stretch: 1; enabled: root.backend-ready && !root.applying; model: root.binding-actions; current-index <=> root.m2-action; } } }
                HorizontalLayout { height: 30px; spacing: 10px; HorizontalLayout { horizontal-stretch: 1; spacing: 6px; Text { width: 26px; text: "M3"; font-size: 12px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } ComboBox { horizontal-stretch: 1; enabled: root.backend-ready && !root.applying; model: root.binding-actions; current-index <=> root.m3-action; } } HorizontalLayout { horizontal-stretch: 1; spacing: 6px; Text { width: 26px; text: "M4"; font-size: 12px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } ComboBox { horizontal-stretch: 1; enabled: root.backend-ready && !root.applying; model: root.binding-actions; current-index <=> root.m4-action; } } }
                HorizontalLayout { height: 30px; spacing: 10px; HorizontalLayout { horizontal-stretch: 1; spacing: 6px; Text { width: 26px; text: "M5"; font-size: 12px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } ComboBox { horizontal-stretch: 1; enabled: root.backend-ready && !root.applying; model: root.binding-actions; current-index <=> root.m5-action; } } Rectangle { horizontal-stretch: 1; } }
            }

            VerticalLayout {
                spacing: 6px;
                SectionTitle { title: "Backlight"; detail: root.keyboard-state-ready ? "Hardware1" : "Unavailable"; }
                HorizontalLayout {
                    height: 36px;
                    spacing: 4px;
                    ModeCard { title: "Off"; icon-kind: 4; icon-visible: false; min-height: 36px; width: 94px; accent: Palette.accent-default; selected: root.keyboard-control-ready && root.keyboard-brightness == 0; disabled: !root.keyboard-control-ready; clicked => { root.keyboard-brightness-requested(0); } }
                    ModeCard { title: "1"; icon-kind: 4; icon-visible: false; min-height: 36px; width: 94px; accent: Palette.accent-default; selected: root.keyboard-control-ready && root.keyboard-brightness == 1; disabled: !root.keyboard-control-ready; clicked => { root.keyboard-brightness-requested(1); } }
                    ModeCard { title: "2"; icon-kind: 4; icon-visible: false; min-height: 36px; width: 94px; accent: Palette.accent-default; selected: root.keyboard-control-ready && root.keyboard-brightness == 2; disabled: !root.keyboard-control-ready; clicked => { root.keyboard-brightness-requested(2); } }
                    ModeCard { title: "3"; icon-kind: 4; icon-visible: false; min-height: 36px; width: 94px; accent: Palette.accent-default; selected: root.keyboard-control-ready && root.keyboard-brightness == 3; disabled: !root.keyboard-control-ready; clicked => { root.keyboard-brightness-requested(3); } }
                }
                HorizontalLayout {
                    height: 30px; spacing: 8px;
                    Text { width: 92px; text: "Effect"; font-size: 12px; color: root.aura-state-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; }
                    // The privileged Aura writer is Static RGB only; effect/speed
                    // stay read-only until a typed effect contract exists.
                    ComboBox { horizontal-stretch: 1; enabled: false; model: ["Static", "Breathing", "Color Cycle", "Strobing"]; current-index <=> root.keyboard-effect; }
                    ComboBox { width: 122px; enabled: false; model: ["Slow", "Normal", "Fast"]; current-index <=> root.keyboard-speed; }
                }
            }

            VerticalLayout {
                spacing: 2px;
                SectionTitle { title: "Other"; detail: root.panel-overdrive-state-ready ? (root.panel-overdrive-control-ready ? "Hardware1 write ready" : "Read only") : "Unavailable"; }
                RequestToggleRow {
                    label: "Panel overdrive";
                    description: root.panel-overdrive-state-ready ? (root.panel-overdrive-control-ready ? "Committed only after authoritative read-back" : "Observed · read only") : "State unavailable";
                    checked: root.panel-overdrive;
                    disabled: !root.panel-overdrive-control-ready || root.applying;
                    toggled(value) => { root.panel-overdrive-requested(value); }
                }
                RequestToggleRow {
                    label: "Boot sound";
                    description: root.boot-sound-state-ready ? "Firmware attribute · read only" : "State unavailable";
                    checked: root.boot-sound-state-ready && root.boot-sound;
                    disabled: true;
                }
                RequestToggleRow {
                    label: "Status LEDs";
                    description: root.backend-ready ? "Draft surface · Apply persists the draft" : "Waiting for advanced backend";
                    checked: root.status-led;
                    disabled: !root.backend-ready || root.applying;
                    toggled(value) => { root.status-led = value; }
                }
                RequestToggleRow {
                    label: "Auto clamshell mode";
                    description: root.backend-ready ? "Draft surface · Apply persists the draft" : "Waiting for advanced backend";
                    checked: root.auto-clamshell;
                    disabled: !root.backend-ready || root.applying;
                    toggled(value) => { root.auto-clamshell = value; }
                }
                RequestToggleRow {
                    label: "Disable PCIe ASPM when plugged in";
                    description: root.backend-ready ? "Draft surface · Apply persists the draft" : "Waiting for advanced backend";
                    checked: root.disable-aspm;
                    disabled: !root.backend-ready || root.applying;
                    toggled(value) => { root.disable-aspm = value; }
                }
                RequestToggleRow {
                    label: "Disable networking in Modern Standby";
                    description: root.backend-ready ? "Draft surface · Apply persists the draft" : "Waiting for advanced backend";
                    checked: root.disable-standby-networking;
                    disabled: !root.backend-ready || root.applying;
                    toggled(value) => { root.disable-standby-networking = value; }
                }
            }

            VerticalLayout {
                spacing: 6px;
                SectionTitle { title: "Power / CPU"; detail: root.backend-ready ? "Draft" : "Unavailable"; }
                HorizontalLayout { height: 30px; spacing: 8px; Text { width: 142px; text: "iGPU memory"; font-size: 12px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } ComboBox { horizontal-stretch: 1; enabled: root.backend-ready && !root.applying; model: ["Auto", "512 MB", "1 GB", "2 GB", "4 GB", "8 GB"]; current-index <=> root.igpu-memory; } }
                HorizontalLayout { height: 30px; spacing: 8px; Text { width: 142px; text: "Hibernate after"; font-size: 12px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } SpinBox { width: 120px; enabled: root.backend-ready && !root.applying; minimum: 0; maximum: 1440; step-size: 5; value <=> root.hibernate-after; } Text { text: "min"; font-size: 12px; color: Palette.text-secondary; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } }
                HorizontalLayout { height: 30px; spacing: 8px; Text { width: 142px; text: "Performance cores"; font-size: 12px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } SpinBox { width: 120px; enabled: root.backend-ready && !root.applying; minimum: 1; maximum: 32; value <=> root.p-cores; } Rectangle { horizontal-stretch: 1; } }
                HorizontalLayout { height: 30px; spacing: 8px; Text { width: 142px; text: "Efficiency cores"; font-size: 12px; color: root.backend-ready ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; } SpinBox { width: 120px; enabled: root.backend-ready && !root.applying; minimum: 0; maximum: 32; value <=> root.e-cores; } Rectangle { horizontal-stretch: 1; } }
            }

            VerticalLayout {
                spacing: 6px;
                SectionTitle { title: "Settings"; detail: "Saved immediately"; }
                HorizontalLayout {
                    height: 30px; spacing: 6px;
                    Text { width: 142px; text: "Theme"; font-size: 12px; color: Palette.text-primary; vertical-alignment: center; }
                    ChoiceChip { horizontal-stretch: 1; label: "Dark"; selected: ThemeState.mode == ThemeMode.Dark; clicked => { ThemeState.mode = ThemeMode.Dark; root.theme-changed(false); } }
                    ChoiceChip { horizontal-stretch: 1; label: "Light"; selected: ThemeState.mode == ThemeMode.Light; clicked => { ThemeState.mode = ThemeMode.Light; root.theme-changed(true); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                RequestToggleRow {
                    label: "Start minimized";
                    description: root.start-minimized-enabled ? "Open without focusing the main window" : "Waiting for preferences lifecycle";
                    checked: root.start-minimized;
                    disabled: !root.start-minimized-enabled;
                    toggled(value) => { root.start-minimized-changed(value); }
                }
                RequestToggleRow {
                    label: "Remember window position";
                    description: root.remember-position-enabled ? "Restore only when the window system supports it" : "Unavailable on current lifecycle/backend";
                    checked: root.remember-position;
                    disabled: !root.remember-position-enabled;
                    toggled(value) => { root.remember-position-changed(value); }
                }
                HorizontalLayout {
                    height: 30px; spacing: 6px;
                    Text { width: 142px; text: "Close button"; font-size: 12px; color: root.close-action-enabled ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; }
                    ComboBox {
                        width: 200px;
                        enabled: root.close-action-enabled;
                        model: ["Quit", "Hide to tray"];
                        current-index: root.close-action;
                        selected => {
                            if (!root.hide-to-tray-enabled && self.current-index == 1) {
                                self.current-index = root.close-action;
                            } else {
                                root.close-action-changed(self.current-index);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: 30px; spacing: 6px;
                    ActionButton { width: 96px; label: root.refresh-pending ? "Refreshing…" : "Refresh"; disabled: !root.refresh-enabled || root.refresh-pending; clicked => { root.diagnostics-refresh-requested(); } }
                    ActionButton {
                        width: 96px;
                        label: "Copy";
                        disabled: root.diagnostics-summary == "";
                        clicked => {
                            copy-ti.select-all();
                            copy-ti.copy();
                            root.settings-local-status = "Diagnostics copied to clipboard";
                        }
                    }
                    ActionButton { width: 96px; label: "Export"; disabled: !root.export-enabled; clicked => { root.diagnostics-export-requested(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                LocalStatus { text: root.diagnostics-status; accent: Palette.text-secondary; }
                LocalStatus { text: root.settings-local-status; accent: Palette.text-secondary; }
            }

            HorizontalLayout {
                height: 30px;
                spacing: 6px;
                Text {
                    horizontal-stretch: 1;
                    text: root.backend-ready ? "Edit the draft, then Apply" : "Proven hardware controls apply individually after read-back";
                    font-size: 12px;
                    color: Palette.text-disabled;
                    vertical-alignment: center;
                }
                ActionButton { width: 88px; label: "Reload"; disabled: !root.backend-ready || root.applying; clicked => { root.reload-requested(); } }
                ActionButton { width: 96px; label: root.applying ? "Applying…" : "Apply"; accent: true; disabled: !root.backend-ready || root.applying; clicked => { root.apply-requested(); } }
            }
        }
    }

    copy-ti := TextInput {
        y: -1000px;
        width: 1px;
        height: 1px;
        text: root.diagnostics-summary;
        read-only: true;
    }
}
