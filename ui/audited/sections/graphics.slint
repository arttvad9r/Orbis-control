// Graphics page — product GPU mode with explicit current/queued semantics and
// observed dGPU hardware state.
import { ScrollView } from "std-widgets.slint";
import { UiState, GpuHwState, GpuModeHwState, NvidiaRow } from "../model.slint";
import { ValueSlider } from "../../components/value-slider.slint";
import { PageHeader, SectionCard, SectionTitle, CardHeader, InfoRow, LocalStatus, LayoutMetrics, PageSurface } from "../common.slint";
import { Icon, Icons } from "../../components/icon.slint";
import { ModeCard } from "../../components/mode-card.slint";
import { Palette } from "../../themes/dark.slint";

// Display path diagram: iGPU ─ MUX ─ dGPU with the side that drives the
// internal panel lit (from the observed MUX state, never assumed).
component MuxDiagram inherits Rectangle {
    // 0 = hybrid (iGPU drives the panel), 1 = discrete, -1 = unknown.
    in property <int> route: -1;
    in property <bool> dgpu-active: false;
    property <color> igpu-tint: root.route == 0 ? Palette.accent-default : Palette.text-disabled;
    property <color> dgpu-tint: root.route == 1 ? Palette.success : root.dgpu-active ? Palette.success.transparentize(0.4) : Palette.text-disabled;
    height: 120px;
    background: transparent;

    // Traces.
    for i in 3 : Rectangle {
        x: 100px;
        y: parent.height / 2 - 18px + i * 18px - 1px;
        width: parent.width / 2 - 144px;
        height: 2px;
        background: root.igpu-tint.transparentize(i == 1 ? 0 : 0.5);
    }
    for i in 3 : Rectangle {
        x: parent.width / 2 + 44px;
        y: parent.height / 2 - 18px + i * 18px - 1px;
        width: parent.width / 2 - 144px;
        height: 2px;
        background: root.dgpu-tint.transparentize(i == 1 ? 0 : 0.5);
    }
    // Chips.
    for chip[i] in [
        { label: "iGPU", tint: root.igpu-tint },
        { label: "dGPU", tint: root.dgpu-tint },
    ] : Rectangle {
        x: i == 0 ? 0px : parent.width - 100px;
        y: (parent.height - 56px) / 2;
        width: 100px;
        height: 56px;
        border-radius: 12px;
        border-width: 1.5px;
        border-color: chip.tint;
        background: chip.tint.transparentize(0.88);
        Text { text: chip.label; font-size: 16px; font-weight: 650; color: chip.tint; horizontal-alignment: center; vertical-alignment: center; }
    }
    Rectangle {
        x: parent.width / 2 - 44px;
        y: (parent.height - 88px) / 2;
        width: 88px;
        height: 88px;
        border-radius: 14px;
        border-width: 2px;
        border-color: root.route == 0 ? Palette.accent-default : root.route == 1 ? Palette.success : Palette.border-strong;
        background: #141B2B;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: "MUX"; font-size: 18px; font-weight: 700; color: Palette.text-primary; horizontal-alignment: center; }
            Text {
                text: root.route == 0 ? "гибрид" : root.route == 1 ? "прямой" : "—";
                font-size: 11.5px;
                color: Palette.text-secondary;
                horizontal-alignment: center;
            }
        }
    }
}

export component GraphicsSection inherits PageSurface {
    in property <UiState> ui-state;
    callback gpu-clicked(int);
    in property <bool> gpu-optimized: false;
    callback gpu-optimized-requested(bool);
    in property <bool> nvidia-visible: false;
    in property <bool> nvidia-writable: false;
    in property <string> nvidia-status: "";
    in property <string> nvidia-error: "";
    in property <[NvidiaRow]> nvidia-rows: [];
    callback nvidia-tuning-requested(int, int);

    function bit-set(mask: int, bit: int) -> bool {
        let shifted = Math.floor(mask / bit);
        return shifted - 2 * Math.floor(shifted / 2) == 1;
    }

    function mode-label(index: int) -> string {
        if (index == 0) { return "Eco"; }
        if (index == 1) { return "Standard"; }
        if (index == 2) { return "Ultimate"; }
        return "—";
    }

    function power-label() -> string {
        if (root.ui-state.gpu-power-state == GpuHwState.Loading) { return "—"; }
        if (root.ui-state.gpu-power-state == GpuHwState.Unavailable) { return "Недоступно"; }
        if (root.ui-state.gpu-power-value == 0) { return "Активна"; }
        if (root.ui-state.gpu-power-value == 1) { return "Приостановлена"; }
        if (root.ui-state.gpu-power-value == 2) { return "Выключена"; }
        return "Неизвестно";
    }

    function mux-label() -> string {
        if (root.ui-state.gpu-mux-state == GpuHwState.Loading) { return "—"; }
        if (root.ui-state.gpu-mux-state == GpuHwState.Unavailable) { return "Недоступно"; }
        if (root.ui-state.gpu-mux-value == 0) { return "Гибрид (iGPU)"; }
        if (root.ui-state.gpu-mux-value == 1) { return "Дискретный"; }
        return "Неизвестно";
    }

    function access-label() -> string {
        if (root.ui-state.gpu-access-state == GpuHwState.Loading) { return "—"; }
        if (root.ui-state.gpu-access-state == GpuHwState.Unavailable) { return "Недоступно"; }
        if (root.ui-state.gpu-access-value == 0) { return "Не заблокирована"; }
        if (root.ui-state.gpu-access-value == 1) { return "Заблокирована"; }
        if (root.ui-state.gpu-access-value == 2) { return "Ожидает"; }
        return "Неизвестно";
    }

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: LayoutMetrics.page-margin;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            PageHeader { title: "Графика"; subtitle: "Режим GPU, MUX и разгон NVIDIA"; }

            HorizontalLayout {
                height: 92px;
                spacing: 12px;
                if (root.bit-set(root.ui-state.available-gpu-mask, 1)) : ModeCard {
                    title: "Eco";
                    icon-kind: Icons.leaf;
                    selected: root.ui-state.gpu-mode-state == GpuModeHwState.Ready && root.ui-state.gpu-selected == 0 && !root.gpu-optimized;
                    pending: root.ui-state.gpu-queued == 0;
                    disabled: root.ui-state.gpu-mode-state != GpuModeHwState.Ready || !root.ui-state.gpu-mode-writable || root.ui-state.gpu-mode-pending || root.ui-state.gpu-mode-unconfirmed;
                    clicked => { if (root.gpu-optimized) { root.gpu-optimized-requested(false); } root.gpu-clicked(0); }
                }
                if (root.bit-set(root.ui-state.available-gpu-mask, 2)) : ModeCard {
                    title: "Standard";
                    icon-kind: Icons.gpu;
                    selected: root.ui-state.gpu-mode-state == GpuModeHwState.Ready && root.ui-state.gpu-selected == 1 && !root.gpu-optimized;
                    pending: root.ui-state.gpu-queued == 1;
                    disabled: root.ui-state.gpu-mode-state != GpuModeHwState.Ready || !root.ui-state.gpu-mode-writable || root.ui-state.gpu-mode-pending || root.ui-state.gpu-mode-unconfirmed;
                    clicked => { if (root.gpu-optimized) { root.gpu-optimized-requested(false); } root.gpu-clicked(1); }
                }
                if (root.bit-set(root.ui-state.available-gpu-mask, 4)) : ModeCard {
                    title: "Ultimate";
                    icon-kind: Icons.rocket;
                    selected: root.ui-state.gpu-mode-state == GpuModeHwState.Ready && root.ui-state.gpu-selected == 2 && !root.gpu-optimized;
                    pending: root.ui-state.gpu-ultimate-pending || root.ui-state.gpu-queued == 2;
                    disabled: root.ui-state.gpu-mode-state != GpuModeHwState.Ready || !root.ui-state.gpu-mode-writable || root.ui-state.gpu-mode-pending || root.ui-state.gpu-mode-unconfirmed || root.ui-state.gpu-ultimate-disabled;
                    clicked => { if (root.gpu-optimized) { root.gpu-optimized-requested(false); } root.gpu-clicked(2); }
                }
                if (root.bit-set(root.ui-state.available-gpu-mask, 8)) : ModeCard {
                    title: "Optimized";
                    icon-kind: Icons.sync;
                    selected: root.ui-state.gpu-mode-state == GpuModeHwState.Ready && root.gpu-optimized;
                    disabled: root.ui-state.gpu-mode-state != GpuModeHwState.Ready || !root.ui-state.gpu-mode-writable || root.ui-state.gpu-mode-pending || root.ui-state.gpu-mode-unconfirmed;
                    clicked => { root.gpu-optimized-requested(true); }
                }
            }

            if (root.ui-state.gpu-mode-state == GpuModeHwState.Unavailable) : LocalStatus {
                text: "Переключение режима GPU недоступно на этом устройстве";
                accent: Palette.text-secondary;
            }
            if (root.ui-state.gpu-mode-state == GpuModeHwState.Ready && !root.ui-state.gpu-mode-writable) : LocalStatus {
                text: "Режим GPU доступен только для чтения";
                accent: Palette.text-secondary;
            }
            if (root.ui-state.gpu-mode-pending) : LocalStatus {
                text: "Ожидание подтверждения";
                accent: Palette.warning;
            }
            if (root.ui-state.gpu-section-error) : LocalStatus {
                text: "Изменение режима GPU не подтверждено";
                accent: Palette.error;
            }
            if (root.ui-state.gpu-mode-unconfirmed) : LocalStatus {
                text: "Результат неизвестен · обновите состояние перед новой записью";
                accent: Palette.warning;
            }
            if (root.ui-state.gpu-reboot-required && !root.ui-state.gpu-section-error) : LocalStatus {
                text: "В очереди: " + root.mode-label(root.ui-state.gpu-queued) + " · применится после перезагрузки";
                accent: Palette.warning;
            }
            if (root.gpu-optimized) : LocalStatus {
                text: "Eco от батареи, Standard от сети · переключение после перезагрузки";
                accent: Palette.accent-default;
            }

            HorizontalLayout {
                spacing: LayoutMetrics.page-gap;

                // Read-only observations; hidden when no source reports anything.
                if (root.ui-state.gpu-power-state != GpuHwState.Unavailable
                    || root.ui-state.gpu-mux-state != GpuHwState.Unavailable
                    || root.ui-state.gpu-access-state != GpuHwState.Unavailable) : SectionCard {
                    width: root.nvidia-visible ? (parent.width - LayoutMetrics.page-gap) / 2 : parent.width;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 2px;
                        CardHeader { title: "Состояние"; icon-kind: Icons.swap; }
                        if (root.ui-state.gpu-mux-state == GpuHwState.Ready) : MuxDiagram {
                            route: root.ui-state.gpu-mux-value == 0 ? 0 : root.ui-state.gpu-mux-value == 1 ? 1 : -1;
                            dgpu-active: root.ui-state.gpu-power-state == GpuHwState.Ready && root.ui-state.gpu-power-value == 0;
                        }
                        InfoRow { label: "Текущий режим"; value: root.mode-label(root.ui-state.gpu-selected); }
                        InfoRow { label: "Питание dGPU"; value: root.power-label(); }
                        InfoRow { label: "MUX"; value: root.mux-label(); }
                        InfoRow { label: "Доступ к dGPU"; value: root.access-label(); }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                if (root.nvidia-visible) : SectionCard {
                    horizontal-stretch: 1;
                    min-width: (parent.width - LayoutMetrics.page-gap) / 2;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 8px;
                        CardHeader {
                            title: "NVIDIA";
                            icon-kind: Icons.gpu;
                            icon-tint: Palette.success;
                            detail: root.nvidia-rows.length == 0 ? "Недоступно" : root.nvidia-writable ? "" : "Только чтение";
                        }
                        if (root.nvidia-status != "") : LocalStatus {
                            text: root.nvidia-status;
                            accent: Palette.text-secondary;
                        }
                        for row in root.nvidia-rows : HorizontalLayout {
                            height: 44px;
                            spacing: 16px;
                            Text {
                                width: 128px;
                                text: row.label;
                                font-size: 14px;
                                color: Palette.text-primary;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            ValueSlider {
                                horizontal-stretch: 1;
                                min: row.min;
                                max: row.max;
                                value: row.current;
                                unit: row.unit;
                                disabled: !root.nvidia-writable;
                                changed(v) => { root.nvidia-tuning-requested(row.field, Math.round(v)); }
                            }
                        }
                        if (root.nvidia-error != "") : LocalStatus {
                            text: root.nvidia-error;
                            accent: Palette.error;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            Rectangle { vertical-stretch: 100; }
        }
    }
}
