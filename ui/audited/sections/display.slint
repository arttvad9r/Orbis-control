// Display page — observed refresh rate and the panel overdrive request toggle.
import { ScrollView } from "std-widgets.slint";
import { PageHeader, SectionCard, SectionTitle, LocalStatus, InfoRow } from "../common.slint";
import { RequestToggleRow } from "../../components/request-toggle-row.slint";
import { Palette } from "../../themes/dark.slint";

export component DisplaySection inherits Rectangle {
    in property <bool> display-state-ready: false;
    in property <string> display-status: "Unavailable";
    in property <bool> panel-overdrive-state-ready: false;
    in property <bool> panel-overdrive-control-ready: false;
    in-out property <bool> panel-overdrive: false;
    in property <bool> applying: false;
    callback panel-overdrive-requested(bool);

    ScrollView {
        VerticalLayout {
            width: root.width - 56px;
            x: 28px;
            spacing: 16px;
            padding-top: 8px;
            padding-bottom: 20px;

            PageHeader {
                title: "Экран";
                description: "Частота обновления и параметры панели.";
            }

            SectionCard {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    SectionTitle {
                        title: "Частота обновления";
                        detail: root.display-state-ready ? "" : "недоступно";
                        detail-color: Palette.text-disabled;
                    }

                    InfoRow { label: "Наблюдаемый режим"; value: root.display-status; }
                }
            }

            SectionCard {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    SectionTitle {
                        title: "Панель";
                        detail: root.panel-overdrive-state-ready ? (root.panel-overdrive-control-ready ? "" : "только чтение") : "недоступно";
                        detail-color: Palette.text-disabled;
                    }

                    RequestToggleRow {
                        label: "Panel Overdrive";
                        description: root.panel-overdrive-state-ready
                            ? (root.panel-overdrive-control-ready ? "Применение подтверждается чтением фактического состояния" : "Наблюдается · только чтение")
                            : "Состояние недоступно";
                        checked: root.panel-overdrive;
                        disabled: !root.panel-overdrive-control-ready || root.applying;
                        toggled(value) => { root.panel-overdrive-requested(value); }
                    }
                }
            }

            LocalStatus {
                text: "Смена режима отображения выполняется средствами рабочего стола.";
                accent: Palette.text-secondary;
            }
            Rectangle { vertical-stretch: 100; background: transparent; }
        }
    }
}
