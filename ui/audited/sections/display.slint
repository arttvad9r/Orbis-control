// Display page — observed refresh rate (read-only in production), the display
// mode request surface and the panel overdrive request toggle.
import { ScrollView } from "std-widgets.slint";
import { PageHeader, SectionCard, SectionTitle, LocalStatus, InfoRow } from "../common.slint";
import { RequestToggleRow } from "../../components/request-toggle-row.slint";
import { Palette } from "../../themes/dark.slint";

export component DisplaySection inherits Rectangle {
    in property <bool> display-state-ready: false;
    in property <bool> display-control-ready: false;
    in property <int> display-mode: -1;
    in property <string> display-status: "Unavailable";
    callback display-mode-requested(int);
    in property <bool> panel-overdrive-state-ready: false;
    in property <bool> panel-overdrive-control-ready: false;
    in-out property <bool> panel-overdrive: false;
    in property <bool> applying: false;
    callback panel-overdrive-requested(bool);

    ScrollView {
        VerticalLayout {
            width: root.width - 56px;
            x: 28px;
            spacing: 16px;
            padding-top: 8px;
            padding-bottom: 20px;

            PageHeader {
                title: "Экран";
                description: "Частота обновления и параметры панели.";
            }

            SectionCard {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    SectionTitle {
                        title: "Частота обновления";
                        detail: root.display-state-ready ? "" : "недоступно";
                        detail-color: Palette.text-disabled;
                    }

                    HorizontalLayout {
                        height: 40px;
                        spacing: 8px;
                        for mode in 3: Rectangle {
                            min-width: 110px;
                            horizontal-stretch: 1;
                            border-radius: 8px;
                            border-width: root.display-mode == mode && root.display-control-ready ? 1.5px : 1px;
                            border-color: root.display-mode == mode && root.display-control-ready ? Palette.accent-default
                                : hz-touch.has-hover && root.display-control-ready ? Palette.border-strong
                                : Palette.border-default;
                            background: root.display-mode == mode && root.display-control-ready ? Palette.accent-soft
                                : hz-touch.pressed && root.display-control-ready ? Palette.surface-pressed
                                : hz-touch.has-hover && root.display-control-ready ? Palette.surface-hover
                                : Palette.surface-default;
                            Text {
                                text: mode == 0 ? "Авто" : (mode == 1 ? "60 Гц" : "120 Гц");
                                font-size: 12.5px;
                                font-weight: 500;
                                color: root.display-control-ready ? Palette.text-primary : Palette.text-disabled;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            hz-touch := TouchArea {
                                enabled: root.display-control-ready;
                                clicked => { root.display-mode-requested(mode); }
                            }
                        }
                    }

                    InfoRow { label: "Наблюдаемый режим"; value: root.display-status; }
                }
            }

            SectionCard {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    SectionTitle {
                        title: "Панель";
                        detail: root.panel-overdrive-state-ready ? (root.panel-overdrive-control-ready ? "" : "только чтение") : "недоступно";
                        detail-color: Palette.text-disabled;
                    }

                    RequestToggleRow {
                        label: "Panel Overdrive";
                        description: root.panel-overdrive-state-ready
                            ? (root.panel-overdrive-control-ready ? "Применение подтверждается чтением фактического состояния" : "Наблюдается · только чтение")
                            : "Состояние недоступно";
                        checked: root.panel-overdrive;
                        disabled: !root.panel-overdrive-control-ready || root.applying;
                        toggled(value) => { root.panel-overdrive-requested(value); }
                    }
                }
            }

            LocalStatus {
                text: "Смена режима отображения без владельца мутации остаётся отключённой.";
                accent: Palette.text-secondary;
            }
            Rectangle { vertical-stretch: 100; background: transparent; }
        }
    }
}
