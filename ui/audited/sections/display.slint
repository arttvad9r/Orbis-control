// Display page — observed desktop mode plus ASUS panel capabilities.
import { ScrollView } from "std-widgets.slint";
import { PageHeader, SectionCard, SectionTitle, LocalStatus, InfoRow, StatusPill, ActionButton, LayoutMetrics } from "../common.slint";
import { ValueSlider } from "../../components/value-slider.slint";
import { RequestToggleRow } from "../../components/request-toggle-row.slint";
import { Palette } from "../../themes/dark.slint";

export component DisplaySection inherits Rectangle {
    in property <bool> display-state-ready: false;
    in property <string> display-status: "Недоступно";
    in property <bool> panel-overdrive-state-ready: false;
    in property <bool> panel-overdrive-control-ready: false;
    in-out property <bool> panel-overdrive: false;
    in property <bool> applying: false;
    callback panel-overdrive-requested(bool);
    in property <bool> panel-refresh-known: false;
    in property <[int]> panel-refresh-rates: [];
    in property <int> panel-refresh-current: 0;
    in property <string> panel-refresh-error: "";
    in property <bool> power-rules-enabled: false;
    in property <int> power-rules-ac-hz: 0;
    in property <int> power-rules-battery-hz: 0;
    in property <bool> panel-brightness-known: false;
    in property <int> panel-brightness: 0;
    in property <string> panel-brightness-error: "";
    callback panel-brightness-requested(int);
    callback panel-refresh-requested(int);
    callback power-rules-refresh-requested(bool, int);

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: 14px;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            PageHeader {
                title: "Экран";
                description: "Наблюдаемый режим рабочего стола и аппаратные параметры панели ASUS.";
            }

            SectionCard {
                min-height: 104px;
                HorizontalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;
                        Text { text: "Текущий режим"; font-size: 12px; color: Palette.text-secondary; }
                        Text {
                            text: root.display-state-ready ? root.display-status : "Определяется";
                            font-size: 20px;
                            font-weight: 700;
                            color: root.display-state-ready ? Palette.text-primary : Palette.text-disabled;
                            overflow: elide;
                        }
                    }
                    Rectangle {
              width: root.display-state-ready ? 114px : 146px;
              vertical-stretch: 1;
              background: transparent;
              StatusPill {
                  width: parent.width;
                  y: (parent.height - self.height) / 2;
                  text: root.display-state-ready ? "Наблюдается" : "Получение данных";
                  accent: root.display-state-ready ? Palette.success : Palette.warning;
              }
          }
                }
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 8px;

                    SectionTitle {
                        title: "Яркость экрана";
                        detail: root.panel-brightness-known ? "Меняется через systemd-logind, как это делает рабочий стол" : "Недоступно";
                    }
                    if (root.panel-brightness-known) : HorizontalLayout {
                        spacing: 12px;
                        ValueSlider {
                            horizontal-stretch: 1;
                            min: 1;
                            max: 100;
                            value: root.panel-brightness;
                            show-percent: false;
                            changed(v) => { root.panel-brightness-requested(v); }
                        }
                        Text {
                            width: 48px;
                            text: root.panel-brightness + "%";
                            font-size: 14px;
                            font-weight: 650;
                            color: Palette.text-primary;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }
                    if (!root.panel-brightness-known) : LocalStatus {
                        text: "Встроенная панель не показала управляемую подсветку.";
                        accent: Palette.text-secondary;
                    }
                    if (root.panel-brightness-error != "") : LocalStatus {
                        text: root.panel-brightness-error;
                        accent: Palette.error;
                    }
                }
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 12px;

                    SectionTitle {
                        title: "Частота обновления";
                        detail: root.panel-refresh-known ? "Переключается через рабочий стол" : "Управляется рабочим столом";
                    }
                    InfoRow {
                        label: "Наблюдаемый режим";
                        value: root.display-state-ready ? root.display-status : "—";
                    }
                    if (root.panel-refresh-known) : VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Частота встроенной панели";
                            font-size: 13.5px;
                            font-weight: 550;
                            color: Palette.text-primary;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            for hz in root.panel-refresh-rates : ActionButton {
                                label: hz + " Гц";
                                accent: root.panel-refresh-current == hz;
                                clicked => { root.panel-refresh-requested(hz); }
                            }
                        }
                        Text {
                            text: "По источнику питания";
                            font-size: 13.5px;
                            font-weight: 550;
                            color: Palette.text-primary;
                        }
                        if (root.power-rules-enabled) : VerticalLayout {
                            spacing: 6px;
                            Text { text: "От сети"; font-size: 12px; color: Palette.text-secondary; }
                            HorizontalLayout {
                                spacing: 10px;
                                ActionButton { label: "Не менять"; accent: root.power-rules-ac-hz == 0; clicked => { root.power-rules-refresh-requested(true, 0); } }
                                for hz in root.panel-refresh-rates : ActionButton {
                                    label: hz + " Гц";
                                    accent: root.power-rules-ac-hz == hz;
                                    clicked => { root.power-rules-refresh-requested(true, hz); }
                                }
                            }
                            Text { text: "От батареи"; font-size: 12px; color: Palette.text-secondary; }
                            HorizontalLayout {
                                spacing: 10px;
                                ActionButton { label: "Не менять"; accent: root.power-rules-battery-hz == 0; clicked => { root.power-rules-refresh-requested(false, 0); } }
                                for hz in root.panel-refresh-rates : ActionButton {
                                    label: hz + " Гц";
                                    accent: root.power-rules-battery-hz == hz;
                                    clicked => { root.power-rules-refresh-requested(false, hz); }
                                }
                            }
                        }
                        if (!root.power-rules-enabled) : LocalStatus {
                            text: "Правила по источнику питания включаются на странице «Производительность».";
                            accent: Palette.text-secondary;
                        }
                    }
                    if (!root.panel-refresh-known) : LocalStatus {
                        text: "Переключение частоты недоступно: рабочий стол не сообщил параметры встроенной панели.";
                        accent: Palette.text-secondary;
                    }
                    if (root.panel-refresh-error != "") : LocalStatus {
                        text: root.panel-refresh-error;
                        accent: Palette.error;
                    }
                }
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 10px;

                    HorizontalLayout {
                        height: 30px;
                        SectionTitle { horizontal-stretch: 1; title: "Панель"; }
                        StatusPill {
                            text: root.panel-overdrive-state-ready ? (root.panel-overdrive-control-ready ? "Доступно" : "Только чтение") : "Определяется";
                            accent: root.panel-overdrive-control-ready ? Palette.success : root.panel-overdrive-state-ready ? Palette.text-secondary : Palette.warning;
                        }
                    }

                    RequestToggleRow {
                        label: "Ускорение отклика панели (Overdrive)";
                        description: root.panel-overdrive-state-ready
                            ? (root.panel-overdrive-control-ready ? "Уменьшает время отклика панели; результат подтверждается чтением состояния" : "Текущее состояние доступно только для чтения")
                            : "Поддержка панели определяется по возможностям устройства";
                        checked: root.panel-overdrive;
                        disabled: !root.panel-overdrive-control-ready || root.applying;
                        toggled(value) => { root.panel-overdrive-requested(value); }
                    }
                }
            }

            Rectangle { vertical-stretch: 100; background: transparent; }
        }
    }
}
