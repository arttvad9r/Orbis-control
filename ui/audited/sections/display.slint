// Display page (reference 6) — built-in panel brightness, refresh rate and
// overdrive as icon rows, with a preview card showing the active mode.
import { ScrollView } from "std-widgets.slint";
import { PageHeader, SectionCard, CardHeader, IconRow, LocalStatus, ChoiceButton, FieldRow, LayoutMetrics, PageSurface } from "../common.slint";
import { ValueSlider } from "../../components/value-slider.slint";
import { RequestToggleRow } from "../../components/request-toggle-row.slint";
import { Icon, Icons } from "../../components/icon.slint";
import { Palette } from "../../themes/dark.slint";

export component DisplaySection inherits PageSurface {
    in property <bool> display-state-ready: false;
    in property <string> display-status: "Недоступно";
    in property <string> display-resolution: "";
    in property <string> device-name: "";
    in property <bool> panel-overdrive-state-ready: false;
    in property <bool> panel-overdrive-control-ready: false;
    in-out property <bool> panel-overdrive: false;
    in property <bool> applying: false;
    callback panel-overdrive-requested(bool);
    in property <bool> panel-refresh-known: false;
    in property <[int]> panel-refresh-rates: [];
    in property <int> panel-refresh-current: 0;
    in property <string> panel-refresh-error: "";
    in property <bool> power-rules-enabled: false;
    in property <int> power-rules-ac-hz: 0;
    in property <int> power-rules-battery-hz: 0;
    in property <bool> panel-brightness-known: false;
    in property <int> panel-brightness: 0;
    in property <string> panel-brightness-error: "";
    callback panel-brightness-requested(int);
    callback panel-refresh-requested(int);
    callback power-rules-refresh-requested(bool, int);

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: LayoutMetrics.page-margin;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            PageHeader { title: "Экран"; subtitle: "Яркость, частота обновления и отклик встроенной панели"; }

            HorizontalLayout {
                spacing: LayoutMetrics.page-gap;

                SectionCard {
                    width: (parent.width - LayoutMetrics.page-gap) * 0.56;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        padding-top: 12px;
                        spacing: 0px;

                        IconRow {
                            icon-kind: Icons.sun;
                            title: "Яркость";
                            muted: !root.panel-brightness-known;
                            label-width: 120px;
                            if (root.panel-brightness-known) : ValueSlider {
                                horizontal-stretch: 1;
                                min: 1;
                                max: 100;
                                value: root.panel-brightness;
                                changed(v) => { root.panel-brightness-requested(v); }
                            }
                            if (!root.panel-brightness-known) : Text {
                                text: "Недоступно";
                                font-size: 13.5px;
                                color: Palette.text-disabled;
                                vertical-alignment: center;
                            }
                        }

                        IconRow {
                            separator: true;
                            icon-kind: Icons.monitor;
                            title: "Частота обновления";
                            description: root.panel-refresh-known ? "" : "Управляется рабочим столом";
                            muted: !root.panel-refresh-known;
                        }
                        if (root.panel-refresh-known) : HorizontalLayout {
                            padding-left: 42px;
                            padding-bottom: 12px;
                            spacing: 6px;
                            for hz in root.panel-refresh-rates : ChoiceButton {
                                min-width: 0px;
                                label: hz + " Гц";
                                selected: root.panel-refresh-current == hz;
                                clicked => { root.panel-refresh-requested(hz); }
                            }
                        }

                        if (root.panel-overdrive-state-ready) : RequestToggleRow {
                            separator: true;
                            icon-kind: Icons.sync;
                            label: "Overdrive";
                            description: "Ускоренный отклик матрицы, меньше шлейфов в динамике";
                            checked: root.panel-overdrive;
                            disabled: !root.panel-overdrive-control-ready || root.applying;
                            toggled(value) => { root.panel-overdrive-requested(value); }
                        }

                        if (root.panel-brightness-error != "") : LocalStatus {
                            text: root.panel-brightness-error;
                            accent: Palette.error;
                        }
                        if (root.panel-refresh-error != "") : LocalStatus {
                            text: root.panel-refresh-error;
                            accent: Palette.error;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                SectionCard {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 14px;
                        CardHeader { title: "Предпросмотр"; divider: false; }
                        Rectangle {
                            height: 200px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Palette.border-default;
                            background: Palette.surface-muted;
                            clip: true;
                            // Glow inset by the corner radius (gradients ignore rounding).
                            Rectangle {
                                x: 12px;
                                width: parent.width - 24px;
                                background: @radial-gradient(circle, Palette.glow.transparentize(0.55) 0%, #00000000 70%);
                            }
                            Image {
                                x: parent.width * 0.06;
                                y: 12px;
                                width: parent.width * 0.88;
                                height: parent.height - 16px;
                                source: @image-url("../../assets/laptop.svg");
                                image-fit: contain;
                            }
                        }
                        Rectangle {
                            height: 76px;
                            border-radius: 12px;
                            background: Palette.surface-raised;
                            HorizontalLayout {
                                padding-left: 18px;
                                padding-right: 18px;
                                spacing: 18px;
                                Icon { width: 34px; height: 34px; y: (parent.height - self.height) / 2; kind: Icons.monitor; tint: Palette.text-primary; }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: root.display-resolution != "" ? "Разрешение" : "Экран";
                                        font-size: 13px;
                                        color: Palette.text-secondary;
                                    }
                                    Text {
                                        text: root.display-resolution != "" ? root.display-resolution
                                            : root.display-state-ready ? root.display-status : "Нет данных";
                                        font-size: 18px;
                                        font-weight: 600;
                                        color: Palette.text-primary;
                                        overflow: elide;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                if (root.panel-refresh-known && root.panel-refresh-current > 0) : VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text { text: "Частота"; font-size: 13px; color: Palette.text-secondary; horizontal-alignment: right; }
                                    Text { text: root.panel-refresh-current + " Гц"; font-size: 18px; font-weight: 600; color: Palette.text-primary; horizontal-alignment: right; }
                                }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            if (root.panel-refresh-known && root.power-rules-enabled) : SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 12px;
                    CardHeader { title: "Частота по источнику питания"; icon-kind: Icons.plug; }
                    FieldRow {
                        label: "От сети";
                        ChoiceButton { min-width: 0px; label: "Не менять"; selected: root.power-rules-ac-hz == 0; clicked => { root.power-rules-refresh-requested(true, 0); } }
                        for hz in root.panel-refresh-rates : ChoiceButton {
                            min-width: 0px;
                            label: hz + " Гц";
                            selected: root.power-rules-ac-hz == hz;
                            clicked => { root.power-rules-refresh-requested(true, hz); }
                        }
                    }
                    FieldRow {
                        label: "От батареи";
                        ChoiceButton { min-width: 0px; label: "Не менять"; selected: root.power-rules-battery-hz == 0; clicked => { root.power-rules-refresh-requested(false, 0); } }
                        for hz in root.panel-refresh-rates : ChoiceButton {
                            min-width: 0px;
                            label: hz + " Гц";
                            selected: root.power-rules-battery-hz == hz;
                            clicked => { root.power-rules-refresh-requested(false, hz); }
                        }
                    }
                }
            }

            Rectangle { vertical-stretch: 100; }
        }
    }
}
