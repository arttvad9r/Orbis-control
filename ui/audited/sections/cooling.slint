// Cooling page — fan curve workspace: selectors, chart, points and one action bar.
import { ScrollView } from "std-widgets.slint";
import { UiState, FanCurveHwState } from "../model.slint";
import { PageHeader, SectionCard, ActionButton, LayoutMetrics } from "../common.slint";
import { FanCurveEditor } from "../fan-curve-editor-v3.slint";
import { Palette } from "../../themes/dark.slint";

export component CoolingSection inherits Rectangle {
    in property <UiState> ui-state;
    in property <bool> mutation-safety-blocked: false;
    in property <bool> factory-reset-available: true;
    in property <bool> fan-eco-profile-available: false;
    in property <string> policy-status: "Кривая применяется через Hardware1 с read-back";

    property <bool> factory-reset-pending: false;

    callback fan-changed(int);
    callback fan-profile-changed(int);
    callback fan-temp-point-changed(int, int);
    callback fan-pwm-point-changed(int, int);
    callback fan-apply-clicked(bool);

    function status-text() -> string {
        if (root.ui-state.fan-curve-error) { return "Операция с кривой завершилась ошибкой"; }
        if (root.ui-state.fan-curve-pending) { return "Изменение поставлено в очередь"; }
        if (root.ui-state.fan-curve-unconfirmed) { return "Результат неизвестен · обновите состояние перед новой записью"; }
        if (root.mutation-safety-blocked) { return root.policy-status; }
        if (root.factory-reset-pending) { return "Будут применены заводские значения"; }
        if (root.ui-state.fan-curve-state != FanCurveHwState.Ready) { return ""; }
        if (!root.ui-state.fan-curve-writable) { return "Только чтение"; }
        if (root.ui-state.fan-curve-dirty) { return "Есть неприменённые изменения"; }
        if (root.ui-state.fan-curve-enabled-known) {
            return root.ui-state.fan-curve-enabled ? "Пользовательская кривая активна" : "Кривая сохранена, но выключена";
        }
        return "";
    }

    function status-color() -> color {
        if (root.ui-state.fan-curve-error) { return Palette.error; }
        if (root.mutation-safety-blocked || root.factory-reset-pending || root.ui-state.fan-curve-pending || root.ui-state.fan-curve-unconfirmed || root.ui-state.fan-curve-dirty || !root.ui-state.fan-curve-enabled-known) { return Palette.warning; }
        return root.ui-state.fan-curve-enabled ? Palette.success : Palette.text-secondary;
    }

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: LayoutMetrics.page-margin;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            HorizontalLayout {
                PageHeader { horizontal-stretch: 1; title: "Охлаждение"; }
                for fan in [
                    { label: "CPU", rpm: root.ui-state.cpu-fan-rpm },
                    { label: "GPU", rpm: root.ui-state.gpu-fan-rpm },
                ] : HorizontalLayout {
                    padding-left: 20px;
                    spacing: 8px;
                    Text { text: fan.label; font-size: 13px; color: Palette.text-secondary; vertical-alignment: center; }
                    Text { text: fan.rpm; font-size: 15px; font-weight: 650; color: Palette.text-primary; vertical-alignment: center; }
                }
            }

            SectionCard {
                min-height: 540px;
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 16px;

                    FanCurveEditor {
                        vertical-stretch: 1;
                        state: root.ui-state.fan-curve-state;
                        eco-profile-available: root.fan-eco-profile-available;
                        writable: root.ui-state.fan-curve-writable && !root.mutation-safety-blocked && !root.ui-state.fan-curve-pending && !root.ui-state.fan-curve-unconfirmed;
                        error-state: root.ui-state.fan-curve-error;
                        dirty: root.ui-state.fan-curve-dirty;
                        fan-selected: root.ui-state.fan-selected;
                        profile-selected: root.ui-state.fan-profile-selected;
                        temp-0: root.ui-state.fan-temp-0; temp-1: root.ui-state.fan-temp-1; temp-2: root.ui-state.fan-temp-2; temp-3: root.ui-state.fan-temp-3;
                        temp-4: root.ui-state.fan-temp-4; temp-5: root.ui-state.fan-temp-5; temp-6: root.ui-state.fan-temp-6; temp-7: root.ui-state.fan-temp-7;
                        pwm-0: root.ui-state.fan-pwm-0; pwm-1: root.ui-state.fan-pwm-1; pwm-2: root.ui-state.fan-pwm-2; pwm-3: root.ui-state.fan-pwm-3;
                        pwm-4: root.ui-state.fan-pwm-4; pwm-5: root.ui-state.fan-pwm-5; pwm-6: root.ui-state.fan-pwm-6; pwm-7: root.ui-state.fan-pwm-7;
                        fan-changed(i) => { root.factory-reset-pending = false; root.fan-changed(i); }
                        profile-changed(i) => { root.factory-reset-pending = false; root.fan-profile-changed(i); }
                        temp-point-changed(i, v) => { root.factory-reset-pending = false; root.fan-temp-point-changed(i, v); }
                        pwm-point-changed(i, v) => { root.factory-reset-pending = false; root.fan-pwm-point-changed(i, v); }
                    }

                    Rectangle { height: 1px; background: Palette.border-default; }

                    HorizontalLayout {
                        height: 36px;
                        spacing: 10px;
                        if (root.status-text() != "") : Rectangle {
                            width: 8px;
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.status-color();
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.status-text();
                            font-size: 13px;
                            color: Palette.text-secondary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        ActionButton {
                            width: 170px;
                            label: "Заводские значения";
                            disabled: root.mutation-safety-blocked || !root.factory-reset-available || !root.ui-state.fan-curve-writable || root.ui-state.fan-curve-error || root.ui-state.fan-curve-pending || root.ui-state.fan-curve-unconfirmed;
                            clicked => { root.factory-reset-pending = true; }
                        }
                        ActionButton {
                            width: 170px;
                            label: "Применить";
                            accent: root.factory-reset-pending || root.ui-state.fan-curve-dirty;
                            disabled: root.mutation-safety-blocked || !root.ui-state.fan-curve-writable || root.ui-state.fan-curve-error || root.ui-state.fan-curve-pending || root.ui-state.fan-curve-unconfirmed || (!root.factory-reset-pending && !root.ui-state.fan-curve-dirty);
                            clicked => {
                                let reset = root.factory-reset-pending;
                                root.fan-apply-clicked(reset);
                                if (reset) { root.factory-reset-pending = false; }
                            }
                        }
                    }
                }
            }
        }
    }
}
