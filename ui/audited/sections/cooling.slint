// Cooling page — fan curve workspace: selectors, chart, points and one action bar.
import { ScrollView } from "std-widgets.slint";
import { UiState, FanCurveHwState } from "../model.slint";
import { PageHeader, SectionCard, CardHeader, ActionButton, ChoiceButton, Segmented, InfoRow, LayoutMetrics, PageSurface } from "../common.slint";
import { Icon, Icons } from "../../components/icon.slint";
import { FanCurveEditor } from "../fan-curve-editor-v3.slint";
import { Palette } from "../../themes/dark.slint";

component ValuesCard inherits SectionCard {
    in property <UiState> ui-state;
    VerticalLayout {
        padding: LayoutMetrics.card-padding;
        spacing: 2px;
        CardHeader { title: "Текущие значения"; }
        Rectangle { height: 4px; }
        InfoRow { label: "Вентилятор CPU"; value: root.ui-state.cpu-fan-rpm; }
        InfoRow { label: "Вентилятор GPU"; value: root.ui-state.gpu-fan-rpm; }
        InfoRow { label: "Температура CPU"; value: root.ui-state.cpu-temp; }
        InfoRow {
            label: "Температура GPU";
            value: root.ui-state.gpu-temp != "—" || root.ui-state.igpu-temp == "—" ? root.ui-state.gpu-temp : root.ui-state.igpu-temp;
        }
    }
}

component ApplyCard inherits SectionCard {
    in property <string> status-text;
    in property <color> status-color;
    in property <bool> apply-accent;
    in property <bool> apply-disabled;
    in property <bool> reset-disabled;
    callback apply();
    callback reset();
    VerticalLayout {
        padding: LayoutMetrics.card-padding;
        spacing: 12px;
        CardHeader { title: "Применение"; }
        if (root.status-text != "") : HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 8px;
                Rectangle { y: 6px; width: 8px; height: 8px; border-radius: 4px; background: root.status-color; }
            }
            Text {
                horizontal-stretch: 1;
                text: root.status-text;
                font-size: 13px;
                color: Palette.text-secondary;
                wrap: word-wrap;
            }
        }
        Rectangle { vertical-stretch: 1; }
        ActionButton {
            height: 40px;
            label: "Применить кривую";
            accent: root.apply-accent;
            disabled: root.apply-disabled;
            clicked => { root.apply(); }
        }
        ActionButton {
            height: 40px;
            label: "Заводские значения";
            disabled: root.reset-disabled;
            clicked => { root.reset(); }
        }
    }
}

// "Current values" and "apply" cards; beside the chart on wide windows,
// below it (side by side) on narrow ones.
component CoolingSide inherits VerticalLayout {
    in property <UiState> ui-state;
    in property <bool> as-row: false;
    in property <string> status-text;
    in property <color> status-color;
    in property <bool> apply-accent;
    in property <bool> apply-disabled;
    in property <bool> reset-disabled;
    callback apply();
    callback reset();

    if (!root.as-row) : VerticalLayout {
        spacing: LayoutMetrics.page-gap;
        ValuesCard { ui-state: root.ui-state; }
        ApplyCard {
            vertical-stretch: 1;
            status-text: root.status-text; status-color: root.status-color;
            apply-accent: root.apply-accent; apply-disabled: root.apply-disabled; reset-disabled: root.reset-disabled;
            apply => { root.apply(); }
            reset => { root.reset(); }
        }
    }
    if (root.as-row) : HorizontalLayout {
        spacing: LayoutMetrics.page-gap;
        ValuesCard { horizontal-stretch: 1; ui-state: root.ui-state; }
        ApplyCard {
            horizontal-stretch: 1;
            status-text: root.status-text; status-color: root.status-color;
            apply-accent: root.apply-accent; apply-disabled: root.apply-disabled; reset-disabled: root.reset-disabled;
            apply => { root.apply(); }
            reset => { root.reset(); }
        }
    }
}

export component CoolingSection inherits PageSurface {
    in property <UiState> ui-state;
    in property <bool> mutation-safety-blocked: false;
    in property <bool> factory-reset-available: true;
    in property <bool> fan-eco-profile-available: false;
    in property <string> policy-status: "Кривая применяется через Hardware1 с read-back";

    property <bool> factory-reset-pending: false;

    callback fan-changed(int);
    callback fan-profile-changed(int);
    callback fan-temp-point-changed(int, int);
    callback fan-pwm-point-changed(int, int);
    callback fan-apply-clicked(bool);

    function status-text() -> string {
        if (root.ui-state.fan-curve-error) { return "Операция с кривой завершилась ошибкой"; }
        if (root.ui-state.fan-curve-pending) { return "Изменение поставлено в очередь"; }
        if (root.ui-state.fan-curve-unconfirmed) { return "Результат неизвестен · обновите состояние перед новой записью"; }
        if (root.mutation-safety-blocked) { return root.policy-status; }
        if (root.factory-reset-pending) { return "Будут применены заводские значения"; }
        if (root.ui-state.fan-curve-state != FanCurveHwState.Ready) { return ""; }
        if (!root.ui-state.fan-curve-writable) { return "Только чтение"; }
        if (root.ui-state.fan-curve-dirty) { return "Есть неприменённые изменения"; }
        if (root.ui-state.fan-curve-enabled-known) {
            return root.ui-state.fan-curve-enabled ? "Пользовательская кривая активна" : "Кривая сохранена, но выключена";
        }
        return "";
    }

    function status-color() -> color {
        if (root.ui-state.fan-curve-error) { return Palette.error; }
        if (root.mutation-safety-blocked || root.factory-reset-pending || root.ui-state.fan-curve-pending || root.ui-state.fan-curve-unconfirmed || root.ui-state.fan-curve-dirty || !root.ui-state.fan-curve-enabled-known) { return Palette.warning; }
        return root.ui-state.fan-curve-enabled ? Palette.success : Palette.text-secondary;
    }

    function apply-disabled() -> bool {
        return root.mutation-safety-blocked || !root.ui-state.fan-curve-writable || root.ui-state.fan-curve-error || root.ui-state.fan-curve-pending || root.ui-state.fan-curve-unconfirmed || (!root.factory-reset-pending && !root.ui-state.fan-curve-dirty);
    }

    function reset-disabled() -> bool {
        return root.mutation-safety-blocked || !root.factory-reset-available || !root.ui-state.fan-curve-writable || root.ui-state.fan-curve-error || root.ui-state.fan-curve-pending || root.ui-state.fan-curve-unconfirmed;
    }

    function apply() {
        let reset = root.factory-reset-pending;
        root.fan-apply-clicked(reset);
        if (reset) { root.factory-reset-pending = false; }
    }

    function fan-label() -> string { return root.ui-state.fan-selected == 0 ? "CPU" : "GPU"; }

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: LayoutMetrics.page-margin;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            PageHeader { title: "Охлаждение"; subtitle: "Кривые вентиляторов для каждого профиля производительности"; }

            // Fan tabs (joined segment) and the profile whose curve is edited.
            HorizontalLayout {
                height: 46px;
                spacing: 16px;
                Segmented {
                    width: root.width < 900px ? 180px : 260px;
                    height: 44px;
                    options: ["CPU", "GPU"];
                    selected: root.ui-state.fan-selected;
                    changed(i) => { root.factory-reset-pending = false; root.fan-changed(i); }
                }
                Rectangle { horizontal-stretch: 0.01; }
                Text { text: "Профиль"; font-size: 14px; color: Palette.text-secondary; vertical-alignment: center; }
                Segmented {
                    max-width: 420px;
                    options: root.fan-eco-profile-available || root.ui-state.fan-profile-selected == 3
                        ? ["Баланс", "Турбо", "Тихий", "Эко"] : ["Баланс", "Турбо", "Тихий"];
                    selected: root.ui-state.fan-profile-selected;
                    changed(i) => { root.factory-reset-pending = false; root.fan-profile-changed(i); }
                }
            }

            HorizontalLayout {
                spacing: LayoutMetrics.page-gap;

                SectionCard {
                    horizontal-stretch: 1;
                    min-height: 520px;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 14px;
                        CardHeader { title: "Кривая вентилятора (" + root.fan-label() + ")"; divider: false; }
                        FanCurveEditor {
                            vertical-stretch: 1;
                            state: root.ui-state.fan-curve-state;
                            eco-profile-available: root.fan-eco-profile-available;
                            writable: root.ui-state.fan-curve-writable && !root.mutation-safety-blocked && !root.ui-state.fan-curve-pending && !root.ui-state.fan-curve-unconfirmed;
                            error-state: root.ui-state.fan-curve-error;
                            dirty: root.ui-state.fan-curve-dirty;
                            fan-selected: root.ui-state.fan-selected;
                            profile-selected: root.ui-state.fan-profile-selected;
                            temp-0: root.ui-state.fan-temp-0; temp-1: root.ui-state.fan-temp-1; temp-2: root.ui-state.fan-temp-2; temp-3: root.ui-state.fan-temp-3;
                            temp-4: root.ui-state.fan-temp-4; temp-5: root.ui-state.fan-temp-5; temp-6: root.ui-state.fan-temp-6; temp-7: root.ui-state.fan-temp-7;
                            pwm-0: root.ui-state.fan-pwm-0; pwm-1: root.ui-state.fan-pwm-1; pwm-2: root.ui-state.fan-pwm-2; pwm-3: root.ui-state.fan-pwm-3;
                            pwm-4: root.ui-state.fan-pwm-4; pwm-5: root.ui-state.fan-pwm-5; pwm-6: root.ui-state.fan-pwm-6; pwm-7: root.ui-state.fan-pwm-7;
                            fan-changed(i) => { root.factory-reset-pending = false; root.fan-changed(i); }
                            profile-changed(i) => { root.factory-reset-pending = false; root.fan-profile-changed(i); }
                            temp-point-changed(i, v) => { root.factory-reset-pending = false; root.fan-temp-point-changed(i, v); }
                            pwm-point-changed(i, v) => { root.factory-reset-pending = false; root.fan-pwm-point-changed(i, v); }
                        }
                    }
                }

                if (root.width >= 940px) : CoolingSide {
                    width: 290px;
                    ui-state: root.ui-state;
                    status-text: root.status-text();
                    status-color: root.status-color();
                    apply-accent: root.factory-reset-pending || root.ui-state.fan-curve-dirty;
                    apply-disabled: root.apply-disabled();
                    reset-disabled: root.reset-disabled();
                    apply => { root.apply(); }
                    reset => { root.factory-reset-pending = true; }
                }
            }

            if (root.width < 940px) : CoolingSide {
                as-row: true;
                ui-state: root.ui-state;
                status-text: root.status-text();
                status-color: root.status-color();
                apply-accent: root.factory-reset-pending || root.ui-state.fan-curve-dirty;
                apply-disabled: root.apply-disabled();
                reset-disabled: root.reset-disabled();
                apply => { root.apply(); }
                reset => { root.factory-reset-pending = true; }
            }
        }
    }
}
