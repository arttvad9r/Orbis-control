// Power page — battery overview, charge preservation and observed consumption.
import { ScrollView } from "std-widgets.slint";
import { UiState, ChargeLimitState } from "../model.slint";
import { PageHeader, SectionCard, SectionTitle, InfoRow, LocalStatus, LayoutMetrics } from "../common.slint";
import { ValueSlider } from "../../components/value-slider.slint";
import { MetricCard } from "../../components/metric-card.slint";
import { Palette } from "../../themes/dark.slint";

export component PowerSection inherits Rectangle {
    in property <UiState> ui-state;
    callback charge-changed(float);

    function ac-label() -> string {
        if (root.ui-state.ac-online == "On AC") { return "От сети"; }
        if (root.ui-state.ac-online == "On battery") { return "От батареи"; }
        return root.ui-state.ac-online;
    }

    function battery-status-label() -> string {
        if (root.ui-state.battery-status == "") { return "—"; }
        if (root.ui-state.battery-status == "Charging" || root.ui-state.battery-status == "charging") { return "Зарядка"; }
        if (root.ui-state.battery-status == "Discharging" || root.ui-state.battery-status == "discharging") { return "Разрядка"; }
        if (root.ui-state.battery-status == "Full" || root.ui-state.battery-status == "full") { return "Полный заряд"; }
        if (root.ui-state.battery-status == "Not charging" || root.ui-state.battery-status == "Not Charging") { return "Не заряжается"; }
        return root.ui-state.battery-status;
    }

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: 14px;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            PageHeader {
                title: "Питание";
                description: "Состояние аккумулятора, ограничение заряда и текущее энергопотребление.";
            }

            HorizontalLayout {
                height: 108px;
                spacing: 14px;
                MetricCard { label: "Заряд"; value: root.ui-state.battery-percent; detail: root.battery-status-label(); icon-kind: 2; value-color: Palette.text-primary; }
                MetricCard { label: "Здоровье"; value: root.ui-state.battery-health; detail: "остаточная ёмкость"; icon-kind: 2; }
                MetricCard { label: "Циклы"; value: root.ui-state.battery-cycles; detail: "циклов аккумулятора"; icon-kind: 13; }
                MetricCard { label: "Источник"; value: root.ac-label(); detail: root.ui-state.power-ac-mw; icon-kind: 13; }
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 14px;

                     SectionTitle {
                         title: "Ограничение заряда батареи";
                         detail: root.ui-state.charge-limit-pending ? "Ожидание подтверждения"
                             : root.ui-state.charge-limit-unconfirmed ? "Результат неизвестен · обновите состояние"
                             : root.ui-state.charge-limit-error != "" ? root.ui-state.charge-limit-error
                             : root.ui-state.charge-limit-state == ChargeLimitState.Ready
                            ? (root.ui-state.charge-limit-writable ? "Доступно" : "Только чтение")
                            : "Получение состояния";
                    }

                    if (root.ui-state.charge-limit-state == ChargeLimitState.Ready) : ValueSlider {
                        min: 20;
                        max: 100;
                        step: 1;
                        value: root.ui-state.charge-limit;
                         disabled: !root.ui-state.charge-limit-writable || root.ui-state.charge-limit-pending || root.ui-state.charge-limit-unconfirmed || root.ui-state.charge-limit-error != "";
                        changed(v) => { root.charge-changed(v); }
                     }
                     if (root.ui-state.charge-limit-pending || root.ui-state.charge-limit-unconfirmed || root.ui-state.charge-limit-error != "") : LocalStatus {
                         text: root.ui-state.charge-limit-pending ? "Изменение поставлено в очередь"
                             : root.ui-state.charge-limit-unconfirmed ? "Результат неизвестен · обновите состояние перед новой записью"
                             : root.ui-state.charge-limit-error;
                         accent: root.ui-state.charge-limit-error != "" ? Palette.error : Palette.warning;
                     }
                    if (root.ui-state.charge-limit-state != ChargeLimitState.Ready) : LocalStatus {
                        text: root.ui-state.charge-limit-state == ChargeLimitState.Loading
                            ? "Чтение текущего порога заряда"
                            : "Порог заряда недоступен на текущем backend";
                        accent: root.ui-state.charge-limit-state == ChargeLimitState.Loading ? Palette.text-secondary : Palette.warning;
                    }

                    Text {
                        text: "Для постоянной работы от сети обычно достаточно 70–80 %. Значение применяется только после подтверждения фактического состояния.";
                        font-size: 12px;
                        color: Palette.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                spacing: 14px;
                SectionCard {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 4px;
                        SectionTitle { title: "Аккумулятор"; }
                        InfoRow { label: "Состояние"; value: root.battery-status-label(); }
                        InfoRow { label: "Текущий заряд"; value: root.ui-state.battery-percent; }
                        InfoRow { label: "Здоровье"; value: root.ui-state.battery-health; }
                        InfoRow { label: "Циклы"; value: root.ui-state.battery-cycles; }
                    }
                }

                SectionCard {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 4px;
                        SectionTitle { title: "Энергопотребление"; }
                        InfoRow { label: "Источник"; value: root.ac-label(); }
                        InfoRow { label: "От адаптера"; value: root.ui-state.power-ac-mw; }
                        InfoRow { label: "Дискретная графика"; value: root.ui-state.gpu-power; }
                    }
                }
            }

            Rectangle { vertical-stretch: 100; background: transparent; }
        }
    }
}
