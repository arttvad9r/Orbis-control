// Power page (reference 5) — current battery status with a large gauge, battery
// health and the charge limit.
import { ScrollView } from "std-widgets.slint";
import { UiState, ChargeLimitState } from "../model.slint";
import { PageHeader, SectionCard, CardHeader, InfoRow, LocalStatus, ActionButton, LayoutMetrics, PageSurface } from "../common.slint";
import { ValueSlider } from "../../components/value-slider.slint";
import { Icon, Icons } from "../../components/icon.slint";
import { Palette } from "../../themes/dark.slint";

// Upright battery with a level fill and a charging bolt.
component BatteryGauge inherits Rectangle {
    in property <int> percent: -1;
    in property <bool> charging: false;
    in property <color> tint: Palette.success;
    width: 92px;
    height: 150px;
    background: transparent;

    Rectangle {
        x: (parent.width - self.width) / 2;
        width: 34px;
        height: 12px;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
        background: root.tint.transparentize(0.45);
    }
    Rectangle {
        y: 10px;
        height: parent.height - 10px;
        border-radius: 16px;
        border-width: 4px;
        border-color: root.tint.transparentize(0.25);
        background: root.tint.transparentize(0.92);

        property <float> level: Math.min(Math.max(root.percent, 0), 100) / 100;
        Rectangle {
            x: 9px;
            width: parent.width - 18px;
            height: (parent.height - 18px) * parent.level;
            y: parent.height - 9px - self.height;
            border-radius: 9px;
            background: root.tint;
        }
        if (root.charging) : Icon {
            width: 46px;
            height: 46px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            kind: Icons.zap;
            tint: #FFFFFF;
        }
    }
}

component StatusRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    height: 30px;
    spacing: 16px;
    Text { width: 142px; text: root.label; font-size: 13px; color: Palette.text-secondary; vertical-alignment: center; overflow: elide; }
    Text { horizontal-stretch: 1; text: root.value; font-size: 13.5px; font-weight: 550; color: Palette.text-primary; vertical-alignment: center; overflow: elide; }
}

export component PowerSection inherits PageSurface {
    in property <UiState> ui-state;
    in property <image> battery-spark;
    // Capacity relative to design capacity, percent (-1 unknown).
    in property <int> battery-health-value: -1;
    callback charge-changed(float);
    in property <int> full-charge-restore: -1;
    callback full-charge-requested(bool);

    function ac-label() -> string {
        if (root.ui-state.ac-online == "On AC") { return "Сеть (AC)"; }
        if (root.ui-state.ac-online == "On battery") { return "Батарея"; }
        return root.ui-state.ac-online;
    }

    function charging() -> bool {
        return root.ui-state.battery-status == "Charging" || root.ui-state.battery-status == "charging";
    }

    function battery-status-label() -> string {
        if (root.ui-state.battery-status == "") { return "—"; }
        if (root.charging()) { return "Заряжается"; }
        if (root.ui-state.battery-status == "Discharging" || root.ui-state.battery-status == "discharging") { return "Разряжается"; }
        if (root.ui-state.battery-status == "Full" || root.ui-state.battery-status == "full") { return "Полностью заряжена"; }
        if (root.ui-state.battery-status == "Not charging" || root.ui-state.battery-status == "Not Charging") { return "Не заряжается"; }
        return root.ui-state.battery-status;
    }

    function status-color() -> color {
        if (root.charging() || root.ui-state.battery-status == "Full" || root.ui-state.battery-status == "full") { return Palette.success; }
        if (root.ui-state.battery-percent-value >= 0 && root.ui-state.battery-percent-value < 20) { return Palette.warning; }
        return Palette.text-primary;
    }

    function gauge-color() -> color {
        if (root.ui-state.battery-percent-value >= 0 && root.ui-state.battery-percent-value < 20) { return Palette.warning; }
        return Palette.success;
    }

    // Health grade from the reported capacity percentage (battery_health "89%").
    function health-grade() -> int {
        if (root.battery-health-value < 0) { return -1; }
        if (root.battery-health-value >= 80) { return 2; }
        if (root.battery-health-value >= 60) { return 1; }
        return 0;
    }

    function health-label() -> string {
        if (root.health-grade() == 2) { return "Хорошее"; }
        if (root.health-grade() == 1) { return "Удовлетворительное"; }
        if (root.health-grade() == 0) { return "Изношена"; }
        return "Нет данных";
    }

    function health-color() -> color {
        if (root.health-grade() == 2) { return Palette.success; }
        if (root.health-grade() == 1) { return Palette.warning; }
        if (root.health-grade() == 0) { return Palette.error; }
        return Palette.text-secondary;
    }

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: LayoutMetrics.page-margin;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            PageHeader { title: "Питание"; subtitle: "Заряд, лимит заряда и состояние батареи"; }

            HorizontalLayout {
                spacing: LayoutMetrics.page-gap;
                height: 250px;

                SectionCard {
                    width: (parent.width - LayoutMetrics.page-gap) * 0.66;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 8px;
                        CardHeader { title: "Текущий статус"; divider: false; }
                        HorizontalLayout {
                            vertical-stretch: 1;
                            spacing: 26px;
                            padding-left: 8px;
                            Rectangle {
                                width: 92px;
                                BatteryGauge {
                                    y: (parent.height - self.height) / 2;
                                    percent: root.ui-state.battery-percent-value;
                                    charging: root.charging();
                                    tint: root.gauge-color();
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    text: root.ui-state.battery-percent;
                                    font-size: 52px;
                                    font-weight: 700;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: root.battery-status-label();
                                    font-size: 17px;
                                    font-weight: 600;
                                    color: root.status-color();
                                }
                                Text { text: root.ac-label(); font-size: 14px; color: Palette.text-secondary; }
                            }
                            Rectangle { width: 1px; background: Palette.border-default; }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                StatusRow { label: "Состояние"; value: root.battery-status-label(); }
                                StatusRow { label: "Источник питания"; value: root.ac-label(); }
                                StatusRow {
                                    label: "Лимит заряда";
                                    value: root.ui-state.charge-limit-state == ChargeLimitState.Ready ? root.ui-state.charge-limit + " %" : "—";
                                }
                                StatusRow { label: "Потребление системы"; value: root.ui-state.power-ac-mw; }
                                StatusRow { label: "Дискретная графика"; value: root.ui-state.gpu-power; }
                            }
                        }
                    }
                }

                SectionCard {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 6px;
                        CardHeader { title: "Здоровье батареи"; }
                        HorizontalLayout {
                            height: 52px;
                            spacing: 14px;
                            Icon { width: 36px; height: 36px; y: 8px; kind: Icons.heart; tint: root.health-color(); }
                            Text {
                                text: root.health-label();
                                font-size: 20px;
                                font-weight: 650;
                                color: root.health-color();
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        InfoRow { label: "Ёмкость (от заводской)"; value: root.ui-state.battery-health; }
                        InfoRow { label: "Циклов заряда"; value: root.ui-state.battery-cycles; }
                        Rectangle { vertical-stretch: 1; }
                        Text {
                            text: root.health-grade() == 2 ? "Батарея в хорошем состоянии. Лимит заряда 60–80 % помогает сохранить ёмкость."
                                : root.health-grade() >= 0 ? "Ёмкость заметно снизилась: время автономной работы будет меньше заводского."
                                : "Контроллер батареи не сообщает ёмкость.";
                            font-size: 12.5px;
                            color: Palette.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 12px;

                    CardHeader {
                        title: "Настройки заряда";
                        detail: root.ui-state.charge-limit-state == ChargeLimitState.Ready && !root.ui-state.charge-limit-writable ? "Только чтение" : "";
                    }

                    Text { text: "Лимит заряда"; font-size: 15px; font-weight: 600; color: Palette.text-primary; }

                    if (root.ui-state.charge-limit-state == ChargeLimitState.Ready) : ValueSlider {
                        min: 20;
                        max: 100;
                        step: 1;
                        value: root.ui-state.charge-limit;
                        disabled: !root.ui-state.charge-limit-writable || root.ui-state.charge-limit-pending || root.ui-state.charge-limit-unconfirmed || root.ui-state.charge-limit-error != "";
                        changed(v) => { root.charge-changed(v); }
                    }
                    Text {
                        text: "Ограничивает максимальный уровень заряда. 60–80 % продлевают срок службы батареи, если ноутбук в основном работает от сети.";
                        font-size: 12.5px;
                        color: Palette.text-secondary;
                        wrap: word-wrap;
                    }
                    if (root.ui-state.charge-limit-state == ChargeLimitState.Ready && root.ui-state.charge-limit-writable) : Rectangle {
                        height: 1px;
                        background: Palette.border-default;
                    }
                    if (root.ui-state.charge-limit-state == ChargeLimitState.Ready && root.ui-state.charge-limit-writable) : HorizontalLayout {
                        spacing: 16px;
                        Rectangle {
                            width: 26px;
                            Icon { width: 24px; height: 24px; y: (parent.height - self.height) / 2; kind: Icons.zap; tint: root.full-charge-restore >= 0 ? Palette.success : Palette.text-primary; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 3px;
                            Text { text: "Зарядить до 100 % один раз"; font-size: 14.5px; font-weight: 550; color: Palette.text-primary; }
                            Text {
                                text: root.full-charge-restore >= 0
                                    ? "Идёт полная зарядка · лимит вернётся к " + root.full-charge-restore + " % после заряда или отключения зарядки"
                                    : "Перед поездкой: лимит временно снимается и возвращается сам";
                                font-size: 12.5px;
                                color: root.full-charge-restore >= 0 ? Palette.success : Palette.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                        ActionButton {
                            width: 150px;
                            y: 4px;
                            label: root.full-charge-restore >= 0 ? "Отменить" : "Зарядить";
                            accent: root.full-charge-restore < 0;
                            disabled: root.ui-state.charge-limit-pending || root.ui-state.charge-limit-unconfirmed;
                            clicked => { root.full-charge-requested(root.full-charge-restore < 0); }
                        }
                    }
                    if (root.ui-state.charge-limit-pending || root.ui-state.charge-limit-unconfirmed || root.ui-state.charge-limit-error != "") : LocalStatus {
                        text: root.ui-state.charge-limit-pending ? "Ожидание подтверждения"
                            : root.ui-state.charge-limit-unconfirmed ? "Результат неизвестен · обновите состояние перед новой записью"
                            : root.ui-state.charge-limit-error;
                        accent: root.ui-state.charge-limit-error != "" ? Palette.error : Palette.warning;
                    }
                    if (root.ui-state.charge-limit-state != ChargeLimitState.Ready) : LocalStatus {
                        text: root.ui-state.charge-limit-state == ChargeLimitState.Loading ? "Чтение…" : "Недоступно на этом устройстве";
                        accent: root.ui-state.charge-limit-state == ChargeLimitState.Loading ? Palette.text-secondary : Palette.warning;
                    }
                }
            }

            Rectangle { vertical-stretch: 100; }
        }
    }
}
