// Power page — battery state, health/consumption and the charge limit.
import { ScrollView } from "std-widgets.slint";
import { UiState, ChargeLimitState } from "../model.slint";
import { PageHeader, SectionCard, SectionTitle, InfoRow, LocalStatus, LayoutMetrics } from "../common.slint";
import { ValueSlider } from "../../components/value-slider.slint";
import { Icon } from "../../components/icon.slint";
import { Palette } from "../../themes/dark.slint";

export component PowerSection inherits Rectangle {
    in property <UiState> ui-state;
    callback charge-changed(float);

    function ac-label() -> string {
        if (root.ui-state.ac-online == "On AC") { return "От сети"; }
        if (root.ui-state.ac-online == "On battery") { return "От батареи"; }
        return root.ui-state.ac-online;
    }

    function battery-status-label() -> string {
        if (root.ui-state.battery-status == "") { return "—"; }
        if (root.ui-state.battery-status == "Charging" || root.ui-state.battery-status == "charging") { return "Зарядка"; }
        if (root.ui-state.battery-status == "Discharging" || root.ui-state.battery-status == "discharging") { return "Разрядка"; }
        if (root.ui-state.battery-status == "Full" || root.ui-state.battery-status == "full") { return "Полный заряд"; }
        if (root.ui-state.battery-status == "Not charging" || root.ui-state.battery-status == "Not Charging") { return "Не заряжается"; }
        return root.ui-state.battery-status;
    }

    function charging() -> bool {
        return root.ui-state.battery-status == "Charging" || root.ui-state.battery-status == "charging"
            || root.ui-state.battery-status == "Full" || root.ui-state.battery-status == "full";
    }

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: LayoutMetrics.page-margin;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            PageHeader { title: "Питание"; }

            HorizontalLayout {
                spacing: LayoutMetrics.page-gap;
                height: 232px;

                SectionCard {
                    width: (parent.width - LayoutMetrics.page-gap) / 2;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 10px;
                        SectionTitle { title: "Батарея"; }
                        Rectangle { vertical-stretch: 1; }
                        HorizontalLayout {
                            spacing: 18px;
                            Text {
                                text: root.ui-state.battery-percent;
                                font-size: 48px;
                                font-weight: 700;
                                color: Palette.text-primary;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: root.battery-status-label();
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: root.charging() ? Palette.success : Palette.text-primary;
                                }
                                Text { text: root.ac-label(); font-size: 13px; color: Palette.text-secondary; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Rectangle { vertical-stretch: 1; }
                        Rectangle {
                            height: 8px;
                            border-radius: 4px;
                            background: Palette.border-default;
                            Rectangle {
                                x: 0px;
                                width: parent.width * Math.min(Math.max(root.ui-state.battery-percent-value, 0), 100) / 100;
                                height: parent.height;
                                border-radius: 4px;
                                background: Palette.success;
                            }
                        }
                    }
                }

                SectionCard {
                    width: (parent.width - LayoutMetrics.page-gap) / 2;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 2px;
                        SectionTitle { title: "Состояние"; }
                        Rectangle { height: 6px; }
                        InfoRow { label: "Здоровье"; value: root.ui-state.battery-health; }
                        InfoRow { label: "Циклы заряда"; value: root.ui-state.battery-cycles; }
                        InfoRow { label: "Потребление"; value: root.ui-state.power-ac-mw; }
                        InfoRow { label: "Дискретная графика"; value: root.ui-state.gpu-power; }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 12px;

                    SectionTitle {
                        title: "Лимит заряда";
                        detail: root.ui-state.charge-limit-state == ChargeLimitState.Ready && !root.ui-state.charge-limit-writable ? "Только чтение" : "";
                    }

                    if (root.ui-state.charge-limit-state == ChargeLimitState.Ready) : ValueSlider {
                        min: 20;
                        max: 100;
                        step: 1;
                        value: root.ui-state.charge-limit;
                        disabled: !root.ui-state.charge-limit-writable || root.ui-state.charge-limit-pending || root.ui-state.charge-limit-unconfirmed || root.ui-state.charge-limit-error != "";
                        changed(v) => { root.charge-changed(v); }
                    }
                    if (root.ui-state.charge-limit-pending || root.ui-state.charge-limit-unconfirmed || root.ui-state.charge-limit-error != "") : LocalStatus {
                        text: root.ui-state.charge-limit-pending ? "Ожидание подтверждения"
                            : root.ui-state.charge-limit-unconfirmed ? "Результат неизвестен · обновите состояние перед новой записью"
                            : root.ui-state.charge-limit-error;
                        accent: root.ui-state.charge-limit-error != "" ? Palette.error : Palette.warning;
                    }
                    if (root.ui-state.charge-limit-state != ChargeLimitState.Ready) : LocalStatus {
                        text: root.ui-state.charge-limit-state == ChargeLimitState.Loading ? "Чтение…" : "Недоступно на этом устройстве";
                        accent: root.ui-state.charge-limit-state == ChargeLimitState.Loading ? Palette.text-secondary : Palette.warning;
                    }
                }
            }

            Rectangle { vertical-stretch: 100; }
        }
    }
}
