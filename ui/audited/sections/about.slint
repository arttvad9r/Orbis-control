// About page — product identity, scope and version.
import { ScrollView } from "std-widgets.slint";
import { PageHeader, SectionCard, SectionTitle, CardHeader, IconBadge, InfoRow, ActionButton, LayoutMetrics } from "../common.slint";
import { Icons } from "../../components/icon.slint";
import { AppMark } from "../../components/app-mark.slint";
import { Palette } from "../../themes/dark.slint";

export component AboutSection inherits Rectangle {
    in property <string> version: "0.0.0";
    in property <string> update-status: "";
    in property <bool> update-problem: false;
    in property <bool> update-busy: false;
    callback update-check-requested();

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: LayoutMetrics.page-margin;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            PageHeader { title: "О программе"; subtitle: "Версия, обновления и сведения о проекте"; }

            SectionCard {
                height: 150px;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 20px;

                    Rectangle {
                        width: 88px;
                        AppMark {
                            width: 88px;
                            height: 88px;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: "Orbis Control";
                            font-size: 28px;
                            font-weight: 700;
                            color: Palette.text-primary;
                        }
                        Text {
                            text: "Версия " + root.version;
                            font-size: 13.5px;
                            color: Palette.text-secondary;
                        }
                    }

                    VerticalLayout {
                        width: 240px;
                        alignment: center;
                        spacing: 8px;
                        ActionButton {
                            label: root.update-busy ? "Проверяю…" : "Проверить обновления";
                            accent: true;
                            disabled: root.update-busy;
                            clicked => { root.update-check-requested(); }
                        }
                        if (root.update-status != "") : Text {
                            text: root.update-status;
                            font-size: 12px;
                            color: root.update-problem ? Palette.warning : Palette.text-secondary;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 2px;
                    CardHeader { title: "Приложение"; icon-kind: Icons.info; }
                    Rectangle { height: 4px; }
                    InfoRow { label: "Платформа"; value: "Linux"; }
                    InfoRow { label: "Устройства"; value: "ASUS ROG / TUF / Zephyrus"; }
                    InfoRow { label: "Лицензия"; value: "GPL-3.0-or-later"; }
                }
            }

            Rectangle { vertical-stretch: 100; }
        }
    }
}
