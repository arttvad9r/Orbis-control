// About page — application identity, version and an honest scope statement.
import { ScrollView } from "std-widgets.slint";
import { PageHeader, SectionCard, Grid } from "../common.slint";
import { Palette } from "../../themes/dark.slint";

export component AboutSection inherits Rectangle {
    in property <string> version: "0.0.0";

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * Grid.page-gutter;
            x: Grid.page-gutter;
            spacing: Grid.card-spacing;
            padding-top: Grid.page-top;
            padding-bottom: Grid.page-bottom;

            PageHeader {
                title: "О программе";
            }

            SectionCard {
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 10px;
                            background: Palette.accent-default;
                            Rectangle {
                                width: 12px;
                                height: 12px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: 3px;
                                background: Palette.text-on-accent;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Orbis Control";
                                font-size: 18px;
                                font-weight: 650;
                                color: Palette.text-primary;
                            }
                            Text {
                                text: "Версия " + root.version;
                                font-size: 12.5px;
                                color: Palette.text-secondary;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }

                    Text {
                        // F3 (audit t_5fc90d28): follow the layout width — the
                        // previous hard min-width exceeded the 980px window's
                        // text area and clipped the last word.
                        width: parent.width;
                        text: "Лёгкое управление ноутбуками ASUS ROG / TUF / Zephyrus для Linux: профили производительности, заряд батареи, вентиляторы и наблюдение за оборудованием.";
                        font-size: 13px;
                        color: Palette.text-primary;
                        wrap: word-wrap;
                    }
                    Text {
                        width: parent.width;
                        text: "Интерфейс построен на данных о возможностях устройства: поддерживаемые функции показываются, неподдерживаемые — скрываются. Изменения применяются через ограниченный Hardware1-интерфейс с подтверждением фактического состояния.";
                        font-size: 12.5px;
                        color: Palette.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }
            Rectangle { vertical-stretch: 100; background: transparent; }
        }
    }
}
