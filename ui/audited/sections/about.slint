// About page — product identity, scope and version.
import { ScrollView } from "std-widgets.slint";
import { PageHeader, SectionCard, SectionTitle, InfoRow, StatusPill, LayoutMetrics } from "../common.slint";
import { AppMark } from "../../components/app-mark.slint";
import { Palette } from "../../themes/dark.slint";

export component AboutSection inherits Rectangle {
    in property <string> version: "0.0.0";

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: 14px;
            padding-bottom: 26px;

            PageHeader {
                title: "О программе";
                description: "Orbis Control — единый центр управления поддерживаемыми функциями ноутбуков ASUS в Linux.";
            }

            SectionCard {
                min-height: 172px;
                background: Palette.surface-raised;
                HorizontalLayout {
                    padding: 24px;
                    spacing: 20px;
                    AppMark { width: 72px; height: 72px; }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                        VerticalLayout {
                            width: parent.width;
                            alignment: center;
                            spacing: 5px;
                            Text {
                                width: parent.width;
                                text: "Orbis Control";
                                font-size: 24px;
                                font-weight: 700;
                                color: Palette.text-primary;
                            }
                            Text {
                                width: parent.width;
                                text: "Нативный Linux control center для ASUS ROG / TUF / Zephyrus";
                                font-size: 13px;
                                color: Palette.text-secondary;
                                overflow: elide;
                            }
                            Rectangle { height: 4px; background: transparent; }
                            StatusPill { width: 126px; text: "Версия " + root.version; accent: Palette.accent-default; }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 14px;
                SectionCard {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 10px;
                        SectionTitle { title: "Возможности"; }
                        Text {
                            text: "Профили производительности, управление батареей, вентиляторами, гибридной графикой, подсветкой, панелью и расширенными функциями ASUS.";
                            font-size: 13px;
                            color: Palette.text-primary;
                            wrap: word-wrap;
                        }
                    }
                }
                SectionCard {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: LayoutMetrics.card-padding;
                        spacing: 10px;
                        SectionTitle { title: "Принцип работы"; }
                        Text {
                            text: "Интерфейс строится по фактическим возможностям устройства. Изменения проходят через ограниченный Hardware1 API и, где возможно, подтверждаются чтением реального состояния.";
                            font-size: 13px;
                            color: Palette.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 4px;
                    SectionTitle { title: "Приложение"; }
                    InfoRow { label: "Название"; value: "Orbis Control"; }
                    InfoRow { label: "Версия"; value: root.version; }
                    InfoRow { label: "Платформа"; value: "Linux · Arch first"; }
                    InfoRow { label: "Лицензия"; value: "GPL-3.0-or-later"; }
                }
            }

            Rectangle { vertical-stretch: 100; background: transparent; }
        }
    }
}
