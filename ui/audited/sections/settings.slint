// Settings section: appearance, startup/window behavior, diagnostics actions
// and about (spec §2.4). Merges the former preferences-window and the
// diagnostics actions; Open Logs stays intentionally absent (#111).
import { ComboBox } from "std-widgets.slint";
import { RequestToggleRow } from "../../components/request-toggle-row.slint";
import { ChoiceChip } from "../../components/visual-controls.slint";
import { ThemeBridge, SectionCard, SectionTitle, ActionButton, LocalStatus } from "../common.slint";
import { Palette, ThemeState, ThemeMode } from "../../themes/dark.slint";

export component SettingsSection inherits Rectangle {
    callback theme-changed(bool);
    callback startup-changed(bool);
    callback start-minimized-changed(bool);
    callback remember-position-changed(bool);
    callback close-action-changed(int);

    // Backend-owned state. Disabled means the corresponding lifecycle backend
    // has not supplied authoritative state yet.
    in-out property <bool> startup: false;
    in-out property <bool> startup-enabled: false;
    in property <string> startup-status: "Unavailable";

    in property <bool> start-minimized: false;
    in property <bool> start-minimized-enabled: false;
    in property <bool> remember-position: false;
    in property <bool> remember-position-enabled: false;
    in property <int> close-action: 0; // 0 Quit, 1 Hide to tray
    // Persistence/readiness of the close-action setting itself.
    in property <bool> close-action-enabled: false;
    // Runtime capability for the tray-specific option only. Quit remains a
    // safe selectable action whenever close-action-enabled is true.
    in property <bool> hide-to-tray-enabled: false;

    // Diagnostics actions (same runtime paths as the former window).
    in-out property <bool> refresh-enabled: false;
    in property <bool> refresh-pending: false;
    in property <bool> export-enabled: false;
    // Privacy-safe projection filled by the diagnostics runtime on refresh;
    // the Copy button routes it through the toolkit clipboard.
    in property <string> diagnostics-summary: "";
    in property <string> diagnostics-status: "Diagnostics unavailable · lifecycle wiring pending";
    callback refresh-requested;
    callback export-report-requested;

    in property <string> version: "0.0.0";
    in property <string> mock-profile: "production";

    in-out property <string> local-status: "Theme changes are saved immediately";

    function set-theme(light: bool) {
        ThemeState.mode = light ? ThemeMode.Light : ThemeMode.Dark;
        root.local-status = light ? "Light theme active" : "Dark theme active";
        root.theme-changed(light);
    }

    ThemeBridge { }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        SectionCard {
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                SectionTitle { title: "Appearance"; detail: "Saved immediately"; }
                HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    Text { width: 116px; text: "Theme"; font-size: 10px; font-weight: 550; color: Palette.text-primary; vertical-alignment: center; }
                    ChoiceChip { horizontal-stretch: 1; label: "Dark"; selected: ThemeState.mode == ThemeMode.Dark; clicked => { root.set-theme(false); } }
                    ChoiceChip { horizontal-stretch: 1; label: "Light"; selected: ThemeState.mode == ThemeMode.Light; clicked => { root.set-theme(true); } }
                }
            }
        }

        SectionCard {
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                SectionTitle { title: "Startup and window"; detail: root.startup-status; }
                RequestToggleRow {
                    label: "Run on startup";
                    description: root.startup-enabled ? "Start Orbis with the user session" : "Waiting for autostart backend";
                    checked: root.startup;
                    disabled: !root.startup-enabled;
                    toggled(value) => { root.startup-changed(value); }
                }
                RequestToggleRow {
                    label: "Start minimized";
                    description: root.start-minimized-enabled ? "Open without focusing the main window" : "Waiting for preferences lifecycle";
                    checked: root.start-minimized;
                    disabled: !root.start-minimized-enabled;
                    toggled(value) => { root.start-minimized-changed(value); }
                }
                RequestToggleRow {
                    label: "Remember window position";
                    description: root.remember-position-enabled ? "Restore only when the active window system supports it" : "Unavailable on current lifecycle/backend";
                    checked: root.remember-position;
                    disabled: !root.remember-position-enabled;
                    toggled(value) => { root.remember-position-changed(value); }
                }
                HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    Text { width: 148px; text: "Close button"; font-size: 10px; color: root.close-action-enabled ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; }
                    ComboBox {
                        width: 200px;
                        enabled: root.close-action-enabled;
                        model: ["Quit", "Hide to tray"];
                        current-index: root.close-action;
                        selected => {
                            // Hide-to-tray stays unselectable without a live
                            // tray host; snap back to the authoritative value.
                            if (!root.hide-to-tray-enabled && self.current-index == 1) {
                                self.current-index = root.close-action;
                            } else {
                                root.close-action-changed(self.current-index);
                            }
                        }
                    }
                }
            }
        }

        SectionCard {
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                SectionTitle { title: "Diagnostics"; }
                HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    ActionButton { width: 96px; label: root.refresh-pending ? "Refreshing…" : "Refresh"; disabled: !root.refresh-enabled || root.refresh-pending; clicked => { root.refresh-requested(); } }
                    ActionButton {
                        width: 96px;
                        label: "Copy";
                        disabled: root.diagnostics-summary == "";
                        clicked => {
                            copy-ti.select-all();
                            copy-ti.copy();
                            root.local-status = "Diagnostics copied to clipboard";
                        }
                    }
                    ActionButton { width: 96px; label: "Export"; disabled: !root.export-enabled; clicked => { root.export-report-requested(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
                LocalStatus { text: root.diagnostics-status; accent: Palette.text-secondary; }
            }
        }


        SectionCard {
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                SectionTitle { title: "About"; }
                Text {
                    text: "Orbis Control v" + root.version + " · profile: " + root.mock-profile;
                    font-size: 10px;
                    color: Palette.text-secondary;
                    vertical-alignment: center;
                }
            }
        }

        LocalStatus {
            text: root.local-status;
            accent: Palette.text-secondary;
        }
    }

    // Offscreen clipboard carrier: select-all + copy use the toolkit
    // clipboard without any extra dependency. Direct child of the section
    // root so no layout manages its position.
    copy-ti := TextInput {
        y: -1000px;
        width: 1px;
        height: 1px;
        text: root.diagnostics-summary;
        read-only: true;
    }
}
