// Backlight page — keyboard brightness and Aura state/presets.
import { ScrollView } from "std-widgets.slint";
import { PageHeader, SectionCard, SectionTitle, LocalStatus, InfoRow, StatusPill, LayoutMetrics } from "../common.slint";
import { Icon } from "../../components/icon.slint";
import { Palette } from "../../themes/dark.slint";

component ColorPresetButton inherits Rectangle {
    in property <string> label;
    in property <color> swatch;
    in property <bool> disabled: false;
    callback clicked;

    horizontal-stretch: 1;
    height: 54px;
    border-radius: 11px;
    border-width: 1px;
    border-color: touch.has-hover && !root.disabled ? Palette.border-strong : Palette.border-default;
    background: root.disabled ? Palette.surface-disabled : touch.has-hover ? Palette.surface-hover : Palette.surface-raised;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: center;
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;
            border-width: 2px;
            border-color: Palette.border-strong;
            background: root.swatch;
        }
        Text {
            text: root.label;
            font-size: 12.5px;
            font-weight: 600;
            color: root.disabled ? Palette.text-disabled : Palette.text-primary;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

export component BacklightSection inherits Rectangle {
    in property <bool> keyboard-state-ready: false;
    in property <bool> keyboard-control-ready: false;
    in property <int> keyboard-brightness: -1;
    callback keyboard-brightness-requested(int);
    in property <bool> aura-state-ready: false;
    in property <bool> aura-control-ready: false;
    in-out property <int> keyboard-effect: -1;
    in-out property <int> keyboard-speed: -1;
    callback aura-static-rgb-requested(int, int, int);

    function keyboard-status() -> string {
        if (!root.keyboard-state-ready) { return "Получение состояния подсветки"; }
        if (root.keyboard-control-ready) { return "Изменение яркости подтверждается чтением фактического уровня"; }
        return "Текущий уровень доступен только для чтения";
    }

    function aura-effect-label() -> string {
        if (!root.aura-state-ready) { return "—"; }
        if (root.keyboard-effect == 0) { return "Static"; }
        if (root.keyboard-effect == 1) { return "Breathing"; }
        if (root.keyboard-effect == 2) { return "Color Cycle"; }
        return "—";
    }

    function aura-speed-label() -> string {
        if (!root.aura-state-ready) { return "—"; }
        if (root.keyboard-speed == 0) { return "Slow"; }
        if (root.keyboard-speed == 1) { return "Normal"; }
        if (root.keyboard-speed == 2) { return "Fast"; }
        return "—";
    }

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: 14px;
            padding-bottom: 26px;

            PageHeader {
                title: "Подсветка";
                description: "Яркость клавиатуры, состояние Aura и быстрые цветовые пресеты.";
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 14px;

                    HorizontalLayout {
                        height: 30px;
                        SectionTitle { horizontal-stretch: 1; title: "Подсветка клавиатуры"; }
                        StatusPill {
                            text: root.keyboard-state-ready ? (root.keyboard-control-ready ? "Доступно" : "Только чтение") : "Определяется";
                            accent: root.keyboard-control-ready ? Palette.success : root.keyboard-state-ready ? Palette.text-secondary : Palette.warning;
                        }
                    }

                    if (root.keyboard-state-ready) : HorizontalLayout {
                        height: 46px;
                        spacing: 10px;
                        for level in 4: Rectangle {
                            min-width: 104px;
                            horizontal-stretch: 1;
                            border-radius: 11px;
                            border-width: root.keyboard-brightness == level && root.keyboard-control-ready ? 1.5px : 1px;
                            border-color: root.keyboard-brightness == level && root.keyboard-control-ready ? Palette.accent-default : Palette.border-default;
                            background: root.keyboard-brightness == level && root.keyboard-control-ready ? Palette.accent-soft : Palette.surface-raised;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Icon {
                                    kind: 5;
                                    tint: root.keyboard-brightness == level && root.keyboard-control-ready ? Palette.accent-default : Palette.text-secondary;
                                }
                                Text {
                                    text: level == 0 ? "Выключено" : "Уровень " + level;
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    color: root.keyboard-control-ready ? Palette.text-primary : Palette.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                            kb-touch := TouchArea {
                                enabled: root.keyboard-control-ready;
                                clicked => { root.keyboard-brightness-requested(level); }
                            }
                        }
                    }

                    LocalStatus {
                        text: root.keyboard-status();
                        accent: root.keyboard-control-ready ? Palette.success : root.keyboard-state-ready ? Palette.text-secondary : Palette.warning;
                    }
                }
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 14px;

                    HorizontalLayout {
                        height: 30px;
                        SectionTitle { horizontal-stretch: 1; title: "Aura"; }
                        StatusPill {
                            text: root.aura-state-ready ? (root.aura-control-ready ? "Управление" : "Наблюдение") : "Определяется";
                            accent: root.aura-control-ready ? Palette.success : root.aura-state-ready ? Palette.text-secondary : Palette.warning;
                        }
                    }

                    HorizontalLayout {
                        spacing: 18px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            InfoRow { label: "Эффект"; value: root.aura-effect-label(); }
                            InfoRow { label: "Скорость"; value: root.aura-speed-label(); }
                        }
                        Rectangle { width: 1px; background: Palette.border-default; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            Text {
                                text: "Быстрый Static RGB";
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Palette.text-secondary;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                ColorPresetButton {
                                    label: "Красный"; swatch: #ff414d; disabled: !root.aura-control-ready;
                                    clicked => { root.aura-static-rgb-requested(255, 65, 77); }
                                }
                                ColorPresetButton {
                                    label: "Голубой"; swatch: #38c9ff; disabled: !root.aura-control-ready;
                                    clicked => { root.aura-static-rgb-requested(56, 201, 255); }
                                }
                                ColorPresetButton {
                                    label: "Белый"; swatch: #f4f7ff; disabled: !root.aura-control-ready;
                                    clicked => { root.aura-static-rgb-requested(244, 247, 255); }
                                }
                            }
                        }
                    }

                    LocalStatus {
                        text: root.aura-control-ready
                            ? "Static RGB применяется с config-level read-back"
                            : root.aura-state-ready ? "Aura определяется, управление для этого backend пока не опубликовано" : "Получение состояния Aura";
                        accent: root.aura-control-ready ? Palette.success : Palette.text-secondary;
                    }
                }
            }

            Rectangle { vertical-stretch: 100; background: transparent; }
        }
    }
}
