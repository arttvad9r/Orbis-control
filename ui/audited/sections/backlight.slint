// Backlight page — keyboard brightness/timeout and Aura effect, speed and color.
import { ScrollView } from "std-widgets.slint";
import { PageHeader, SectionCard, SectionTitle, CardHeader, IconRow, LocalStatus, ChoiceButton, Segmented, FieldRow, Divider, LayoutMetrics, PageSurface } from "../common.slint";
import { Icon, Icons } from "../../components/icon.slint";
import { KeyboardPreview } from "../../components/keyboard-preview.slint";
import { ValueSlider } from "../../components/value-slider.slint";
import { Palette } from "../../themes/dark.slint";

component Swatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> selected: false;
    in property <bool> disabled: false;
    callback clicked;

    width: 40px;
    height: 40px;
    border-radius: 20px;
    border-width: 2.5px;
    border-color: root.selected ? Palette.accent-border : touch.has-hover && !root.disabled ? Palette.border-strong : transparent;
    background: transparent;
    Rectangle {
        x: 5px;
        y: 5px;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: root.disabled ? root.swatch.transparentize(0.6) : root.swatch;
    }
    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

component ChannelRow inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <bool> disabled;
    callback changed(float);
    height: 40px;
    HorizontalLayout {
        spacing: 16px;
        Text {
            width: 190px;
            text: root.label;
            font-size: 13.5px;
            color: Palette.text-secondary;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        ValueSlider {
            horizontal-stretch: 1;
            value: root.value;
            min: 0; max: 255; unit: "";
            disabled: root.disabled;
            changed(v) => { root.changed(v); }
        }
    }
}

export component BacklightSection inherits PageSurface {
    in property <bool> keyboard-state-ready: false;
    in property <bool> keyboard-control-ready: false;
    in property <int> keyboard-brightness: -1;
    in property <string> keyboard-mutation-error: "";
    callback keyboard-brightness-requested(int);
    in property <int> keyboard-timeout-ac: 0;
    in property <int> keyboard-timeout-battery: 0;
    in property <string> keyboard-timeout-status: "";
    in property <bool> keyboard-timeout-problem: false;
    callback keyboard-timeout-requested(bool, int);
    in property <bool> aura-state-ready: false;
    in property <bool> aura-control-ready: false;
    in-out property <int> keyboard-effect: -1;
    in-out property <int> keyboard-speed: -1;
    in-out property <int> rgb-red: 255;
    in-out property <int> rgb-green: 65;
    in-out property <int> rgb-blue: 77;
    in property <bool> aura-static-supported: false;
    in property <bool> aura-breathe-supported: false;
    in property <bool> aura-rainbow-supported: false;
    in property <bool> aura-rainbow-wave-supported: false;
    in property <bool> aura-star-supported: false;
    in property <bool> aura-rain-supported: false;
    in property <bool> aura-highlight-supported: false;
    in property <bool> aura-laser-supported: false;
    in property <bool> aura-ripple-supported: false;
    in property <bool> aura-pulse-supported: false;
    in property <bool> aura-comet-supported: false;
    in property <bool> aura-flash-supported: false;
    in-out property <int> aura-secondary-red: 0;
    in-out property <int> aura-secondary-green: 0;
    in-out property <int> aura-secondary-blue: 0;
    callback aura-static-rgb-requested(int, int, int);
    callback aura-effect-requested(int, int, int, int, int, int, int, int);

    function request-rgb(r: int, g: int, b: int) {
        root.rgb-red = r;
        root.rgb-green = g;
        root.rgb-blue = b;
        root.aura-static-rgb-requested(r, g, b);
    }

    function request-effect(mode: int, speed: int) {
        root.aura-effect-requested(mode, speed, root.rgb-red, root.rgb-green, root.rgb-blue,
            root.aura-secondary-red, root.aura-secondary-green, root.aura-secondary-blue);
    }

    property <bool> edit-secondary: false;
    property <int> edit-red: root.edit-secondary ? root.aura-secondary-red : root.rgb-red;
    property <int> edit-green: root.edit-secondary ? root.aura-secondary-green : root.rgb-green;
    property <int> edit-blue: root.edit-secondary ? root.aura-secondary-blue : root.rgb-blue;

    function timeout-index(secs: int) -> int {
        if (secs == 0) { return 0; }
        if (secs == 15) { return 1; }
        if (secs == 30) { return 2; }
        if (secs == 60) { return 3; }
        if (secs == 300) { return 4; }
        return -1;
    }

    function timeout-label(secs: int) -> string {
        if (secs == 0) { return "Никогда"; }
        if (secs < 60) { return secs + " с"; }
        return (secs / 60) + " мин";
    }

    // Color edits keep a color-using effect; anything else falls back to Static.
    function color-effect() -> int {
        return root.keyboard-effect == 1 ? 1 : 0;
    }

    function speed() -> int {
        return root.keyboard-speed < 0 ? 1 : root.keyboard-speed;
    }

    function set-edit-color(r: int, g: int, b: int) {
        if (root.edit-secondary) {
            root.aura-secondary-red = r;
            root.aura-secondary-green = g;
            root.aura-secondary-blue = b;
            root.request-effect(root.keyboard-effect < 0 ? 0 : root.keyboard-effect, root.speed());
        } else {
            root.rgb-red = r;
            root.rgb-green = g;
            root.rgb-blue = b;
            root.request-effect(root.color-effect(), root.speed());
        }
    }

    ScrollView {
        VerticalLayout {
            width: root.width - 2 * LayoutMetrics.page-margin;
            x: LayoutMetrics.page-margin;
            spacing: LayoutMetrics.page-gap;
            padding-top: LayoutMetrics.page-margin;
            padding-bottom: LayoutMetrics.page-bottom-padding;

            PageHeader {
                title: "Подсветка";
                subtitle: "Яркость, автоотключение и эффекты Aura для клавиатуры";
                icon-kind: Icons.keyboard;
            }

            KeyboardPreview {
                height: 250px;
                glow: rgb(root.rgb-red, root.rgb-green, root.rgb-blue);
                rainbow: root.keyboard-effect == 2 || root.keyboard-effect == 3 || root.keyboard-effect == 5;
                level: root.keyboard-state-ready ? root.keyboard-brightness : -1;
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 12px;

                    CardHeader {
                        title: "Настройки подсветки клавиатуры";
                        detail: !root.keyboard-state-ready ? "Чтение…" : root.keyboard-control-ready ? "" : "Только чтение";
                    }

                    if (root.keyboard-state-ready) : IconRow {
                        icon-kind: Icons.sun;
                        title: "Яркость";
                        description: "Уровень подсветки клавиш";
                        label-width: 190px;
                        Segmented {
                            options: ["Выкл", "Уровень 1", "Уровень 2", "Уровень 3"];
                            selected: root.keyboard-brightness;
                            disabled: !root.keyboard-control-ready;
                            changed(level) => { root.keyboard-brightness-requested(level); }
                        }
                    }
                    if (root.keyboard-state-ready) : IconRow {
                        separator: true;
                        icon-kind: Icons.plug;
                        title: "Гаснет от сети";
                        description: "Бездействие до отключения";
                        label-width: 190px;
                        Segmented {
                            options: ["Никогда", "15 с", "30 с", "1 мин", "5 мин"];
                            selected: root.timeout-index(root.keyboard-timeout-ac);
                            changed(i) => { root.keyboard-timeout-requested(true, [0, 15, 30, 60, 300][i]); }
                        }
                    }
                    if (root.keyboard-state-ready) : IconRow {
                        separator: true;
                        icon-kind: Icons.battery;
                        title: "Гаснет от батареи";
                        description: "Бездействие до отключения";
                        label-width: 190px;
                        Segmented {
                            options: ["Никогда", "15 с", "30 с", "1 мин", "5 мин"];
                            selected: root.timeout-index(root.keyboard-timeout-battery);
                            changed(i) => { root.keyboard-timeout-requested(false, [0, 15, 30, 60, 300][i]); }
                        }
                    }
                    if (root.keyboard-mutation-error != "") : LocalStatus {
                        text: root.keyboard-mutation-error;
                        accent: Palette.error;
                    }
                    if (root.keyboard-timeout-problem && root.keyboard-timeout-status != "") : LocalStatus {
                        text: root.keyboard-timeout-status;
                        accent: Palette.warning;
                    }
                }
            }

            SectionCard {
                VerticalLayout {
                    padding: LayoutMetrics.card-padding;
                    spacing: 12px;

                    CardHeader {
                        title: "Эффекты Aura";
                        detail: !root.aura-state-ready ? "Чтение…" : root.aura-control-ready ? "" : "Только чтение";
                    }

                    IconRow {
                        icon-kind: Icons.sparkles;
                        title: "Эффект";
                        description: "Режим анимации";
                        label-width: 190px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            if (root.aura-static-supported || root.aura-breathe-supported || root.aura-rainbow-supported || root.aura-rainbow-wave-supported) : HorizontalLayout {
                                spacing: 6px;
                                if (root.aura-static-supported) : ChoiceButton { min-width: 0px; label: "Static"; selected: root.keyboard-effect == 0; disabled: !root.aura-control-ready; clicked => { root.request-effect(0, root.speed()); } }
                                if (!root.aura-static-supported) : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
                                if (root.aura-breathe-supported) : ChoiceButton { min-width: 0px; label: "Breathe"; selected: root.keyboard-effect == 1; disabled: !root.aura-control-ready; clicked => { root.request-effect(1, root.speed()); } }
                                if (!root.aura-breathe-supported) : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
                                if (root.aura-rainbow-supported) : ChoiceButton { min-width: 0px; label: "Rainbow"; selected: root.keyboard-effect == 2; disabled: !root.aura-control-ready; clicked => { root.request-effect(2, root.speed()); } }
                                if (!root.aura-rainbow-supported) : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
                                if (root.aura-rainbow-wave-supported) : ChoiceButton { min-width: 0px; label: "Rainbow Wave"; selected: root.keyboard-effect == 3; disabled: !root.aura-control-ready; clicked => { root.request-effect(3, root.speed()); } }
                                if (!root.aura-rainbow-wave-supported) : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
                            }
                            if (root.aura-star-supported || root.aura-rain-supported || root.aura-highlight-supported || root.aura-laser-supported) : HorizontalLayout {
                                spacing: 6px;
                                if (root.aura-star-supported) : ChoiceButton { min-width: 0px; label: "Star"; selected: root.keyboard-effect == 4; disabled: !root.aura-control-ready; clicked => { root.request-effect(4, root.speed()); } }
                                if (!root.aura-star-supported) : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
                                if (root.aura-rain-supported) : ChoiceButton { min-width: 0px; label: "Rain"; selected: root.keyboard-effect == 5; disabled: !root.aura-control-ready; clicked => { root.request-effect(5, root.speed()); } }
                                if (!root.aura-rain-supported) : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
                                if (root.aura-highlight-supported) : ChoiceButton { min-width: 0px; label: "Highlight"; selected: root.keyboard-effect == 6; disabled: !root.aura-control-ready; clicked => { root.request-effect(6, root.speed()); } }
                                if (!root.aura-highlight-supported) : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
                                if (root.aura-laser-supported) : ChoiceButton { min-width: 0px; label: "Laser"; selected: root.keyboard-effect == 7; disabled: !root.aura-control-ready; clicked => { root.request-effect(7, root.speed()); } }
                                if (!root.aura-laser-supported) : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
                            }
                            if (root.aura-ripple-supported || root.aura-pulse-supported || root.aura-comet-supported || root.aura-flash-supported) : HorizontalLayout {
                                spacing: 6px;
                                if (root.aura-ripple-supported) : ChoiceButton { min-width: 0px; label: "Ripple"; selected: root.keyboard-effect == 8; disabled: !root.aura-control-ready; clicked => { root.request-effect(8, root.speed()); } }
                                if (!root.aura-ripple-supported) : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
                                if (root.aura-pulse-supported) : ChoiceButton { min-width: 0px; label: "Pulse"; selected: root.keyboard-effect == 10; disabled: !root.aura-control-ready; clicked => { root.request-effect(10, root.speed()); } }
                                if (!root.aura-pulse-supported) : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
                                if (root.aura-comet-supported) : ChoiceButton { min-width: 0px; label: "Comet"; selected: root.keyboard-effect == 11; disabled: !root.aura-control-ready; clicked => { root.request-effect(11, root.speed()); } }
                                if (!root.aura-comet-supported) : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
                                if (root.aura-flash-supported) : ChoiceButton { min-width: 0px; label: "Flash"; selected: root.keyboard-effect == 12; disabled: !root.aura-control-ready; clicked => { root.request-effect(12, root.speed()); } }
                                if (!root.aura-flash-supported) : Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
                            }
                        }
                    }

                    IconRow {
                        separator: true;
                        icon-kind: Icons.speed;
                        title: "Скорость";
                        description: "Скорость анимации эффекта";
                        label-width: 190px;
                        Segmented {
                            options: ["Медленно", "Обычно", "Быстро"];
                            selected: root.keyboard-speed;
                            disabled: !root.aura-control-ready;
                            changed(speed) => { root.request-effect(root.keyboard-effect < 0 ? 0 : root.keyboard-effect, speed); }
                        }
                    }

                    IconRow {
                        separator: true;
                        icon-kind: Icons.palette;
                        title: "Цвет";
                        description: "Основной и второй цвет эффекта";
                        label-width: 190px;
                        Segmented {
                            max-width: 320px;
                            options: ["Основной", "Второй"];
                            selected: root.edit-secondary ? 1 : 0;
                            changed(i) => { root.edit-secondary = i == 1; }
                        }
                    }
                    HorizontalLayout {
                        height: 46px;
                        spacing: 10px;
                        Rectangle { width: 232px; }
                        Swatch {
                            swatch: #ff2d3a;
                            selected: root.edit-red == 255 && root.edit-green == 45 && root.edit-blue == 58;
                            disabled: !root.aura-control-ready;
                            clicked => { root.set-edit-color(255, 45, 58); }
                        }
                        Swatch {
                            swatch: #ff7a1a;
                            selected: root.edit-red == 255 && root.edit-green == 122 && root.edit-blue == 26;
                            disabled: !root.aura-control-ready;
                            clicked => { root.set-edit-color(255, 122, 26); }
                        }
                        Swatch {
                            swatch: #ffd21a;
                            selected: root.edit-red == 255 && root.edit-green == 210 && root.edit-blue == 26;
                            disabled: !root.aura-control-ready;
                            clicked => { root.set-edit-color(255, 210, 26); }
                        }
                        Swatch {
                            swatch: #2ee06e;
                            selected: root.edit-red == 46 && root.edit-green == 224 && root.edit-blue == 110;
                            disabled: !root.aura-control-ready;
                            clicked => { root.set-edit-color(46, 224, 110); }
                        }
                        Swatch {
                            swatch: #1ae0f0;
                            selected: root.edit-red == 26 && root.edit-green == 224 && root.edit-blue == 240;
                            disabled: !root.aura-control-ready;
                            clicked => { root.set-edit-color(26, 224, 240); }
                        }
                        Swatch {
                            swatch: #1f5ef5;
                            selected: root.edit-red == 31 && root.edit-green == 94 && root.edit-blue == 245;
                            disabled: !root.aura-control-ready;
                            clicked => { root.set-edit-color(31, 94, 245); }
                        }
                        Swatch {
                            swatch: #9b3dff;
                            selected: root.edit-red == 155 && root.edit-green == 61 && root.edit-blue == 255;
                            disabled: !root.aura-control-ready;
                            clicked => { root.set-edit-color(155, 61, 255); }
                        }
                        Swatch {
                            swatch: #ff3dd8;
                            selected: root.edit-red == 255 && root.edit-green == 61 && root.edit-blue == 216;
                            disabled: !root.aura-control-ready;
                            clicked => { root.set-edit-color(255, 61, 216); }
                        }
                        Swatch {
                            swatch: #f4f7ff;
                            selected: root.edit-red == 244 && root.edit-green == 247 && root.edit-blue == 255;
                            disabled: !root.aura-control-ready;
                            clicked => { root.set-edit-color(244, 247, 255); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 64px;
                            height: 38px;
                            y: 4px;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Palette.border-strong;
                            background: rgb(root.edit-red, root.edit-green, root.edit-blue);
                        }
                    }
                    ChannelRow {
                        label: "Красный";
                        value: root.edit-red;
                        disabled: !root.aura-control-ready;
                        changed(v) => { root.set-edit-color(v, root.edit-green, root.edit-blue); }
                    }
                    ChannelRow {
                        label: "Зелёный";
                        value: root.edit-green;
                        disabled: !root.aura-control-ready;
                        changed(v) => { root.set-edit-color(root.edit-red, v, root.edit-blue); }
                    }
                    ChannelRow {
                        label: "Синий";
                        value: root.edit-blue;
                        disabled: !root.aura-control-ready;
                        changed(v) => { root.set-edit-color(root.edit-red, root.edit-green, v); }
                    }
                }
            }

            Rectangle { vertical-stretch: 100; }
        }
    }
}
