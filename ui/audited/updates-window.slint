import { ComboBox } from "std-widgets.slint";
import { StatusBadge } from "../components/visual-controls.slint";
import { ThemeBridge, WindowHeader, SectionCard, SectionTitle, ActionButton, LocalStatus } from "common.slint";
import { Palette } from "../themes/dark.slint";

export component UpdatesWindow inherits Window {
    width: 470px;
    height: 364px;
    title: "Orbis Control — Updates";
    background: Palette.window-background;

    in property <string> version: "0.1.0";
    // Local installation ownership, release-source readiness and installation
    // mutation ownership are independent capabilities.
    in property <bool> backend-ready: false;
    in property <bool> source-ready: false;
    in property <bool> check-enabled: false;
    in property <bool> install-enabled: false;
    in property <bool> checking: false;
    in property <bool> installing: false;
    in property <int> channel: 0;
    in property <bool> channel-enabled: false;
    in property <bool> update-available: false;
    in property <string> latest-version: "—";
    in property <string> release-notes: "Release notes unavailable";
    in property <string> status: "Update backend unavailable";

    callback channel-requested(int);
    callback check-requested;
    callback install-requested;

    property <bool> notes-visible: false;

    ThemeBridge { }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        WindowHeader { title: "Updates"; subtitle: "Release and package status"; }
        LocalStatus { text: root.status; accent: root.source-ready ? Palette.text-secondary : Palette.warning; }

        SectionCard {
            height: 116px;
            VerticalLayout {
                padding: 10px;
                spacing: 7px;
                SectionTitle {
                    title: "Release";
                    detail: !root.backend-ready ? "Backend unavailable"
                        : !root.source-ready ? "Release source unavailable"
                        : root.update-available ? "Update available"
                        : "Up to date";
                }
                HorizontalLayout {
                    height: 22px;
                    Text { text: "Installed version"; font-size: 10px; color: Palette.text-secondary; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: "v" + root.version; font-size: 11px; font-weight: 650; color: Palette.text-primary; vertical-alignment: center; }
                }
                HorizontalLayout {
                    height: 30px; spacing: 8px; alignment: center;
                    Text { width: 92px; text: "Channel"; font-size: 10px; color: root.channel-enabled ? Palette.text-primary : Palette.text-disabled; vertical-alignment: center; }
                    channel-box := ComboBox {
                        horizontal-stretch: 1;
                        enabled: root.backend-ready && root.source-ready && root.channel-enabled && !root.checking && !root.installing;
                        model: ["Stable", "Preview", "Development"];
                        current-index: root.channel;
                        selected(_) => { root.channel-requested(self.current-index); }
                    }
                    StatusBadge {
                        width: 112px;
                        text: !root.backend-ready ? "Unknown"
                            : !root.source-ready ? "Not configured"
                            : root.update-available ? "v" + root.latest-version
                            : "Up to date";
                        accent: !root.source-ready ? Palette.text-disabled : root.update-available ? Palette.accent-default : Palette.success;
                    }
                }
            }
        }

        SectionCard {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                SectionTitle { title: "Release notes"; detail: root.notes-visible ? "Details" : "Summary"; }
                Text {
                    vertical-stretch: 1;
                    text: !root.backend-ready ? "The local update ownership backend is unavailable."
                        : !root.source-ready ? root.release-notes
                        : root.notes-visible ? root.release-notes
                        : root.update-available ? "A newer release is available. Open release notes for details."
                        : "No newer release is currently reported by the configured source.";
                    font-size: 10px;
                    color: Palette.text-secondary;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }
        }

        HorizontalLayout {
            height: 30px; spacing: 6px;
            ActionButton {
                width: 86px;
                label: root.checking ? "Checking…" : "Check";
                accent: true;
                disabled: !root.check-enabled || root.checking || root.installing;
                clicked => { root.check-requested(); }
            }
            ActionButton {
                width: 104px;
                label: root.notes-visible ? "Hide Details" : "Details";
                disabled: !root.backend-ready;
                clicked => { root.notes-visible = !root.notes-visible; }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            ActionButton {
                width: 112px;
                label: root.installing ? "Installing…" : "Install Update";
                disabled: !root.install-enabled || !root.update-available || root.checking || root.installing;
                clicked => { root.install-requested(); }
            }
        }
    }
}
