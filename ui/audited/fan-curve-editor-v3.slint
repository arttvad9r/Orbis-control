import { ComboBox } from "std-widgets.slint";
import { FanCurveHwState } from "model.slint";
import { SectionCard, SectionTitle, LocalStatus } from "common.slint";
import { Palette } from "../themes/dark.slint";

component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked;

    height: 30px;
    min-width: 82px;
    border-radius: 7px;
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected ? Palette.accent-default
        : touch.has-hover ? Palette.border-strong
        : Palette.border-default;
    background: touch.pressed ? Palette.surface-pressed
        : root.selected ? Palette.surface-selected
        : touch.has-hover ? Palette.surface-hover
        : Palette.surface-default;

    Text {
        text: root.label;
        font-size: 10px;
        font-weight: root.selected ? 700 : 550;
        color: Palette.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea { clicked => { root.clicked(); } }
}

component TempStepper inherits Rectangle {
    in property <int> index;
    in property <int> value;
    in property <bool> editable: false;
    callback changed(int, int);

    width: 48px;
    height: 48px;
    border-radius: 7px;
    border-width: 1px;
    border-color: Palette.border-default;
    background: Palette.surface-default;

    Text {
        x: 0px;
        y: 4px;
        width: parent.width;
        height: 16px;
        text: root.value + "°";
        font-size: 9px;
        font-weight: 650;
        color: root.editable ? Palette.text-primary : Palette.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: 5px;
        y: 25px;
        width: 17px;
        height: 17px;
        border-radius: 5px;
        border-width: 1px;
        border-color: Palette.border-default;
        background: !root.editable ? Palette.surface-disabled
            : minus.pressed ? Palette.surface-pressed
            : minus.has-hover ? Palette.surface-hover
            : Palette.window-background;
        Text {
            text: "−";
            font-size: 9px;
            color: root.editable ? Palette.text-primary : Palette.text-disabled;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        minus := TouchArea {
            enabled: root.editable;
            clicked => { root.changed(root.index, root.value - 1); }
        }
    }

    Rectangle {
        x: 26px;
        y: 25px;
        width: 17px;
        height: 17px;
        border-radius: 5px;
        border-width: 1px;
        border-color: Palette.border-default;
        background: !root.editable ? Palette.surface-disabled
            : plus.pressed ? Palette.surface-pressed
            : plus.has-hover ? Palette.surface-hover
            : Palette.window-background;
        Text {
            text: "+";
            font-size: 9px;
            color: root.editable ? Palette.text-primary : Palette.text-disabled;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        plus := TouchArea {
            enabled: root.editable;
            clicked => { root.changed(root.index, root.value + 1); }
        }
    }
}

component GraphPoint inherits Rectangle {
    in property <int> index;
    in property <int> pwm;
    in property <bool> editable: false;
    in property <color> accent: Palette.accent-default;
    callback committed(int, int);

    property <bool> active: false;
    property <int> preview: root.pwm;
    property <int> shown: root.active ? root.preview : root.pwm;

    width: 20px;
    background: transparent;

    Rectangle {
        x: 4px;
        y: (1 - Math.min(Math.max(root.shown / 255, 0), 1)) * (parent.height - 12px);
        width: 12px;
        height: 12px;
        border-radius: 6px;
        border-width: 2px;
        border-color: Palette.text-primary;
        background: root.editable ? root.accent : Palette.text-disabled;
    }

    if (drag.has-hover || root.active) : Rectangle {
        x: -11px;
        y: Math.max((1 - Math.min(Math.max(root.shown / 255, 0), 1)) * (parent.height - 12px) - 19px, 0px);
        width: 42px;
        height: 17px;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.border-default;
        background: Palette.surface-default;
        Text {
            text: root.shown + "";
            font-size: 8px;
            font-weight: 650;
            color: Palette.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    drag := TouchArea {
        enabled: root.editable;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.active = true;
                root.preview = Math.min(Math.max(Math.round((1 - self.mouse-y / self.height) * 255), 0), 255);
            } else if (ev.kind == PointerEventKind.move && self.pressed) {
                root.preview = Math.min(Math.max(Math.round((1 - self.mouse-y / self.height) * 255), 0), 255);
            } else if (ev.kind == PointerEventKind.up && root.active) {
                let value = Math.min(Math.max(Math.round((1 - self.mouse-y / self.height) * 255), 0), 255);
                root.active = false;
                root.preview = root.pwm;
                root.committed(root.index, value);
            } else if (ev.kind == PointerEventKind.cancel) {
                root.active = false;
                root.preview = root.pwm;
            }
        }
    }
}

component CurveChart inherits Rectangle {
    in property <string> title;
    in property <FanCurveHwState> state: FanCurveHwState.Loading;
    in property <bool> writable: false;
    in property <color> accent: Palette.accent-default;
    in property <int> temp-0; in property <int> temp-1; in property <int> temp-2; in property <int> temp-3;
    in property <int> temp-4; in property <int> temp-5; in property <int> temp-6; in property <int> temp-7;
    in property <int> pwm-0; in property <int> pwm-1; in property <int> pwm-2; in property <int> pwm-3;
    in property <int> pwm-4; in property <int> pwm-5; in property <int> pwm-6; in property <int> pwm-7;
    callback pwm-changed(int, int);

    property <bool> has-curve: root.state == FanCurveHwState.Ready;
    property <int> axis-min: root.has-curve ? root.min-temp() - 5 : 20;
    property <int> axis-max: root.has-curve ? Math.max(root.max-temp() + 5, root.axis-min + 10) : 110;

    pure function min-temp() -> int {
        return Math.min(root.temp-0, Math.min(root.temp-1, Math.min(root.temp-2, Math.min(root.temp-3, Math.min(root.temp-4, Math.min(root.temp-5, Math.min(root.temp-6, root.temp-7)))))));
    }
    pure function max-temp() -> int {
        return Math.max(root.temp-0, Math.max(root.temp-1, Math.max(root.temp-2, Math.max(root.temp-3, Math.max(root.temp-4, Math.max(root.temp-5, Math.max(root.temp-6, root.temp-7)))))));
    }
    pure function x-pos(temp: int) -> float {
        return Math.min(Math.max((temp - root.axis-min) / (root.axis-max - root.axis-min) * 100, 0), 100);
    }
    pure function y-pos(pwm: int) -> float {
        return 100 - Math.min(Math.max(pwm / 255, 0), 1) * 100;
    }

    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border-default;
    background: Palette.surface-default;

    Text {
        x: 44px;
        y: 8px;
        width: parent.width - 56px;
        height: 18px;
        text: root.title;
        font-size: 10px;
        font-weight: 700;
        color: Palette.text-primary;
        horizontal-alignment: center;
    }

    plot := Rectangle {
        x: 42px;
        y: 32px;
        width: parent.width - 54px;
        height: parent.height - 66px;
        background: Palette.window-background;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.border-default;
        clip: true;

        Rectangle { x: 0px; y: parent.height * 0.25; width: parent.width; height: 1px; background: Palette.border-default; }
        Rectangle { x: 0px; y: parent.height * 0.50; width: parent.width; height: 1px; background: Palette.border-default; }
        Rectangle { x: 0px; y: parent.height * 0.75; width: parent.width; height: 1px; background: Palette.border-default; }
        Rectangle { x: parent.width * 0.25; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: parent.width * 0.50; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: parent.width * 0.75; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }

        if (root.has-curve) : Path {
            width: parent.width;
            height: parent.height;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 100;
            viewbox-height: 100;
            stroke: root.accent;
            stroke-width: 2px;
            stroke-line-cap: round;
            MoveTo { x: root.x-pos(root.temp-0); y: root.y-pos(root.pwm-0); }
            LineTo { x: root.x-pos(root.temp-1); y: root.y-pos(root.pwm-1); }
            LineTo { x: root.x-pos(root.temp-2); y: root.y-pos(root.pwm-2); }
            LineTo { x: root.x-pos(root.temp-3); y: root.y-pos(root.pwm-3); }
            LineTo { x: root.x-pos(root.temp-4); y: root.y-pos(root.pwm-4); }
            LineTo { x: root.x-pos(root.temp-5); y: root.y-pos(root.pwm-5); }
            LineTo { x: root.x-pos(root.temp-6); y: root.y-pos(root.pwm-6); }
            LineTo { x: root.x-pos(root.temp-7); y: root.y-pos(root.pwm-7); }
        }

        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-0) * (plot.width - self.width) / 100; height: plot.height; index: 0; pwm: root.pwm-0; editable: root.writable; accent: root.accent; committed(i,v) => { root.pwm-changed(i,v); } }
        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-1) * (plot.width - self.width) / 100; height: plot.height; index: 1; pwm: root.pwm-1; editable: root.writable; accent: root.accent; committed(i,v) => { root.pwm-changed(i,v); } }
        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-2) * (plot.width - self.width) / 100; height: plot.height; index: 2; pwm: root.pwm-2; editable: root.writable; accent: root.accent; committed(i,v) => { root.pwm-changed(i,v); } }
        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-3) * (plot.width - self.width) / 100; height: plot.height; index: 3; pwm: root.pwm-3; editable: root.writable; accent: root.accent; committed(i,v) => { root.pwm-changed(i,v); } }
        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-4) * (plot.width - self.width) / 100; height: plot.height; index: 4; pwm: root.pwm-4; editable: root.writable; accent: root.accent; committed(i,v) => { root.pwm-changed(i,v); } }
        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-5) * (plot.width - self.width) / 100; height: plot.height; index: 5; pwm: root.pwm-5; editable: root.writable; accent: root.accent; committed(i,v) => { root.pwm-changed(i,v); } }
        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-6) * (plot.width - self.width) / 100; height: plot.height; index: 6; pwm: root.pwm-6; editable: root.writable; accent: root.accent; committed(i,v) => { root.pwm-changed(i,v); } }
        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-7) * (plot.width - self.width) / 100; height: plot.height; index: 7; pwm: root.pwm-7; editable: root.writable; accent: root.accent; committed(i,v) => { root.pwm-changed(i,v); } }

        if (!root.has-curve) : Text {
            x: 12px;
            y: parent.height / 2 - 18px;
            width: parent.width - 24px;
            height: 36px;
            text: root.state == FanCurveHwState.Loading ? "Loading authoritative curve…" : "Fan curve unavailable";
            font-size: 10px;
            color: root.state == FanCurveHwState.Unavailable ? Palette.error : Palette.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text { x: 5px; y: 33px; width: 30px; text: "255"; font-size: 8px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 5px; y: parent.height / 2 - 3px; width: 30px; text: "128"; font-size: 8px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 5px; y: parent.height - 42px; width: 30px; text: "0"; font-size: 8px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 42px; y: parent.height - 27px; width: 54px; text: root.axis-min + "°"; font-size: 8px; color: Palette.text-secondary; }
    Text { x: parent.width - 88px; y: parent.height - 27px; width: 74px; text: root.axis-max + "°"; font-size: 8px; color: Palette.text-secondary; horizontal-alignment: right; }
}

export component FanCurveEditor inherits Rectangle {
    in property <FanCurveHwState> state: FanCurveHwState.Loading;
    in property <bool> writable: false;
    in property <bool> error-state: false;
    in property <bool> dirty: false;
    in property <int> fan-selected: 0;
    in property <int> profile-selected: 0;
    in property <int> temp-0: 0; in property <int> temp-1: 0; in property <int> temp-2: 0; in property <int> temp-3: 0;
    in property <int> temp-4: 0; in property <int> temp-5: 0; in property <int> temp-6: 0; in property <int> temp-7: 0;
    in property <int> pwm-0: 0; in property <int> pwm-1: 0; in property <int> pwm-2: 0; in property <int> pwm-3: 0;
    in property <int> pwm-4: 0; in property <int> pwm-5: 0; in property <int> pwm-6: 0; in property <int> pwm-7: 0;

    callback fan-changed(int);
    callback profile-changed(int);
    callback temp-point-changed(int, int);
    callback pwm-point-changed(int, int);
    callback apply-clicked;

    height: 438px;
    background: Palette.window-background;

    function state-text() -> string {
        if (root.error-state) { return "Curve error"; }
        if (root.state == FanCurveHwState.Loading) { return "Loading"; }
        if (root.state == FanCurveHwState.Unavailable) { return "Unavailable"; }
        if (!root.writable) { return "Read only"; }
        if (root.dirty) { return "Modified"; }
        return "Current";
    }

    function state-color() -> color {
        if (root.error-state || root.state == FanCurveHwState.Unavailable) { return Palette.error; }
        if (root.dirty) { return Palette.warning; }
        if (root.state == FanCurveHwState.Ready) { return root.writable ? Palette.success : Palette.text-secondary; }
        return Palette.text-secondary;
    }

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            height: 30px;
            spacing: 6px;
            TabButton {
                label: "CPU Fan";
                selected: root.fan-selected == 0;
                clicked => { root.fan-changed(0); }
            }
            TabButton {
                label: "GPU Fan";
                selected: root.fan-selected == 1;
                clicked => { root.fan-changed(1); }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            LocalStatus {
                width: 118px;
                text: root.state-text();
                accent: root.state-color();
            }
        }

        SectionCard {
            height: 48px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                alignment: center;
                Text {
                    width: 92px;
                    text: "BIOS profile";
                    font-size: 10px;
                    font-weight: 600;
                    color: Palette.text-primary;
                    vertical-alignment: center;
                }
                ComboBox {
                    width: 210px;
                    enabled: root.state == FanCurveHwState.Ready;
                    model: ["Balanced", "Performance", "Quiet", "Low Power"];
                    current-index: root.profile-selected;
                    selected(_) => { root.profile-changed(self.current-index); }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text {
                    text: root.writable ? "Drag PWM points or adjust temperatures below" : "Authoritative read only";
                    font-size: 9px;
                    color: Palette.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        CurveChart {
            vertical-stretch: 1;
            title: root.fan-selected == 0 ? "CPU fan curve · PWM / °C" : "GPU fan curve · PWM / °C";
            state: root.state;
            writable: root.writable;
            accent: root.fan-selected == 0 ? Palette.accent-default : Palette.turbo;
            temp-0: root.temp-0; temp-1: root.temp-1; temp-2: root.temp-2; temp-3: root.temp-3;
            temp-4: root.temp-4; temp-5: root.temp-5; temp-6: root.temp-6; temp-7: root.temp-7;
            pwm-0: root.pwm-0; pwm-1: root.pwm-1; pwm-2: root.pwm-2; pwm-3: root.pwm-3;
            pwm-4: root.pwm-4; pwm-5: root.pwm-5; pwm-6: root.pwm-6; pwm-7: root.pwm-7;
            pwm-changed(i, v) => { root.pwm-point-changed(i, v); }
        }

        HorizontalLayout {
            height: 48px;
            spacing: 5px;
            alignment: center;
            TempStepper { index: 0; value: root.temp-0; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
            TempStepper { index: 1; value: root.temp-1; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
            TempStepper { index: 2; value: root.temp-2; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
            TempStepper { index: 3; value: root.temp-3; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
            TempStepper { index: 4; value: root.temp-4; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
            TempStepper { index: 5; value: root.temp-5; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
            TempStepper { index: 6; value: root.temp-6; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
            TempStepper { index: 7; value: root.temp-7; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }
    }
}
