import { ComboBox } from "std-widgets.slint";
import { FanCurveHwState } from "model.slint";
import { PreviewSliderRow, ToggleRow, PreviewNotice } from "../components/visual-controls.slint";
import { SectionCard, SectionTitle, ActionButton, LocalStatus } from "common.slint";
import { Palette } from "../themes/dark.slint";

component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked;
    height: 28px;
    min-width: 64px;
    horizontal-stretch: 1;
    border-radius: 3px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Palette.accent-default : Palette.border-default;
    background: touch.pressed ? Palette.surface-pressed : touch.has-hover ? Palette.surface-hover : Palette.surface-default;
    Text { text: root.label; font-size: 9px; font-weight: root.selected ? 600 : 500; color: Palette.text-primary; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component TempStepper inherits Rectangle {
    in property <int> index;
    in property <int> value;
    in property <bool> editable: false;
    callback changed(int, int);
    width: 48px;
    height: 34px;
    background: transparent;
    Text { x: 0px; y: 0px; width: parent.width; height: 14px; text: root.value + "°"; font-size: 8px; font-weight: 600; color: root.editable ? Palette.text-primary : Palette.text-secondary; horizontal-alignment: center; }
    Rectangle {
        x: 5px; y: 16px; width: 17px; height: 16px; border-radius: 2px; border-width: 1px; border-color: Palette.border-default;
        background: !root.editable ? Palette.surface-disabled : minus.pressed ? Palette.surface-pressed : minus.has-hover ? Palette.surface-hover : Palette.surface-default;
        Text { text: "−"; font-size: 9px; color: root.editable ? Palette.text-primary : Palette.text-disabled; horizontal-alignment: center; vertical-alignment: center; }
        minus := TouchArea { enabled: root.editable; clicked => { root.changed(root.index, root.value - 1); } }
    }
    Rectangle {
        x: 26px; y: 16px; width: 17px; height: 16px; border-radius: 2px; border-width: 1px; border-color: Palette.border-default;
        background: !root.editable ? Palette.surface-disabled : plus.pressed ? Palette.surface-pressed : plus.has-hover ? Palette.surface-hover : Palette.surface-default;
        Text { text: "+"; font-size: 9px; color: root.editable ? Palette.text-primary : Palette.text-disabled; horizontal-alignment: center; vertical-alignment: center; }
        plus := TouchArea { enabled: root.editable; clicked => { root.changed(root.index, root.value + 1); } }
    }
}

component GraphPoint inherits Rectangle {
    in property <int> index;
    in property <int> pwm;
    in property <bool> editable: false;
    in property <color> accent: Palette.accent-default;
    callback committed(int, int);
    property <bool> active: false;
    property <int> preview: root.pwm;
    property <int> shown: root.active ? root.preview : root.pwm;
    width: 18px;
    background: transparent;
    Rectangle {
        x: 4px;
        y: (1 - Math.min(Math.max(root.shown / 255, 0), 1)) * (parent.height - 10px);
        width: 10px; height: 10px; border-radius: 5px; border-width: 2px; border-color: Palette.text-primary;
        background: root.editable ? root.accent : Palette.text-disabled;
    }
    if (drag.has-hover || root.active) : Rectangle {
        x: -10px;
        y: Math.max((1 - Math.min(Math.max(root.shown / 255, 0), 1)) * (parent.height - 10px) - 17px, 0px);
        width: 38px; height: 15px; border-radius: 3px; border-width: 1px; border-color: Palette.border-default; background: Palette.surface-default;
        Text { text: root.shown + ""; font-size: 8px; color: Palette.text-primary; horizontal-alignment: center; vertical-alignment: center; }
    }
    drag := TouchArea {
        enabled: root.editable;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.active = true;
                root.preview = Math.min(Math.max(Math.round((1 - self.mouse-y / self.height) * 255), 0), 255);
            } else if (ev.kind == PointerEventKind.move && self.pressed) {
                root.preview = Math.min(Math.max(Math.round((1 - self.mouse-y / self.height) * 255), 0), 255);
            } else if (ev.kind == PointerEventKind.up && root.active) {
                let value = Math.min(Math.max(Math.round((1 - self.mouse-y / self.height) * 255), 0), 255);
                root.active = false;
                root.preview = root.pwm;
                root.committed(root.index, value);
            } else if (ev.kind == PointerEventKind.cancel) {
                root.active = false;
                root.preview = root.pwm;
            }
        }
    }
}

component MiniCurveChart inherits Rectangle {
    in property <string> title;
    in property <int> fan-id;
    in property <int> selected-fan;
    in property <FanCurveHwState> state: FanCurveHwState.Loading;
    in property <bool> writable: false;
    in property <int> temp-0; in property <int> temp-1; in property <int> temp-2; in property <int> temp-3;
    in property <int> temp-4; in property <int> temp-5; in property <int> temp-6; in property <int> temp-7;
    in property <int> pwm-0; in property <int> pwm-1; in property <int> pwm-2; in property <int> pwm-3;
    in property <int> pwm-4; in property <int> pwm-5; in property <int> pwm-6; in property <int> pwm-7;
    callback selected(int);
    callback pwm-changed(int, int);

    property <bool> active: root.selected-fan == root.fan-id;
    property <bool> has-curve: root.active && root.state == FanCurveHwState.Ready;
    property <color> curve-color: root.fan-id == 0 ? Palette.accent-default : Palette.turbo;
    property <int> axis-min: root.has-curve ? root.min-temp() - 5 : 20;
    property <int> axis-max: root.has-curve ? Math.max(root.max-temp() + 5, root.axis-min + 10) : 110;

    pure function min-temp() -> int { return Math.min(root.temp-0, Math.min(root.temp-1, Math.min(root.temp-2, Math.min(root.temp-3, Math.min(root.temp-4, Math.min(root.temp-5, Math.min(root.temp-6, root.temp-7))))))); }
    pure function max-temp() -> int { return Math.max(root.temp-0, Math.max(root.temp-1, Math.max(root.temp-2, Math.max(root.temp-3, Math.max(root.temp-4, Math.max(root.temp-5, Math.max(root.temp-6, root.temp-7))))))); }
    pure function x-pos(temp: int) -> float { return Math.min(Math.max((temp - root.axis-min) / (root.axis-max - root.axis-min) * 100, 0), 100); }
    pure function y-pos(pwm: int) -> float { return 100 - Math.min(Math.max(pwm / 255, 0), 1) * 100; }

    height: 174px;
    border-radius: 3px;
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? root.curve-color : Palette.border-default;
    background: Palette.surface-pressed;

    Text { x: 38px; y: 4px; width: parent.width - 46px; height: 16px; text: root.title + " · PWM / °C"; font-size: 9px; font-weight: 600; color: root.active ? root.curve-color : Palette.text-primary; horizontal-alignment: center; }
    plot := Rectangle {
        x: 36px; y: 22px; width: parent.width - 44px; height: 125px; background: transparent; border-width: 1px; border-color: Palette.border-default; clip: true;
        Rectangle { x: 0px; y: parent.height * 0.25; width: parent.width; height: 1px; background: Palette.border-default; }
        Rectangle { x: 0px; y: parent.height * 0.50; width: parent.width; height: 1px; background: Palette.border-default; }
        Rectangle { x: 0px; y: parent.height * 0.75; width: parent.width; height: 1px; background: Palette.border-default; }
        Rectangle { x: parent.width * 0.25; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: parent.width * 0.50; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        Rectangle { x: parent.width * 0.75; y: 0px; width: 1px; height: parent.height; background: Palette.border-default; }
        if (root.has-curve) : Path {
            width: parent.width; height: parent.height; viewbox-x: 0; viewbox-y: 0; viewbox-width: 100; viewbox-height: 100;
            stroke: root.curve-color; stroke-width: 2px; stroke-line-cap: round;
            MoveTo { x: root.x-pos(root.temp-0); y: root.y-pos(root.pwm-0); }
            LineTo { x: root.x-pos(root.temp-1); y: root.y-pos(root.pwm-1); }
            LineTo { x: root.x-pos(root.temp-2); y: root.y-pos(root.pwm-2); }
            LineTo { x: root.x-pos(root.temp-3); y: root.y-pos(root.pwm-3); }
            LineTo { x: root.x-pos(root.temp-4); y: root.y-pos(root.pwm-4); }
            LineTo { x: root.x-pos(root.temp-5); y: root.y-pos(root.pwm-5); }
            LineTo { x: root.x-pos(root.temp-6); y: root.y-pos(root.pwm-6); }
            LineTo { x: root.x-pos(root.temp-7); y: root.y-pos(root.pwm-7); }
        }
        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-0) * (plot.width - self.width) / 100; height: plot.height; index: 0; pwm: root.pwm-0; editable: root.writable; accent: root.curve-color; committed(i,v) => { root.pwm-changed(i,v); } }
        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-1) * (plot.width - self.width) / 100; height: plot.height; index: 1; pwm: root.pwm-1; editable: root.writable; accent: root.curve-color; committed(i,v) => { root.pwm-changed(i,v); } }
        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-2) * (plot.width - self.width) / 100; height: plot.height; index: 2; pwm: root.pwm-2; editable: root.writable; accent: root.curve-color; committed(i,v) => { root.pwm-changed(i,v); } }
        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-3) * (plot.width - self.width) / 100; height: plot.height; index: 3; pwm: root.pwm-3; editable: root.writable; accent: root.curve-color; committed(i,v) => { root.pwm-changed(i,v); } }
        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-4) * (plot.width - self.width) / 100; height: plot.height; index: 4; pwm: root.pwm-4; editable: root.writable; accent: root.curve-color; committed(i,v) => { root.pwm-changed(i,v); } }
        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-5) * (plot.width - self.width) / 100; height: plot.height; index: 5; pwm: root.pwm-5; editable: root.writable; accent: root.curve-color; committed(i,v) => { root.pwm-changed(i,v); } }
        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-6) * (plot.width - self.width) / 100; height: plot.height; index: 6; pwm: root.pwm-6; editable: root.writable; accent: root.curve-color; committed(i,v) => { root.pwm-changed(i,v); } }
        if (root.has-curve) : GraphPoint { x: root.x-pos(root.temp-7) * (plot.width - self.width) / 100; height: plot.height; index: 7; pwm: root.pwm-7; editable: root.writable; accent: root.curve-color; committed(i,v) => { root.pwm-changed(i,v); } }
        if (!root.has-curve) : Text {
            x: 10px; y: 45px; width: parent.width - 20px; height: 34px;
            text: root.active ? (root.state == FanCurveHwState.Loading ? "Loading curve…" : "Curve unavailable") : "Select " + root.title + " to load its authoritative curve";
            font-size: 9px; color: root.active && root.state == FanCurveHwState.Unavailable ? Palette.error : Palette.text-secondary; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
        }
    }
    Text { x: 3px; y: 20px; width: 29px; text: "255"; font-size: 7px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 3px; y: 79px; width: 29px; text: "128"; font-size: 7px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 3px; y: 139px; width: 29px; text: "0"; font-size: 7px; color: Palette.text-secondary; horizontal-alignment: right; }
    Text { x: 34px; y: 150px; width: 46px; text: root.axis-min + "°"; font-size: 7px; color: Palette.text-secondary; }
    Text { x: parent.width - 74px; y: 150px; width: 62px; text: root.axis-max + "°"; font-size: 7px; color: Palette.text-secondary; horizontal-alignment: right; }
    touch := TouchArea { enabled: !root.active; clicked => { root.selected(root.fan-id); } }
}

component PowerPanel inherits Rectangle {
    in property <int> page: 0;
    property <int> power-mode: 1;
    property <int> cpu-boost: 1;
    property <bool> apply-limits: false;
    property <float> spl: 48; property <float> sppt: 62; property <float> fppt: 78;
    property <float> gpu-power: 72; property <float> gpu-boost: 55; property <float> gpu-temp: 76;
    property <float> gpu-memory: 50; property <float> gpu-core: 50; property <float> gpu-clock: 65;
    property <string> status: "Preview values · not applied";

    width: 254px;
    height: 390px;
    border-radius: 3px; border-width: 1px; border-color: Palette.border-default; background: Palette.surface-default;
    VerticalLayout { padding: 9px; spacing: 3px;
        SectionTitle { title: root.page == 0 ? "CPU / Power Limits" : "GPU Settings"; }
        if (root.page == 0) : ComboBox { model: ["Best Efficiency", "Balanced", "Best Performance"]; current-index <=> root.power-mode; }
        if (root.page == 0) : ComboBox { model: ["CPU Boost: Disabled", "CPU Boost: Enabled", "CPU Boost: Aggressive", "CPU Boost: Efficient"]; current-index <=> root.cpu-boost; }
        if (root.page == 0) : PreviewSliderRow { label: "SPL / sustained"; unit: "% preview"; value <=> root.spl; }
        if (root.page == 0) : PreviewSliderRow { label: "sPPT / long boost"; unit: "% preview"; value <=> root.sppt; }
        if (root.page == 0) : PreviewSliderRow { label: "fPPT / short boost"; unit: "% preview"; value <=> root.fppt; }
        if (root.page == 1) : PreviewSliderRow { label: "GPU Power"; unit: "% preview"; value <=> root.gpu-power; }
        if (root.page == 1) : PreviewSliderRow { label: "Dynamic Boost"; unit: "% preview"; value <=> root.gpu-boost; }
        if (root.page == 1) : PreviewSliderRow { label: "GPU Temperature"; unit: "% preview"; value <=> root.gpu-temp; }
        if (root.page == 1) : PreviewSliderRow { label: "Memory Offset"; unit: "% preview"; value <=> root.gpu-memory; }
        if (root.page == 1) : PreviewSliderRow { label: "Core Offset"; unit: "% preview"; value <=> root.gpu-core; }
        if (root.page == 1) : PreviewSliderRow { label: "Clock Limit"; unit: "% preview"; value <=> root.gpu-clock; }
        ToggleRow { label: "Apply Power Limits"; checked <=> root.apply-limits; }
        Rectangle { vertical-stretch: 1; background: transparent; }
        LocalStatus { text: root.status; accent: Palette.warning; }
        ActionButton { label: "Apply Power Preview"; accent: root.apply-limits; clicked => { root.status = root.apply-limits ? "Power values applied locally" : "Enable Apply Power Limits first"; } }
    }
}

component AdvancedPanel inherits Rectangle {
    property <float> cpu-uv: 42;
    property <float> igpu-uv: 48;
    property <float> temp-limit: 75;
    property <bool> auto-apply: false;
    property <string> status: "Experimental preview";
    width: 254px; height: 390px;
    border-radius: 3px; border-width: 1px; border-color: Palette.border-default; background: Palette.surface-default;
    VerticalLayout { padding: 9px; spacing: 4px;
        SectionTitle { title: "Advanced"; detail: "Experimental"; }
        PreviewNotice { text: "Ranges are preview-only until hardware semantics are proven"; }
        PreviewSliderRow { label: "CPU Voltage Offset"; unit: "% preview"; value <=> root.cpu-uv; }
        PreviewSliderRow { label: "iGPU Voltage Offset"; unit: "% preview"; value <=> root.igpu-uv; }
        PreviewSliderRow { label: "CPU Temperature Limit"; unit: "% preview"; value <=> root.temp-limit; }
        ToggleRow { label: "Auto Apply"; checked <=> root.auto-apply; }
        HorizontalLayout { height: 28px; spacing: 5px;
            ActionButton { horizontal-stretch: 1; label: "Read Limits"; clicked => { root.status = "Limits refreshed locally"; } }
            ActionButton { horizontal-stretch: 1; label: "Apply"; accent: root.auto-apply; clicked => { root.status = root.auto-apply ? "Advanced values applied locally" : "Enable Auto Apply first"; } }
        }
        Rectangle { vertical-stretch: 1; background: transparent; }
        LocalStatus { text: root.status; accent: Palette.warning; }
        ActionButton { label: "Restore Preview Defaults"; clicked => { root.cpu-uv = 42; root.igpu-uv = 48; root.temp-limit = 75; root.auto-apply = false; root.status = "Preview defaults restored"; } }
    }
}

export component FanCurveEditor inherits Rectangle {
    in property <FanCurveHwState> state: FanCurveHwState.Loading;
    in property <bool> writable: false;
    in property <bool> error-state: false;
    in property <bool> dirty: false;
    in property <int> fan-selected: 0;
    in property <int> profile-selected: 0;
    in property <int> temp-0: 0; in property <int> temp-1: 0; in property <int> temp-2: 0; in property <int> temp-3: 0;
    in property <int> temp-4: 0; in property <int> temp-5: 0; in property <int> temp-6: 0; in property <int> temp-7: 0;
    in property <int> pwm-0: 0; in property <int> pwm-1: 0; in property <int> pwm-2: 0; in property <int> pwm-3: 0;
    in property <int> pwm-4: 0; in property <int> pwm-5: 0; in property <int> pwm-6: 0; in property <int> pwm-7: 0;
    callback fan-changed(int);
    callback profile-changed(int);
    callback temp-point-changed(int, int);
    callback pwm-point-changed(int, int);
    callback apply-clicked;

    property <int> page: root.fan-selected;
    property <string> profile-status: "";
    height: 460px;
    background: Palette.window-background;

    VerticalLayout { spacing: 6px;
        HorizontalLayout { height: 28px; spacing: 5px;
            TabButton { label: "CPU"; selected: root.page == 0; clicked => { root.page = 0; root.fan-changed(0); } }
            TabButton { label: "GPU"; selected: root.page == 1; clicked => { root.page = 1; root.fan-changed(1); } }
            TabButton { label: "Advanced"; selected: root.page == 2; clicked => { root.page = 2; } }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text { text: root.page == 2 ? "Visual only" : root.state == FanCurveHwState.Loading ? "Loading" : root.state == FanCurveHwState.Unavailable ? "Unavailable" : root.writable ? "Editable" : "Read only"; font-size: 8px; color: root.state == FanCurveHwState.Unavailable && root.page != 2 ? Palette.error : root.page == 2 ? Palette.warning : Palette.text-secondary; vertical-alignment: center; }
        }
        HorizontalLayout { height: 30px; spacing: 5px; alignment: center;
            Text { width: 92px; text: "BIOS Fan Curves"; font-size: 9px; font-weight: 600; color: Palette.text-primary; vertical-alignment: center; }
            profile-box := ComboBox { width: 190px; enabled: root.state == FanCurveHwState.Ready; model: ["Balanced", "Performance", "Quiet", "Low Power"]; current-index: root.profile-selected; selected(_) => { root.profile-changed(self.current-index); root.profile-status = "Profile selected"; } }
            ActionButton { width: 34px; label: "+"; clicked => { root.profile-status = "Custom profile slot added locally"; } }
            ActionButton { width: 58px; label: "Rename"; clicked => { root.profile-status = "Rename action previewed"; } }
            ActionButton { width: 58px; label: "Remove"; clicked => { root.profile-status = "Remove action previewed"; } }
            if (root.profile-status != "") : Text { horizontal-stretch: 1; text: root.profile-status; font-size: 8px; color: Palette.text-secondary; vertical-alignment: center; overflow: elide; }
            if (root.profile-status == "") : Rectangle { horizontal-stretch: 1; background: transparent; }
        }
        HorizontalLayout { height: 390px; spacing: 8px;
            if (root.page != 2) : PowerPanel { page: root.page; }
            if (root.page == 2) : AdvancedPanel { }
            VerticalLayout { horizontal-stretch: 1; spacing: 5px;
                MiniCurveChart {
                    title: "CPU Fan Profile"; fan-id: 0; selected-fan: root.fan-selected; state: root.state; writable: root.writable;
                    temp-0: root.temp-0; temp-1: root.temp-1; temp-2: root.temp-2; temp-3: root.temp-3; temp-4: root.temp-4; temp-5: root.temp-5; temp-6: root.temp-6; temp-7: root.temp-7;
                    pwm-0: root.pwm-0; pwm-1: root.pwm-1; pwm-2: root.pwm-2; pwm-3: root.pwm-3; pwm-4: root.pwm-4; pwm-5: root.pwm-5; pwm-6: root.pwm-6; pwm-7: root.pwm-7;
                    selected(i) => { root.page = i; root.fan-changed(i); }
                    pwm-changed(i,v) => { if (root.fan-selected == 0) { root.pwm-point-changed(i,v); } }
                }
                MiniCurveChart {
                    title: "GPU Fan Profile"; fan-id: 1; selected-fan: root.fan-selected; state: root.state; writable: root.writable;
                    temp-0: root.temp-0; temp-1: root.temp-1; temp-2: root.temp-2; temp-3: root.temp-3; temp-4: root.temp-4; temp-5: root.temp-5; temp-6: root.temp-6; temp-7: root.temp-7;
                    pwm-0: root.pwm-0; pwm-1: root.pwm-1; pwm-2: root.pwm-2; pwm-3: root.pwm-3; pwm-4: root.pwm-4; pwm-5: root.pwm-5; pwm-6: root.pwm-6; pwm-7: root.pwm-7;
                    selected(i) => { root.page = i; root.fan-changed(i); }
                    pwm-changed(i,v) => { if (root.fan-selected == 1) { root.pwm-point-changed(i,v); } }
                }
                if (root.page != 2) : HorizontalLayout { height: 34px; spacing: 1px; alignment: center;
                    TempStepper { index: 0; value: root.temp-0; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
                    TempStepper { index: 1; value: root.temp-1; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
                    TempStepper { index: 2; value: root.temp-2; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
                    TempStepper { index: 3; value: root.temp-3; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
                    TempStepper { index: 4; value: root.temp-4; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
                    TempStepper { index: 5; value: root.temp-5; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
                    TempStepper { index: 6; value: root.temp-6; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
                    TempStepper { index: 7; value: root.temp-7; editable: root.writable && root.state == FanCurveHwState.Ready; changed(i,v) => { root.temp-point-changed(i,v); } }
                }
            }
        }
    }
}
