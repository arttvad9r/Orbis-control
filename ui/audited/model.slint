// Stable Slint ABI shared by the audited windows and Rust glue.
// Keep this model backend-agnostic; runtime truth still comes from controller state.
export enum ChargeLimitState { Loading, Ready, Unavailable }
export enum GpuHwState { Loading, Ready, Unavailable }
export enum PerformanceHwState { Loading, Ready, Unavailable }
export enum GpuModeHwState { Loading, Ready, Unavailable }
export enum FanCurveHwState { Loading, Ready, Unavailable }
export enum Section { Dashboard, Performance, Power, Cooling, Graphics, Backlight, Display, System, Settings, About }

export struct UiState {
    capability-generation: int,
    perf-selected: int,
    available-perf-mask: int,
    perf-state: PerformanceHwState,
    perf-writable: bool,
    perf-unavailable-reason: string,
    power-limits-ready: bool,
    power-limits-reason: string,
    power-limits-stale: bool,
    power-limits-writable: bool,
    power-limit-pending-mask: int,
    power-limit-dirty-mask: int,
    power-limit-snapshot-identity: string,
    spl-value: int,
    spl-min: int,
    spl-max: int,
    spl-step: int,
    spl-unit: string,
    spl-default: string,
    spl-draft: int,
    sppt-value: int,
    sppt-min: int,
    sppt-max: int,
    sppt-step: int,
    sppt-unit: string,
    sppt-default: string,
    sppt-draft: int,
    fppt-value: int,
    fppt-min: int,
    fppt-max: int,
    fppt-step: int,
    fppt-unit: string,
    fppt-default: string,
    fppt-draft: int,
    cpu-temp-limit-value: int,
    cpu-temp-limit-min: int,
    cpu-temp-limit-max: int,
    cpu-temp-limit-step: int,
    cpu-temp-limit-unit: string,
    cpu-temp-limit-default: string,
    cpu-temp-limit-draft: int,
    gpu-dynamic-boost-value: int,
    gpu-dynamic-boost-min: int,
    gpu-dynamic-boost-max: int,
    gpu-dynamic-boost-step: int,
    gpu-dynamic-boost-unit: string,
    gpu-dynamic-boost-default: string,
    gpu-dynamic-boost-draft: int,
    gpu-temp-target-value: int,
    gpu-temp-target-min: int,
    gpu-temp-target-max: int,
    gpu-temp-target-step: int,
    gpu-temp-target-unit: string,
    gpu-temp-target-default: string,
    gpu-temp-target-draft: int,
    gpu-selected: int,
    available-gpu-mask: int,
    gpu-ultimate-pending: bool,
    gpu-ultimate-disabled: bool,
    gpu-section-error: bool,
    gpu-mode-state: GpuModeHwState,
    gpu-mode-writable: bool,
    gpu-queued: int,
    gpu-reboot-required: bool,
    charge-limit: int,
    charge-limit-enabled: bool,
    charge-limit-writable: bool,
    charge-limit-unavailable-reason: string,
    charge-limit-state: ChargeLimitState,
    gpu-power-state: GpuHwState,
    gpu-mux-state: GpuHwState,
    gpu-access-state: GpuHwState,
    gpu-power-value: int,
    gpu-mux-value: int,
    gpu-access-value: int,
    cpu-temp: string,
    gpu-temp: string,
    igpu-temp: string,
    igpu-power: string,
    cpu-fan-rpm: string,
    gpu-fan-rpm: string,
    battery-percent: string,
    /// Numeric battery charge percent for the header indicator (-1 = unknown).
    battery-percent-value: int,
    power-ac-mw: string,
    battery-health: string,
    battery-cycles: string,
    battery-status: string,
    ac-online: string,
    gpu-power: string,
    telemetry-fresh: bool,
    version: string,
    mock-profile: string,
    fan-curve-state: FanCurveHwState,
    fan-curve-writable: bool,
    fan-curve-unavailable-reason: string,
    fan-curve-error: bool,
    fan-curve-dirty: bool,
    fan-curve-enabled-known: bool,
    fan-curve-enabled: bool,
    fan-selected: int,
    fan-profile-selected: int,
    fan-temp-0: int,
    fan-temp-1: int,
    fan-temp-2: int,
    fan-temp-3: int,
    fan-temp-4: int,
    fan-temp-5: int,
    fan-temp-6: int,
    fan-temp-7: int,
    fan-pwm-0: int,
    fan-pwm-1: int,
    fan-pwm-2: int,
    fan-pwm-3: int,
    fan-pwm-4: int,
    fan-pwm-5: int,
    fan-pwm-6: int,
    fan-pwm-7: int,
}
