import { Palette as WidgetPalette } from "std-widgets.slint";
import { Palette, ThemeState, ThemeMode } from "../themes/dark.slint";

// Canonical geometry for the product UI (docs/references/orbis-visual-2026-09-24/):
// one gutter, one card padding and one radius shared by every page.
export global LayoutMetrics {
    in property <length> sidebar-width: 240px;
    in property <length> titlebar-height: 44px;
    in property <length> page-margin: 24px;
    in property <length> page-gap: 16px;
    in property <length> card-padding: 20px;
    in property <length> card-radius: 14px;
    in property <length> control-height: 40px;
    in property <length> compact-control-height: 36px;
    in property <length> page-bottom-padding: 24px;
}

// Standard Slint widgets (ScrollView/ComboBox/etc.) have their own style
// palette. Keep it synchronized with the runtime Orbis theme.
export component ThemeBridge inherits Rectangle {
    width: 0px;
    height: 0px;
    background: transparent;

    property <ThemeMode> observed-mode: ThemeState.mode;

    function sync-widget-theme() {
        WidgetPalette.color-scheme = root.observed-mode == ThemeMode.Light
            ? ColorScheme.light
            : ColorScheme.dark;
    }

    init => { root.sync-widget-theme(); }
    changed observed-mode => { root.sync-widget-theme(); }
}

export component SectionCard inherits Rectangle {
    border-radius: LayoutMetrics.card-radius;
    border-width: 1px;
    border-color: Palette.border-default;
    background: @linear-gradient(180deg, Palette.card-top 0%, Palette.surface-default 100%);
}

export component SectionTitle inherits Rectangle {
    in property <string> title;
    in property <string> detail: "";
    in property <color> detail-color: Palette.text-secondary;
    height: 30px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.title;
            font-size: 16px;
            font-weight: 600;
            color: Palette.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        if (root.detail != "") : Text {
            text: root.detail;
            font-size: 12.5px;
            font-weight: 500;
            color: root.detail-color;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}

export component PageHeader inherits Rectangle {
    in property <string> title;
    height: 44px;
    background: transparent;

    Text {
        width: parent.width;
        horizontal-alignment: left;
        text: root.title;
        font-size: 28px;
        font-weight: 700;
        color: Palette.text-primary;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component WindowHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    height: 44px;
    background: transparent;

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 17px;
                font-weight: 650;
                color: Palette.text-primary;
            }
            if (root.subtitle != "") : Text {
                text: root.subtitle;
                font-size: 12px;
                color: Palette.text-secondary;
                overflow: elide;
            }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
    }
}

export component Divider inherits Rectangle {
    background: Palette.border-default;
}

export component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Palette.text-primary;
    height: 36px;
    background: transparent;

    HorizontalLayout {
        spacing: 16px;
        Text {
            text: root.label;
            font-size: 13.5px;
            font-weight: 500;
            color: Palette.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        Text {
            text: root.value;
            font-size: 13.5px;
            font-weight: 600;
            color: root.value-color;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}

export component SubsectionLabel inherits Rectangle {
    in property <string> text;
    height: 28px;
    background: transparent;
    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.text;
            font-size: 11.5px;
            font-weight: 650;
            letter-spacing: 0.6px;
            color: Palette.text-secondary;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 1px;
            background: Palette.border-default;
        }
    }
}

export component StatusPill inherits Rectangle {
    in property <string> text;
    in property <color> accent: Palette.text-secondary;
    min-width: 84px;
    max-width: 190px;
    horizontal-stretch: 0;
    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: root.accent.transparentize(0.48);
    background: root.accent.transparentize(0.90);

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 10px;
        spacing: 7px;
        alignment: center;
        Rectangle {
            width: 6px;
            vertical-stretch: 1;
            background: transparent;
            Rectangle {
                width: 6px;
                height: 6px;
                y: (parent.height - self.height) / 2 + 1px;
                border-radius: 3px;
                background: root.accent;
            }
        }
        Text {
            text: root.text;
            font-size: 11.5px;
            font-weight: 600;
            color: root.accent;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Selector segment: the selected option is a solid accent fill, as in the
// reference tabs (CPU/GPU, profile tiles).
export component ChoiceButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> disabled: false;
    callback clicked;

    min-width: 72px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: LayoutMetrics.control-height;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.selected && !root.disabled ? Palette.accent-border
        : touch.has-hover && !root.disabled ? Palette.border-strong
        : Palette.border-default;
    background: root.selected ? (root.disabled ? Palette.accent-fill.transparentize(0.55) : Palette.accent-fill)
        : root.disabled ? Palette.surface-disabled
        : touch.pressed ? Palette.surface-pressed
        : touch.has-hover ? Palette.surface-hover
        : Palette.surface-raised;

    Text {
        text: root.label;
        font-size: 13px;
        font-weight: root.selected ? 600 : 500;
        color: root.selected ? Palette.text-on-accent
            : root.disabled ? Palette.text-disabled
            : Palette.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

// Command button. `accent` marks the primary action of a card.
export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> disabled: false;
    in property <bool> accent: false;
    callback clicked;

    height: LayoutMetrics.compact-control-height;
    min-width: 96px;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.accent && !root.disabled ? Palette.accent-border
        : touch.has-hover && !root.disabled ? Palette.border-strong
        : Palette.border-default;
    background: root.disabled ? Palette.surface-disabled
        : root.accent ? (touch.pressed ? Palette.accent-fill.darker(0.2) : touch.has-hover ? Palette.accent-fill.brighter(0.12) : Palette.accent-fill)
        : touch.pressed ? Palette.surface-pressed
        : touch.has-hover ? Palette.surface-hover
        : Palette.surface-raised;

    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.label;
        font-size: 13px;
        font-weight: root.accent ? 600 : 500;
        color: root.disabled ? Palette.text-disabled
            : root.accent ? Palette.text-on-accent
            : Palette.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

// Labeled control row: fixed label column on the left, control on the right.
export component FieldRow inherits Rectangle {
    in property <string> label;
    in property <bool> muted: false;
    height: LayoutMetrics.control-height;
    background: transparent;

    HorizontalLayout {
        spacing: 16px;
        Text {
            width: 140px;
            text: root.label;
            font-size: 13.5px;
            font-weight: 500;
            color: root.muted ? Palette.text-disabled : Palette.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            @children
        }
    }
}

export component LocalStatus inherits Rectangle {
    in property <string> text;
    in property <color> accent: Palette.text-secondary;
    min-height: LayoutMetrics.compact-control-height;
    vertical-stretch: 0;
    border-radius: 10px;
    background: root.accent.transparentize(0.9);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 9px;
        Rectangle {
            width: 7px;
            vertical-stretch: 1;
            background: transparent;
            Rectangle {
                width: 7px;
                height: 7px;
                y: (parent.height - self.height) / 2 + 1px;
                border-radius: 3.5px;
                background: root.accent;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: 12.5px;
            font-weight: 500;
            color: Palette.text-secondary;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}
