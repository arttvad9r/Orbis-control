import { Palette as WidgetPalette } from "std-widgets.slint";
import { Palette, ThemeState, ThemeMode } from "../themes/dark.slint";

// Canonical geometry for the product UI. Pages may still compose differently,
// but they share one rhythm instead of carrying per-screen magic numbers.
export global LayoutMetrics {
    in property <length> sidebar-width: 224px;
    in property <length> titlebar-height: 48px;
    in property <length> page-margin: 28px;
    in property <length> page-gap: 18px;
    in property <length> card-padding: 18px;
    in property <length> card-radius: 14px;
    in property <length> control-height: 40px;
    in property <length> compact-control-height: 36px;
}

// Standard Slint widgets (ScrollView/ComboBox/etc.) have their own style
// palette. Keep it synchronized with the runtime Orbis theme.
export component ThemeBridge inherits Rectangle {
    width: 0px;
    height: 0px;
    background: transparent;

    property <ThemeMode> observed-mode: ThemeState.mode;

    function sync-widget-theme() {
        WidgetPalette.color-scheme = root.observed-mode == ThemeMode.Light
            ? ColorScheme.light
            : ColorScheme.dark;
    }

    init => { root.sync-widget-theme(); }
    changed observed-mode => { root.sync-widget-theme(); }
}

export component SectionCard inherits Rectangle {
    border-radius: LayoutMetrics.card-radius;
    border-width: 1px;
    border-color: Palette.border-default;
    background: Palette.surface-default;
}

export component SectionTitle inherits Rectangle {
    in property <string> title;
    in property <string> detail: "";
    in property <color> detail-color: Palette.text-secondary;
    height: 28px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.title;
            font-size: 15px;
            font-weight: 650;
            color: Palette.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        if (root.detail != "") : Text {
            text: root.detail;
            font-size: 12.5px;
            font-weight: 500;
            color: root.detail-color;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}

export component PageHeader inherits Rectangle {
    in property <string> title;
    in property <string> description: "";
    height: root.description == "" ? 38px : 62px;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 5px;
        Text {
            text: root.title;
            font-size: 25px;
            font-weight: 700;
            color: Palette.text-primary;
            overflow: elide;
        }
        if (root.description != "") : Text {
            text: root.description;
            font-size: 13.5px;
            color: Palette.text-secondary;
            overflow: elide;
        }
    }
}

export component WindowHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    height: 44px;
    background: transparent;

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 17px;
                font-weight: 650;
                color: Palette.text-primary;
            }
            if (root.subtitle != "") : Text {
                text: root.subtitle;
                font-size: 12px;
                color: Palette.text-secondary;
                overflow: elide;
            }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
    }
}

export component Divider inherits Rectangle {
    background: Palette.border-default;
}

export component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Palette.text-secondary;
    height: 38px;
    background: transparent;

    HorizontalLayout {
        spacing: 16px;
        Text {
            text: root.label;
            font-size: 13.5px;
            font-weight: 500;
            color: Palette.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        Text {
            text: root.value;
            font-size: 13.5px;
            font-weight: 500;
            color: root.value-color;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}

export component SubsectionLabel inherits Rectangle {
    in property <string> text;
    height: 28px;
    background: transparent;
    Text {
        text: root.text;
        font-size: 11.5px;
        font-weight: 650;
        letter-spacing: 0.6px;
        color: Palette.text-secondary;
        vertical-alignment: center;
    }
}

export component StatusPill inherits Rectangle {
    in property <string> text;
    in property <color> accent: Palette.text-secondary;
    min-width: 84px;
    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: root.accent.transparentize(0.48);
    background: root.accent.transparentize(0.90);

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 10px;
        spacing: 7px;
        alignment: center;
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.accent;
        }
        Text {
            text: root.text;
            font-size: 11.5px;
            font-weight: 600;
            color: root.accent;
            vertical-alignment: center;
        }
    }
}

export component ChoiceButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> disabled: false;
    callback clicked;

    min-width: 112px;
    height: LayoutMetrics.control-height;
    border-radius: 10px;
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected ? Palette.accent-default
        : touch.has-hover && !root.disabled ? Palette.border-strong
        : Palette.border-default;
    background: root.disabled ? Palette.surface-disabled
        : touch.pressed ? Palette.surface-pressed
        : root.selected ? Palette.accent-soft
        : touch.has-hover ? Palette.surface-hover
        : Palette.surface-raised;

    Text {
        text: root.label;
        font-size: 13px;
        font-weight: root.selected ? 650 : 550;
        color: root.disabled ? Palette.text-disabled
            : root.selected ? Palette.accent-default
            : Palette.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> disabled: false;
    in property <bool> accent: false;
    callback clicked;

    height: LayoutMetrics.compact-control-height;
    min-width: 88px;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.accent && !root.disabled ? Palette.accent-default
        : touch.has-hover && !root.disabled ? Palette.border-strong
        : Palette.border-default;
    background: root.disabled ? Palette.surface-disabled
        : touch.pressed ? Palette.surface-pressed
        : root.accent ? Palette.accent-soft
        : touch.has-hover ? Palette.surface-hover
        : Palette.surface-raised;

    Text {
        text: root.label;
        font-size: 13px;
        font-weight: root.accent ? 650 : 550;
        color: root.disabled ? Palette.text-disabled
            : root.accent ? Palette.accent-default
            : Palette.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

export component LocalStatus inherits Rectangle {
    in property <string> text;
    in property <color> accent: Palette.text-secondary;
    height: LayoutMetrics.compact-control-height;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.accent.transparentize(0.55);
    background: root.accent.transparentize(0.92);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 9px;
        alignment: center;
        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: root.accent;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: 12.5px;
            font-weight: 500;
            color: Palette.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
