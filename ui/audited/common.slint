import { Palette as WidgetPalette } from "std-widgets.slint";
import { Palette, ThemeState, ThemeMode } from "../themes/dark.slint";
import { Icon } from "../components/icon.slint";
import { Ripple, FocusRing } from "../components/interaction.slint";
import { Motion, Shape } from "../themes/tokens.slint";

// Canonical geometry for the product UI (docs/references/orbis-visual-2026-09-24/):
// one gutter, one card padding and one radius shared by every page.
export global LayoutMetrics {
    in property <length> sidebar-width: 268px;
    in property <length> titlebar-height: 48px;
    in property <length> page-margin: 26px;
    in property <length> page-gap: 16px;
    in property <length> card-padding: 20px;
    in property <length> card-radius: 14px;
    in property <length> control-height: 40px;
    in property <length> compact-control-height: 36px;
    in property <length> page-bottom-padding: 24px;
}

// Standard Slint widgets (ScrollView/ComboBox/etc.) have their own style
// palette. Keep it synchronized with the runtime Orbis theme.
export component ThemeBridge inherits Rectangle {
    width: 0px;
    height: 0px;
    background: transparent;

    property <ThemeMode> observed-mode: ThemeState.mode;

    function sync-widget-theme() {
        WidgetPalette.color-scheme = root.observed-mode == ThemeMode.Light
            ? ColorScheme.light
            : ColorScheme.dark;
    }

    init => { root.sync-widget-theme(); }
    changed observed-mode => { root.sync-widget-theme(); }
}

// Card surface. No drop shadows exist in the software renderer, so elevation
// is expressed like Fluent "Mica" cards: a raised body, a hairline border
// and a soft light edge along the top.
export component SectionCard inherits Rectangle {
    border-radius: LayoutMetrics.card-radius;
    border-width: 1px;
    border-color: Palette.border-default;
    // Solid: the software renderer draws gradients with square corners.
    background: Palette.card-top.mix(Palette.surface-default, 0.5);

    Rectangle {
        x: LayoutMetrics.card-radius;
        y: 0px;
        width: parent.width - 2 * LayoutMetrics.card-radius;
        height: 1px;
        background: @linear-gradient(90deg, #FFFFFF00 0%, Palette.edge-light 50%, #FFFFFF00 100%);
    }
    @children
}

export component SectionTitle inherits Rectangle {
    in property <string> title;
    in property <string> detail: "";
    in property <color> detail-color: Palette.text-secondary;
    height: 30px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.title;
            font-size: 17px;
            font-weight: 650;
            color: Palette.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        if (root.detail != "") : Text {
            text: root.detail;
            font-size: 12.5px;
            font-weight: 500;
            color: root.detail-color;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}

export component PageHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    // Negative hides the leading page icon.
    in property <int> icon-kind: -1;
    height: root.subtitle == "" ? 44px : 66px;
    background: transparent;

    HorizontalLayout {
        spacing: 18px;
        if (root.icon-kind >= 0) : Rectangle {
            width: 52px;
            Icon {
                width: 44px;
                height: 44px;
                y: (parent.height - self.height) / 2;
                kind: root.icon-kind;
                tint: Palette.text-primary;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text {
                text: root.title;
                font-size: 30px;
                font-weight: 700;
                color: Palette.text-primary;
                overflow: elide;
            }
            if (root.subtitle != "") : Text {
                text: root.subtitle;
                font-size: 14.5px;
                color: Palette.text-secondary;
                overflow: elide;
            }
        }
    }
}

// Card heading as in the references: title (+ optional icon and subtitle) on
// top, a hairline divider below, optional trailing detail on the right.
export component CardHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <string> detail: "";
    in property <color> detail-color: Palette.text-secondary;
    in property <int> icon-kind: -1;
    in property <color> icon-tint: Palette.text-primary;
    in property <bool> divider: true;
    height: (root.subtitle == "" ? 34px : 46px) + (root.divider ? 13px : 0px);
    background: transparent;

    HorizontalLayout {
        y: 0px;
        height: root.subtitle == "" ? 34px : 46px;
        spacing: 14px;
        if (root.icon-kind >= 0) : Rectangle {
            width: 28px;
            Icon {
                width: 28px;
                height: 28px;
                y: (parent.height - self.height) / 2;
                kind: root.icon-kind;
                tint: root.icon-tint;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 17px;
                font-weight: 650;
                color: Palette.text-primary;
                overflow: elide;
            }
            if (root.subtitle != "") : Text {
                text: root.subtitle;
                font-size: 12.5px;
                color: Palette.text-secondary;
                overflow: elide;
            }
        }
        if (root.detail != "") : Text {
            text: root.detail;
            font-size: 12.5px;
            font-weight: 500;
            color: root.detail-color;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
        @children
    }
    if (root.divider) : Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.border-default;
    }
}

// Settings row with a leading line icon, title, optional description and a
// trailing control area (children).
export component IconRow inherits Rectangle {
    in property <int> icon-kind: -1;
    in property <color> icon-tint: Palette.text-primary;
    in property <string> title;
    in property <string> description: "";
    in property <bool> muted: false;
    in property <length> label-width: 0px;
    in property <bool> separator: false;
    min-height: root.description == "" ? 52px : 60px;
    background: transparent;

    if (root.separator) : Rectangle {
        y: 0px;
        height: 1px;
        background: Palette.border-default;
    }

    HorizontalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 16px;
        if (root.icon-kind >= 0) : Rectangle {
            width: 26px;
            Icon {
                width: 24px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                kind: root.icon-kind;
                tint: root.muted ? Palette.text-disabled : root.icon-tint;
            }
        }
        VerticalLayout {
            horizontal-stretch: root.label-width > 0px ? 0 : 1;
            min-width: root.label-width;
            max-width: root.label-width > 0px ? root.label-width : 100000px;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.title;
                font-size: 14.5px;
                font-weight: 550;
                color: root.muted ? Palette.text-disabled : Palette.text-primary;
                overflow: elide;
            }
            if (root.description != "") : Text {
                text: root.description;
                font-size: 12.5px;
                color: Palette.text-secondary;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            horizontal-stretch: root.label-width > 0px ? 1 : 0;
            spacing: 8px;
            alignment: root.label-width > 0px ? LayoutAlignment.stretch : LayoutAlignment.end;
            @children
        }
    }
}

// Switch (Material 3 / Fluent toggle): the thumb slides and recolors, grows
// while pressed and shows a hover halo; Tab focuses it, Space toggles.
export component Switch inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> disabled: false;
    // Screen-reader name (the row's label).
    in property <string> label: "";
    callback toggled(bool);

    property <bool> pressed: touch.pressed;
    property <length> thumb: root.pressed ? 24px : 20px;

    width: 50px;
    height: 28px;
    border-radius: 14px;
    border-width: root.checked ? 0px : 1.5px;
    border-color: touch.has-hover && !root.disabled ? Palette.text-secondary : Palette.border-strong;
    background: root.checked
        ? (root.disabled ? Palette.accent-fill.transparentize(0.55) : touch.has-hover ? Palette.accent-fill.brighter(0.12) : Palette.accent-fill)
        : root.disabled ? Palette.surface-muted
        : Palette.surface-pressed;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-enabled: !root.disabled;
    accessible-checked: root.checked;
    accessible-action-default => { if (!root.disabled) { root.toggled(!root.checked); } }
    animate background, border-color { duration: Motion.normal; easing: ease-out; }

    // Hover halo around the thumb.
    Rectangle {
        width: 36px;
        height: 36px;
        x: knob.x + knob.width / 2 - self.width / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 18px;
        background: (root.checked ? Palette.accent-default : Palette.text-secondary)
            .transparentize(touch.has-hover && !root.disabled ? (root.pressed ? 0.78 : 0.86) : 1);
        animate background { duration: Motion.fast; }
    }
    knob := Rectangle {
        width: root.thumb;
        height: 20px;
        x: root.checked ? parent.width - self.width - 4px : 4px;
        y: 4px;
        border-radius: 10px;
        background: root.checked ? Palette.text-on-accent
            : root.disabled ? Palette.text-disabled
            : #C9D3E6;
        animate x, width { duration: Motion.normal; easing: cubic-bezier(0.2, 0, 0, 1); }
        animate background { duration: Motion.normal; }
    }
    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
    focus := FocusScope {
        enabled: !root.disabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) { root.toggled(!root.checked); return accept; }
            return reject;
        }
    }
    FocusRing { shown: focus.has-focus; radius: 14px; }
}

export component WindowHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    height: 44px;
    background: transparent;

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 17px;
                font-weight: 650;
                color: Palette.text-primary;
            }
            if (root.subtitle != "") : Text {
                text: root.subtitle;
                font-size: 12px;
                color: Palette.text-secondary;
                overflow: elide;
            }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
    }
}

export component Divider inherits Rectangle {
    background: Palette.border-default;
}

export component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Palette.text-primary;
    height: 36px;
    background: transparent;

    HorizontalLayout {
        spacing: 16px;
        Text {
            text: root.label;
            font-size: 13.5px;
            font-weight: 500;
            color: Palette.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        Text {
            text: root.value;
            font-size: 13.5px;
            font-weight: 600;
            color: root.value-color;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}

export component SubsectionLabel inherits Rectangle {
    in property <string> text;
    height: 28px;
    background: transparent;
    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.text;
            font-size: 11.5px;
            font-weight: 650;
            letter-spacing: 0.6px;
            color: Palette.text-secondary;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 1px;
            background: Palette.border-default;
        }
    }
}

export component StatusPill inherits Rectangle {
    in property <string> text;
    in property <color> accent: Palette.text-secondary;
    min-width: 84px;
    max-width: 190px;
    horizontal-stretch: 0;
    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: root.accent.transparentize(0.48);
    background: root.accent.transparentize(0.90);

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 10px;
        spacing: 7px;
        alignment: center;
        Rectangle {
            width: 6px;
            vertical-stretch: 1;
            background: transparent;
            Rectangle {
                width: 6px;
                height: 6px;
                y: (parent.height - self.height) / 2 + 1px;
                border-radius: 3px;
                background: root.accent;
            }
        }
        Text {
            text: root.text;
            font-size: 11.5px;
            font-weight: 600;
            color: root.accent;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Selector button: the selected option is a solid accent fill. Hover and
// press are animated state layers with a press ripple; Tab focuses it and
// Space/Enter activate it.
export component ChoiceButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> disabled: false;
    callback clicked;

    min-width: 72px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: LayoutMetrics.control-height;
    border-radius: Shape.control;
    border-width: 1px;
    border-color: root.selected && !root.disabled ? Palette.accent-border
        : touch.has-hover && !root.disabled ? Palette.border-strong
        : Palette.border-default;
    background: root.selected ? (root.disabled ? Palette.accent-fill.transparentize(0.55) : Palette.accent-fill)
        : root.disabled ? Palette.surface-disabled
        : touch.has-hover ? Palette.surface-hover
        : Palette.surface-raised;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.selected;
    accessible-action-default => { if (!root.disabled) { root.clicked(); } }

    animate background, border-color { duration: Motion.fast; easing: ease-out; }

    ripple := Ripple { radius: parent.border-radius; tint: root.selected ? #FFFFFF : Palette.accent-default; }
    Text {
        text: root.label;
        font-size: 13px;
        font-weight: root.selected ? 600 : 500;
        color: root.selected ? Palette.text-on-accent
            : root.disabled ? Palette.text-disabled
            : Palette.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        animate color { duration: Motion.fast; }
    }
    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) { ripple.press(self.mouse-x, self.mouse-y); }
            else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) { ripple.release(); }
        }
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        enabled: !root.disabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) { root.clicked(); return accept; }
            return reject;
        }
    }
    FocusRing { shown: focus.has-focus; }
}

// Command button. `accent` marks the primary action of a card: a lit
// gradient fill; the others are neutral surfaces.
export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> disabled: false;
    in property <bool> accent: false;
    in property <int> icon-kind: -1;
    callback clicked;

    height: LayoutMetrics.compact-control-height;
    min-width: 96px;
    border-radius: Shape.control;
    border-width: 1px;
    border-color: root.accent && !root.disabled ? Palette.accent-border
        : touch.has-hover && !root.disabled ? Palette.border-strong
        : Palette.border-default;
    background: root.disabled ? Palette.surface-disabled
        : root.accent ? (touch.has-hover ? Palette.accent-fill.brighter(0.14) : Palette.accent-fill)
        : touch.has-hover ? Palette.surface-hover
        : Palette.surface-raised;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (!root.disabled) { root.clicked(); } }

    animate background, border-color { duration: Motion.fast; easing: ease-out; }

    ripple := Ripple { radius: parent.border-radius; tint: root.accent ? #FFFFFF : Palette.accent-default; strength: root.accent ? 0.24 : 0.18; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;
        if (root.icon-kind >= 0) : Icon {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            kind: root.icon-kind;
            tint: root.disabled ? Palette.text-disabled : root.accent ? Palette.text-on-accent : Palette.text-primary;
        }
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.accent ? 600 : 500;
            color: root.disabled ? Palette.text-disabled
                : root.accent ? Palette.text-on-accent
                : Palette.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) { ripple.press(self.mouse-x, self.mouse-y); }
            else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) { ripple.release(); }
        }
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        enabled: !root.disabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) { root.clicked(); return accept; }
            return reject;
        }
    }
    FocusRing { shown: focus.has-focus; }
}

// Segmented control (Fluent/iOS pattern): options share one track and the
// selection is a thumb that slides between them. `selected` < 0 shows no
// thumb (nothing observed yet).
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected: -1;
    in property <bool> disabled: false;
    callback changed(int);

    property <length> pad: 3px;
    property <length> cell: (self.width - 2 * root.pad) / Math.max(root.options.length, 1);

    min-width: root.options.length * 52px;
    height: LayoutMetrics.control-height;
    horizontal-stretch: 1;
    border-radius: Shape.control;
    border-width: 1px;
    border-color: Palette.border-default;
    background: root.disabled ? Palette.surface-disabled : Palette.surface-muted;
    accessible-role: tab-list;

    Rectangle {
        x: root.pad + Math.max(root.selected, 0) * root.cell;
        y: root.pad;
        width: root.cell;
        height: parent.height - 2 * root.pad;
        border-radius: Shape.control - 3px;
        border-width: 1px;
        border-color: root.disabled ? transparent : Palette.accent-border;
        background: root.disabled ? Palette.accent-fill.transparentize(0.55) : Palette.accent-fill;
        opacity: root.selected >= 0 ? 1 : 0;
        animate x { duration: Motion.slow; easing: cubic-bezier(0.2, 0, 0, 1); }
        animate opacity { duration: Motion.normal; }
    }

    for option[i] in root.options : Rectangle {
        x: root.pad + i * root.cell;
        y: root.pad;
        width: root.cell;
        height: parent.height - 2 * root.pad;
        border-radius: Shape.control - 3px;
        clip: true;
        background: i != root.selected && seg-touch.has-hover && !root.disabled ? Palette.surface-hover : transparent;
        accessible-role: tab;
        accessible-label: option;
        accessible-checked: i == root.selected;
        accessible-action-default => { if (!root.disabled) { root.changed(i); } }
        animate background { duration: Motion.fast; }

        seg-ripple := Ripple { radius: Shape.control - 3px; tint: i == root.selected ? #FFFFFF : Palette.accent-default; strength: 0.16; }
        Text {
            text: option;
            font-size: 13px;
            font-weight: i == root.selected ? 600 : 500;
            color: i == root.selected ? Palette.text-on-accent
                : root.disabled ? Palette.text-disabled
                : Palette.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            animate color { duration: Motion.normal; }
        }
        seg-touch := TouchArea {
            enabled: !root.disabled;
            mouse-cursor: pointer;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) { seg-ripple.press(self.mouse-x, self.mouse-y); }
                else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) { seg-ripple.release(); }
            }
            clicked => { root.changed(i); }
        }
    }

    focus := FocusScope {
        enabled: !root.disabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow && root.selected > 0) { root.changed(root.selected - 1); return accept; }
            if (event.text == Key.RightArrow && root.selected < root.options.length - 1) { root.changed(root.selected + 1); return accept; }
            return reject;
        }
    }
    FocusRing { shown: focus.has-focus; }
}

// Labeled control row: fixed label column on the left, control on the right.
export component FieldRow inherits Rectangle {
    in property <string> label;
    in property <bool> muted: false;
    height: LayoutMetrics.control-height;
    background: transparent;

    HorizontalLayout {
        spacing: 16px;
        Text {
            width: 140px;
            text: root.label;
            font-size: 13.5px;
            font-weight: 500;
            color: root.muted ? Palette.text-disabled : Palette.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            @children
        }
    }
}

export component LocalStatus inherits Rectangle {
    in property <string> text;
    in property <color> accent: Palette.text-secondary;
    property <bool> entered: false;
    opacity: root.entered ? 1 : 0;
    animate opacity { duration: Motion.normal; easing: ease-out; }
    init => { root.entered = true; }
    min-height: LayoutMetrics.compact-control-height;
    vertical-stretch: 0;
    border-radius: 10px;
    background: root.accent.transparentize(0.9);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 9px;
        Rectangle {
            width: 7px;
            vertical-stretch: 1;
            background: transparent;
            Rectangle {
                width: 7px;
                height: 7px;
                y: (parent.height - self.height) / 2 + 1px;
                border-radius: 3.5px;
                background: root.accent;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: 12.5px;
            font-weight: 500;
            color: Palette.text-secondary;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}

// Rounded tinted square holding a line icon (reference 9 tiles).
export component IconBadge inherits Rectangle {
    in property <int> kind;
    in property <color> tint: Palette.accent-default;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.tint.transparentize(0.6);
    background: root.tint.transparentize(0.86);
    Icon {
        width: root.width * 0.52;
        height: root.height * 0.52;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        kind: root.kind;
        tint: root.tint;
    }
}

// Base of every page: fades in and settles 12 px upward when the section is
// opened (Fluent "entrance" motion).
export component PageSurface inherits Rectangle {
    property <bool> entered: false;
    opacity: root.entered ? 1 : 0;
    y: root.entered ? 0px : 12px;
    animate opacity { duration: Motion.slow; easing: ease-out; }
    animate y { duration: Motion.slow; easing: cubic-bezier(0.2, 0, 0, 1); }

    init => { root.entered = true; }
}
