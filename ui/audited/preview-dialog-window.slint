import { WindowHeader, SectionCard, ActionButton } from "common.slint";
import { Palette } from "../themes/dark.slint";

// Compatibility name retained for current Rust glue. This is a real frontend
// dialog contract: the UI never performs the underlying operation itself.
export component PreviewDialogWindow inherits Window {
    width: 430px;
    height: 220px;
    title: "Orbis Control";
    background: Palette.window-background;

    in-out property <int> kind: 0; // 0 reboot, 1 logout, 2 failure, 3 confirm
    in property <string> action-label: "Confirm";
    in property <bool> action-enabled: true;

    callback dismiss-clicked;
    callback confirm-clicked;

    VerticalLayout {
        padding: 16px; spacing: 12px;
        WindowHeader {
            title: root.kind == 0 ? "Требуется перезагрузка"
                : root.kind == 1 ? "Требуется выход из сессии"
                : root.kind == 2 ? "Действие не удалось"
                : "Подтвердите действие";
            subtitle: root.kind == 2 ? "Наблюдаемое состояние не было изменено" : "Требуется системное действие";
        }
        SectionCard {
            vertical-stretch: 1;
            Text {
                x: 14px; y: 12px; width: parent.width - 28px; height: parent.height - 24px;
                text: root.kind == 0 ? "Запрошенный режим GPU применится после перезагрузки."
                    : root.kind == 1 ? "Переключение требует выхода из сессии, чтобы рабочий стол переключился безопасно."
                    : root.kind == 2 ? "Backend не подтвердил операцию. Прежнее наблюдаемое состояние сохранено."
                    : "Проверьте запрошенную операцию перед продолжением.";
                font-size: 12.5px;
                color: root.kind == 2 ? Palette.error : Palette.text-primary;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            height: 32px; spacing: 8px;
            Rectangle { horizontal-stretch: 1; background: transparent; }
            if (root.kind != 2) : ActionButton { label: "Отмена"; clicked => { root.dismiss-clicked(); } }
            ActionButton {
                min-width: 120px;
                label: root.kind == 0 ? "Перезагрузить позже" : root.kind == 1 ? "Выйти позже" : root.kind == 2 ? "Закрыть" : root.action-label;
                accent: root.kind != 2;
                disabled: root.kind == 3 && !root.action-enabled;
                clicked => {
                    if (root.kind == 3) { root.confirm-clicked(); }
                    else { root.dismiss-clicked(); }
                }
            }
        }
    }
}
