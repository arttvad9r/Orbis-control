import { WindowHeader, SectionCard, ActionButton, StatusPill } from "common.slint";
import { AppMark } from "../components/app-mark.slint";
import { Palette } from "../themes/dark.slint";

export component PreviewDialogWindow inherits Window {
    width: 470px;
    height: 248px;
    title: "Orbis Control";
    background: Palette.window-background;

    in-out property <int> kind: 0; // 0 reboot, 1 logout, 2 failure, 3 confirm
    in property <string> action-label: "Подтвердить";
    in property <bool> action-enabled: true;

    callback dismiss-clicked;
    callback confirm-clicked;

    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        HorizontalLayout {
            height: 46px;
            spacing: 12px;
            AppMark { width: 38px; height: 38px; }
            WindowHeader {
                horizontal-stretch: 1;
                title: root.kind == 0 ? "Требуется перезагрузка"
                    : root.kind == 1 ? "Требуется выход из сессии"
                    : root.kind == 2 ? "Действие не удалось"
                    : "Подтвердите действие";
                subtitle: root.kind == 2 ? "Фактическое состояние не было подтверждено" : "Orbis сохранит текущий контекст операции";
            }
            StatusPill {
                text: root.kind == 2 ? "Ошибка" : root.kind == 0 || root.kind == 1 ? "Системное действие" : "Подтверждение";
                accent: root.kind == 2 ? Palette.error : root.kind == 0 || root.kind == 1 ? Palette.warning : Palette.accent-default;
            }
        }

        SectionCard {
            vertical-stretch: 1;
            background: Palette.surface-raised;
            Text {
                x: 16px;
                y: 14px;
                width: parent.width - 32px;
                height: parent.height - 28px;
                text: root.kind == 0 ? "Запрошенный режим GPU применится после перезагрузки. Можно продолжить работу и выполнить её позже."
                    : root.kind == 1 ? "Переключение требует выхода из сессии, чтобы рабочий стол завершил изменение безопасно."
                    : root.kind == 2 ? "Backend не подтвердил операцию. Orbis сохранил прежнее наблюдаемое состояние и не показывает ложный успех."
                    : "Проверьте запрошенное действие перед продолжением.";
                font-size: 13px;
                color: root.kind == 2 ? Palette.error : Palette.text-primary;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            height: 38px;
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; background: transparent; }
            if (root.kind != 2) : ActionButton { label: "Отмена"; clicked => { root.dismiss-clicked(); } }
            ActionButton {
                min-width: 142px;
                label: root.kind == 0 ? "Перезагрузить позже" : root.kind == 1 ? "Выйти позже" : root.kind == 2 ? "Закрыть" : root.action-label;
                accent: root.kind != 2;
                disabled: root.kind == 3 && !root.action-enabled;
                clicked => {
                    if (root.kind == 3) { root.confirm-clicked(); }
                    else { root.dismiss-clicked(); }
                }
            }
        }
    }
}
