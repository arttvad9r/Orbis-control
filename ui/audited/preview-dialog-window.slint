import { WindowHeader, SectionCard, ActionButton } from "common.slint";
import { Palette } from "../themes/dark.slint";

// Compatibility name retained for current Rust glue. This is a real frontend
// dialog contract: the UI never performs the underlying operation itself.
export component PreviewDialogWindow inherits Window {
    width: 430px;
    height: 220px;
    title: "Orbis Control";
    background: Palette.window-background;

    in-out property <int> kind: 0; // 0 reboot, 1 logout, 2 failure, 3 confirm
    in property <string> action-label: "Confirm";
    in property <bool> action-enabled: true;

    callback dismiss-clicked;
    callback confirm-clicked;

    VerticalLayout {
        padding: 12px; spacing: 9px;
        WindowHeader {
            title: root.kind == 0 ? "Reboot required"
                : root.kind == 1 ? "Logout required"
                : root.kind == 2 ? "Action failed"
                : "Confirm action";
            subtitle: root.kind == 2 ? "The observed state was not replaced" : "System action required";
        }
        SectionCard {
            vertical-stretch: 1;
            Text {
                x: 12px; y: 12px; width: parent.width - 24px; height: parent.height - 24px;
                text: root.kind == 0 ? "The requested GPU mode requires a reboot before it becomes effective."
                    : root.kind == 1 ? "The requested transition requires logging out before the desktop session can switch safely."
                    : root.kind == 2 ? "The backend did not confirm the requested operation. The previously observed state is preserved."
                    : "Review the requested operation before continuing.";
                font-size: 10px;
                color: root.kind == 2 ? Palette.error : Palette.text-primary;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            height: 30px; spacing: 6px;
            Rectangle { horizontal-stretch: 1; background: transparent; }
            if (root.kind != 2) : ActionButton { width: 88px; label: "Cancel"; clicked => { root.dismiss-clicked(); } }
            ActionButton {
                width: 112px;
                label: root.kind == 0 ? "Reboot Later" : root.kind == 1 ? "Logout Later" : root.kind == 2 ? "Close" : root.action-label;
                accent: root.kind != 2;
                disabled: root.kind == 3 && !root.action-enabled;
                clicked => {
                    if (root.kind == 3) { root.confirm-clicked(); }
                    else { root.dismiss-clicked(); }
                }
            }
        }
    }
}
