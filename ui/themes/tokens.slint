// Orbis Control design tokens (non-color): motion, type ramp, shape.
//
// Follows the common desktop design-system conventions (Fluent 2 /
// Material 3): short state transitions (~100–150 ms) for hover and press,
// ~200 ms for selection changes, ~250–300 ms for spatial moves, all with a
// decelerating curve; one type ramp; a 4-px spacing grid. Colors live in
// dark.slint / light.slint.

export global Motion {
    // Hover/press state layers, color changes.
    out property <duration> fast: 120ms;
    // Toggles, selection fills, focus rings.
    out property <duration> normal: 200ms;
    // Indicators that travel (segmented thumb, nav pill), page entry.
    out property <duration> slow: 280ms;
    // Press ripple expansion and fade.
    out property <duration> ripple: 520ms;
    // Level bars and gauges following live telemetry.
    out property <duration> data: 600ms;
}

export global Type {
    in property <length> display: 30px;
    in property <length> title-large: 22px;
    in property <length> title: 17px;
    in property <length> body-large: 15px;
    in property <length> body: 14px;
    in property <length> label: 13px;
    in property <length> caption: 12px;
    in property <length> metric: 30px;
}

export global Shape {
    in property <length> control: 10px;
    in property <length> card: 14px;
    in property <length> tile: 12px;
    in property <length> focus-width: 2px;
    // Gap between a control's edge and its focus ring.
    in property <length> focus-offset: 3px;
}
