// Orbis Control — light-theme semantic tokens.
// Light mode mirrors the same visual hierarchy as dark mode instead of being a
// white inversion: quiet window chrome, clear cards and one restrained accent.

export global LightPalette {
    // surfaces
    in property <color> window-background: #F4F5F7;
    in property <color> titlebar-background: #F4F5F7;
    in property <color> surface-default: #FFFFFF;
    in property <color> surface-hover: #F0F3F6;
    in property <color> surface-pressed: #E7EBEF;
    in property <color> surface-selected: #EDF4FC;
    in property <color> surface-disabled: #ECEFF3;
    in property <color> border-default: #D5DBE2;
    in property <color> border-strong: #AEB7C2;

    // text
    in property <color> text-primary: #171A1E;
    in property <color> text-secondary: #5F6873;
    in property <color> text-disabled: #98A0AA;
    in property <color> text-on-accent: #FFFFFF;

    // semantic accents
    in property <color> accent-default: #2678E8;
    in property <color> warning: #A66C12;
    in property <color> error: #C84455;
    in property <color> success: #1E8064;

    // mode accents
    in property <color> silent: #258B70;
    in property <color> balanced: #2678E8;
    in property <color> turbo: #D94E60;
    in property <color> eco: #3C914B;
    in property <color> standard: #2678E8;
    in property <color> ultimate: #AF741D;
    in property <color> optimized: #337FC7;
}
