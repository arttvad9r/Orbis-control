// Orbis Control — light-theme semantic tokens.
// Neutral system surface hierarchy with one restrained blue product accent.

export global LightPalette {
    // surfaces
    in property <color> window-background: #F3F5F8;
    in property <color> titlebar-background: #F7F9FB;
    in property <color> surface-default: #FFFFFF;
    in property <color> surface-raised: #FBFCFE;
    in property <color> surface-muted: #F5F7FA;
    in property <color> surface-hover: #EEF2F6;
    in property <color> surface-pressed: #E6EBF1;
    in property <color> surface-selected: #E8F1FF;
    in property <color> surface-disabled: #F0F2F5;
    in property <color> accent-soft: #E8F1FF;

    // borders
    in property <color> border-default: #DDE3EA;
    in property <color> border-strong: #C4CDD8;

    // text
    in property <color> text-primary: #17202A;
    in property <color> text-secondary: #657180;
    in property <color> text-disabled: #98A2AE;
    in property <color> text-on-accent: #FFFFFF;

    // semantic accents
    in property <color> accent-default: #2F6FE4;
    in property <color> warning: #C77A16;
    in property <color> error: #D74755;
    in property <color> success: #168B63;

    // mode accents
    in property <color> silent: #168B63;
    in property <color> balanced: #2F6FE4;
    in property <color> turbo: #D74755;
    in property <color> eco: #168B63;
    in property <color> standard: #2F6FE4;
    in property <color> ultimate: #B87918;
    in property <color> optimized: #1785B8;
}
