// Orbis Control — light-theme semantic tokens.
// Calm system-utility palette: off-white chrome, white cards, thin borders,
// one restrained blue accent (reference design 2026-08-25).

export global LightPalette {
    // surfaces
    in property <color> window-background: #F7F8FA;
    in property <color> titlebar-background: #FAFAFB;
    in property <color> surface-default: #FFFFFF;
    in property <color> surface-hover: #F3F4F7;
    in property <color> surface-pressed: #ECEDF1;
    in property <color> surface-selected: #EAF2FF;
    in property <color> surface-disabled: #F2F3F5;
    in property <color> accent-soft: #EAF2FF;

    // borders
    in property <color> border-default: #E6E8EC;
    in property <color> border-strong: #CFD3DA;

    // text
    in property <color> text-primary: #171717;
    in property <color> text-secondary: #6B7280;
    in property <color> text-disabled: #9CA3AF;
    in property <color> text-on-accent: #FFFFFF;

    // semantic accents
    in property <color> accent-default: #2563EB;
    in property <color> warning: #D97706;
    in property <color> error: #DC2626;
    in property <color> success: #16A34A;

    // mode accents (markers only, never large fills)
    in property <color> silent: #16A34A;
    in property <color> balanced: #2563EB;
    in property <color> turbo: #DC2626;
    in property <color> eco: #16A34A;
    in property <color> standard: #2563EB;
    in property <color> ultimate: #D97706;
    in property <color> optimized: #0284C7;
}
