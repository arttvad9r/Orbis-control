// Orbis Control — light-theme semantic tokens (pairs with dark.slint).

export global LightPalette {
    in property <color> window-background: #EEF2F8;
    in property <color> titlebar-background: #F6F8FC;
    in property <color> surface-default: #FFFFFF;
    in property <color> surface-raised: #F7F9FD;
    in property <color> surface-muted: #F2F5FA;
    in property <color> surface-hover: #E9EFF8;
    in property <color> surface-pressed: #DEE6F2;
    in property <color> surface-selected: #E3ECFF;
    in property <color> surface-disabled: #EFF2F6;
    in property <color> accent-soft: #E3ECFF;
    in property <color> accent-fill: #1F5EF5;
    in property <color> border-default: #DCE3EE;
    in property <color> border-strong: #C2CCDC;
    in property <color> text-primary: #141C2B;
    in property <color> text-secondary: #5F6B80;
    in property <color> text-disabled: #9AA4B5;
    in property <color> text-on-accent: #FFFFFF;
    in property <color> accent-default: #1F5EF5;
    in property <color> warning: #C47A12;
    in property <color> error: #D63F51;
    in property <color> success: #15935F;
    in property <color> silent: #15935F;
    in property <color> balanced: #1F5EF5;
    in property <color> turbo: #D63F51;
    in property <color> eco: #15935F;
    in property <color> standard: #1F5EF5;
    in property <color> ultimate: #B87712;
    in property <color> optimized: #1486B8;
    in property <color> violet: #7A45E0;
    in property <color> card-top: #FFFFFF;
    in property <color> accent-border: #1F5EF5;
}
