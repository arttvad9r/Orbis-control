// Orbis Control — тёмная тема (дизайн-токены).
// Базовые значения из docs/ui-reference.md; уточняются после визуальной сверки.

export global Palette {
    // surfaces
    in property <color> window-background: #1F1F1F;
    in property <color> titlebar-background: #242529;
    in property <color> surface-default: #303030;
    in property <color> surface-hover: #383838;
    in property <color> surface-pressed: #292929;
    in property <color> surface-disabled: #292929;
    in property <color> border-default: #444444;
    // text
    in property <color> text-primary: #F2F2F2;
    in property <color> text-secondary: #B7B7B7;
    in property <color> text-disabled: #777777;
    // accents
    in property <color> accent-default: #2DA8F2;
    in property <color> warning: #E5A94F;
    in property <color> error: #E35D6A;
    in property <color> success: #4BC39A;
    // mode accents
    in property <color> silent: #49C6A5;
    in property <color> balanced: #2DA8F2;
    in property <color> turbo: #EF6376;
    in property <color> eco: #67C66A;
    in property <color> standard: #2DA8F2;
    in property <color> ultimate: #E6A04B;
    in property <color> optimized: #2DA8F2;
}
