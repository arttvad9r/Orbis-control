// Orbis Control — runtime semantic theme tokens.
// Deep navy surfaces, one saturated blue accent (docs/references/orbis-visual-2026-09-24).

import { LightPalette } from "light.slint";

export enum ThemeMode { Dark, Light }

export global ThemeState {
    in-out property <ThemeMode> mode: ThemeMode.Dark;
}

export global Palette {
    in property <color> window-background: ThemeState.mode == ThemeMode.Light ? LightPalette.window-background : #0A1322;
    in property <color> titlebar-background: ThemeState.mode == ThemeMode.Light ? LightPalette.titlebar-background : #070D19;
    in property <color> surface-default: ThemeState.mode == ThemeMode.Light ? LightPalette.surface-default : #0D1729;
    in property <color> surface-raised: ThemeState.mode == ThemeMode.Light ? LightPalette.surface-raised : #111D33;
    in property <color> surface-muted: ThemeState.mode == ThemeMode.Light ? LightPalette.surface-muted : #0A1426;
    in property <color> surface-hover: ThemeState.mode == ThemeMode.Light ? LightPalette.surface-hover : #16264A;
    in property <color> surface-pressed: ThemeState.mode == ThemeMode.Light ? LightPalette.surface-pressed : #1B2E57;
    in property <color> surface-selected: ThemeState.mode == ThemeMode.Light ? LightPalette.surface-selected : #0F3A9E;
    in property <color> surface-disabled: ThemeState.mode == ThemeMode.Light ? LightPalette.surface-disabled : #0E1626;
    in property <color> accent-soft: ThemeState.mode == ThemeMode.Light ? LightPalette.accent-soft : #10285E;
    in property <color> accent-fill: ThemeState.mode == ThemeMode.Light ? LightPalette.accent-fill : #1E63F5;
    in property <color> border-default: ThemeState.mode == ThemeMode.Light ? LightPalette.border-default : #1A2945;
    in property <color> border-strong: ThemeState.mode == ThemeMode.Light ? LightPalette.border-strong : #2A3F66;
    in property <color> text-primary: ThemeState.mode == ThemeMode.Light ? LightPalette.text-primary : #EEF3FB;
    in property <color> text-secondary: ThemeState.mode == ThemeMode.Light ? LightPalette.text-secondary : #93A3BD;
    in property <color> text-disabled: ThemeState.mode == ThemeMode.Light ? LightPalette.text-disabled : #56647D;
    in property <color> text-on-accent: ThemeState.mode == ThemeMode.Light ? LightPalette.text-on-accent : #FFFFFF;
    in property <color> accent-default: ThemeState.mode == ThemeMode.Light ? LightPalette.accent-default : #3D86FF;
    in property <color> warning: ThemeState.mode == ThemeMode.Light ? LightPalette.warning : #F2B24C;
    in property <color> error: ThemeState.mode == ThemeMode.Light ? LightPalette.error : #FF5B6B;
    in property <color> success: ThemeState.mode == ThemeMode.Light ? LightPalette.success : #3DDC84;
    in property <color> silent: ThemeState.mode == ThemeMode.Light ? LightPalette.silent : #3DDC84;
    in property <color> balanced: ThemeState.mode == ThemeMode.Light ? LightPalette.balanced : #3D86FF;
    in property <color> turbo: ThemeState.mode == ThemeMode.Light ? LightPalette.turbo : #FF5B6B;
    in property <color> eco: ThemeState.mode == ThemeMode.Light ? LightPalette.eco : #3DDC84;
    in property <color> standard: ThemeState.mode == ThemeMode.Light ? LightPalette.standard : #3D86FF;
    in property <color> ultimate: ThemeState.mode == ThemeMode.Light ? LightPalette.ultimate : #F2B24C;
    in property <color> optimized: ThemeState.mode == ThemeMode.Light ? LightPalette.optimized : #34C6F4;
    in property <color> violet: ThemeState.mode == ThemeMode.Light ? LightPalette.violet : #A66BFF;
    in property <color> card-top: ThemeState.mode == ThemeMode.Light ? LightPalette.card-top : #101D34;
    in property <color> nav-selected-top: ThemeState.mode == ThemeMode.Light ? LightPalette.nav-selected-top : #0E47C9;
    in property <color> nav-selected-bottom: ThemeState.mode == ThemeMode.Light ? LightPalette.nav-selected-bottom : #0A36A0;
    in property <color> edge-light: ThemeState.mode == ThemeMode.Light ? LightPalette.edge-light : #8FB4FF40;
    in property <color> glow: ThemeState.mode == ThemeMode.Light ? LightPalette.glow : #1B4FC4;
    in property <color> accent-border: ThemeState.mode == ThemeMode.Light ? LightPalette.accent-border : #3F7BFF;
}
