#!/usr/bin/env python3
"""Generate and validate the Stage 6 UI-review screenshot matrix."""
from pathlib import Path
import struct
import subprocess

ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / "tests/screenshots/artifacts/stage6"
SECTIONS = ("dashboard", "performance", "cooling", "graphics")
STATES = ("normal", "dirty", "pending", "error", "unsupported", "readonly")
THEMES = ("dark", "light")
SIZES = ((980, 680), (1200, 800))


def png_size(path: Path) -> tuple[int, int]:
    with path.open("rb") as stream:
        if stream.read(8) != b"\x89PNG\r\n\x1a\n":
            raise RuntimeError(f"not a PNG: {path}")
        length = struct.unpack(">I", stream.read(4))[0]
        if stream.read(4) != b"IHDR" or length < 8:
            raise RuntimeError(f"missing PNG IHDR: {path}")
        width, height = struct.unpack(">II", stream.read(8))
        return width, height


def main() -> int:
    OUT.mkdir(parents=True, exist_ok=True)
    total = 0
    for section in SECTIONS:
        for state in STATES:
            for theme in THEMES:
                for width, height in SIZES:
                    path = OUT / f"{section}-{state}-{theme}-{width}x{height}.png"
                    subprocess.run(
                        [
                            "cargo", "run", "-p", "orbis-ui", "--example", "ui_snapshot",
                            "--features", "ui-review", "--", section, str(path), theme,
                            str(width), str(height), state,
                        ], cwd=ROOT, check=True
                    )
                    if path.stat().st_size == 0:
                        raise RuntimeError(f"empty screenshot: {path}")
                    if png_size(path) != (width, height):
                        raise RuntimeError(f"wrong screenshot size: {path}")
                    total += 1
    print(f"generated and validated {total} screenshots in {OUT}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
