#!/usr/bin/env python3
"""Run Orbis source-contract checks that do not require Cargo, Rust or Nix."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

CHECKS = (
    "scripts/check-ui-contract.py",
    "scripts/check-automation-shadow-contract.py",
    "scripts/check-automation-executor-contract.py",
)


def main() -> int:
    root = Path(__file__).resolve().parent.parent
    failed = False

    for relative in CHECKS:
        command = [sys.executable, relative]
        print(f"[verify-static] {relative}", file=sys.stderr)
        result = subprocess.run(command, cwd=root, check=False)
        if result.returncode != 0:
            failed = True

    if failed:
        print("verify-static: FAIL", file=sys.stderr)
        return 1

    print("verify-static: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
