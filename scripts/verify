#!/usr/bin/env python3
"""Practical verification runner for Orbis Control.

Usage:
  scripts/verify quick
  scripts/verify task
  scripts/verify full
  scripts/verify crate <crate-name>

The runner executes real build/test tools. It intentionally does not maintain
status documents, evidence logs, source-marker contracts, or JSON reports.
"""

from __future__ import annotations

import shutil
import subprocess
import sys
from pathlib import Path


def run(command: list[str], root: Path) -> None:
    print("+", " ".join(command), flush=True)
    subprocess.run(command, cwd=root, check=True)


def project_root() -> Path:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        check=True,
        capture_output=True,
        text=True,
    )
    return Path(result.stdout.strip()).resolve()


def ensure_cargo(root: Path, argv: list[str]) -> None:
    if shutil.which("cargo"):
        return
    if shutil.which("nix"):
        command = ["nix", "develop", "--command", sys.executable, str(Path(__file__).resolve()), *argv]
        print("+", " ".join(command), flush=True)
        raise SystemExit(subprocess.run(command, cwd=root, check=False).returncode)
    raise SystemExit("cargo is unavailable; install Rust or use the project Nix dev shell")


def cargo_base(root: Path) -> None:
    run(["cargo", "fmt", "--all", "--", "--check"], root)


def workspace_check(root: Path) -> None:
    cargo_base(root)
    run(["cargo", "check", "--workspace", "--all-targets", "--locked"], root)
    run(["git", "diff", "--check"], root)


def workspace_task(root: Path) -> None:
    workspace_check(root)
    run(["cargo", "test", "--workspace", "--locked"], root)
    run(
        ["cargo", "clippy", "--workspace", "--all-targets", "--locked", "--", "-D", "warnings"],
        root,
    )


def crate_task(root: Path, crate: str) -> None:
    cargo_base(root)
    run(["cargo", "check", "-p", crate, "--all-targets", "--locked"], root)
    run(["cargo", "test", "-p", crate, "--locked"], root)
    run(["cargo", "clippy", "-p", crate, "--all-targets", "--locked", "--", "-D", "warnings"], root)
    run(["git", "diff", "--check"], root)


def full(root: Path) -> None:
    workspace_task(root)
    if not shutil.which("nix"):
        raise SystemExit("full verification requires Nix")
    run(["nix", "flake", "check", "--max-jobs", "1", "--cores", "4", "--print-build-logs"], root)


def usage() -> int:
    print(__doc__.strip())
    return 2


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help"}:
        return usage() if not argv else 0

    root = project_root()
    ensure_cargo(root, argv)

    if argv == ["quick"]:
        workspace_check(root)
    elif argv == ["task"]:
        workspace_task(root)
    elif argv == ["full"]:
        full(root)
    elif len(argv) == 2 and argv[0] == "crate":
        crate_task(root, argv[1])
    else:
        return usage()

    print("verification passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
