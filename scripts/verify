#!/usr/bin/env python3
"""Practical verification runner for Orbis Control.

Usage:
  scripts/verify quick
  scripts/verify task
  scripts/verify full
  scripts/verify package
  scripts/verify crate <crate-name>

The runner executes real Rust/build/package checks and has no Nix dependency.
It intentionally does not maintain status documents, evidence logs, source-marker
contracts, or JSON reports.
"""

from __future__ import annotations

import shutil
import subprocess
import sys
import xml.etree.ElementTree as ET
from pathlib import Path


def run(command: list[str], root: Path) -> None:
    print("+", " ".join(command), flush=True)
    subprocess.run(command, cwd=root, check=True)


def project_root() -> Path:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        check=True,
        capture_output=True,
        text=True,
    )
    return Path(result.stdout.strip()).resolve()


def ensure_tools() -> None:
    missing = [tool for tool in ("cargo", "git") if not shutil.which(tool)]
    if missing:
        raise SystemExit(
            "missing required tools: " + ", ".join(missing) + ". Install the Rust toolchain and base development tools."
        )


def ensure_package_tools() -> None:
    if not shutil.which("makepkg"):
        raise SystemExit("missing required tool: makepkg. Install the Arch base development tools.")


def cargo_base(root: Path) -> None:
    run(["cargo", "fmt", "--all", "--", "--check"], root)


def workspace_check(root: Path) -> None:
    cargo_base(root)
    run(["cargo", "check", "--workspace", "--all-targets", "--locked"], root)
    run(["git", "diff", "--check"], root)


def workspace_task(root: Path) -> None:
    workspace_check(root)
    run(["cargo", "test", "--workspace", "--locked"], root)
    run(
        ["cargo", "clippy", "--workspace", "--all-targets", "--locked", "--", "-D", "warnings"],
        root,
    )


def crate_task(root: Path, crate: str) -> None:
    cargo_base(root)
    run(["cargo", "check", "-p", crate, "--all-targets", "--locked"], root)
    run(["cargo", "test", "-p", crate, "--locked"], root)
    run(["cargo", "clippy", "-p", crate, "--all-targets", "--locked", "--", "-D", "warnings"], root)
    run(["git", "diff", "--check"], root)


def validate_packaging_assets(root: Path) -> None:
    xml_files = [
        root / "data/dbus-1/system.d/io.github.orbiscontrol.Hardware.conf",
        root / "data/polkit-1/actions/io.github.orbiscontrol.hardware.policy",
        root / "data/metainfo/io.github.orbiscontrol.Orbis.metainfo.xml",
    ]
    for path in xml_files:
        print(f"+ parse XML {path.relative_to(root)}", flush=True)
        ET.parse(path)

    run(["bash", "-n", "packaging/deploy-dev-hardwared.sh"], root)
    run(["bash", "-n", "scripts/validate-support-matrix.sh"], root)


def package_check(root: Path) -> None:
    ensure_package_tools()
    package_dir = root / "packaging/arch"
    run(["makepkg", "--verifysource", "--nocolor"], package_dir)
    run(
        [
            "makepkg",
            "--cleanbuild",
            "--nodeps",
            "--noarchive",
            "--nosign",
            "--nocolor",
        ],
        package_dir,
    )
    if shutil.which("namcap"):
        run(["namcap", "PKGBUILD"], package_dir)
    else:
        print("- namcap not installed; skipped optional PKGBUILD lint", flush=True)


def full(root: Path) -> None:
    workspace_task(root)
    run(["cargo", "build", "--workspace", "--release", "--locked"], root)
    validate_packaging_assets(root)


def usage() -> int:
    print(__doc__.strip())
    return 2


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help"}:
        return usage() if not argv else 0

    root = project_root()
    ensure_tools()

    if argv == ["quick"]:
        workspace_check(root)
    elif argv == ["task"]:
        workspace_task(root)
    elif argv == ["full"]:
        full(root)
    elif argv == ["package"]:
        package_check(root)
    elif len(argv) == 2 and argv[0] == "crate":
        crate_task(root, argv[1])
    else:
        return usage()

    print("verification passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
