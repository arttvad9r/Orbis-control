{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "developer",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@3.2.5"],
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "ollama-vision": {
      "type": "local",
      "command": ["node", "/home/artt/.config/opencode/mcp-servers/ollama-vision/index.js"],
      "enabled": true
    }
  },
  "tools": {
    "context7_*": true,
    "gh_grep_*": true,
    "ollama-vision_*": true
  }
}
