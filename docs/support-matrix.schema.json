{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://io.github.orbiscontrol/Orbis/support-matrix.schema.json",
  "title": "Orbis Control support matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "models"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "$defs": {
    "evidenceLevel": {
      "type": "string",
      "enum": [
        "IMPLEMENTED",
        "TESTED",
        "PACKAGED",
        "LIVE-VALIDATED",
        "BLOCKED",
        "UNKNOWN"
      ]
    },
    "supportStatus": {
      "type": "string",
      "enum": ["supported", "unsupported", "unknown", "not_applicable"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "references"],
      "properties": {
        "level": {
          "$ref": "#/$defs/evidenceLevel"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "$ref": "#/$defs/supportStatus"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "read", "write"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "read": {
          "$ref": "#/$defs/access"
        },
        "write": {
          "$ref": "#/$defs/access"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "capabilities"],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
